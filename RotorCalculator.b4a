	Private HeaderTabsY As Int
	Private HeaderTabsH As Int
	Private UiContentW As Int
	Private UiContentLeft As Int

End Sub

Sub Activity_Create(FirstTime As Boolean)

	' Initialize Independent Sub-Modules
	If FirstTime Then
		RotorStorage.Initialize
		RotorPopups.Initialize
		ActiveGeom = RotorStorage.GetActiveRotor
		ActiveCond = zBETEngine.CreateDefaultCondition
		ActiveRes.Initialize
		LoadUiSettings
		RestoreSessionState
	End If
	ApplyThemePalette
	ApplySystemBars
	InitializeInputUnitMaps

	BuildMainUi
End Sub

Private Sub InitSheet
	If sheet.IsInitialized Then
		Try
			sheet.CloseAll
		Catch
			Log("Sheet close skipped: " & LastException.Message)
		End Try
	End If
	sheet.Initialize(root)
	Dim pal As Map
	pal.Initialize
	pal.Put("accent", ColorAccentCyan)
	pal.Put("green", ColorAccentGreen)
	pal.Put("amber", ColorAccentAmber)
	pal.Put("red", ColorAccentRed)
	sheet.SetTheme(ThemeMode = 1, pal)
End Sub

Private Sub BuildAllPages
	RowKey.Initialize
	RowLbl.Initialize
	RowVal.Initialize
	RowUnit.Initialize
	FocusRow = ""
	BuildPageGeom
	BuildPageCond
	BuildPageRes
	root.AddView(pnlBack0, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack1, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack2, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
End Sub

Private Sub BuildMainUi
	UpdatingUI = True
	' B4A's Activity content area is the layout viewport. Keep all UI inside it.
	root.Initialize("")
	Activity.Color = ColorPnlInput5
	root.Color = ColorPnlInput5
	If SafeContentWidth <= 0 Or SafeContentHeight <= 0 Then
		SafeContentWidth = 100%x
		SafeContentHeight = 100%y
	End If
	Activity.AddView(root, SafeContentLeft, SafeContentTop, SafeContentWidth, SafeContentHeight)
	InitSheet
	
	' Responsive scaling: both width and height constrain growth.
	' This prevents tall/narrow phones from enlarging the header until it clips.
	Dim hh As Double
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim PanelNb As Int = 14
	hh = 99dip + PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 1dip
	If root.Width > root.Height Then ld = 1 Else ld = 0
	Dim widthScale As Double = root.Width / 360dip
	Dim heightScale As Double = root.Height / hh
	sc = Min(widthScale, heightScale)
	If sc < 1 Then sc = 1
	If sc > 1.12 Then sc = 1.12
	
	' Compact landscape header; portrait preserves the AeroCalculator proportions.
	If ld = 1 Then
		sc = 1
		HeaderTopH = 48dip
		HeaderTabsY = 48dip
		HeaderTabsH = 48dip
		HeaderHeight = 97dip
	Else
		HeaderTopH = 56dip * sc
		HeaderTabsY = 56dip * sc
		HeaderTabsH = 48dip * sc
		HeaderHeight = 105dip * sc
	End If
	
	' Phone-width form on large screens: readable line lengths, no stretched controls.
	UiContentW = root.Width
	If UiContentW > 620dip Then UiContentW = 620dip
	UiContentLeft = (root.Width - UiContentW) / 2
	
	' Build three native pages. Custom header tabs control visibility.
	BuildAllPages
	
	' Header stays above page content.
	BuildUnifiedHeader
	
	' Restore persistent condition controls and in-page geometry state.
	LoadConditionDataToFields
	UpdatingUI = False
	CheckDirty
	RecalculateRotor
	ShowPage(CurrentPage, False)
	RefreshActiveRotorBar
End Sub

Sub Activity_Resume
	ShowPage(CurrentPage, False)
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	SaveSessionState
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean
	If KeyCode = KeyCodes.KEYCODE_BACK Then
		If sheet.IsInitialized Then
			If sheet.CloseTop Then Return True
		End If
		If HelpPopupOpen Then
			ClosePhysicsHelp
			Return True
		End If
		If SettingsPopupOpen Then
			CloseSettingsPopup
			Return True
		End If
		If UnitPopupOpen Then
			CloseUnitConverter
			Return True
		End If
		If SweepValuesPopupOpen Then
			CloseSweepValuesPopup
			Return True
		End If
		If SweepTablePopupOpen Then
			CloseSweepTablePopup
			Return True
		End If
		If SweepPopupOpen Then
			CloseSweepPopup
			Return True
		End If
		If CurrentPage = 2 Then
			ShowPage(1, True)
			Return True
		Else If CurrentPage = 1 Then
			ShowPage(0, True)
			Return True
		Else If CurrentPage = 0 And GeometryDirty Then
			CallSubDelayed(Me, "ConfirmExit")
			Return True
		End If
	End If
	Return False
End Sub

Sub ConfirmExit
	Wait For (sheet.ShowConfirm("Unsaved Geometry", "Save the changes to " & ActiveGeom.Name & " before leaving RotorCalculator?", "Save", "Discard", "Cancel", False)) Complete (r As Int)
	If r = DialogResponse.POSITIVE Then
		SaveCurrentRotor
		Activity.Finish
	Else If r = DialogResponse.NEGATIVE Then
		ActiveGeom = RotorStorage.GetActiveRotor
		GeometryDirty = False
		RotorStorage.ClearDraft
		Activity.Finish
	End If
End Sub

' ---- session persistence: conditions, page and the unsaved geometry draft ----
Private Sub MapD(m As Map, key As String, def As Double) As Double
	Return ParseDoubleDef("" & m.GetDefault(key, def), def)
End Sub

Private Sub SaveSessionState
	Try
		Dim m As Map
		m.Initialize
		m.Put("page", CurrentPage)
		m.Put("hmode", HorizontalInputMode)
		m.Put("hval", ConditionHorizontalValue)
		m.Put("amode", AxialInputMode)
		m.Put("aval", ConditionAxialValue)
		m.Put("alt", ConditionAltitudeM)
		m.Put("temp", ConditionTemperatureC)
		m.Put("inflow", ActiveCond.InflowModel)
		m.Put("pair", ActiveCond.OperatingPair)
		m.Put("rpm", ActiveCond.RPM)
		m.Put("coll", ActiveCond.CollectiveDeg)
		m.Put("tct", ActiveCond.TargetCT)
		m.Put("tt", ActiveCond.TargetThrustN)
		m.Put("kind", ActiveCond.KInd)
		File.WriteMap(File.DirInternal, "session_state.txt", m)
		If GeometryDirty Then
			RotorStorage.SaveDraft(ActiveGeom, RotorStorage.ActiveIndex)
		Else
			RotorStorage.ClearDraft
		End If
	Catch
		Log("Session save failed: " & LastException.Message)
	End Try
End Sub

Private Sub RestoreSessionState
	Dim hadSession As Boolean = False
	If File.Exists(File.DirInternal, "session_state.txt") Then
		Try
			Dim m As Map = File.ReadMap(File.DirInternal, "session_state.txt")
			CurrentPage = Max(0, Min(2, ParseIntDef("" & m.GetDefault("page", 0), 0)))
			Dim hm As String = "" & m.GetDefault("hmode", "mu")
			If hm = "vx" Then HorizontalInputMode = "vx" Else HorizontalInputMode = "mu"
			Dim am As String = "" & m.GetDefault("amode", "alpha")
			If am = "vz" Or am = "muz" Then AxialInputMode = am Else AxialInputMode = "alpha"
			ConditionHorizontalValue = MapD(m, "hval", 0)
			ConditionAxialValue = MapD(m, "aval", 0)
			ActiveCond.HorizontalMode = HorizontalInputMode
			ActiveCond.HorizontalValue = ConditionHorizontalValue
			ActiveCond.AxialMode = AxialInputMode
			ActiveCond.AxialValue = ConditionAxialValue
			ActiveCond.AltitudeM = ClampD(MapD(m, "alt", 0), -500.0, 11000.0)
			ActiveCond.TemperatureC = ClampD(MapD(m, "temp", 15), -80.0, 60.0)
			Dim inf As String = "" & m.GetDefault("inflow", "coleman_feingold")
			If inf = "uniform" Or inf = "coleman_simple" Or inf = "coleman_feingold" Or inf = "drees" Then ActiveCond.InflowModel = inf
			Dim pr As String = "" & m.GetDefault("pair", "rpm_ct")
			If pr = "rpm_collective" Or pr = "rpm_ct" Or pr = "rpm_thrust" Or pr = "collective_ct" Or pr = "collective_thrust" Or pr = "ct_thrust" Then ActiveCond.OperatingPair = pr
			ActiveCond.RPM = ClampD(MapD(m, "rpm", ActiveCond.RPM), 1.0, 30000.0)
			ActiveCond.CollectiveDeg = ClampD(MapD(m, "coll", 0), -60.0, 60.0)
			ActiveCond.TargetCT = ClampD(MapD(m, "tct", ActiveCond.TargetCT), 0.000001, 0.20)
			ActiveCond.TargetThrustN = ClampD(MapD(m, "tt", ActiveCond.TargetThrustN), 0.0, 1.0e8)
			ActiveCond.KInd = ClampD(MapD(m, "kind", 1.15), 1.0, 3.0)
			hadSession = True
		Catch
			Log("Session restore failed: " & LastException.Message)
		End Try
	End If
	Dim bi(1) As Int
	bi(0) = -1
	Dim d As RotorGeometry = RotorStorage.LoadDraft(bi)
	If d.IsInitialized And bi(0) = RotorStorage.ActiveIndex Then
		ActiveGeom = d
		CheckDirty
	End If
	If hadSession = False And ActiveGeom.NominalRPM > 0 Then ActiveCond.RPM = ActiveGeom.NominalRPM
End Sub

' ====================================================================
' UNIFIED HEADER (AeroCalculator Style)
' ====================================================================
Private Sub BuildUnifiedHeader
	pnltitle.Initialize("pnltitle")
	root.AddView(pnltitle, 0, 0, root.Width, HeaderHeight)
	pnltitle.Color = ColorPnlTitle
	
	Dim edge As Int = Max(8dip, root.Width * 2 / 100)
	Dim iconSize As Int = 38dip * sc
	If ld = 1 Then iconSize = 34dip
	Dim iconTop As Int = (HeaderTopH - iconSize) / 2
	
	' 1. Left BEMT rotor icon
	Dim img1 As ImageView
	Dim bmpImage1 As Bitmap
	bmpImage1.Initialize(File.DirAssets, "icon.png")
	img1.Initialize("")
	img1.Bitmap = bmpImage1
	img1.Gravity = Gravity.FILL
	pnltitle.AddView(img1, edge, iconTop, iconSize, iconSize)
	
	' 2. 3-dot menu: keep a full 48dip touch target on every screen.
	Dim menuW As Int = 48dip
	pnlMenuAnchor.Initialize("pnlMenuAnchor")
	pnlMenuAnchor.Color = Colors.Transparent
	pnltitle.AddView(pnlMenuAnchor, root.Width - menuW - edge, 0, menuW, HeaderTopH)
	
	' Theme-aware overflow glyph. The old white PNG vanished on the Light header.
	Dim lblMenuDots As Label
	lblMenuDots.Initialize("pnlMenuAnchor")
	lblMenuDots.Text = "⋮"
	lblMenuDots.TextColor = ColorButText1
	lblMenuDots.TextSize = 28
	lblMenuDots.Gravity = Gravity.CENTER
	lblMenuDots.Typeface = Typeface.DEFAULT_BOLD
	pnlMenuAnchor.AddView(lblMenuDots, 0, 0, menuW, HeaderTopH)
	
	PopupMenu.Initialize("PopupMenu", pnlMenuAnchor)
	PopupMenu.AddMenuItem(0, 0, "Settings")
	PopupMenu.AddMenuItem(1, 1, "Quick Unit Converter")
	PopupMenu.AddMenuItem(2, 2, "Physics & Equations")
	PopupMenu.AddMenuItem(3, 3, "zBET Conventions & Physical Axes")
	PopupMenu.AddMenuItem(4, 4, "Restore Factory Rotor Presets")
	PopupMenu.AddMenuItem(5, 5, "About RotorCalculator")
	PopupMenu.AddMenuItem(6, 6, "Privacy Policy")
	
	' 3. App title uses the whole header between app icon and menu.
	Dim titleLeft As Int = edge + iconSize + 8dip
	Dim titleW As Int = root.Width - menuW - edge - titleLeft - 8dip
	lblAppTitle.Initialize("")
	lblAppTitle.Text = "RotorCalculator"
	lblAppTitle.TextColor = ColorTitleText
	Dim titleSize As Float = 20 * sc
	If titleW < 170dip Then titleSize = 18
	If titleW < 145dip Then titleSize = 17
	If titleW < 125dip Then titleSize = 15.5
	If root.Width <= 340dip Then titleSize = 18
	lblAppTitle.TextSize = titleSize
	lblAppTitle.Gravity = Gravity.CENTER_VERTICAL
	lblAppTitle.SingleLine = True
	Try
		lblAppTitle.Typeface = Typeface.LoadFromAssets("xenara-bold.ttf")
	Catch
		lblAppTitle.Typeface = Typeface.DEFAULT_BOLD
	End Try
	pnltitle.AddView(lblAppTitle, titleLeft, 0, titleW, HeaderTopH)
	
	' 4. Three large navigation tabs
	Dim tabW As Int = root.Width / 3
	Dim tabTextSize As Float = 14 * sc
	' 14sp preferred; shrinks only as far as needed to keep CONDITIONS on one line at 320dp / 130% font
	tabTextSize = RotorNames.FitTextSize("CONDITIONS", tabTextSize, 12, tabW - 12dip)
	
	btnTabGeom.Initialize("btnTabGeom")
	pnltitle.AddView(btnTabGeom, 0, HeaderTabsY, tabW, HeaderTabsH)
	btnTabGeom.Text = "GEOMETRY"
	btnTabGeom.TextSize = tabTextSize
	btnTabGeom.Typeface = Typeface.DEFAULT_BOLD
	btnTabGeom.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabGeom.TextColor = ColorButText3
	btnTabGeom.Gravity = Gravity.CENTER
	btnTabGeom.Padding = Array As Int (0, 0, 0, 4dip)
	btnTabGeom.Tag = "tabGeom"
	AttachHelp(btnTabGeom)
	
	btnTabCond.Initialize("btnTabCond")
	pnltitle.AddView(btnTabCond, tabW, HeaderTabsY, tabW, HeaderTabsH)
	btnTabCond.Text = "CONDITIONS"
	btnTabCond.TextSize = tabTextSize
	btnTabCond.Typeface = Typeface.DEFAULT_BOLD
	btnTabCond.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabCond.TextColor = ColorButText2
	btnTabCond.Gravity = Gravity.CENTER
	btnTabCond.Padding = Array As Int (0, 0, 0, 4dip)
	btnTabCond.Tag = "tabCond"
	AttachHelp(btnTabCond)
	
	btnTabRes.Initialize("btnTabRes")
	pnltitle.AddView(btnTabRes, tabW * 2, HeaderTabsY, root.Width - tabW * 2, HeaderTabsH)
	btnTabRes.Text = "RESULTS"
	btnTabRes.TextSize = tabTextSize
	btnTabRes.Typeface = Typeface.DEFAULT_BOLD
	btnTabRes.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabRes.TextColor = ColorButText2
	btnTabRes.Gravity = Gravity.CENTER
	btnTabRes.Padding = Array As Int (0, 0, 0, 4dip)
	btnTabRes.Tag = "tabRes"
	AttachHelp(btnTabRes)
	
	' 5. Header divider and sliding active-tab indicator
	Dim line2 As Panel
	line2.Initialize("line2")
	pnltitle.AddView(line2, 0, HeaderHeight - 1dip, root.Width, 1dip)
	line2.Color = ColorPnlLine2
	line2.Elevation = 5dip
	
	line.Initialize("line")
	pnltitle.AddView(line, 0, HeaderHeight - 5dip, tabW, 4dip)
	line.Color = ColorPnlLine
	line.Elevation = 5dip
End Sub

Sub pnlMenuAnchor_Click
	If sheet.IsInitialized Then sheet.CloseAll
	PopupMenu.Show
End Sub

Sub PopupMenu_MenuItemClick(ItemId As Int) As Boolean
	' Dismiss the native popup before any themed sheet opens.
	PopupMenu.Dismiss
	CallSubDelayed2(Me, "HandleMenuItem", ItemId)
	Return True
End Sub

Sub HandleMenuItem(ItemId As Int)
	Select ItemId
		Case 0
			OpenSettingsPopup
		Case 1
			OpenUnitConverter
		Case 2
			OpenPhysicsHelp
		Case 3
			ShowConventionDialog
		Case 4
			Wait For (ResolveUnsavedGeometry("restoring factory presets")) Complete (ok As Boolean)
			If ok = False Then Return
			Wait For (sheet.ShowConfirm("Restore Factory Presets", "Restore the shipped factory rotor definitions?" & CRLF & CRLF & "Custom user rotors are preserved. Same-name factory presets are replaced by their original values.", "Restore", "Cancel", "", False)) Complete (r As Int)
			If r = DialogResponse.POSITIVE Then
				RotorStorage.RestoreFactoryPresets
				AfterRotorChange
				ToastMessageShow("Factory presets restored; custom rotors preserved.", False)
			End If
		Case 5
			Dim pm As PackageManager
			Dim ver As String = "1.0.0"
			Try
				ver = pm.GetVersionName("flightdyn.rotorcalculator")
			Catch
			End Try
			sheet.ShowMessage("About RotorCalculator", "RotorCalculator v" & ver & CRLF & CRLF & _
				"Rotor performance calculator using the zBET analytical model." & CRLF & _
				"Conventions aligned with zBET and zBEMT." & CRLF & CRLF & _
				"Developed by Gustavo Zambrano")
		Case 6
			Dim privacyAsset As String = "privacy_policy.html"
			If ThemeMode = 1 Then privacyAsset = "privacy_policy_light.html"
			OpenHelpAsset(privacyAsset, "PRIVACY POLICY")
	End Select
End Sub


' ====================================================================
' SETTINGS / THEME / OUTPUT FORMAT
' ====================================================================
Private Sub LoadUiSettings
	If File.Exists(File.DirInternal, "ui_settings.txt") = False Then Return
	Try
		Dim m As Map = File.ReadMap(File.DirInternal, "ui_settings.txt")
		ThemeMode = Max(0, Min(1, ParseIntDef("" & m.GetDefault("theme", 0), 0)))
		UnitSystem = Max(0, Min(1, ParseIntDef("" & m.GetDefault("units", 0), 0)))
		ExtraPrecision = Max(0, Min(1, ParseIntDef("" & m.GetDefault("precision", 0), 0)))
		PlotPalette = Max(0, Min(RotorPopups.PlotPaletteCount - 1, ParseIntDef("" & m.GetDefault("palette", 0), 0)))
		Dim tm As String = "" & m.GetDefault("swtrim", "coll_all")
		If RotorPopups.SweepTrimModeKeys.IndexOf(tm) >= 0 Then SweepTrimMode = tm
	Catch
		ThemeMode = 0
		UnitSystem = 0
		ExtraPrecision = 0
		PlotPalette = 0
	End Try
End Sub

Private Sub SaveUiSettings
	Dim m As Map
	m.Initialize
	m.Put("theme", ThemeMode)
	m.Put("units", UnitSystem)
	m.Put("precision", ExtraPrecision)
	m.Put("palette", PlotPalette)
	m.Put("swtrim", SweepTrimMode)
	File.WriteMap(File.DirInternal, "ui_settings.txt", m)
End Sub

' Status/navigation bars follow the theme; light theme needs dark icons (API 23/26 flags).
Private Sub ApplySystemBars
	Try
		Dim ph As Phone
		If ph.SdkVersion < 21 Then Return
		Dim ctxt As JavaObject
		ctxt.InitializeContext
		Dim win As JavaObject = ctxt.RunMethodJO("getWindow", Null)
		win.RunMethod("setStatusBarColor", Array(ColorPnlTitle))
		win.RunMethod("setNavigationBarColor", Array(ColorPnlTitle))
		If ph.SdkVersion >= 23 Then
			Dim decor As JavaObject = win.RunMethodJO("getDecorView", Null)
			Dim flags As Int = decor.RunMethod("getSystemUiVisibility", Null)
			Dim lightBits As Int = 0x2000
			If ph.SdkVersion >= 26 Then lightBits = Bit.Or(lightBits, 0x10)
			If ThemeMode = 1 Then
				flags = Bit.Or(flags, lightBits)
			Else
				flags = Bit.And(flags, Bit.Not(lightBits))
			End If
			decor.RunMethod("setSystemUiVisibility", Array(flags))
		End If
	Catch
		Log("System bars: " & LastException.Message)
	End Try
End Sub

