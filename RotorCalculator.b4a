	root.AddView(pnlBack0, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack1, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack2, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	BuildUnifiedHeader
	LoadConditionDataToFields
	RecalculateRotor
	ShowPage(CurrentPage, False)
End Sub

Private Sub ShowConventionDialog
	Msgbox("zBET / zBEMT rotor convention:" & CRLF & CRLF & _
		"+x / +Vx: forward in the rotor plane." & CRLF & _
		"+y: starboard." & CRLF & _
		"+Vz: positive climb rate; relative wind is from above and through the disk." & CRLF & _
		"Thrust T > 0 acts upward (-z)." & CRLF & CRLF & _
		"μ = Vx/(ΩR)." & CRLF & _
		"μz = Vz/(ΩR), positive for that downward relative flow." & CRLF & _
		"α > 0 means the stream arrives from below, so μz = -μ tan α." & CRLF & _
		"λ = μz + λi, with λi ≥ 0 induced downward." & CRLF & CRLF & _
		"CCW rotation viewed from above; advancing side is the right side.", "zBET / zBEMT Conventions")
End Sub

