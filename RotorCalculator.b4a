	pnl = AddFormRowPanel(scvCond, y, rowIndex): edtTemperature = AddFullInputRow(pnl, 4dip, 48dip, "Temperature", "15", "°C", "edtCond_TextChanged"): y=y+rowH: rowIndex=rowIndex+1
	
	pnl = AddFormRowPanel(scvCond, y, rowIndex)
