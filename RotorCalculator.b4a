Sub btnSettingExportGeometries_Click
	Dim tempName As String = "rotorcalculator_geometries.txt"
	File.WriteString(File.DirInternal, tempName, RotorStorage.ExportDatabaseText)
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "text/plain", tempName)) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("Geometry backup exported.", False)
	Else
		ToastMessageShow("Geometry export canceled or failed.", False)
	End If
End Sub

Sub btnSettingImportGeometries_Click
	Wait For (ResolveUnsavedGeometry("importing geometries")) Complete (ok As Boolean)
	If ok = False Then Return
	Wait For (ReadTextDocument("*/*")) Complete (Text As String)
	If Text = "" Then Return
	Dim imported As List
	imported.Initialize
	If Text.Length < 2000000 Then imported = RotorStorage.ParseDatabaseText(Text)
	If imported.Size = 0 Then
		sheet.ShowMessage("Import Geometries", "No valid RotorCalculator geometries were found in this file.")
		Return
	End If
	Dim conflicts As Int = 0
	For i = 0 To imported.Size - 1
		Dim ig As RotorGeometry = imported.Get(i)
		If RotorStorage.FindRotorByName(ig.Name) >= 0 Then conflicts = conflicts + 1
	Next
	Dim msg As String = "Found " & imported.Size & " valid geometries. Import them into the local rotor library?"
	If conflicts > 0 Then msg = msg & CRLF & CRLF & conflicts & " use names that already exist."
	Wait For (sheet.ShowConfirm("Import Geometries", msg, "Import", "Cancel", "", False)) Complete (r As Int)
	If r <> DialogResponse.POSITIVE Then Return
	Dim mode As String = "rename"
	If conflicts > 0 Then
		Dim modes As List
		modes.Initialize
		modes.Add("Rename imported duplicates|Keep both rotors")
		modes.Add("Replace same-name local geometries|Overwrite the local rotors")
		modes.Add("Skip same-name imported geometries|Keep the local rotors")
		Wait For (sheet.ShowChoice("Name Conflicts", modes, 0)) Complete (choice As Int)
		If choice < 0 Then Return
		If choice = 1 Then mode = "replace"
		If choice = 2 Then mode = "skip"
	End If
	Dim added As Int = RotorStorage.MergeImportedRotors(imported, mode)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	RotorStorage.ClearDraft
	RefreshGeomFields("")
	RefreshActiveRotorBar
	RecalculateRotor
	ToastMessageShow(added & " geometries imported.", False)
End Sub

Private Sub ReadTextDocument(MimeType As String) As ResumableSub
	Dim intent As Intent
	intent.Initialize("android.intent.action.OPEN_DOCUMENT", "")
	intent.AddCategory("android.intent.category.OPENABLE")
	intent.SetType(MimeType)
	Try
		StartActivityForResult(intent)
		Wait For ion_Event (MethodName As String, Args() As Object)
		If Args.Length > 1 And -1 = Args(0) Then
			Dim result As Intent = Args(1)
			Dim jo As JavaObject = result
			Dim ctxt As JavaObject
			Dim resolver As JavaObject = ctxt.InitializeContext.RunMethodJO("getContentResolver", Null)
			Dim input As InputStream = resolver.RunMethod("openInputStream", Array(jo.RunMethod("getData", Null)))
			If input.IsInitialized = False Then Return ""
			Dim tempName As String = "geometry_import.txt"
			Dim output As OutputStream = File.OpenOutput(File.DirInternal, tempName, False)
			File.Copy2(input, output)
			input.Close
			output.Close
			Return File.ReadString(File.DirInternal, tempName)
		End If
	Catch
		Log("Geometry import failed: " & LastException.Message)
	End Try
	Return ""
End Sub

