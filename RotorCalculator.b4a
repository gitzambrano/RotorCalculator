Sub spnUnitMode_ItemClick(Position As Int, Value As Object)
	UpdateUnitConversion
End Sub

Sub edtUnitValue_TextChanged (Old As String, New As String)
	If UnitPopupOpen Then UpdateUnitConversion
End Sub

Private Sub UpdateUnitConversion
	If spnUnitMode.IsInitialized = False Or edtUnitValue.IsInitialized = False Or lblUnitResult.IsInitialized = False Then Return
	Dim x As Double = ParseDoubleDef(edtUnitValue.Text, 0)
	Dim y As Double
	Dim unitText As String
	Select spnUnitMode.SelectedIndex
		Case 0
			y = x * 1.34102209 : unitText = "hp"
		Case 1
			y = x / 1.34102209 : unitText = "kW"
		Case 2
			y = x / 9.80665 : unitText = "kgf"
		Case 3
			y = x * 9.80665 : unitText = "N"
		Case 4
			y = x * 0.224808943 : unitText = "lbf"
		Case 5
			y = x / 0.224808943 : unitText = "N"
		Case 6
			y = x / 1.852 : unitText = "kt"
		Case 7
			y = x * 1.852 : unitText = "km/h"
		Case 8
			y = x / 3.6 : unitText = "m/s"
		Case 9
			y = x * 3.6 : unitText = "km/h"
		Case 10
			y = x * 3.280839895 : unitText = "ft"
		Case 11
			y = x / 3.280839895 : unitText = "m"
		Case 12
			y = x / 25.4 : unitText = "in"
		Case Else
			y = x * 25.4 : unitText = "mm"
	End Select
	lblUnitResult.Text = NumberFormat2(y, 1, 4, 4, False) & " " & unitText
End Sub

' ====================================================================
' PAGE 0: GEOMETRY (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageGeom
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
	scvGeom.Initialize(3200)
	pnlBack0.AddView(scvGeom, 0, 0, root.Width, root.Height - HeaderHeight)
	Dim y As Int = 8dip
	Dim rowIndex As Int = 0
	Dim rowH As Int = 57dip
	
	Dim loaded As Panel
	loaded.Initialize("")
	loaded.Color = ColorPnlTitle
	scvGeom.Panel.AddView(loaded, UiContentLeft, y, UiContentW, 52dip)
	lblLoadedRotor.Initialize("")
	lblLoadedRotor.TextColor = ColorAccentCyan
	lblLoadedRotor.Typeface = Typeface.DEFAULT_BOLD
	lblLoadedRotor.TextSize = 12 * sc
	lblLoadedRotor.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	loaded.AddView(lblLoadedRotor, 14dip, 0, UiContentW - 28dip, 52dip)
	y = y + 60dip
	
	y = AddGeometrySectionHeader(y, "BLADE GEOMETRY")
	Dim pnl As Panel
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRotorName = AddTextInputRow(pnl, 4dip, 48dip, "Rotor Name", ActiveGeom.Name, "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRadius = AddFullInputRow(pnl, 4dip, 48dip, "Radius R", "", "m", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtNBlades = AddFullInputRow(pnl, 4dip, 48dip, "Blade Count", "", "[-]", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRootCutout = AddFullInputRow(pnl, 4dip, 48dip, "Root Cutout", "", "r/R", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtChordRoot = AddFullInputRow(pnl, 4dip, 48dip, "Root Chord c0", "", "m", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtChordTip = AddFullInputRow(pnl, 4dip, 48dip, "Tip Chord c1", "", "m", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtSigmaRef = AddFullInputRow(pnl, 4dip, 48dip, "Reference Solidity", "", "[-]", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtAspectRatio = AddFullInputRow(pnl, 4dip, 48dip, "Aspect Ratio", "", "[-]", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtThetaRoot = AddFullInputRow(pnl, 4dip, 48dip, "Root Incidence", "", "deg", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtThetaTip = AddFullInputRow(pnl, 4dip, 48dip, "Tip Incidence", "", "deg", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	
	y = AddGeometrySectionHeader(y + 4dip, "DERIVED GEOMETRY")
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblSigmaGeomDerived = AddDerivedRow(pnl, "Geometric Solidity", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblSigmaThrustDerived = AddDerivedRow(pnl, "Thrust Solidity", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblTaperDerived = AddDerivedRow(pnl, "Taper Ratio", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblDiskAreaDerived = AddDerivedRow(pnl, "Disk Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblRefBladeAreaDerived = AddDerivedRow(pnl, "Reference Blade Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblActiveBladeAreaDerived = AddDerivedRow(pnl, "Active Blade Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblTwistDerived = AddDerivedRow(pnl, "Total Twist", "deg"): y=y+rowH: rowIndex=rowIndex+1
	
	y = AddGeometrySectionHeader(y + 4dip, "ROTOR AERODYNAMICS")
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblAirfoil As Label = CreateRowLabel("Airfoil", "lblRowTip")
	pnl.AddView(lblAirfoil, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnSelectAirfoil = CreateRowButton("Airfoil", "btnSelectAirfoil")
	pnl.AddView(btnSelectAirfoil, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtLiftSlope = AddFullInputRow(pnl, 4dip, 48dip, "Lift Slope a0", "", "1/rad", "edtGeom"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtCd0 = AddFullInputRow(pnl, 4dip, 48dip, "Profile Cd0", "", "[-]", "edtGeom"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblTip As Label = CreateRowLabel("Tip Loss", "lblRowTip")
	pnl.AddView(lblTip, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnTipLoss = CreateRowButton("Tip Loss", "btnTipLoss")
	pnl.AddView(btnTipLoss, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtTipLossB = AddFullInputRow(pnl, 4dip, 48dip, "Fixed Tip Factor B", "", "[-]", "edtGeom"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblComp As Label = CreateRowLabel("Compressibility", "lblRowTip")
	pnl.AddView(lblComp, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnCompressibility = CreateRowButton("Compressibility", "btnCompressibility")
	pnl.AddView(btnCompressibility, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	
	Dim actions As Panel
	actions.Initialize("")
	actions.Color = ColorPnlInput5
	scvGeom.Panel.AddView(actions, UiContentLeft, y + 8dip, UiContentW, 64dip)
	Dim gap As Int = 6dip
	Dim bw As Int = (UiContentW - gap*4) / 3
	Dim bLoad As Button = CreateRowButton("LOAD ROTOR", "btnLoadRotor")
	Dim bSave As Button = CreateRowButton("SAVE", "btnSaveRotor")
	Dim bNew As Button = CreateRowButton("SAVE AS NEW", "btnSaveAsNewRotor")
	actions.AddView(bLoad, gap, 8dip, bw, 48dip)
	actions.AddView(bSave, gap*2+bw, 8dip, bw, 48dip)
	actions.AddView(bNew, gap*3+bw*2, 8dip, bw, 48dip)
	y = y + 82dip
	scvGeom.Panel.Height = y + 16dip
	LoadRotorDataToFields(ActiveGeom)
	RefreshLoadedRotorStrip
End Sub

Private Sub AddGeometrySectionHeader(y As Int, title As String) As Int
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title
	lbl.TextColor = ColorAccentGreen
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextSize = 10 * sc
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scvGeom.Panel.AddView(lbl, UiContentLeft + 12dip, y, UiContentW - 24dip, 26dip)
	Return y + 28dip
End Sub

Private Sub AddFormRowPanel(scv As ScrollView, y As Int, rowIndex As Int) As Panel
	Dim pnl As Panel
	pnl.Initialize("")
	If rowIndex Mod 2 = 0 Then pnl.Color = ColorPnlInput2 Else pnl.Color = ColorPnlInput1
	scv.Panel.AddView(pnl, UiContentLeft, y, UiContentW, 56dip)
	Dim lineRow As Panel
	lineRow.Initialize("")
	lineRow.Color = ColorPnlLine3
	scv.Panel.AddView(lineRow, UiContentLeft, y + 55dip, UiContentW, 1dip)
	Return pnl
End Sub

Private Sub AddFormRowPanelH(scv As ScrollView, y As Int, rowIndex As Int, h As Int) As Panel
	Dim pnl As Panel
	pnl.Initialize("")
	If rowIndex Mod 2 = 0 Then pnl.Color = ColorPnlInput2 Else pnl.Color = ColorPnlInput1
	scv.Panel.AddView(pnl, UiContentLeft, y, UiContentW, h)
	Dim lineRow As Panel
	lineRow.Initialize("")
	lineRow.Color = ColorPnlLine3
	scv.Panel.AddView(lineRow, UiContentLeft, y + h - 1dip, UiContentW, 1dip)
	Return pnl
End Sub

Private Sub AddDerivedRow(pnl As Panel, title As String, unit As String) As Label
	Dim lbl As Label = CreateRowLabel(title, "lblRowTip")
	pnl.AddView(lbl, pnl.Width*3/100, 4dip, pnl.Width*48/100, 48dip)
	Dim value As Label
	value.Initialize("")
	value.Text = "---"
	value.TextColor = ColorAccentCyan
	value.Typeface = Typeface.DEFAULT_BOLD
	value.TextSize = 13 * sc
	value.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	pnl.AddView(value, pnl.Width*52/100, 4dip, pnl.Width*28/100, 48dip)
	Dim u As Label
	u.Initialize("")
	u.Text = unit
	u.TextColor = ColorButText2
	u.TextSize = 11 * sc
	u.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	pnl.AddView(u, pnl.Width*82/100, 4dip, pnl.Width*15/100, 48dip)
	Return value
End Sub

Private Sub RefreshLoadedRotorStrip
	If lblLoadedRotor.IsInitialized = False Then Return
	Dim suffix As String = ""
	If GeometryDirty Then suffix = "  •  UNSAVED"
	lblLoadedRotor.Text = "Loaded rotor: " & ActiveGeom.Name & suffix
End Sub

Private Sub SaveCurrentRotor
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	GeometryDirty = False
	RefreshLoadedRotorStrip
	ToastMessageShow("Rotor saved.", False)
End Sub

Sub btnLoadRotor_Click
	If GeometryDirty Then
		Dim answer As Int = Msgbox2("Save current geometry changes before loading another rotor?", "Unsaved Geometry", "SAVE", "Cancel", "Discard", Null)
		If answer = DialogResponse.CANCEL Then Return
		If answer = DialogResponse.POSITIVE Then SaveCurrentRotor
	End If
	Dim options As List
	options.Initialize
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g As RotorGeometry = RotorStorage.Rotors.Get(i)
		Dim prefix As String = "USER · "
		If RotorStorage.IsFactoryPresetName(g.Name) Then prefix = "FACTORY · "
		options.Add(prefix & g.Name)
	Next
	Dim idx As Int = InputList(options, "Load Rotor", RotorStorage.ActiveIndex)
	If idx < 0 Then Return
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshLoadedRotorStrip
	RecalculateRotor
End Sub

Sub btnSaveRotor_Click
	SaveCurrentRotor
End Sub

Sub btnSaveAsNewRotor_Click
	Dim clone As RotorGeometry = zBETEngine.CloneGeometry(ActiveGeom)
	clone.Name = RotorStorage.MakeUniqueName(clone.Name)
	Dim idx As Int = RotorStorage.AddRotor(clone)
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshLoadedRotorStrip
	ToastMessageShow("Saved as new rotor: " & ActiveGeom.Name, False)
End Sub


' ====================================================================
' PAGE 1: CONDITIONS (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageCond
	pnlBack1.Initialize("")
	pnlBack1.Color = ColorPnlInput5
	scvCond.Initialize(2200)
	pnlBack1.AddView(scvCond, 0, 0, root.Width, root.Height - HeaderHeight)
	Dim y As Int = 8dip
	Dim rowIndex As Int = 0
	Dim rowH As Int = 57dip
	Dim flowRowH As Int = 76dip
	Dim pnl As Panel
	
	y = AddConditionSectionHeader(y, "ATMOSPHERE & FLOW")
	pnl = AddFormRowPanel(scvCond, y, rowIndex): edtAltitude = AddFullInputRow(pnl, 4dip, 48dip, "Altitude", "0", "m", "edtCond"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvCond, y, rowIndex): edtTemperature = AddFullInputRow(pnl, 4dip, 48dip, "Temperature", "15", "°C", "edtCond"): y=y+rowH: rowIndex=rowIndex+1
	
	pnl = AddFormRowPanelH(scvCond, y, rowIndex, flowRowH - 1dip)
	Dim lblHorizontal As Label = CreateRowLabel("Horizontal Flow", "lblRowTip")
	pnl.AddView(lblHorizontal, pnl.Width*3/100, 4dip, pnl.Width*25/100, 48dip)
	btnHorizontalInput.Initialize("btnHorizontalInput")
	btnHorizontalInput.Typeface = Typeface.DEFAULT_BOLD
	btnHorizontalInput.TextColor = ColorAccentCyan
	btnHorizontalInput.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnHorizontalInput.TextSize = 11 * sc
	pnl.AddView(btnHorizontalInput, pnl.Width*29/100, 4dip, pnl.Width*16/100, 48dip)
	edtHorizontalValue.Initialize("edtHorizontalValue")
	edtHorizontalValue.TextColor = ColorEdtText
	edtHorizontalValue.Color = ColorEdt
	edtHorizontalValue.Gravity = Gravity.CENTER
	edtHorizontalValue.InputType = Bit.Or(edtHorizontalValue.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edtHorizontalValue.SingleLine = True
	edtHorizontalValue.ForceDoneButton = True
	edtHorizontalValue.TextSize = 12 * sc
	pnl.AddView(edtHorizontalValue, pnl.Width*47/100, 4dip, pnl.Width*20/100, 48dip)
	lblHorizontalUnit.Initialize("")
	lblHorizontalUnit.TextColor = ColorButText2
	lblHorizontalUnit.TextSize = 10 * sc
	lblHorizontalUnit.Gravity = Gravity.CENTER
	pnl.AddView(lblHorizontalUnit, pnl.Width*68/100, 4dip, pnl.Width*10/100, 48dip)
	lblHorizontalDerived.Initialize("")
	lblHorizontalDerived.TextColor = ColorButText2
	lblHorizontalDerived.TextSize = 9.5 * sc
	lblHorizontalDerived.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblHorizontalDerived.SingleLine = True
	pnl.AddView(lblHorizontalDerived, pnl.Width*29/100, 52dip, pnl.Width*68/100, 20dip)
	y=y+flowRowH: rowIndex=rowIndex+1
	
	pnl = AddFormRowPanelH(scvCond, y, rowIndex, flowRowH - 1dip)
	Dim lblAxial As Label = CreateRowLabel("Axial Flow", "lblRowTip")
	pnl.AddView(lblAxial, pnl.Width*3/100, 4dip, pnl.Width*25/100, 48dip)
	btnAxialInput.Initialize("btnAxialInput")
	btnAxialInput.Typeface = Typeface.DEFAULT_BOLD
	btnAxialInput.TextColor = ColorAccentCyan
	btnAxialInput.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnAxialInput.TextSize = 11 * sc
	pnl.AddView(btnAxialInput, pnl.Width*29/100, 4dip, pnl.Width*16/100, 48dip)
	edtAxialValue.Initialize("edtAxialValue")
	edtAxialValue.TextColor = ColorEdtText
	edtAxialValue.Color = ColorEdt
	edtAxialValue.Gravity = Gravity.CENTER
	edtAxialValue.InputType = Bit.Or(edtAxialValue.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edtAxialValue.SingleLine = True
	edtAxialValue.ForceDoneButton = True
	edtAxialValue.TextSize = 12 * sc
	pnl.AddView(edtAxialValue, pnl.Width*47/100, 4dip, pnl.Width*20/100, 48dip)
	lblAxialUnit.Initialize("")
	lblAxialUnit.TextColor = ColorButText2
	lblAxialUnit.TextSize = 10 * sc
	lblAxialUnit.Gravity = Gravity.CENTER
	pnl.AddView(lblAxialUnit, pnl.Width*68/100, 4dip, pnl.Width*10/100, 48dip)
	lblAxialDerived.Initialize("")
	lblAxialDerived.TextColor = ColorButText2
	lblAxialDerived.TextSize = 9.2 * sc
	lblAxialDerived.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblAxialDerived.SingleLine = True
	pnl.AddView(lblAxialDerived, pnl.Width*29/100, 52dip, pnl.Width*68/100, 20dip)
	y=y+flowRowH: rowIndex=rowIndex+1
	
	y = AddConditionSectionHeader(y + 4dip, "OPERATING CONSTRAINTS")
	pnl = AddFormRowPanel(scvCond, y, rowIndex)
	Dim lblPair As Label = CreateRowLabel("Operating Inputs", "lblRowTip")
	pnl.AddView(lblPair, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnOperatingPair = CreateRowButton("Operating Inputs", "btnOperatingPair")
	pnl.AddView(btnOperatingPair, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
