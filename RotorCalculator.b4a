Private Sub OpenSettingsPopup
	If SettingsPopupOpen Then CloseSettingsPopup
	pnlSettingsPopup.Initialize("pnlSettingsPopup")
	pnlSettingsPopup.Color = 0x99000000
	root.AddView(pnlSettingsPopup, 0, 0, root.Width, root.Height)
	SettingsPopupOpen = True
	pnlSettingsPopup.BringToFront

	Dim cardW As Int = root.Width - 24dip
	If cardW > 540dip Then cardW = 540dip
	Dim contentH As Int = 8dip + 6 * 74dip + 8dip
	Dim cardH As Int = Min(52dip + contentH, root.Height - 24dip)
	Dim cardLeft As Int = (root.Width - cardW) / 2
	Dim cardTop As Int = (root.Height - cardH) / 2
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlSettingsPopup.AddView(card, cardLeft, cardTop, cardW, cardH)

	Dim titleBar As Panel
	titleBar.Initialize("")
	titleBar.Color = ColorPnlTitle
	card.AddView(titleBar, 0, 0, cardW, 52dip)
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "SETTINGS"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 15
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	titleBar.AddView(lblTitle, 16dip, 0, cardW - 72dip, 52dip)
	Dim btnClose As Button
	btnClose.Initialize("btnCloseSettings")
	btnClose.Text = "×"
	btnClose.TextColor = ColorButText1
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	titleBar.AddView(btnClose, cardW - 52dip, 2dip, 48dip, 48dip)

	Dim scv As ScrollView
	scv.Initialize(contentH)
	card.AddView(scv, 0, 52dip, cardW, cardH - 52dip)
	' scv.Panel has no width yet: lay rows out against the card width.
	AddSettingsRow(scv.Panel, cardW, 8dip, "Theme", "Dark or light technical palette", "btnSettingTheme")
	AddSettingsRow(scv.Panel, cardW, 82dip, "Result Units", "Dimensional outputs only", "btnSettingUnits")
	AddSettingsRow(scv.Panel, cardW, 156dip, "Output Format", "Standard or +1 decimal", "btnSettingPrecision")
	AddSettingsRow(scv.Panel, cardW, 230dip, "Plot Palette", "Sweep curve colors", "btnSettingPalette")
	AddSettingsRow(scv.Panel, cardW, 304dip, "Import Geometries", "Restore or merge a shared backup", "btnSettingImportGeometries")
	AddSettingsRow(scv.Panel, cardW, 378dip, "Export Geometries", "Backup all saved rotor geometries", "btnSettingExportGeometries")
	scv.Panel.Height = contentH
	RefreshSettingsButtons
End Sub

Private Sub AddSettingsRow(parent As Panel, cardW As Int, y As Int, title As String, subtitle As String, eventName As String)
	Dim lbl As Label
	lbl.Initialize("")
	Dim cs As CSBuilder
	cs.Initialize
	cs.Bold.Append(title).Pop.Append(CRLF).RelativeSize(0.85).Append(subtitle).Pop
	lbl.Text = cs
	lbl.TextColor = ColorButText1
	lbl.TextSize = 15
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	SetTextLines(lbl, 4)
	parent.AddView(lbl, 14dip, y, cardW * 0.58 - 20dip, 68dip)
	Dim b As Button
	b.Initialize(eventName)
	b.TextColor = ColorAccentCyan
	b.Typeface = Typeface.DEFAULT_BOLD
	b.TextSize = 14
	b.SingleLine = True
	b.Padding = Array As Int(2dip, 0, 2dip, 0)
	b.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	parent.AddView(b, cardW * 0.58, y + 10dip, cardW * 0.38, 48dip)
	If eventName = "btnSettingTheme" Then btnSettingTheme = b
	If eventName = "btnSettingUnits" Then btnSettingUnits = b
	If eventName = "btnSettingPrecision" Then btnSettingPrecision = b
	If eventName = "btnSettingPalette" Then btnSettingPalette = b
	If eventName = "btnSettingImportGeometries" Then b.Text = "IMPORT"
	If eventName = "btnSettingExportGeometries" Then b.Text = "EXPORT"
End Sub

Private Sub RefreshSettingsButtons
	If btnSettingTheme.IsInitialized Then
		If ThemeMode = 1 Then btnSettingTheme.Text = "LIGHT" Else btnSettingTheme.Text = "DARK"
	End If
	If btnSettingUnits.IsInitialized Then
		If UnitSystem = 1 Then btnSettingUnits.Text = "IMPERIAL" Else btnSettingUnits.Text = "SI"
	End If
	If btnSettingPrecision.IsInitialized Then
		If ExtraPrecision = 1 Then btnSettingPrecision.Text = "+1 DECIMAL" Else btnSettingPrecision.Text = "STANDARD"
	End If
	If btnSettingPalette.IsInitialized Then btnSettingPalette.Text = RotorPopups.PlotPaletteName(PlotPalette)
End Sub

