	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtHorizontalValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtAxialValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

' ====================================================================
' SWEEP POPUP (Multi-Parameter μ-Sweep)
' ====================================================================
Sub btnViewPolarPlot_Click
	If SweepPopupOpen Then CloseSweepPopup
	pnlSweepPopup.Initialize("pnlSweepPopup")
	pnlSweepPopup.Color = ColorPnlInput5
	root.AddView(pnlSweepPopup, 0, 0, root.Width, root.Height)
	SweepPopupOpen = True
	pnlSweepPopup.BringToFront
	
	Dim topBarH As Int = 48dip
	Dim footerH As Int
	If ld = 1 Then footerH = 50dip Else footerH = 94dip * sc
	Dim controlsH As Int
	If ld = 1 Then controlsH = 58dip Else controlsH = 172dip * sc
	
	Dim pnlHeader As Panel
	pnlHeader.Initialize("")
	pnlHeader.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlHeader, 0, 0, root.Width, topBarH)
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "PARAMETER SWEEP"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 13 * sc
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	pnlHeader.AddView(lblTitle, 12dip, 0, root.Width - 64dip, topBarH)
	Dim btnClose As Button
	btnClose.Initialize("btnCloseSweepPlot")
	btnClose.Text = "×"
	btnClose.TextColor = ColorAccentRed
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	pnlHeader.AddView(btnClose, root.Width - 52dip, 0, 48dip, topBarH)
	
	Dim pnlControls As Panel
	pnlControls.Initialize("")
	pnlControls.Color = ColorPnlInput2
	pnlSweepPopup.AddView(pnlControls, 0, topBarH, root.Width, controlsH)
	
	spnSweepParam.Initialize("spnSweepParam")
	spnSweepParam.DropdownBackgroundColor = ColorPnlTitle
	spnSweepParam.DropdownTextColor = ColorTitleText
	spnSweepParam.TextColor = ColorTitleText
	spnSweepParam.TextSize = 11 * sc
	
	btnSweepMultiModel.Initialize("btnSweepMultiModel")
	btnSweepMultiModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepMultiModel.TextSize = 10.5 * sc
	btnSweepXAxis.Initialize("btnSweepXAxis")
	btnSweepXAxis.TextColor = ColorAccentGreen
	btnSweepXAxis.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepXAxis.TextSize = 10.5 * sc
	btnSweepMaxMu.Initialize("btnSweepMaxMu")
	btnSweepMaxMu.TextColor = ColorAccentAmber
	btnSweepMaxMu.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepMaxMu.TextSize = 10.5 * sc
	btnSweepValues.Initialize("btnSweepValues")
	btnSweepValues.Text = "VALUES"
	btnSweepValues.TextColor = ColorAccentCyan
	btnSweepValues.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepValues.TextSize = 10.5 * sc
	btnSweepTrimHover.Initialize("btnSweepTrimHover")
	btnSweepTrimHover.TextColor = ColorAccentGreen
	btnSweepTrimHover.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepTrimHover.TextSize = 9.5 * sc
	
	spnSweepParam.Clear
	For paramIndex = 0 To RotorPopups.SweepParamLabels.Size - 1
		spnSweepParam.Add(RotorPopups.SweepParamLabels.Get(paramIndex))
	Next
	Dim selectedParamIndex As Int = 0
	For paramIndex = 0 To RotorPopups.SweepParamKeys.Size - 1
		If RotorPopups.SweepParamKeys.Get(paramIndex) = SweepParamSelectedKey Then
			selectedParamIndex = paramIndex
			Exit
		End If
	Next
	spnSweepParam.SelectedIndex = selectedParamIndex
	
	If ld = 1 Then
		Dim gapL As Int = 5dip
		Dim usable As Int = root.Width - 24dip
		Dim wParam As Int = usable * 0.28
		Dim wFamily As Int = usable * 0.23
		Dim wValues As Int = usable * 0.10
		Dim wAxis As Int = usable * 0.10
		Dim wRange As Int = usable * 0.12
		Dim wTrim As Int = usable - wParam - wFamily - wValues - wAxis - wRange - 5 * gapL
		Dim xL As Int = 12dip
		pnlControls.AddView(spnSweepParam, xL, 5dip, wParam, 48dip): xL=xL+wParam+gapL
		pnlControls.AddView(btnSweepMultiModel, xL, 5dip, wFamily, 48dip): xL=xL+wFamily+gapL
		pnlControls.AddView(btnSweepValues, xL, 5dip, wValues, 48dip): xL=xL+wValues+gapL
		pnlControls.AddView(btnSweepXAxis, xL, 5dip, wAxis, 48dip): xL=xL+wAxis+gapL
		pnlControls.AddView(btnSweepMaxMu, xL, 5dip, wRange, 48dip): xL=xL+wRange+gapL
		pnlControls.AddView(btnSweepTrimHover, xL, 5dip, wTrim, 48dip)
	Else
		Dim lblY As Label
		lblY.Initialize("")
		lblY.Text = "Y-AXIS RESULT"
		lblY.TextColor = ColorButText2
		lblY.Typeface = Typeface.DEFAULT_BOLD
		lblY.TextSize = 9.5 * sc
		pnlControls.AddView(lblY, 12dip, 4dip, root.Width - 24dip, 16dip)
		pnlControls.AddView(spnSweepParam, 12dip, 22dip * sc, root.Width - 24dip, 46dip * sc)
		Dim rowWidth As Int = root.Width - 30dip
		Dim familyW As Int = rowWidth * 0.68
		Dim valuesW As Int = rowWidth - familyW - 6dip
		pnlControls.AddView(btnSweepMultiModel, 12dip, 72dip * sc, familyW, 44dip * sc)
		pnlControls.AddView(btnSweepValues, 18dip + familyW, 72dip * sc, valuesW, 44dip * sc)
		Dim thirdGap As Int = 6dip
		Dim axisW2 As Int = rowWidth * 0.22
		Dim rangeW2 As Int = rowWidth * 0.27
		Dim trimW2 As Int = rowWidth - axisW2 - rangeW2 - 2 * thirdGap
		pnlControls.AddView(btnSweepXAxis, 12dip, 120dip * sc, axisW2, 44dip * sc)
		pnlControls.AddView(btnSweepMaxMu, 12dip + axisW2 + thirdGap, 120dip * sc, rangeW2, 44dip * sc)
		pnlControls.AddView(btnSweepTrimHover, 12dip + axisW2 + rangeW2 + 2 * thirdGap, 120dip * sc, trimW2, 44dip * sc)
	End If
	
	UpdateSweepMultiButtonText
	UpdateSweepXAxisButtonText
	UpdateSweepMaxButtonText
	UpdateSweepAuxControls
	
	Dim plotTop As Int = topBarH + controlsH + 2dip
	Dim plotW As Int = root.Width - 16dip
	Dim plotH As Int = root.Height - plotTop - footerH - 2dip
	If plotH < 120dip Then plotH = 120dip
	ivSweepPlot.Initialize("")
	pnlSweepPopup.AddView(ivSweepPlot, 8dip, plotTop, plotW, plotH)
	
	Dim pnlFooter As Panel
	pnlFooter.Initialize("")
	pnlFooter.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlFooter, 0, root.Height - footerH, root.Width, footerH)
	lblSweepCurrentVal.Initialize("")
	lblSweepCurrentVal.TextColor = ColorAccentAmber
	lblSweepCurrentVal.TextSize = 9.5 * sc
	lblSweepCurrentVal.Typeface = Typeface.DEFAULT_BOLD
	lblSweepCurrentVal.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblSweepCurrentVal.SingleLine = True
	Dim btnTable As Button
	btnTable.Initialize("btnSweepTable")
	btnTable.Text = "TABLE"
	btnTable.TextColor = ColorAccentCyan
	btnTable.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	Dim btnCsv As Button
	btnCsv.Initialize("btnSweepExportCsv")
	btnCsv.Text = "CSV"
	btnCsv.TextColor = ColorAccentGreen
	btnCsv.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	Dim btnPng As Button
	btnPng.Initialize("btnSweepExportPng")
	btnPng.Text = "PNG"
	btnPng.TextColor = ColorAccentGreen
	btnPng.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnTable.Typeface = Typeface.DEFAULT_BOLD: btnCsv.Typeface = Typeface.DEFAULT_BOLD: btnPng.Typeface = Typeface.DEFAULT_BOLD
	btnTable.TextSize = 10 * sc: btnCsv.TextSize = 10 * sc: btnPng.TextSize = 10 * sc
	
	If ld = 1 Then
		Dim infoWidth As Int = root.Width * 0.38
		pnlFooter.AddView(lblSweepCurrentVal, 10dip, 0, infoWidth - 12dip, footerH)
		Dim actionLeft As Int = infoWidth
		Dim actionGap As Int = 5dip
		Dim actionWidth As Int = (root.Width - actionLeft - 16dip - 2 * actionGap) / 3
		pnlFooter.AddView(btnTable, actionLeft, 1dip, actionWidth, 48dip)
		pnlFooter.AddView(btnCsv, actionLeft + actionWidth + actionGap, 1dip, actionWidth, 48dip)
		pnlFooter.AddView(btnPng, actionLeft + 2 * (actionWidth + actionGap), 1dip, actionWidth, 48dip)
	Else
		pnlFooter.AddView(lblSweepCurrentVal, 12dip, 0, root.Width - 24dip, 34dip * sc)
		Dim footerGap As Int = 6dip
		Dim footerButtonW As Int = (root.Width - 24dip - 2 * footerGap) / 3
		Dim footerButtonY As Int = 36dip * sc
		pnlFooter.AddView(btnTable, 12dip, footerButtonY, footerButtonW, 48dip * sc)
		pnlFooter.AddView(btnCsv, 12dip + footerButtonW + footerGap, footerButtonY, footerButtonW, 48dip * sc)
		pnlFooter.AddView(btnPng, 12dip + 2 * (footerButtonW + footerGap), footerButtonY, footerButtonW, 48dip * sc)
	End If
	UpdateSweepPlotView
End Sub

Sub spnSweepParam_ItemClick(Position As Int, Value As Object)
	If Position >= 0 And Position < RotorPopups.SweepParamKeys.Size Then
		SweepParamSelectedKey = RotorPopups.SweepParamKeys.Get(Position)
		SweepParamSelectedLabel = RotorPopups.SweepParamLabels.Get(Position)
		UpdateSweepPlotView
	End If
End Sub

Sub btnSweepMultiModel_Click
	Dim options As List
	options.Initialize
	options.Add("Inflow Models")
	options.Add("Rotor α Family")
	options.Add("Axial Vz Family")
	options.Add("Axial μz Family")
	options.Add("Active Only")
	Dim idx As Int = InputList(options, "Curve Family", SweepMultiMode)
	If idx < 0 Then Return
	SweepMultiMode = idx
	UpdateSweepMultiButtonText
	UpdateSweepAuxControls
	UpdateSweepPlotView
End Sub

Private Sub CurrentSweepFamilyText As String
	Select SweepMultiMode
		Case 1: Return SweepAlphaValues
		Case 2: Return SweepVzValues
		Case 3: Return SweepMuZValues
	End Select
	Return ""
End Sub

Private Sub SetCurrentSweepFamilyText(value As String)
	Select SweepMultiMode
		Case 1: SweepAlphaValues = value
		Case 2: SweepVzValues = value
		Case 3: SweepMuZValues = value
	End Select
End Sub

Private Sub ParseSweepFamilyValues(raw As String) As List
	Dim values As List
	values.Initialize
	Dim parts() As String = Regex.Split(",", raw)
	If parts.Length < 1 Or parts.Length > 9 Then Return values
	For valueIndex = 0 To parts.Length - 1
		Dim token As String = parts(valueIndex).Trim
		If token = "" Then
			values.Clear
			Return values
		End If
		Try
			Dim v As Double = token
			values.Add(v)
		Catch
			values.Clear
			Return values
		End Try
	Next
	Return values
End Sub

Private Sub CurrentSweepFamilyValues As List
	Dim values As List
	If SweepMultiMode >= 1 And SweepMultiMode <= 3 Then values = ParseSweepFamilyValues(CurrentSweepFamilyText) Else values.Initialize
	If SweepMultiMode = 1 And values.Size = 0 Then values = ParseSweepFamilyValues("-10,-5,0,5,10")
	If SweepMultiMode = 2 And values.Size = 0 Then values = ParseSweepFamilyValues("-10,-5,0,5,10")
	If SweepMultiMode = 3 And values.Size = 0 Then values = ParseSweepFamilyValues("-0.05,-0.025,0,0.025,0.05")
	Return values
End Sub

Private Sub UpdateSweepMultiButtonText
	If btnSweepMultiModel.IsInitialized = False Then Return
	Dim count As Int = RotorPopups.SweepCurveCount(SweepMultiMode, CurrentSweepFamilyValues)
	Select SweepMultiMode
		Case 0: btnSweepMultiModel.Text = "Inflow Models (4)"
		Case 1: btnSweepMultiModel.Text = "α Family (" & count & ")"
		Case 2: btnSweepMultiModel.Text = "Vz Family (" & count & ")"
		Case 3: btnSweepMultiModel.Text = "μz Family (" & count & ")"
		Case Else: btnSweepMultiModel.Text = "Active Only"
	End Select
	If SweepMultiMode = 4 Then btnSweepMultiModel.TextColor = ColorButText2 Else btnSweepMultiModel.TextColor = ColorAccentCyan
End Sub

Private Sub UpdateSweepAuxControls
	If btnSweepValues.IsInitialized Then btnSweepValues.Visible = (SweepMultiMode >= 1 And SweepMultiMode <= 3)
	If btnSweepTrimHover.IsInitialized Then
		btnSweepTrimHover.Visible = (ActiveCond.OperatingPair <> "rpm_collective")
		If SweepTrimOnlyHover Then
			btnSweepTrimHover.Text = "☑ TRIM ONLY HOVER"
			btnSweepTrimHover.TextColor = ColorAccentGreen
		Else
			btnSweepTrimHover.Text = "☐ TRIM ONLY HOVER"
			btnSweepTrimHover.TextColor = ColorButText2
		End If
	End If
End Sub

Sub btnSweepValues_Click
	If SweepMultiMode < 1 Or SweepMultiMode > 3 Then Return
	If SweepValuesPopupOpen Then CloseSweepValuesPopup
	pnlSweepValuesPopup.Initialize("")
	pnlSweepValuesPopup.Color = 0x99000000
	root.AddView(pnlSweepValuesPopup, 0, 0, root.Width, root.Height)
	SweepValuesPopupOpen = True
	pnlSweepValuesPopup.BringToFront
	Dim cardW As Int = Min(root.Width - 24dip, 520dip)
	Dim cardH As Int = 230dip
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlSweepValuesPopup.AddView(card, (root.Width-cardW)/2, (root.Height-cardH)/2, cardW, cardH)
	Dim title As Label
	title.Initialize("")
	title.Text = "FAMILY VALUES"
	title.TextColor = ColorAccentCyan
	title.Typeface = Typeface.DEFAULT_BOLD
	title.TextSize = 13
	card.AddView(title, 16dip, 12dip, cardW-32dip, 28dip)
	Dim hint As Label
	hint.Initialize("")
	hint.Text = "Enter 1–9 values separated by commas. Example: -10, -5, 0, 5, 10"
	hint.TextColor = ColorButText2
	hint.TextSize = 10.5
	hint.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	card.AddView(hint, 16dip, 44dip, cardW-32dip, 40dip)
	edtSweepValues.Initialize("")
	edtSweepValues.Text = CurrentSweepFamilyText
	edtSweepValues.TextColor = ColorEdtText
	edtSweepValues.Color = ColorEdt
	edtSweepValues.TextSize = 13
	edtSweepValues.SingleLine = True
	card.AddView(edtSweepValues, 16dip, 90dip, cardW-32dip, 48dip)
	Dim btnCancel As Button = CreateRowButton("CANCEL", "btnCancelSweepValues")
	Dim btnApply As Button = CreateRowButton("APPLY", "btnApplySweepValues")
	card.AddView(btnCancel, 16dip, 158dip, (cardW-38dip)/2, 48dip)
	card.AddView(btnApply, 22dip+(cardW-38dip)/2, 158dip, (cardW-38dip)/2, 48dip)
End Sub

Sub btnApplySweepValues_Click
	Dim values As List = ParseSweepFamilyValues(edtSweepValues.Text)
	If values.Size = 0 Then
		ToastMessageShow("Enter 1–9 valid numbers separated by commas.", True)
		Return
	End If
	For familyIndex = 0 To values.Size - 1
		Dim familyValue As Double = values.Get(familyIndex)
		If SweepMultiMode = 1 And (familyValue <= -89 Or familyValue >= 89) Then
			ToastMessageShow("α family values must stay between -89° and +89°.", True)
			Return
		End If
		If SweepMultiMode = 2 And Abs(familyValue) > 200 Then
			ToastMessageShow("Vz family values must stay within ±200 m/s.", True)
			Return
		End If
		If SweepMultiMode = 3 And Abs(familyValue) > 0.50 Then
			ToastMessageShow("μz family values must stay within ±0.50.", True)
			Return
		End If
	Next
	SetCurrentSweepFamilyText(edtSweepValues.Text.Trim)
	CloseSweepValuesPopup
	UpdateSweepMultiButtonText
	UpdateSweepPlotView
End Sub

Sub btnCancelSweepValues_Click
	CloseSweepValuesPopup
End Sub

