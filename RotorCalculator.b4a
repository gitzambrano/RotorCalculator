		items.Add(RotorPopups.SweepTrimModeLabel(k))
	Next
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("sweepTrim", 0), items, keys.IndexOf(SweepTrimMode))) Complete (idx As Int)
	If idx < 0 Or idx >= keys.Size Then Return
	SweepTrimMode = keys.Get(idx)
	SaveUiSettings
