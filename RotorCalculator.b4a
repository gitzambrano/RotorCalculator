	pnl = AddFormRowPanel(scvCond, y, rowIndex)
	Dim lblDrag As Button = CreateRowLabel("Profile Drag", "lblRowTip")
	pnl.AddView(lblDrag, pnl.Width*3/100, 4dip, pnl.Width*31/100, 48dip)
