NumberOfModules=3
Version=13
@EndOfDesignText@
#Region  Project Attributes 
	#ApplicationLabel: RotorCalculator
	#MultiDex: False
	#VersionCode: 1
	#VersionName: 1.00
	#SupportedOrientations: unspecified
	#CanInstallToExternalStorage: True
#End Region

#Region  Activity Attributes 
	#FullScreen: False
	#IncludeTitle: False
#End Region

#Region  Module Attributes 
	#IgnoreWarnings: 1, 2, 3, 4, 5, 6
#End Region
Sub Process_Globals
	
	' Theme Colors (AeroCalculator Cockpit Stealth Palette)
	Public ColorPnlTitle As Int = 0xFF0D121B     ' Dark Stealth Cockpit Header
	Public ColorTitleText As Int = 0xFFFFFFFF    ' Crisp White Title
	Public ColorPnlLine As Int = 0xFF00E5FF      ' Active Aero Cyan Indicator
	Public ColorPnlLine2 As Int = 0xFF1E2738     ' Header Hairline Divider
	Public ColorPnlLine3 As Int = 0xFF171E2B     ' Row Divider
	Public ColorBut3 As Int = 0x00000000         ' Transparent Tab Button
	Public ColorBut4 As Int = 0x00000000         ' Transparent Tab Button
	Public ColorButText2 As Int = 0xFF94A3B8     ' Unselected Tab Text (Slate)
	Public ColorButText3 As Int = 0xFF00E5FF     ' Active Tab Text (Cyan)
	Public ColorBut1 As Int = 0xFF1A2332         ' Button Gradient Top
	Public ColorBut2 As Int = 0xFF121925         ' Button Gradient Bottom
	Public ColorButText1 As Int = 0xFFF1F5F9     ' Button Text Main
	Public ColorEdt As Int = 0xFF0F141E          ' Edit Box Background
	Public ColorEdtText As Int = 0xFF00E5FF      ' Edit Text Cyan
	Public ColorEdtHint As Int = 0xFF64748B      ' Edit Hint Slate
	Public ColorPnlInput1 As Int = 0xFF0A0E15    ' Row 1 Background
	Public ColorPnlInput2 As Int = 0xFF0E131C    ' Row 2 Background
	Public ColorPnlInput3 As Int = 0xFF0A0E15    ' Output Row 1
	Public ColorPnlInput4 As Int = 0xFF0E131C    ' Output Row 2
	Public ColorPnlInput5 As Int = 0xFF07090E    ' Page Background
	Public ColorAccentCyan As Int = 0xFF00E5FF   ' Cyan Accent
	Public ColorAccentGreen As Int = 0xFF00E676  ' Emerald Accent
	Public ColorAccentAmber As Int = 0xFFFFB300  ' Amber Accent
	
	' Aerodynamic Global State
	Public ActiveGeom As RotorGeometry
	Public ActiveCond As FlightCondition
	Public ActiveRes As RotorResults
	Public AmbientPressureHPa As Double = 1013.25
	
	' Navigation & Scaling
	Public sc As Double = 1.0
	Public ld As Int = 0
	Public CurrentPage As Int = 0
	Public UnitSystem As Int = 0 ' 0=Metric (SI), 1=Imperial
	Public ConditionAltitudeM As Double = 0.0
	Public ConditionTemperatureC As Double = 15.0
	Public ConditionShaftTiltDeg As Double = 0.0
	Public ConditionClimbRateMs As Double = 0.0

End Sub

Sub Globals
	
	' Activity content root. B4A activity content already excludes standard system bars.
	Private root As Panel
	
	' Unified Header (Title + Tabs)
	Private pnltitle As Panel
	Private btnTabGeom As Button
	Private btnTabCond As Button
	Private btnTabRes As Button
	Private line As Panel
	Private lblAppTitle As Label
	Private lblRotorNameHeader As Label
	Private PopupMenu As RSPopupMenu
	Private pnlMenuAnchor As Panel
	
	' Page 0: Geometry Views
	Private pnlBack0 As Panel
	Private scvGeom As ScrollView
	Private spnRotorSelect As Spinner
	Private edtRadius As EditText
	Private edtRPM As EditText
	Private edtNBlades As EditText
	Private edtRootCutout As EditText
	Private edtChordRoot As EditText
	Private edtChordTip As EditText
	Private edtThetaRoot As EditText
	Private edtThetaTip As EditText
	Private edtLiftSlope As EditText
	Private edtCd0 As EditText
	Private btnSelectAirfoil As Button
	Private btnTipLoss As Button
	Private btnCompressibility As Button
	
	' Page 1: Conditions Views
	Private pnlBack1 As Panel
	Private scvCond As ScrollView
	Private edtAltitude As EditText
	Private edtTemperature As EditText
	Private edtAdvanceMu As EditText
	Private edtSpeedKmh As EditText
	Private edtShaftTiltAlpha As EditText
	Private edtClimbRateW As EditText
	Private btnInflowModel As Button
	Private btnProfileDragModel As Button
	Private btnHoverTrimMode As Button
	Private edtTargetThrust As EditText
	Private edtTargetCT As EditText
	
	' Page 2: Results Views
	Private pnlBack2 As Panel
	Private scvRes As ScrollView
	Private btnViewPolarPlot As Button
	Private lblResults(25) As Label
	
	' Multi-Parameter μ-Sweep Popup
	Private pnlSweepPopup As Panel
	Private spnSweepParam As Spinner
	Private btnSweepMultiModel As Button
	Private btnSweepMaxMu As Button
	Private ivSweepPlot As ImageView
	Private lblSweepCurrentVal As Label
	Private SweepMultiMode As Int = 0
	Private SweepMaxMuVal As Double = 0.40
	Private SweepParamSelectedKey As String = "CP"
	Private SweepParamSelectedLabel As String = "CP / CQ — Rotor Power / Shaft Torque"
	
	Private UpdatingUI As Boolean = False
	
	' Responsive layout metrics
	Private HeaderHeight As Int
	Private HeaderTopH As Int
	Private HeaderTabsY As Int
	Private HeaderTabsH As Int
	Private UiContentW As Int
	Private UiContentLeft As Int

End Sub

Sub Activity_Create(FirstTime As Boolean)
	
	' Initialize Independent Sub-Modules
	If FirstTime Then
		RotorStorage.Initialize
		RotorPopups.Initialize
		ActiveGeom = RotorStorage.GetActiveRotor
		ActiveCond = zBETEngine.CreateDefaultCondition
	End If
	
	' B4A's Activity content area is the layout viewport. Keep all UI inside it.
	root.Initialize("")
	Activity.AddView(root, 0, 0, 100%x, 100%y)
	
	' Responsive scaling: both width and height constrain growth.
	' This prevents tall/narrow phones from enlarging the header until it clips.
	Dim hh As Double
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim PanelNb As Int = 14
	hh = 99dip + PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 1dip
	If root.Width > root.Height Then ld = 1 Else ld = 0
	Dim widthScale As Double = root.Width / 360dip
	Dim heightScale As Double = root.Height / hh
	sc = Min(widthScale, heightScale)
	If sc < 1 Then sc = 1
	If sc > 1.12 Then sc = 1.12
	
	' Compact landscape header; portrait preserves the AeroCalculator proportions.
	If ld = 1 Then
		sc = 1
		HeaderTopH = 42dip
		HeaderTabsY = 42dip
		HeaderTabsH = 48dip
		HeaderHeight = 91dip
	Else
		HeaderTopH = 56dip * sc
		HeaderTabsY = 56dip * sc
		HeaderTabsH = 48dip * sc
		HeaderHeight = 105dip * sc
	End If
	
	' Phone-width form on large screens: readable line lengths, no stretched controls.
	UiContentW = root.Width
	If UiContentW > 620dip Then UiContentW = 620dip
	UiContentLeft = (root.Width - UiContentW) / 2
	
	' Build three native pages. Custom header tabs control visibility.
	BuildPageGeom
	BuildPageCond
	BuildPageRes
	root.AddView(pnlBack0, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack1, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack2, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	
	' Header stays above page content.
	BuildUnifiedHeader
	
	' Restore state into all controls and calculate the first frame.
	LoadRotorDataToFields(ActiveGeom)
	LoadConditionDataToFields
	RecalculateRotor
	ShowPage(CurrentPage, False)
	
End Sub

Sub Activity_Resume
	ShowPage(CurrentPage, False)
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean
	If KeyCode = KeyCodes.KEYCODE_BACK Then
		If pnlSweepPopup.IsInitialized Then
			If pnlSweepPopup.Parent = root Then
				pnlSweepPopup.RemoveView
				Return True
			End If
		End If
		If CurrentPage = 2 Then
			ShowPage(1, True)
			Return True
		Else If CurrentPage = 1 Then
			ShowPage(0, True)
			Return True
		End If
	End If
	Return False
End Sub

' ====================================================================
' UNIFIED HEADER (AeroCalculator Style)
' ====================================================================
Private Sub BuildUnifiedHeader
	pnltitle.Initialize("pnltitle")
	root.AddView(pnltitle, 0, 0, root.Width, HeaderHeight)
	pnltitle.Color = ColorPnlTitle
	
	Dim edge As Int = Max(8dip, root.Width * 2 / 100)
	Dim iconSize As Int = 38dip * sc
	If ld = 1 Then iconSize = 34dip
	Dim iconTop As Int = (HeaderTopH - iconSize) / 2
	
	' 1. Left BEMT rotor icon
	Dim img1 As ImageView
	Dim bmpImage1 As Bitmap
	bmpImage1.Initialize(File.DirAssets, "icon.png")
	img1.Initialize("")
	img1.Bitmap = bmpImage1
	img1.Gravity = Gravity.FILL
	pnltitle.AddView(img1, edge, iconTop, iconSize, iconSize)
	
	' 2. 3-dot menu: keep a full 48dip touch target on every screen.
	Dim menuW As Int = 48dip
	pnlMenuAnchor.Initialize("pnlMenuAnchor")
	pnlMenuAnchor.Color = Colors.Transparent
	pnltitle.AddView(pnlMenuAnchor, root.Width - menuW - edge, 0, menuW, HeaderTopH)
	
	Dim img2 As ImageView
	Dim bmpImage2 As Bitmap
	bmpImage2.Initialize(File.DirAssets, "android-3-dot-menu.png")
	img2.Initialize("pnlMenuAnchor")
	img2.Bitmap = bmpImage2
	img2.Gravity = Gravity.FILL
	pnlMenuAnchor.AddView(img2, (menuW - 22dip) / 2, (HeaderTopH - 22dip) / 2, 22dip, 22dip)
	
	PopupMenu.Initialize("PopupMenu", pnlMenuAnchor)
	PopupMenu.AddMenuItem(0, 0, "Toggle Result Units (SI / Imperial)")
	PopupMenu.AddMenuItem(1, 1, "Delete Active Rotor")
	PopupMenu.AddMenuItem(2, 2, "Reset to Factory Rotor Presets")
	PopupMenu.AddMenuItem(3, 3, "zBET Conventions & Physical Axes")
	PopupMenu.AddMenuItem(4, 4, "About RotorCalculator")
	
	' 3. Active rotor preset. Compact phones use only the model identifier;
	' tapping it shows the complete stored name.
	Dim presetW As Int
	If root.Width <= 340dip Then
		presetW = 52dip
	Else If root.Width <= 380dip Then
		presetW = 72dip
	Else If root.Width <= 430dip Then
		presetW = 90dip
	Else
		presetW = 120dip
	End If
	Dim presetLeft As Int = root.Width - menuW - edge - presetW - 4dip
	lblRotorNameHeader.Initialize("lblRotorNameHeader")
	lblRotorNameHeader.Text = HeaderRotorName(ActiveGeom.Name)
	lblRotorNameHeader.TextColor = ColorAccentCyan
	If root.Width <= 340dip Then lblRotorNameHeader.TextSize = 11 Else lblRotorNameHeader.TextSize = 11 * sc
	lblRotorNameHeader.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	lblRotorNameHeader.SingleLine = True
	pnltitle.AddView(lblRotorNameHeader, presetLeft, 0, presetW, HeaderTopH)
	
	' 4. App title uses all remaining space and scales down only when necessary.
	Dim titleLeft As Int = edge + iconSize + 8dip
	Dim titleW As Int = presetLeft - titleLeft - 6dip
	lblAppTitle.Initialize("")
	lblAppTitle.Text = "RotorCalculator"
	lblAppTitle.TextColor = ColorTitleText
	Dim titleSize As Float = 20 * sc
	If titleW < 170dip Then titleSize = 18
	If titleW < 145dip Then titleSize = 17
	If titleW < 125dip Then titleSize = 15.5
	If root.Width <= 340dip Then titleSize = 14
	lblAppTitle.TextSize = titleSize
	lblAppTitle.Gravity = Gravity.CENTER_VERTICAL
	lblAppTitle.SingleLine = True
	Try
		lblAppTitle.Typeface = Typeface.LoadFromAssets("xenara-bold.ttf")
	Catch
		lblAppTitle.Typeface = Typeface.DEFAULT_BOLD
	End Try
	pnltitle.AddView(lblAppTitle, titleLeft, 0, titleW, HeaderTopH)
	
	' 5. Three large navigation tabs
	Dim tabW As Int = root.Width / 3
	Dim tabTextSize As Float = 13 * sc
	If root.Width <= 340dip Then tabTextSize = 12
	
	btnTabGeom.Initialize("btnTabGeom")
	pnltitle.AddView(btnTabGeom, 0, HeaderTabsY, tabW, HeaderTabsH)
	btnTabGeom.Text = "GEOMETRY"
	btnTabGeom.TextSize = tabTextSize
	btnTabGeom.Typeface = Typeface.DEFAULT_BOLD
	btnTabGeom.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabGeom.TextColor = ColorButText3
	btnTabGeom.Gravity = Gravity.CENTER
	btnTabGeom.Padding = Array As Int (0, 0, 0, 4dip)
	
	btnTabCond.Initialize("btnTabCond")
	pnltitle.AddView(btnTabCond, tabW, HeaderTabsY, tabW, HeaderTabsH)
	btnTabCond.Text = "CONDITIONS"
	btnTabCond.TextSize = tabTextSize
	btnTabCond.Typeface = Typeface.DEFAULT_BOLD
	btnTabCond.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabCond.TextColor = ColorButText2
	btnTabCond.Gravity = Gravity.CENTER
	btnTabCond.Padding = Array As Int (0, 0, 0, 4dip)
	
	btnTabRes.Initialize("btnTabRes")
	pnltitle.AddView(btnTabRes, tabW * 2, HeaderTabsY, root.Width - tabW * 2, HeaderTabsH)
	btnTabRes.Text = "RESULTS"
	btnTabRes.TextSize = tabTextSize
	btnTabRes.Typeface = Typeface.DEFAULT_BOLD
	btnTabRes.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabRes.TextColor = ColorButText2
	btnTabRes.Gravity = Gravity.CENTER
	btnTabRes.Padding = Array As Int (0, 0, 0, 4dip)
	
	' 6. Header divider and sliding active-tab indicator
	Dim line2 As Panel
	line2.Initialize("line2")
	pnltitle.AddView(line2, 0, HeaderHeight - 1dip, root.Width, 1dip)
	line2.Color = ColorPnlLine2
	line2.Elevation = 5dip
	
	line.Initialize("line")
	pnltitle.AddView(line, 0, HeaderHeight - 5dip, tabW, 4dip)
	line.Color = ColorPnlLine
	line.Elevation = 5dip
End Sub

Sub lblRotorNameHeader_Click
	ToastMessageShow("Active rotor preset: " & ActiveGeom.Name, False)
End Sub

Sub pnlMenuAnchor_Click
	PopupMenu.Show
End Sub

Sub PopupMenu_MenuItemClick(ItemId As Int) As Boolean
	Select ItemId
		Case 0
			UnitSystem = 1 - UnitSystem
			If UnitSystem = 0 Then
				ToastMessageShow("Result Units: Metric (SI)", False)
			Else
				ToastMessageShow("Result Units: Imperial", False)
			End If
			RecalculateRotor
		Case 1
			If RotorStorage.Rotors.Size <= 1 Then
				ToastMessageShow("At least one rotor preset must remain.", False)
			Else
				Dim deleteAnswer As Int = Msgbox2("Delete the active rotor preset '" & ActiveGeom.Name & "'?", "Delete Rotor", "DELETE", "Cancel", "", Null)
				If deleteAnswer = DialogResponse.POSITIVE Then
					Dim deletedName As String = ActiveGeom.Name
					If RotorStorage.DeleteRotor(RotorStorage.ActiveIndex) Then
						ActiveGeom = RotorStorage.GetActiveRotor
						RefreshRotorSpinner
						LoadRotorDataToFields(ActiveGeom)
						RefreshDerivedCondition(True)
						RecalculateRotor
						ToastMessageShow("Deleted: " & deletedName, False)
					End If
				End If
			End If
		Case 2
			Dim resetAnswer As Int = Msgbox2("Restore all factory rotor presets? Custom copies and edits will be removed.", "Reset Rotor Presets", "RESET", "Cancel", "", Null)
			If resetAnswer = DialogResponse.POSITIVE Then
				RotorStorage.ResetToDefaults
				RefreshRotorSpinner
				ActiveGeom = RotorStorage.GetActiveRotor
				LoadRotorDataToFields(ActiveGeom)
				RefreshDerivedCondition(True)
				RecalculateRotor
				ToastMessageShow("Factory presets restored.", False)
			End If
		Case 3
			Msgbox("zBET Coordinate Conventions:" & CRLF & CRLF & _
				"+x: Forward (aircraft nose)" & CRLF & _
				"+y: Starboard (right wing)" & CRLF & _
				"+z: Downward through rotor disk" & CRLF & CRLF & _
				"Thrust acts upward (-z)." & CRLF & _
				"Shaft torque Q > 0 powers CCW rotor." & CRLF & _
				"Advance ratio: μ = V / (ΩR)" & CRLF & _
				"Axial flow: μz = -μ·tan(α) + Vz/(ΩR)" & CRLF & _
				"Mean downwash inflow: λ = μz + λi", "zBET Conventions")
		Case 4
			Dim pm As PackageManager
			Dim ver As String = "1.0.0"
			Try
				ver = pm.GetVersionName("flightdyn.rotorcalculator")
			Catch
			End Try
			Msgbox("RotorCalculator v" & ver & CRLF & CRLF & _
				"High-Fidelity Helicopter & Rotorcraft Aeromechanics Calculator." & CRLF & CRLF & _
				"Engineered on analytical Blade Element Momentum Theory (zBET - Johnson & Leishman)." & CRLF & CRLF & _
				"Flight Dynamicist: Gustavo Zambrano" & CRLF & _
				"flightdyn@gmail.com", "About RotorCalculator")
	End Select
	Return False
End Sub

' ====================================================================
' PAGE 0: GEOMETRY (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageGeom
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
	scvGeom.Initialize(2500)
	pnlBack0.AddView(scvGeom, 0, 0, root.Width, root.Height - HeaderHeight)
	
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim rowH As Int = (ib * 2 + tb) * sc
	Dim PanelNb As Int = 14
	
	Dim j As Int
	For j = 0 To PanelNb - 1
		Dim pnlInput As Panel
		Dim pnlline As Panel
		pnlInput.Initialize("pnlInput")
		pnlline.Initialize("pnlline")
		
		scvGeom.Panel.AddView(pnlInput, UiContentLeft, (j * (ib * 2 + tb) + j * 1dip) * sc, UiContentW, rowH)
		scvGeom.Panel.AddView(pnlline, UiContentLeft, (j * (ib * 2 + tb) + j * 1dip - 1dip) * sc, UiContentW, 1dip * sc)
		pnlline.Color = ColorPnlLine3
		
		If (j Mod 2) = 1 Then
			pnlInput.Color = ColorPnlInput1
		Else
			pnlInput.Color = ColorPnlInput2
		End If
		
		Select j
			Case 0
				' Row 0: Preset Selector
				Dim lblPreset As Label = CreateRowLabel("Rotor Preset", "lblRowTip_Click")
				pnlInput.AddView(lblPreset, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				
				Dim pnlSpn As Panel: pnlSpn.Initialize("")
				pnlSpn.Background = ButtonGradient(Array As Int(ColorEdt, ColorEdt), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(pnlSpn, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 45 / 100, tb * sc)
				
				spnRotorSelect.Initialize("spnRotorSelect")
				spnRotorSelect.DropdownBackgroundColor = ColorPnlTitle
				spnRotorSelect.DropdownTextColor = ColorTitleText
				pnlSpn.AddView(spnRotorSelect, 0, 0, pnlSpn.Width, pnlSpn.Height)
				RefreshRotorSpinner
				
				Dim btnDup As Button = CreateRowButton("⧉", "btnRotorDup")
				pnlInput.AddView(btnDup, pnlInput.Width * 85 / 100, ib * sc, pnlInput.Width * 12 / 100, tb * sc)
				
			Case 1
				edtRadius = AddFullInputRow(pnlInput, ib, tb, "Radius R", "5.50", "m", "edtGeom_TextChanged")
			Case 2
				edtRPM = AddFullInputRow(pnlInput, ib, tb, "Rotor RPM", "390.0", "RPM", "edtGeom_TextChanged")
			Case 3
				edtNBlades = AddFullInputRow(pnlInput, ib, tb, "Blade Count", "4", "blades", "edtGeom_TextChanged")
			Case 4
				edtRootCutout = AddFullInputRow(pnlInput, ib, tb, "Root Cutout", "0.15", "r0/R", "edtGeom_TextChanged")
			Case 5
				edtChordRoot = AddFullInputRow(pnlInput, ib, tb, "Root Chord", "0.324", "m", "edtGeom_TextChanged")
			Case 6
				edtChordTip = AddFullInputRow(pnlInput, ib, tb, "Tip Chord", "0.324", "m", "edtGeom_TextChanged")
			Case 7
				edtThetaRoot = AddFullInputRow(pnlInput, ib, tb, "θ Root Pitch", "12.0", "deg", "edtGeom_TextChanged")
			Case 8
				edtThetaTip = AddFullInputRow(pnlInput, ib, tb, "θ Tip Pitch", "4.0", "deg", "edtGeom_TextChanged")
			Case 9
				edtLiftSlope = AddFullInputRow(pnlInput, ib, tb, "Lift Slope a0", "5.73", "1/rad", "edtGeom_TextChanged")
			Case 10
				edtCd0 = AddFullInputRow(pnlInput, ib, tb, "Profile Cd0", "0.0090", "coef", "edtGeom_TextChanged")
			Case 11
				Dim lblAf As Label = CreateRowLabel("Airfoil", "lblRowTip_Click")
				pnlInput.AddView(lblAf, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnSelectAirfoil.Initialize("btnSelectAirfoil")
				btnSelectAirfoil.Text = "NACA 0012 (Library...)"
				btnSelectAirfoil.TextSize = 13 * sc
				btnSelectAirfoil.SingleLine = True
				btnSelectAirfoil.TextColor = ColorAccentCyan
				btnSelectAirfoil.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnSelectAirfoil, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 12
				Dim lblTipLoss As Label = CreateRowLabel("Tip Loss", "lblRowTip_Click")
				pnlInput.AddView(lblTipLoss, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnTipLoss.Initialize("btnTipLoss")
				btnTipLoss.Text = "Sissingh: ON"
				btnTipLoss.TextSize = 13 * sc
				btnTipLoss.SingleLine = True
				btnTipLoss.TextColor = ColorAccentGreen
				btnTipLoss.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnTipLoss, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 13
				Dim lblCompress As Label = CreateRowLabel("Compressibility", "lblRowTip_Click")
				pnlInput.AddView(lblCompress, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnCompressibility.Initialize("btnCompressibility")
				btnCompressibility.Text = "Prandtl-Glauert: ON"
				btnCompressibility.TextSize = 13 * sc
				btnCompressibility.SingleLine = True
				btnCompressibility.TextColor = ColorAccentGreen
				btnCompressibility.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnCompressibility, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
		End Select
	Next
	
	scvGeom.Panel.Height = (PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 20dip) * sc
End Sub

' ====================================================================
' PAGE 1: CONDITIONS (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageCond
	pnlBack1.Initialize("")
	pnlBack1.Color = ColorPnlInput5
	scvCond.Initialize(2500)
	pnlBack1.AddView(scvCond, 0, 0, root.Width, root.Height - HeaderHeight)
	
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim rowH As Int = (ib * 2 + tb) * sc
	Dim PanelNb As Int = 11
	
	Dim j As Int
	For j = 0 To PanelNb - 1
		Dim pnlInput As Panel
		Dim pnlline As Panel
		pnlInput.Initialize("pnlInput")
		pnlline.Initialize("pnlline")
		
		scvCond.Panel.AddView(pnlInput, UiContentLeft, (j * (ib * 2 + tb) + j * 1dip) * sc, UiContentW, rowH)
		scvCond.Panel.AddView(pnlline, UiContentLeft, (j * (ib * 2 + tb) + j * 1dip - 1dip) * sc, UiContentW, 1dip * sc)
		pnlline.Color = ColorPnlLine3
		
		If (j Mod 2) = 1 Then
			pnlInput.Color = ColorPnlInput1
		Else
			pnlInput.Color = ColorPnlInput2
		End If
		
		Select j
			Case 0
				edtAltitude = AddFullInputRow(pnlInput, ib, tb, "Altitude", "0", "m", "edtCond_TextChanged")
			Case 1
				edtTemperature = AddFullInputRow(pnlInput, ib, tb, "Temperature", "15.0", "°C", "edtCond_TextChanged")
			Case 2
				edtAdvanceMu = AddFullInputRow(pnlInput, ib, tb, "Advance (μ)", "0.00", "μ", "edtCond_TextChanged")
			Case 3
				edtSpeedKmh = AddFullInputRow(pnlInput, ib, tb, "Flight Speed", "0.0", "km/h", "edtSpeedKmh_TextChanged")
			Case 4
				edtShaftTiltAlpha = AddFullInputRow(pnlInput, ib, tb, "Shaft Tilt (α)", "0.0", "deg", "edtCond_TextChanged")
			Case 5
				edtClimbRateW = AddFullInputRow(pnlInput, ib, tb, "Climb Rate", "0.0", "m/s", "edtClimbRate_TextChanged")
			Case 6
				Dim lblInflow As Label = CreateRowLabel("Inflow Model", "lblRowTip_Click")
				pnlInput.AddView(lblInflow, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnInflowModel.Initialize("btnInflowModel")
				btnInflowModel.Text = "Coleman-Feingold"
				btnInflowModel.TextSize = 13 * sc
				btnInflowModel.SingleLine = True
				btnInflowModel.TextColor = ColorAccentCyan
				btnInflowModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnInflowModel, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 7
				Dim lblDrag As Label = CreateRowLabel("Profile Drag", "lblRowTip_Click")
				pnlInput.AddView(lblDrag, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnProfileDragModel.Initialize("btnProfileDragModel")
				btnProfileDragModel.Text = "Numerical Vectorial"
				btnProfileDragModel.TextSize = 13 * sc
				btnProfileDragModel.SingleLine = True
				btnProfileDragModel.TextColor = ColorTitleText
				btnProfileDragModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnProfileDragModel, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 8
				Dim lblTrim As Label = CreateRowLabel("Hover Trim", "lblRowTip_Click")
				pnlInput.AddView(lblTrim, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnHoverTrimMode.Initialize("btnHoverTrimMode")
				btnHoverTrimMode.Text = "Collective to Target"
				btnHoverTrimMode.TextSize = 13 * sc
				btnHoverTrimMode.SingleLine = True
				btnHoverTrimMode.TextColor = ColorAccentGreen
				btnHoverTrimMode.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnHoverTrimMode, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 9
				edtTargetThrust = AddFullInputRow(pnlInput, ib, tb, "Target Thrust", "0", "N", "edtCond_TextChanged")
			Case 10
				edtTargetCT = AddFullInputRow(pnlInput, ib, tb, "Target CT", "0.00650", "coef", "edtCond_TextChanged")
		End Select
	Next
	
	scvCond.Panel.Height = (PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 20dip) * sc
End Sub

' ====================================================================
' PAGE 2: RESULTS / OUTPUTS (AeroCalculator scvMain2 Architecture)
' ====================================================================
Private Sub BuildPageRes
	pnlBack2.Initialize("")
	pnlBack2.Color = ColorPnlInput5
	scvRes.Initialize(2500)
	pnlBack2.AddView(scvRes, 0, 0, root.Width, root.Height - HeaderHeight)
	
	Dim PanelHeight1 As Int = 48dip * sc
	
	' 1. Top Action Button: Open Multi-Parameter μ-Sweep
	btnViewPolarPlot.Initialize("btnViewPolarPlot")
	btnViewPolarPlot.Text = "OPEN PARAMETER SWEEP (μ)"
	If root.Width <= 340dip Then btnViewPolarPlot.TextSize = 12 Else btnViewPolarPlot.TextSize = 14 * sc
	btnViewPolarPlot.Typeface = Typeface.DEFAULT_BOLD
	btnViewPolarPlot.TextColor = ColorAccentCyan
	btnViewPolarPlot.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	scvRes.Panel.AddView(btnViewPolarPlot, UiContentLeft + UiContentW * 3 / 100, 8dip * sc, UiContentW * 94 / 100, 48dip * sc)
	
	Dim startY As Int = 62dip * sc
	
	Dim outputLabels As List
	outputLabels.Initialize2(Array As String( _
		"Total Thrust (T)", _
		"Thrust Coef (CT)", _
		"Shaft Power (P)", _
		"Air Power Coef (CPair)", _
		"Total Torque (Q)", _
		"Torque Coef (CQ)", _
		"Induced Torque (CQi)", _
		"Profile Drag Torque (CQ0)", _
		"In-Plane Drag (H)", _
		"In-Plane Coef (CH)", _
		"Side Force Coef (CY)", _
		"Pitch Moment Coef (CMy)", _
		"Roll Moment Coef (CMx)", _
		"Figure of Merit (FoM)", _
		"Effective L/D Ratio", _
		"Total Inflow Ratio (λ)", _
		"Induced Inflow Ratio (λi)", _
		"Longitudinal Inflow (Kx)", _
		"Lateral Inflow (Ky)", _
		"Wake Skew Angle (χ)", _
		"Tip Mach (Hover)", _
		"Advancing Tip Mach (Mat)", _
		"Air Density (ρ)", _
		"Ambient Pressure (p)", _
		"Speed of Sound (a)" _
	))
	
	Dim i As Int
	Dim sectionH As Int = 24dip * sc
	Dim curY As Int = startY
	For i = 0 To outputLabels.Size - 1
		Dim sectionTitle As String = ""
		Select i
			Case 0: sectionTitle = "PERFORMANCE"
			Case 8: sectionTitle = "FORCES & MOMENTS"
			Case 15: sectionTitle = "INFLOW & WAKE"
			Case 20: sectionTitle = "MACH & ATMOSPHERE"
		End Select
		If sectionTitle <> "" Then
			Dim lblSection As Label
			lblSection.Initialize("")
			lblSection.Text = sectionTitle
			lblSection.TextColor = ColorAccentGreen
			lblSection.TextSize = 10 * sc
			lblSection.Typeface = Typeface.DEFAULT_BOLD
			lblSection.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
			scvRes.Panel.AddView(lblSection, UiContentLeft + UiContentW * 4 / 100, curY, UiContentW * 92 / 100, sectionH)
			curY = curY + sectionH
		End If
		
		Dim pnltest As Panel
		Dim pnlline As Panel
		pnltest.Initialize("")
		pnlline.Initialize("")
		
		scvRes.Panel.AddView(pnltest, UiContentLeft, curY, UiContentW, PanelHeight1)
		scvRes.Panel.AddView(pnlline, UiContentLeft, curY + PanelHeight1 - 1dip, UiContentW, 1dip * sc)
		pnlline.Color = ColorPnlLine3
		
		If (i Mod 2) = 1 Then
			pnltest.Color = ColorPnlInput3
		Else
			pnltest.Color = ColorPnlInput4
		End If
		
		Dim fullLabel As String = outputLabels.Get(i)
		Dim lblVar As Label
		lblVar.Initialize("lblResultTip")
		pnltest.AddView(lblVar, pnltest.Width * 4 / 100, 0, pnltest.Width * 52 / 100, PanelHeight1)
		lblVar.Text = ResultDisplayLabel(fullLabel)
		If root.Width <= 340dip Then lblVar.TextSize = 12 Else lblVar.TextSize = 13 * sc
		lblVar.Typeface = Typeface.DEFAULT_BOLD
		lblVar.TextColor = ColorTitleText
		lblVar.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lblVar.SingleLine = True
		lblVar.Tag = fullLabel
		
		lblResults(i).Initialize("")
		pnltest.AddView(lblResults(i), pnltest.Width * 56 / 100, 0, pnltest.Width * 40 / 100, PanelHeight1)
		lblResults(i).Text = "---"
		If root.Width <= 340dip Then lblResults(i).TextSize = 12 Else lblResults(i).TextSize = 13 * sc
		lblResults(i).Typeface = Typeface.DEFAULT_BOLD
		lblResults(i).TextColor = ColorAccentCyan
		lblResults(i).Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
		lblResults(i).SingleLine = True
		curY = curY + PanelHeight1
	Next
	
	scvRes.Panel.Height = curY + 20dip * sc
End Sub

' Compact labels are used only when the available width requires them.
' The full engineering meaning remains available through the row/result tooltip.
Private Sub InputDisplayLabel(fullText As String) As String
	If root.Width > 340dip Then Return fullText
	Select fullText
		Case "Rotor Preset": Return "Preset"
		Case "Blade Count": Return "Blades"
		Case "Root Cutout": Return "Root Cut."
		Case "Root Chord": Return "Root c"
		Case "Tip Chord": Return "Tip c"
		Case "θ Root Pitch": Return "θ Root"
		Case "θ Tip Pitch": Return "θ Tip"
		Case "Lift Slope a0": Return "Lift a0"
		Case "Profile Cd0": Return "Cd0"
		Case "Temperature": Return "Temp."
		Case "Advance (μ)": Return "Advance μ"
		Case "Flight Speed": Return "Speed"
		Case "Shaft Tilt (α)": Return "Shaft α"
		Case "Climb Rate": Return "Climb"
		Case "Inflow Model": Return "Inflow"
		Case "Target Thrust": Return "Target T"
		Case Else: Return fullText
	End Select
End Sub

Private Sub HeaderRotorName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim n As String = fullName.ToLowerCase
	If n.Contains("uh-60") Then Return "UH-60"
	If n.Contains("bell 206") Then Return "Bell 206"
	If n.Contains("bo 105") Or n.Contains("bo105") Then Return "Bo 105"
	If n.Contains("r44") Then Return "R44"
	If n.Contains("dji") Then Return "DJI"
	If n.Contains("evtol") Then Return "eVTOL"
	Return fullName
End Sub

Private Sub RotorListName(fullName As String) As String
	If root.Width > 340dip Then Return fullName
	Dim shortName As String = HeaderRotorName(fullName)
	If fullName.ToLowerCase.Contains("(copy)") And shortName.ToLowerCase.Contains("(copy)") = False Then
		shortName = shortName & " (Copy)"
	End If
	Return shortName
End Sub

Private Sub ResultDisplayLabel(fullText As String) As String
	If root.Width > 380dip Then Return fullText
	Select fullText
		Case "Air Power Coef (CPair)": Return "Air Power (CPair)"
		Case "Profile Drag Torque (CQ0)": Return "Profile Torque (CQ0)"
		Case "Pitch Moment Coef (CMy)": Return "Pitch Moment (CMy)"
		Case "Roll Moment Coef (CMx)": Return "Roll Moment (CMx)"
		Case "Total Inflow Ratio (λ)": Return "Total Inflow (λ)"
		Case "Induced Inflow Ratio (λi)": Return "Induced Inflow (λi)"
		Case "Longitudinal Inflow (Kx)": Return "Long. Inflow (Kx)"
		Case "Lateral Inflow (Ky)": Return "Lat. Inflow (Ky)"
		Case "Advancing Tip Mach (Mat)": Return "Adv. Tip Mach (Mat)"
		Case "Ambient Pressure (p)": Return "Pressure (p)"
		Case "Speed of Sound (a)": Return "Sound Speed (a)"
		Case Else: Return fullText
	End Select
End Sub

Sub lblResultTip_Click
	Dim l As Label = Sender
	ToastMessageShow(ResultTooltip(l.Tag), True)
End Sub

Private Sub ResultTooltip(labelText As String) As String
	Select labelText
		Case "Total Thrust (T)": Return "Total rotor thrust T, dimensional force normal to the rotor disk reference."
		Case "Thrust Coef (CT)": Return "Thrust coefficient CT = T / [ρ A (ΩR)²]."
		Case "Shaft Power (P)": Return "Mechanical shaft power required by the rotor at the current operating point."
		Case "Air Power Coef (CPair)": Return "Air power coefficient from the rotor energy balance, including induced, climb, profile-drag and translational terms."
		Case "Total Torque (Q)": Return "Total aerodynamic rotor torque about the shaft."
		Case "Torque Coef (CQ)": Return "Torque coefficient CQ = Q / [ρ A (ΩR)² R]."
		Case "Induced Torque (CQi)": Return "Induced component of rotor torque associated with induced power."
		Case "Profile Drag Torque (CQ0)": Return "Profile-drag contribution to rotor torque from blade section drag."
		Case "In-Plane Drag (H)": Return "Rotor in-plane H force opposing the forward in-plane velocity component."
		Case "In-Plane Coef (CH)": Return "Non-dimensional in-plane H-force coefficient."
		Case "Side Force Coef (CY)": Return "Non-dimensional rotor side-force coefficient."
		Case "Pitch Moment Coef (CMy)": Return "Non-dimensional rotor pitching-moment coefficient about the y axis."
		Case "Roll Moment Coef (CMx)": Return "Non-dimensional rotor rolling-moment coefficient about the x axis."
		Case "Figure of Merit (FoM)": Return "Hover efficiency metric: ideal induced power divided by actual rotor power."
		Case "Effective L/D Ratio": Return "Effective rotor lift-to-drag ratio derived from resultant aerodynamic forces."
		Case "Total Inflow Ratio (λ)": Return "Total non-dimensional axial inflow ratio through the rotor disk."
		Case "Induced Inflow Ratio (λi)": Return "Induced portion of the non-dimensional inflow ratio."
		Case "Longitudinal Inflow (Kx)": Return "Longitudinal first-harmonic inflow gradient coefficient Kx."
		Case "Lateral Inflow (Ky)": Return "Lateral first-harmonic inflow gradient coefficient Ky."
		Case "Wake Skew Angle (χ)": Return "Wake skew angle χ between the rotor wake axis and the rotor shaft reference."
		Case "Tip Mach (Hover)": Return "Blade-tip Mach number from rotational speed ΩR without forward-flight addition."
		Case "Advancing Tip Mach (Mat)": Return "Approximate Mach number at the advancing blade tip in forward flight."
		Case "Air Density (ρ)": Return "Ambient air density used by the aerodynamic calculation."
		Case "Ambient Pressure (p)": Return "Ambient static pressure from the active atmosphere condition."
		Case "Speed of Sound (a)": Return "Local speed of sound used for Mach and compressibility calculations."
		Case Else: Return labelText
	End Select
End Sub

' Helper to create 30%x | 36%x | 20%x standard input rows
Private Sub AddFullInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, unitText As String, evtName As String) As EditText
	Dim lbl As Label = CreateRowLabel(lblText, "lblRowTip_Click")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 30 / 100, tb * sc)
	
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	edt.Text = defVal
	edt.TextSize = 13 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.HintColor = ColorEdtHint
	edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.CENTER_HORIZONTAL)
	edt.InputType = Bit.Or(edt.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edt.ForceDoneButton = True
	edt.SingleLine = True
	
	pnl.AddView(edt, pnl.Width * 37 / 100, ib * sc, pnl.Width * 36 / 100, tb * sc)
	
	Dim lblUnit As Label
	lblUnit.Initialize("")
	lblUnit.Text = unitText
	If root.Width <= 340dip Then lblUnit.TextSize = 11 Else lblUnit.TextSize = 12 * sc
	lblUnit.TextColor = ColorButText2
	lblUnit.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	lblUnit.SingleLine = True
	pnl.AddView(lblUnit, pnl.Width * 77 / 100, ib * sc, pnl.Width * 17 / 100, tb * sc)
	
	Return edt
End Sub

Private Sub CreateRowLabel(txt As String, evt As String) As Label
	Dim lbl As Label
	lbl.Initialize(evt)
	lbl.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then lbl.TextSize = 12 Else lbl.TextSize = 13 * sc
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextColor = ColorButText1
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lbl.SingleLine = True
	lbl.Tag = txt
	Return lbl
End Sub

Private Sub CreateRowButton(txt As String, evt As String) As Button
	Dim btn As Button
	btn.Initialize(evt)
	btn.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then btn.TextSize = 12 Else btn.TextSize = 13 * sc
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorButText1
	btn.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	Return btn
End Sub

' ====================================================================
' AEROCALCULATOR GRADIENTS & DRAWABLES
' ====================================================================
Sub ButtonGradient(ColorList() As Int, ColorList2() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("BOTTOM_TOP", ColorList2)
	gdwPressed.CornerRadius = 6dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("TOP_BOTTOM", ColorList)
	gdwPressed.CornerRadius = 12dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

' ====================================================================
' NATIVE PAGE NAVIGATION
' ====================================================================
Private Sub ShowPage(Position As Int, Animated As Boolean)
	If Position < 0 Or Position > 2 Then Position = 0
	CurrentPage = Position
	pnlBack0.Visible = (Position = 0)
	pnlBack1.Visible = (Position = 1)
	pnlBack2.Visible = (Position = 2)
	
	Dim tabW As Int = root.Width / 3
	Dim duration As Int = 0
	If Animated Then duration = 150
	line.SetLayoutAnimated(duration, Position * tabW, HeaderHeight - 5dip, tabW, 4dip)
	
	btnTabGeom.TextColor = ColorButText2
	btnTabCond.TextColor = ColorButText2
	btnTabRes.TextColor = ColorButText2
	
	Select Position
		Case 0
			btnTabGeom.TextColor = ColorButText3
		Case 1
			btnTabCond.TextColor = ColorButText3
		Case 2
			btnTabRes.TextColor = ColorButText3
			Dim p As Phone
			p.HideKeyboard(Activity)
			RecalculateRotor
	End Select
End Sub

Sub btnTabGeom_Click
	ShowPage(0, True)
End Sub

Sub btnTabCond_Click
	ShowPage(1, True)
End Sub

Sub btnTabRes_Click
	ShowPage(2, True)
End Sub

' ====================================================================
' AERODYNAMIC CALCULATION & TELEMETRY MAPPING
' ====================================================================
Public Sub RecalculateRotor
	If UpdatingUI Then Return
	
	ActiveRes = zBETEngine.Calculate(ActiveGeom, ActiveCond)
	
	Dim tipMachHover As Double = 0
	Dim omega As Double = ActiveGeom.RPM * (cPI / 30.0)
	Dim vtip As Double = omega * ActiveGeom.Radius
	If ActiveCond.SpeedOfSound > 0 Then
		tipMachHover = vtip / ActiveCond.SpeedOfSound
	End If
	
	' Populate 25 Results Rows (UnitSystem: 0=SI, 1=Imperial)
	If UnitSystem = 0 Then
		lblResults(0).Text = NumberFormat(ActiveRes.ThrustN, 1, 0) & " N"
		lblResults(2).Text = NumberFormat(ActiveRes.PowerShaftKW, 1, 1) & " kW"
		lblResults(4).Text = NumberFormat(ActiveRes.TorqueNm, 1, 1) & " N·m"
		lblResults(8).Text = NumberFormat(ActiveRes.DragHN, 1, 1) & " N"
	Else
		lblResults(0).Text = NumberFormat(ActiveRes.ThrustLbf, 1, 0) & " lbf"
		lblResults(2).Text = NumberFormat(ActiveRes.PowerShaftHP, 1, 1) & " HP"
		lblResults(4).Text = NumberFormat(ActiveRes.TorqueLbft, 1, 1) & " lb·ft"
		lblResults(8).Text = NumberFormat(ActiveRes.DragHN * 0.224808943, 1, 1) & " lbf"
	End If
	
	lblResults(1).Text = NumberFormat(ActiveRes.CT, 1, 5)
	lblResults(3).Text = NumberFormat(ActiveRes.CPair, 1, 6)
	lblResults(5).Text = NumberFormat(ActiveRes.CQ, 1, 6)
	lblResults(6).Text = NumberFormat(ActiveRes.CQi, 1, 6)
	lblResults(7).Text = NumberFormat(ActiveRes.CQ0, 1, 6)
	lblResults(9).Text = NumberFormat(ActiveRes.CH, 1, 6)
	lblResults(10).Text = NumberFormat(ActiveRes.CY, 1, 6)
	lblResults(11).Text = NumberFormat(ActiveRes.CMy, 1, 6)
	lblResults(12).Text = NumberFormat(ActiveRes.CMx, 1, 6)
	lblResults(13).Text = NumberFormat(ActiveRes.FoM, 1, 4)
	lblResults(14).Text = NumberFormat(ActiveRes.L_D_eff, 1, 2)
	lblResults(15).Text = NumberFormat(ActiveRes.InflowLambda, 1, 5)
	lblResults(16).Text = NumberFormat(ActiveRes.InflowLambdaI, 1, 5)
	lblResults(17).Text = NumberFormat(ActiveRes.InflowKx, 1, 3)
	lblResults(18).Text = NumberFormat(ActiveRes.InflowKy, 1, 3)
	lblResults(19).Text = NumberFormat(ActiveRes.WakeSkewChiDeg, 1, 1) & "°"
	lblResults(20).Text = NumberFormat(tipMachHover, 1, 3)
	lblResults(21).Text = NumberFormat(ActiveRes.AdvancingTipMach, 1, 3)
	If UnitSystem = 0 Then
		lblResults(22).Text = NumberFormat(ActiveCond.Rho, 1, 4) & " kg/m³"
		lblResults(23).Text = NumberFormat(AmbientPressureHPa, 1, 1) & " hPa"
		lblResults(24).Text = NumberFormat(ActiveCond.SpeedOfSound, 1, 1) & " m/s"
	Else
		lblResults(22).Text = NumberFormat(ActiveCond.Rho * 0.0019403203, 1, 5) & " slug/ft³"
		lblResults(23).Text = NumberFormat(AmbientPressureHPa * 0.0295299831, 1, 2) & " inHg"
		lblResults(24).Text = NumberFormat(ActiveCond.SpeedOfSound * 3.280839895, 1, 0) & " ft/s"
	End If
End Sub

Public Sub LoadRotorDataToFields(geom As RotorGeometry)
	UpdatingUI = True
	edtRadius.Text = NumberFormat(geom.Radius, 1, 2)
	edtRPM.Text = NumberFormat(geom.RPM, 1, 1)
	edtNBlades.Text = geom.NBlades
	edtRootCutout.Text = NumberFormat(geom.RootCutout, 1, 3)
	edtChordRoot.Text = NumberFormat(geom.ChordRoot, 1, 4)
	edtChordTip.Text = NumberFormat(geom.ChordTip, 1, 4)
	edtThetaRoot.Text = NumberFormat(geom.ThetaRoot * 180.0 / cPI, 1, 2)
	edtThetaTip.Text = NumberFormat(geom.ThetaTip * 180.0 / cPI, 1, 2)
	edtLiftSlope.Text = NumberFormat(geom.LiftSlope0, 1, 2)
	edtCd0.Text = NumberFormat(geom.Cd0, 1, 4)
	lblRotorNameHeader.Text = HeaderRotorName(geom.Name)
	
	RefreshTipLossButton(geom)
	btnSelectAirfoil.Text = AirfoilDisplayName(geom)
	
	If geom.UsePrandtlGlauert Then
		btnCompressibility.Text = "Prandtl-Glauert: ON"
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		btnCompressibility.Text = "Prandtl-Glauert: OFF"
		btnCompressibility.TextColor = ColorButText2
	End If
	
	UpdatingUI = False
End Sub

Private Sub RefreshTipLossButton(geom As RotorGeometry)
	Select geom.TipLossMode
		Case "sissingh"
			btnTipLoss.Text = "Sissingh: ON"
			btnTipLoss.TextColor = ColorAccentGreen
		Case "fixed"
			btnTipLoss.Text = "Fixed B=" & NumberFormat(geom.TipLossB, 1, 2)
			btnTipLoss.TextColor = ColorAccentCyan
		Case Else
			btnTipLoss.Text = "Tip Loss: OFF"
			btnTipLoss.TextColor = ColorButText2
	End Select
End Sub

Private Sub AirfoilDisplayName(geom As RotorGeometry) As String
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		If Abs(geom.LiftSlope0 - af.A0) < 0.001 And Abs(geom.Cd0 - af.Cd0) < 0.00001 Then Return af.Name
	Next
	Return "Custom Section"
End Sub

Private Sub LoadConditionDataToFields
	If ActiveCond.TargetThrustN > 0 And ActiveCond.TargetCT > 0 Then ActiveCond.TargetCT = 0
	UpdatingUI = True
	edtAltitude.Text = NumberFormat(ConditionAltitudeM, 1, 0)
	edtTemperature.Text = NumberFormat(ConditionTemperatureC, 1, 1)
	edtAdvanceMu.Text = NumberFormat(ActiveCond.Mu, 1, 3)
	edtShaftTiltAlpha.Text = NumberFormat(ConditionShaftTiltDeg, 1, 1)
	edtClimbRateW.Text = NumberFormat(ConditionClimbRateMs, 1, 1)
	edtTargetThrust.Text = NumberFormat(ActiveCond.TargetThrustN, 1, 0)
	edtTargetCT.Text = NumberFormat(ActiveCond.TargetCT, 1, 5)
	
	Select ActiveCond.InflowModel
		Case "uniform": btnInflowModel.Text = "Uniform Benchmark"
		Case "coleman_simple": btnInflowModel.Text = "Coleman Simple"
		Case "drees": btnInflowModel.Text = "Drees Linear"
		Case Else: btnInflowModel.Text = "Coleman-Feingold"
	End Select
	Select ActiveCond.ProfileDragModel
		Case "analytical_tangential": btnProfileDragModel.Text = "Analytical Tangential"
		Case "analytical_vectorial": btnProfileDragModel.Text = "Analytical Vectorial"
		Case Else: btnProfileDragModel.Text = "Numerical Vectorial"
	End Select
	RefreshTrimControls
	UpdatingUI = False
	RefreshDerivedCondition(True)
End Sub

Private Sub RefreshTrimControls
	If ActiveCond.HoverTrimMode = "none" Then
		btnHoverTrimMode.Text = "Manual Pitch"
		btnHoverTrimMode.TextColor = ColorButText2
		edtTargetThrust.Enabled = False
		edtTargetCT.Enabled = False
	Else
		If ActiveCond.TargetThrustN > 0 Then
			btnHoverTrimMode.Text = "Collective to Thrust"
		Else
			btnHoverTrimMode.Text = "Collective to CT"
		End If
		btnHoverTrimMode.TextColor = ColorAccentGreen
		edtTargetThrust.Enabled = True
		edtTargetCT.Enabled = True
	End If
End Sub

Private Sub RefreshDerivedCondition(updateSpeedField As Boolean)
	Dim omega As Double = ActiveGeom.RPM * (cPI / 30.0)
	Dim vtip As Double = omega * ActiveGeom.Radius
	If vtip > 0 Then
		Dim alphaRad As Double = ConditionShaftTiltDeg * cPI / 180.0
		ActiveCond.MuZ = -ActiveCond.Mu * Tan(alphaRad) + (ConditionClimbRateMs / vtip)
		If updateSpeedField And edtSpeedKmh.IsInitialized Then
			Dim wasUpdating As Boolean = UpdatingUI
			UpdatingUI = True
			edtSpeedKmh.Text = NumberFormat(ActiveCond.Mu * vtip * 3.6, 1, 1)
			UpdatingUI = wasUpdating
		End If
	Else
		ActiveCond.MuZ = 0.0
	End If
End Sub

Private Sub RefreshRotorSpinner
	spnRotorSelect.Clear
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g As RotorGeometry = RotorStorage.Rotors.Get(i)
		spnRotorSelect.Add(RotorListName(g.Name))
	Next
	If RotorStorage.ActiveIndex >= 0 And RotorStorage.ActiveIndex < RotorStorage.Rotors.Size Then
		spnRotorSelect.SelectedIndex = RotorStorage.ActiveIndex
	End If
End Sub

Sub spnRotorSelect_ItemClick(Position As Int, Value As Object)
	If Position >= 0 And Position < RotorStorage.Rotors.Size Then
		RotorStorage.SetActiveRotor(Position)
		ActiveGeom = RotorStorage.GetActiveRotor
		LoadRotorDataToFields(ActiveGeom)
		RefreshDerivedCondition(True)
		RecalculateRotor
	End If
End Sub

Sub btnRotorDup_Click
	Dim copyG As RotorGeometry = ActiveGeom
	copyG.Name = ActiveGeom.Name & " (Copy)"
	Dim newIdx As Int = RotorStorage.AddRotor(copyG)
	ActiveGeom = RotorStorage.GetActiveRotor
	RefreshRotorSpinner
	spnRotorSelect.SelectedIndex = newIdx
	LoadRotorDataToFields(ActiveGeom)
	RefreshDerivedCondition(True)
	RecalculateRotor
	ToastMessageShow("Preset duplicated: " & copyG.Name, False)
End Sub

Sub btnSelectAirfoil_Click
	Dim options As List: options.Initialize
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		options.Add(af.Name & " (a0=" & af.A0 & ", Cd0=" & af.Cd0 & ")")
	Next
	Dim resIndex As Int = InputList(options, "Select Airfoil Section:", -1)
	If resIndex >= 0 Then
		Dim selAf As AirfoilData = RotorPopups.Airfoils.Get(resIndex)
		ActiveGeom.LiftSlope0 = selAf.A0
		ActiveGeom.Cd0 = selAf.Cd0
		edtLiftSlope.Text = NumberFormat(selAf.A0, 1, 2)
		edtCd0.Text = NumberFormat(selAf.Cd0, 1, 4)
		btnSelectAirfoil.Text = selAf.Name
		RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
		RecalculateRotor
	End If
End Sub

Sub btnTipLoss_Click
	If ActiveGeom.TipLossMode = "none" Then
		ActiveGeom.TipLossMode = "sissingh"
	Else
		ActiveGeom.TipLossMode = "none"
	End If
	RefreshTipLossButton(ActiveGeom)
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	RecalculateRotor
End Sub

Sub btnCompressibility_Click
	ActiveGeom.UsePrandtlGlauert = Not(ActiveGeom.UsePrandtlGlauert)
	If ActiveGeom.UsePrandtlGlauert Then
		btnCompressibility.Text = "Prandtl-Glauert: ON"
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		btnCompressibility.Text = "Prandtl-Glauert: OFF"
		btnCompressibility.TextColor = ColorButText2
	End If
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	RecalculateRotor
End Sub

Sub btnInflowModel_Click
	If ActiveCond.InflowModel = "uniform" Then
		ActiveCond.InflowModel = "coleman_simple"
		btnInflowModel.Text = "Coleman Simple"
	Else If ActiveCond.InflowModel = "coleman_simple" Then
		ActiveCond.InflowModel = "coleman_feingold"
		btnInflowModel.Text = "Coleman-Feingold"
	Else If ActiveCond.InflowModel = "coleman_feingold" Then
		ActiveCond.InflowModel = "drees"
		btnInflowModel.Text = "Drees Linear"
	Else
		ActiveCond.InflowModel = "uniform"
		btnInflowModel.Text = "Uniform Benchmark"
	End If
	RecalculateRotor
End Sub

Sub btnProfileDragModel_Click
	If ActiveCond.ProfileDragModel = "analytical_tangential" Then
		ActiveCond.ProfileDragModel = "analytical_vectorial"
		btnProfileDragModel.Text = "Analytical Vectorial"
	Else If ActiveCond.ProfileDragModel = "analytical_vectorial" Then
		ActiveCond.ProfileDragModel = "numerical_vectorial"
		btnProfileDragModel.Text = "Numerical Vectorial"
	Else
		ActiveCond.ProfileDragModel = "analytical_tangential"
		btnProfileDragModel.Text = "Analytical Tangential"
	End If
	RecalculateRotor
End Sub

Sub btnHoverTrimMode_Click
	If ActiveCond.HoverTrimMode = "none" Then
		ActiveCond.HoverTrimMode = "collective"
	Else
		ActiveCond.HoverTrimMode = "none"
	End If
	RefreshTrimControls
	RecalculateRotor
End Sub

Sub lblRowTip_Click
	Dim b As Label = Sender
	Dim tipMsg As String = ""
	Select b.Tag
		Case "Radius R"
			tipMsg = "Rotor radius R measured from hub centerline to blade tip in meters."
		Case "Rotor RPM"
			tipMsg = "Rotational speed of rotor in revolutions per minute (RPM)."
		Case "Blade Count"
			tipMsg = "Number of blades Nb forming the rotor disk."
		Case "Root Cutout"
			tipMsg = "Non-dimensional radius r0/R where blade aerodynamic profile starts."
		Case "Root Chord", "Tip Chord"
			tipMsg = "Blade chord c in meters at root and tip stations (linear taper)."
		Case "θ Root Pitch", "θ Tip Pitch"
			tipMsg = "Blade pitch angle theta at root and tip stations (linear twist)."
		Case "Lift Slope a0"
			tipMsg = "Sectional 2D lift curve slope dCl/dalpha (nominal 5.73 1/rad)."
		Case "Profile Cd0"
			tipMsg = "Baseline profile drag coefficient at zero angle of attack."
		Case "Altitude"
			tipMsg = "Pressure altitude above mean sea level according to standard ISA."
		Case "Temperature"
			tipMsg = "Ambient air temperature in degrees Celsius (ISA default 15°C)."
		Case "Advance (μ)"
			tipMsg = "Advance ratio μ = V / (Ω·R), ratio of forward speed to tip speed."
		Case "Flight Speed"
			tipMsg = "True forward flight speed V in km/h, synchronized with μ."
		Case "Shaft Tilt (α)"
			tipMsg = "Shaft tilt angle α in degrees (forward tilt positive)."
		Case "Climb Rate"
			tipMsg = "Vertical climb (+) or descent (-) velocity Vz in m/s."
		Case "Target Thrust"
			tipMsg = "Desired total thrust T in Newtons for hover/forward trim."
		Case "Target CT"
			tipMsg = "Desired thrust coefficient CT = T / (ρ·A·(ΩR)²)."
		Case "Rotor Preset"
			tipMsg = "Stored rotor geometry preset. Select a factory rotor or a duplicated custom configuration."
		Case "Airfoil"
			tipMsg = "Blade section aerodynamic model. Selecting an airfoil updates the sectional lift slope and profile drag data."
		Case "Tip Loss"
			tipMsg = "Finite-blade tip-loss correction. Sissingh reduces the ideal loading near the blade tip."
		Case "Compressibility"
			tipMsg = "Compressibility correction applied to sectional aerodynamics as local Mach number increases."
		Case "Inflow Model"
			tipMsg = "Model used to distribute induced velocity across the rotor disk in forward flight."
		Case "Profile Drag"
			tipMsg = "Method used to evaluate blade profile-drag forces and their torque / in-plane-force contributions."
		Case "Hover Trim"
			tipMsg = "Trim mode. Collective-to-target adjusts blade collective to achieve the selected thrust or CT target."
		Case Else
			tipMsg = b.Tag
	End Select
	ToastMessageShow(tipMsg, True)
End Sub

Sub btnUnit_Click
	Dim b As Button = Sender
	ToastMessageShow("Input unit: " & b.Tag & " (inputs use SI)", False)
End Sub

Sub edtGeom_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ActiveGeom.Radius = ParseDoubleDef(edtRadius.Text, ActiveGeom.Radius)
	ActiveGeom.RPM = ParseDoubleDef(edtRPM.Text, ActiveGeom.RPM)
	ActiveGeom.NBlades = ParseIntDef(edtNBlades.Text, ActiveGeom.NBlades)
	ActiveGeom.RootCutout = ParseDoubleDef(edtRootCutout.Text, ActiveGeom.RootCutout)
	ActiveGeom.ChordRoot = ParseDoubleDef(edtChordRoot.Text, ActiveGeom.ChordRoot)
	ActiveGeom.ChordTip = ParseDoubleDef(edtChordTip.Text, ActiveGeom.ChordTip)
	
	Dim thRootDeg As Double = ParseDoubleDef(edtThetaRoot.Text, 12.0)
	Dim thTipDeg As Double = ParseDoubleDef(edtThetaTip.Text, 4.0)
	ActiveGeom.ThetaRoot = thRootDeg * cPI / 180.0
	ActiveGeom.ThetaTip = thTipDeg * cPI / 180.0
	ActiveGeom.PitchMode = "linear_twist"
	
	ActiveGeom.LiftSlope0 = ParseDoubleDef(edtLiftSlope.Text, ActiveGeom.LiftSlope0)
	ActiveGeom.Cd0 = ParseDoubleDef(edtCd0.Text, ActiveGeom.Cd0)
	ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
	btnSelectAirfoil.Text = AirfoilDisplayName(ActiveGeom)
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	RefreshDerivedCondition(True)
	RecalculateRotor
End Sub

Sub edtCond_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	
	ConditionAltitudeM = ParseDoubleDef(edtAltitude.Text, ConditionAltitudeM)
	ConditionTemperatureC = ParseDoubleDef(edtTemperature.Text, ConditionTemperatureC)
	ConditionShaftTiltDeg = ParseDoubleDef(edtShaftTiltAlpha.Text, ConditionShaftTiltDeg)
	ConditionClimbRateMs = ParseDoubleDef(edtClimbRateW.Text, ConditionClimbRateMs)
	
	' Standard Atmosphere ISA
	Dim pRatio As Double = Power(1.0 - 0.0065 * ConditionAltitudeM / 288.15, 5.2561)
	AmbientPressureHPa = 1013.25 * pRatio
	Dim tKelvin As Double = ConditionTemperatureC + 273.15
	ActiveCond.Rho = (AmbientPressureHPa * 100.0) / (287.058 * tKelvin)
	ActiveCond.SpeedOfSound = Sqrt(1.4 * 287.058 * tKelvin)
	
	ActiveCond.Mu = ParseDoubleDef(edtAdvanceMu.Text, ActiveCond.Mu)
	RefreshDerivedCondition(True)
	
	ActiveCond.TargetThrustN = ParseDoubleDef(edtTargetThrust.Text, ActiveCond.TargetThrustN)
	ActiveCond.TargetCT = ParseDoubleDef(edtTargetCT.Text, ActiveCond.TargetCT)
	
	Dim changedField As String = ""
	Try
		Dim changedEdit As EditText = Sender
		changedField = changedEdit.Tag
	Catch
	End Try
	If changedField = "Target Thrust" And ActiveCond.TargetThrustN > 0 Then
		ActiveCond.TargetCT = 0
		UpdatingUI = True
		edtTargetCT.Text = "0"
		UpdatingUI = False
	Else If changedField = "Target CT" And ActiveCond.TargetCT > 0 Then
		ActiveCond.TargetThrustN = 0
		UpdatingUI = True
		edtTargetThrust.Text = "0"
		UpdatingUI = False
	End If
	If changedField = "Target Thrust" Or changedField = "Target CT" Then RefreshTrimControls
	
	RecalculateRotor
End Sub

Sub edtSpeedKmh_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim vKmh As Double = ParseDoubleDef(edtSpeedKmh.Text, 0)
	Dim vMs As Double = vKmh / 3.6
	Dim omega As Double = ActiveGeom.RPM * (cPI / 30.0)
	Dim vtip As Double = omega * ActiveGeom.Radius
	If vtip > 0 Then
		UpdatingUI = True
		ActiveCond.Mu = vMs / vtip
		edtAdvanceMu.Text = NumberFormat(ActiveCond.Mu, 1, 3)
		UpdatingUI = False
		RefreshDerivedCondition(False)
		RecalculateRotor
	End If
End Sub

Sub edtClimbRate_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	edtCond_TextChanged("", "")
End Sub

' ====================================================================
' SWEEP POPUP (Multi-Parameter μ-Sweep)
' ====================================================================
Sub btnViewPolarPlot_Click
	pnlSweepPopup.Initialize("pnlSweepPopup")
	pnlSweepPopup.Color = 0xFA0A0E15
	root.AddView(pnlSweepPopup, 0, 0, root.Width, root.Height)
	pnlSweepPopup.BringToFront
	
	Dim topBarH As Int
	If ld = 1 Then topBarH = 42dip Else topBarH = 48dip * sc
	Dim footerH As Int
	If ld = 1 Then footerH = 50dip Else footerH = 56dip * sc
	
	Dim pnlHeader As Panel: pnlHeader.Initialize("")
	pnlHeader.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlHeader, 0, 0, root.Width, topBarH)
	
	Dim lblTitle As Label: lblTitle.Initialize("")
	lblTitle.Text = "PARAMETER SWEEP vs μ"
	lblTitle.TextColor = ColorAccentCyan
	If root.Width <= 340dip Then lblTitle.TextSize = 12 Else lblTitle.TextSize = 14 * sc
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.Gravity = Gravity.CENTER_VERTICAL
	pnlHeader.AddView(lblTitle, 12dip, 0, root.Width - 60dip, topBarH)
	
	Dim btnClose As Button: btnClose.Initialize("btnCloseSweepPlot")
	btnClose.Text = "×"
	btnClose.TextColor = 0xFFFF5252
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	pnlHeader.AddView(btnClose, root.Width - 52dip, 0, 48dip, topBarH)
	
	Dim pnlControls As Panel: pnlControls.Initialize("")
	pnlControls.Color = ColorPnlInput2
	Dim controlsH As Int
	If ld = 1 Then controlsH = 58dip Else controlsH = 122dip * sc
	pnlSweepPopup.AddView(pnlControls, 0, topBarH, root.Width, controlsH)
	
	spnSweepParam.Initialize("spnSweepParam")
	spnSweepParam.DropdownBackgroundColor = ColorPnlTitle
	spnSweepParam.DropdownTextColor = ColorTitleText
	
	btnSweepMultiModel.Initialize("btnSweepMultiModel")
	UpdateSweepMultiButtonText
	btnSweepMultiModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	If root.Width <= 340dip Then btnSweepMultiModel.TextSize = 10.5 Else btnSweepMultiModel.TextSize = 11 * sc
	
	btnSweepMaxMu.Initialize("btnSweepMaxMu")
	btnSweepMaxMu.Text = "μ max " & NumberFormat(SweepMaxMuVal, 1, 2)
	btnSweepMaxMu.TextColor = ColorAccentAmber
	btnSweepMaxMu.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	If root.Width <= 340dip Then btnSweepMaxMu.TextSize = 10.5 Else btnSweepMaxMu.TextSize = 11 * sc
	
	If ld = 1 Then
		' Landscape: one compact control row maximizes useful plot height.
		Dim gap As Int = 8dip
		Dim usableW As Int = root.Width - 24dip
		Dim paramW As Int = usableW * 0.37
		Dim modeW As Int = usableW * 0.39
		Dim maxW As Int = usableW - paramW - modeW - 2 * gap
		pnlControls.AddView(spnSweepParam, 12dip, 5dip, paramW, 48dip)
		pnlControls.AddView(btnSweepMultiModel, 12dip + paramW + gap, 5dip, modeW, 48dip)
		pnlControls.AddView(btnSweepMaxMu, 12dip + paramW + gap + modeW + gap, 5dip, maxW, 48dip)
	Else
		Dim lblParamH As Label: lblParamH.Initialize("")
		lblParamH.Text = "Y-AXIS PARAMETER"
		lblParamH.TextColor = ColorButText2
		If root.Width <= 340dip Then lblParamH.TextSize = 10 Else lblParamH.TextSize = 11 * sc
		lblParamH.Typeface = Typeface.DEFAULT_BOLD
		pnlControls.AddView(lblParamH, 12dip, 4dip, root.Width - 24dip, 16dip * sc)
		
		pnlControls.AddView(spnSweepParam, 12dip, 22dip * sc, root.Width - 24dip, 48dip * sc)
		pnlControls.AddView(btnSweepMultiModel, 12dip, 72dip * sc, (root.Width - 30dip) * 0.60, 48dip * sc)
		pnlControls.AddView(btnSweepMaxMu, 18dip + (root.Width - 30dip) * 0.60, 72dip * sc, (root.Width - 30dip) * 0.40, 48dip * sc)
	End If
	
	spnSweepParam.Clear
	For i = 0 To RotorPopups.SweepParamLabels.Size - 1
		spnSweepParam.Add(RotorPopups.SweepParamLabels.Get(i))
	Next
	
	Dim curIdx As Int = 0
	For i = 0 To RotorPopups.SweepParamKeys.Size - 1
		If RotorPopups.SweepParamKeys.Get(i) = SweepParamSelectedKey Then
			curIdx = i
			Exit
		End If
	Next
	spnSweepParam.SelectedIndex = curIdx
	
	Dim plotTop As Int = topBarH + controlsH + 2dip
	Dim plotW As Int = root.Width - 16dip
	Dim plotH As Int = root.Height - plotTop - footerH - 2dip
	If plotH < 120dip Then plotH = 120dip
	
	ivSweepPlot.Initialize("")
	pnlSweepPopup.AddView(ivSweepPlot, 8dip, plotTop, plotW, plotH)
	
	Dim pnlFooter As Panel: pnlFooter.Initialize("")
	pnlFooter.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlFooter, 0, root.Height - footerH, root.Width, footerH)
	
	lblSweepCurrentVal.Initialize("")
	lblSweepCurrentVal.TextColor = ColorAccentAmber
	If root.Width <= 340dip Then lblSweepCurrentVal.TextSize = 10.5 Else lblSweepCurrentVal.TextSize = 12 * sc
	lblSweepCurrentVal.Typeface = Typeface.DEFAULT_BOLD
	lblSweepCurrentVal.Gravity = Gravity.CENTER_VERTICAL
	pnlFooter.AddView(lblSweepCurrentVal, 12dip, 0, root.Width - 144dip, footerH)
	
	Dim btnTable As Button: btnTable.Initialize("btnSweepTable")
	btnTable.Text = "TABLE"
	btnTable.TextColor = ColorAccentCyan
	btnTable.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnTable.TextSize = 12 * sc
	btnTable.Typeface = Typeface.DEFAULT_BOLD
	pnlFooter.AddView(btnTable, root.Width - 132dip, (footerH - 48dip) / 2, 120dip, 48dip)
	
	UpdateSweepPlotView
End Sub

Sub spnSweepParam_ItemClick(Position As Int, Value As Object)
	If Position >= 0 And Position < RotorPopups.SweepParamKeys.Size Then
		SweepParamSelectedKey = RotorPopups.SweepParamKeys.Get(Position)
		SweepParamSelectedLabel = RotorPopups.SweepParamLabels.Get(Position)
		UpdateSweepPlotView
	End If
End Sub

Sub btnSweepMultiModel_Click
	SweepMultiMode = (SweepMultiMode + 1) Mod 4
	UpdateSweepMultiButtonText
	UpdateSweepPlotView
End Sub

Private Sub UpdateSweepMultiButtonText
	Select SweepMultiMode
		Case 0
			btnSweepMultiModel.Text = "4 Inflow Models"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 1
			btnSweepMultiModel.Text = "5 α (-10°..+10°)"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 2
			btnSweepMultiModel.Text = "5 Vz (-10..+10 m/s)"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 3
			btnSweepMultiModel.Text = "Single Active"
			btnSweepMultiModel.TextColor = ColorButText2
	End Select
End Sub

Sub btnSweepMaxMu_Click
	If SweepMaxMuVal < 0.45 Then
		SweepMaxMuVal = 0.50
	Else
		SweepMaxMuVal = 0.40
	End If
	btnSweepMaxMu.Text = "μ max " & NumberFormat(SweepMaxMuVal, 1, 2)
	UpdateSweepPlotView
End Sub

Sub btnCloseSweepPlot_Click
	pnlSweepPopup.RemoveView
End Sub

Sub UpdateSweepPlotView
	If ivSweepPlot.IsInitialized = False Then Return
	Dim plotW As Int = ivSweepPlot.Width
	Dim plotH As Int = ivSweepPlot.Height
	If plotW <= 10 Then plotW = root.Width - 16dip
	If plotH <= 10 Then plotH = 300dip
	
	Dim bmp As Bitmap = RotorPopups.DrawSweepPlot( _
		plotW, plotH, ActiveGeom, ActiveCond, SweepParamSelectedKey, SweepParamSelectedLabel, _
		SweepMultiMode, SweepMaxMuVal, ActiveCond.Mu)
	ivSweepPlot.Bitmap = bmp
	
	Dim curVal As Double = RotorPopups.ExtractParamValue(ActiveRes, SweepParamSelectedKey)
	If root.Width <= 360dip Then
		lblSweepCurrentVal.Text = "μ=" & NumberFormat(ActiveCond.Mu, 1, 2) & ": " & NumberFormat(curVal, 1, 5)
	Else
		lblSweepCurrentVal.Text = "Operating μ=" & NumberFormat(ActiveCond.Mu, 1, 2) & ": " & NumberFormat(curVal, 1, 5)
	End If
End Sub

Sub btnSweepTable_Click
	Dim sb As StringBuilder: sb.Initialize
	sb.Append("Advance Ratio (μ)").Append(TAB).Append(SweepParamSelectedKey).Append(CRLF)
	sb.Append("----------------------------------------").Append(CRLF)
	
	Dim tempCond As FlightCondition = ActiveCond
	For i = 0 To 10
		Dim mu As Double = i * (SweepMaxMuVal / 10.0)
		tempCond.Mu = mu
		Dim res As RotorResults = zBETEngine.Calculate(ActiveGeom, tempCond)
		Dim v As Double = RotorPopups.ExtractParamValue(res, SweepParamSelectedKey)
		sb.Append(NumberFormat(mu, 1, 2)).Append(TAB).Append(TAB).Append(NumberFormat(v, 1, 5)).Append(CRLF)
	Next
	
	Msgbox(sb.ToString, "Data Table: " & SweepParamSelectedKey)
End Sub

' Parsing Utilities
Private Sub ParseDoubleDef(txt As String, defVal As Double) As Double
	If txt = "" Or txt = "-" Or txt = "." Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub

Private Sub ParseIntDef(txt As String, defVal As Int) As Int
	If txt = "" Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub
