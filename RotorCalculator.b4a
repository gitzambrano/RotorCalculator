Private Sub HtmlEscape(textValue As String) As String
	Return textValue.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;")
End Sub

Private Sub BuildSweepTableHtml As String
	Dim dark As Boolean = (ThemeMode = 0)
	Dim bg As String = "#ffffff"
	Dim fg As String = "#172033"
	Dim grid As String = "#d5dce6"
	If dark Then
		bg = "#10141c"
		fg = "#f1f5f9"
		grid = "#273244"
	End If
	Dim sb As StringBuilder
	sb.Initialize
	sb.Append("<html><head><meta name='viewport' content='width=device-width,initial-scale=1'><style>")
	sb.Append("body{margin:10px;background:").Append(bg).Append(";color:").Append(fg).Append(";font-family:monospace;font-size:12px}")
	sb.Append("table{border-collapse:collapse;width:100%;white-space:nowrap}th,td{border:1px solid ").Append(grid).Append(";padding:6px;text-align:right}th{position:sticky;top:0;background:").Append(bg).Append("}td:first-child,th:first-child{text-align:left}</style></head><body>")
	Dim strategy As String = "Re-trim at every sweep point"
	If ActiveCond.OperatingPair = "rpm_collective" Then strategy = "Prescribed RPM + collective"
	If SweepTrimOnlyHover And ActiveCond.OperatingPair <> "rpm_collective" Then strategy = "Trim once in hover; hold RPM + collective"
	sb.Append("<p><b>").Append(HtmlEscape(strategy)).Append("</b></p>")
	sb.Append("<table><tr><th>Curve</th><th>μ</th><th>Vx</th><th>").Append(HtmlEscape(SweepParamSelectedKey)).Append("</th><th>RPM</th><th>Δθ</th><th>CT</th><th>T [N]</th><th>Status</th></tr>")
	For rowIndex = 0 To SweepSamplesCache.Size - 1
		Dim point As SweepPoint = SweepSamplesCache.Get(rowIndex)
		sb.Append("<tr><td>").Append(HtmlEscape(point.CurveLabel)).Append("</td>")
		sb.Append("<td>").Append(CsvNum(point.Mu, 4)).Append("</td>")
		If point.Valid Then
			sb.Append("<td>").Append(CsvNum(point.Vx, 2)).Append("</td>")
			sb.Append("<td>").Append(CsvNum(point.Value, RotorPopups.SweepParamDigits(SweepParamSelectedKey)+ExtraPrecision)).Append("</td>")
			sb.Append("<td>").Append(CsvNum(point.RPM, 1)).Append("</td>")
			sb.Append("<td>").Append(CsvNum(point.CollectiveDeg, 2)).Append("</td>")
			sb.Append("<td>").Append(CsvNum(point.CT, 6)).Append("</td>")
			sb.Append("<td>").Append(CsvNum(point.ThrustN, 2)).Append("</td><td>VALID</td>")
		Else
			sb.Append("<td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td>INVALID</td>")
		End If
		sb.Append("</tr>")
	Next
	sb.Append("</table></body></html>")
	Return sb.ToString
End Sub

' ====================================================================
' SWEEP EXPORT — Android Storage Access Framework, no storage permission
' ====================================================================
Sub btnSweepExportCsv_Click
	Dim csv As String = BuildSweepCsv
	Dim tempName As String = "rotor_sweep_export.csv"
	File.WriteString(File.DirInternal, tempName, csv)
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "text/csv", SweepExportBaseName & ".csv")) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("CSV exported.", False)
	Else
		ToastMessageShow("CSV export canceled or failed.", False)
	End If
End Sub

Sub btnSweepExportPng_Click
	If ivSweepPlot.IsInitialized = False Then Return
	Dim bmp As Bitmap = ivSweepPlot.Bitmap
	If bmp.IsInitialized = False Then Return
	Dim tempName As String = "rotor_sweep_export.png"
	Dim out As OutputStream = File.OpenOutput(File.DirInternal, tempName, False)
	bmp.WriteToStream(out, 100, "PNG")
	out.Close
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "image/png", SweepExportBaseName & ".png")) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("PNG exported.", False)
	Else
		ToastMessageShow("PNG export canceled or failed.", False)
	End If
End Sub

Private Sub SweepExportBaseName As String
	Dim n As String = ActiveGeom.Name.Trim.ToLowerCase
	n = n.Replace(" ", "_").Replace("/", "_").Replace(Chr(92), "_").Replace(":", "_").Replace("|", "_")
	If n = "" Then n = "rotor"
	Return n & "_" & SweepParamSelectedKey.ToLowerCase & "_sweep"
End Sub

Private Sub BuildSweepCsv As String
	If SweepSamplesCache.IsInitialized = False Or SweepSamplesCache.Size = 0 Then UpdateSweepPlotView
	Dim sb As StringBuilder
	sb.Initialize
	sb.Append("curve,x_axis,x_value,mu,Vx_m_s,axial_mode,axial_input,mu_z,inflow_model,parameter,value,status,rpm,collective_deg,ct,thrust_n,trim_strategy").Append(CRLF)
	Dim strategy As String = "per_point_trim"
	If ActiveCond.OperatingPair = "rpm_collective" Then strategy = "prescribed_rpm_collective"
	If SweepTrimOnlyHover And ActiveCond.OperatingPair <> "rpm_collective" Then strategy = "hover_trim_then_fixed"
	For rowIndex = 0 To SweepSamplesCache.Size - 1
		Dim point As SweepPoint = SweepSamplesCache.Get(rowIndex)
		Dim xName As String = "mu"
		Dim xValue As Double = point.Mu
		If SweepXAxisMode = 1 Then
			xName = "Vx_m_s"
			xValue = point.Vx
		End If
		sb.Append(CsvQ(point.CurveLabel)).Append(",").Append(xName).Append(",")
		sb.Append(CsvNum(xValue, 8)).Append(",").Append(CsvNum(point.Mu, 8)).Append(",")
		If point.Valid Then
			sb.Append(CsvNum(point.Vx, 8)).Append(",").Append(point.AxialMode).Append(",")
			sb.Append(CsvNum(point.AxialValue, 8)).Append(",").Append(CsvNum(point.MuZ, 8)).Append(",")
			sb.Append(point.InflowModel).Append(",").Append(SweepParamSelectedKey).Append(",")
			sb.Append(CsvNum(point.Value, 12)).Append(",VALID,")
			sb.Append(CsvNum(point.RPM, 8)).Append(",").Append(CsvNum(point.CollectiveDeg, 8)).Append(",")
			sb.Append(CsvNum(point.CT, 10)).Append(",").Append(CsvNum(point.ThrustN, 8)).Append(",")
		Else
			sb.Append(",").Append(point.AxialMode).Append(",").Append(CsvNum(point.AxialValue, 8)).Append(",,")
			sb.Append(point.InflowModel).Append(",").Append(SweepParamSelectedKey).Append(",,INVALID,,,,")
		End If
		sb.Append(strategy).Append(CRLF)
	Next
	Return sb.ToString
End Sub

Private Sub CsvQ(value As String) As String
	Return Chr(34) & value.Replace(Chr(34), Chr(34) & Chr(34)) & Chr(34)
End Sub

Private Sub CsvNum(value As Double, digits As Int) As String
	' CSV always uses a period as decimal separator, independent of device locale.
	Return NumberFormat2(value, 1, digits, digits, False).Replace(",", ".")
End Sub

Private Sub SaveAs(Source As InputStream, MimeType As String, Title As String) As ResumableSub
	Dim intent As Intent
	intent.Initialize("android.intent.action.CREATE_DOCUMENT", "")
	intent.AddCategory("android.intent.category.OPENABLE")
	intent.PutExtra("android.intent.extra.TITLE", Title)
	intent.SetType(MimeType)
	Try
		StartActivityForResult(intent)
		Wait For ion_Event (MethodName As String, Args() As Object)
		If Args.Length > 1 And -1 = Args(0) Then
			Dim result As Intent = Args(1)
			Dim jo As JavaObject = result
			Dim ctxt As JavaObject
			Dim resolver As JavaObject = ctxt.InitializeContext.RunMethodJO("getContentResolver", Null)
			Dim target As OutputStream = resolver.RunMethod("openOutputStream", Array(jo.RunMethod("getData", Null), "wt"))
			If target.IsInitialized = False Then
				Source.Close
				Return False
			End If
			File.Copy2(Source, target)
			target.Close
			Source.Close
			Return True
		End If
	Catch
		Log("Export failed: " & LastException.Message)
	End Try
	If Source.IsInitialized Then Source.Close
	Return False
End Sub

Private Sub StartActivityForResult(i As Intent)
	Dim jo As JavaObject = GetBA
	ion = jo.CreateEvent("anywheresoftware.b4a.IOnActivityResult", "ion", Null)
	jo.RunMethod("startActivityForResult", Array(ion, i))
End Sub

Private Sub GetBA As Object
	Dim jo As JavaObject
	Dim cls As String = Me
	cls = cls.SubString("class ".Length)
	jo.InitializeStatic(cls)
	Return jo.GetField("processBA")
End Sub

Sub ion_Event (MethodName As String, Args() As Object) As Object
	Return Null
End Sub

' Parsing Utilities
Private Sub ClampD(value As Double, low As Double, high As Double) As Double
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Sub

Private Sub ParseDoubleDef(txt As String, defVal As Double) As Double
	If txt = "" Or txt = "-" Or txt = "." Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub

Private Sub ParseIntDef(txt As String, defVal As Int) As Int
	If txt = "" Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub
