' ====================================================================
' QUICK UNIT CONVERTER
' ====================================================================
Private Sub OpenUnitConverter
	If UnitPopupOpen Then CloseUnitConverter
	pnlUnitPopup.Initialize("pnlUnitPopup")
	pnlUnitPopup.Color = 0xA0000000
	root.AddView(pnlUnitPopup, 0, 0, root.Width, root.Height)
	UnitPopupOpen = True
	pnlUnitPopup.BringToFront
	
	Dim cardW As Int = root.Width - 24dip
	If cardW > 520dip Then cardW = 520dip
	Dim cardH As Int = 294dip
	If cardH > root.Height - 24dip Then cardH = root.Height - 24dip
	Dim cardLeft As Int = (root.Width - cardW) / 2
	Dim cardTop As Int = (root.Height - cardH) / 2
	
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlUnitPopup.AddView(card, cardLeft, cardTop, cardW, cardH)
	
	Dim titleBar As Panel
	titleBar.Initialize("")
	titleBar.Color = ColorPnlTitle
	card.AddView(titleBar, 0, 0, cardW, 52dip)
	
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "QUICK UNIT CONVERTER"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 13
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	titleBar.AddView(lblTitle, 16dip, 0, cardW - 72dip, 52dip)
	
	Dim btnClose As Button
	btnClose.Initialize("btnCloseUnitConverter")
	btnClose.Text = "×"
	btnClose.TextColor = ColorButText1
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	titleBar.AddView(btnClose, cardW - 52dip, 2dip, 48dip, 48dip)
	
	spnUnitMode.Initialize("spnUnitMode")
	spnUnitMode.DropdownBackgroundColor = ColorPnlTitle
	spnUnitMode.DropdownTextColor = ColorTitleText
	spnUnitMode.TextColor = ColorTitleText
	spnUnitMode.TextSize = 12
	Dim modes() As String = Array As String("kW → hp", "hp → kW", "N → kgf", "kgf → N", "N → lbf", "lbf → N", "km/h → kt", "kt → km/h", "km/h → m/s", "m/s → km/h", "m → ft", "ft → m", "mm → in", "in → mm")
	For Each mode As String In modes
		spnUnitMode.Add(mode)
	Next
	card.AddView(spnUnitMode, 16dip, 68dip, cardW - 32dip, 48dip)
	
	edtUnitValue.Initialize("edtUnitValue")
	edtUnitValue.Text = "1"
	edtUnitValue.TextSize = 16
	edtUnitValue.TextColor = ColorEdtText
	edtUnitValue.Color = ColorEdt
	edtUnitValue.Gravity = Gravity.CENTER
	edtUnitValue.InputType = Bit.Or(edtUnitValue.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edtUnitValue.SingleLine = True
	card.AddView(edtUnitValue, 16dip, 128dip, cardW - 32dip, 48dip)
	
	lblUnitResult.Initialize("")
	lblUnitResult.TextColor = ColorAccentGreen
	lblUnitResult.Typeface = Typeface.DEFAULT_BOLD
	lblUnitResult.TextSize = 19
	lblUnitResult.Gravity = Gravity.CENTER
	card.AddView(lblUnitResult, 16dip, 190dip, cardW - 32dip, 72dip)
	UpdateUnitConversion
End Sub

Private Sub CloseUnitConverter
	If UnitPopupOpen Then
		pnlUnitPopup.RemoveView
		UnitPopupOpen = False
	End If
End Sub

Sub btnCloseUnitConverter_Click
	CloseUnitConverter
End Sub

Sub spnUnitMode_ItemClick(Position As Int, Value As Object)
	UpdateUnitConversion
End Sub

Sub edtUnitValue_TextChanged (Old As String, New As String)
	If UnitPopupOpen Then UpdateUnitConversion
End Sub

Private Sub UpdateUnitConversion
	If spnUnitMode.IsInitialized = False Or edtUnitValue.IsInitialized = False Or lblUnitResult.IsInitialized = False Then Return
	Dim x As Double = ParseDoubleDef(edtUnitValue.Text, 0)
	Dim y As Double
	Dim unitText As String
	Select spnUnitMode.SelectedIndex
		Case 0
			y = x * 1.34102209 : unitText = "hp"
		Case 1
			y = x / 1.34102209 : unitText = "kW"
		Case 2
			y = x / 9.80665 : unitText = "kgf"
		Case 3
			y = x * 9.80665 : unitText = "N"
		Case 4
			y = x * 0.224808943 : unitText = "lbf"
		Case 5
			y = x / 0.224808943 : unitText = "N"
		Case 6
			y = x / 1.852 : unitText = "kt"
		Case 7
			y = x * 1.852 : unitText = "km/h"
		Case 8
			y = x / 3.6 : unitText = "m/s"
		Case 9
			y = x * 3.6 : unitText = "km/h"
		Case 10
			y = x * 3.280839895 : unitText = "ft"
		Case 11
			y = x / 3.280839895 : unitText = "m"
		Case 12
			y = x / 25.4 : unitText = "in"
		Case Else
			y = x * 25.4 : unitText = "mm"
	End Select
	lblUnitResult.Text = NumberFormat2(y, 1, 4, 4, False) & " " & unitText
End Sub

' ====================================================================
' PAGE 0: GEOMETRY (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageGeom
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
	scvGeom.Initialize(1200)
	pnlBack0.AddView(scvGeom, 0, 0, root.Width, root.Height - HeaderHeight)
	RefreshRotorList
End Sub

Private Sub RefreshRotorList
	If scvGeom.IsInitialized = False Then Return
	scvGeom.Panel.RemoveAllViews
	
	Dim listW As Int = UiContentW
	Dim listLeft As Int = UiContentLeft
	Dim hintH As Int = 46dip
	Dim rowH As Int = 68dip
	Dim y As Int = 0
	
	Dim lblHint As Label
	lblHint.Initialize("")
	lblHint.Text = "Select a rotor to view or edit"
	lblHint.TextColor = ColorButText2
	lblHint.TextSize = 11 * sc
	lblHint.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scvGeom.Panel.AddView(lblHint, listLeft + 16dip, y, listW - 154dip, hintH)
	
	Dim btnNewRotor As Button
	btnNewRotor.Initialize("btnNewRotor")
	btnNewRotor.Text = "+ NEW ROTOR"
	btnNewRotor.TextColor = ColorAccentCyan
	btnNewRotor.Typeface = Typeface.DEFAULT_BOLD
	If root.Width <= 340dip Then btnNewRotor.TextSize = 10 Else btnNewRotor.TextSize = 11 * sc
	btnNewRotor.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	scvGeom.Panel.AddView(btnNewRotor, listLeft + listW - 130dip, y + 3dip, 114dip, 40dip)
	y = y + hintH
	
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g As RotorGeometry = RotorStorage.Rotors.Get(i)
		Dim row As Panel
		row.Initialize("")
		row.Tag = i
		If i = RotorStorage.ActiveIndex Then
			row.Color = ColorPnlInput1
		Else
			row.Color = ColorPnlInput2
		End If
		scvGeom.Panel.AddView(row, listLeft, y, listW, rowH)
		
		If i = RotorStorage.ActiveIndex Then
			Dim activeBar As Panel
			activeBar.Initialize("")
			activeBar.Color = ColorAccentCyan
			row.AddView(activeBar, 0, 0, 4dip, rowH)
		End If
		
		Dim lblName As Label
		lblName.Initialize("")
		lblName.Text = RotorListName(g.Name)
		lblName.TextColor = ColorTitleText
		lblName.Typeface = Typeface.DEFAULT_BOLD
		If root.Width <= 340dip Then lblName.TextSize = 12 Else lblName.TextSize = 13 * sc
		lblName.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lblName.SingleLine = True
		row.AddView(lblName, 16dip, 6dip, listW - 128dip, 30dip)
		
		Dim lblMeta As Label
		lblMeta.Initialize("")
		lblMeta.Text = "R " & NumberFormat(g.Radius, 1, 2) & " m  •  " & g.NBlades & " blades  •  " & NumberFormat(g.RPM, 1, 0) & " RPM"
		lblMeta.TextColor = ColorButText2
		lblMeta.TextSize = 10.5 * sc
		lblMeta.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lblMeta.SingleLine = True
		row.AddView(lblMeta, 16dip, 34dip, listW - 128dip, 26dip)
		
		If i = RotorStorage.ActiveIndex Then
			Dim lblActive As Label
			lblActive.Initialize("")
			lblActive.Text = "ACTIVE"
			lblActive.TextColor = ColorAccentGreen
			lblActive.TextSize = 9.5 * sc
			lblActive.Typeface = Typeface.DEFAULT_BOLD
			lblActive.Gravity = Gravity.CENTER
			row.AddView(lblActive, listW - 112dip, 10dip, 64dip, 22dip)
		End If
		
		Dim lblArrow As Label
		lblArrow.Initialize("")
		lblArrow.Text = "›"
		lblArrow.TextColor = ColorAccentCyan
		lblArrow.TextSize = 24
		lblArrow.Gravity = Gravity.CENTER
		row.AddView(lblArrow, listW - 44dip, 10dip, 36dip, 48dip)
		
		' Dedicated touch surface keeps the whole row clickable, including labels.
		Dim tap As Panel
		tap.Initialize("pnlRotorTap")
		tap.Tag = i
		tap.Color = Colors.Transparent
		row.AddView(tap, 0, 0, listW, rowH)
		
		Dim sep As Panel
		sep.Initialize("")
		sep.Color = ColorPnlLine3
		scvGeom.Panel.AddView(sep, listLeft, y + rowH - 1dip, listW, 1dip)
		y = y + rowH
	Next
	
	scvGeom.Panel.Height = y + 16dip
End Sub

Sub btnNewRotor_Click
	Dim newIdx As Int = RotorStorage.CreateNewRotor
	RotorStorage.SetActiveRotor(newIdx)
	ActiveGeom = RotorStorage.GetActiveRotor
	RefreshRotorList
	RefreshDerivedCondition(True)
	RecalculateRotor
	OpenGeometryPopup
End Sub

Sub pnlRotorTap_Click
	Dim row As Panel = Sender
	Dim idx As Int = row.Tag
	If idx < 0 Or idx >= RotorStorage.Rotors.Size Then Return
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	RefreshRotorList
	RefreshDerivedCondition(True)
	RecalculateRotor
	OpenGeometryPopup
End Sub

Private Sub OpenGeometryPopup
	If GeometryPopupOpen Then CloseGeometryPopup
	
	pnlGeomPopup.Initialize("pnlGeomPopup")
	pnlGeomPopup.Color = 0xA0000000
	root.AddView(pnlGeomPopup, 0, 0, root.Width, root.Height)
	GeometryPopupOpen = True
	pnlGeomPopup.BringToFront
	
	Dim popupW As Int = root.Width - 16dip
	If popupW > 620dip Then popupW = 620dip
	Dim popupLeft As Int = (root.Width - popupW) / 2
	Dim popupTop As Int = 8dip
	Dim popupH As Int = root.Height - 16dip
	Dim titleH As Int = 52dip
	
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlGeomPopup.AddView(card, popupLeft, popupTop, popupW, popupH)
	
	Dim titleBar As Panel
	titleBar.Initialize("")
	titleBar.Color = ColorPnlTitle
	card.AddView(titleBar, 0, 0, popupW, titleH)
	
	lblGeomPopupTitle.Initialize("")
	lblGeomPopupTitle.Text = ActiveGeom.Name
	lblGeomPopupTitle.TextColor = ColorAccentCyan
	lblGeomPopupTitle.Typeface = Typeface.DEFAULT_BOLD
	lblGeomPopupTitle.TextSize = 13 * sc
	lblGeomPopupTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblGeomPopupTitle.SingleLine = True
	titleBar.AddView(lblGeomPopupTitle, 16dip, 0, popupW - 72dip, titleH)
	
	Dim btnClose As Button
	btnClose.Initialize("btnCloseGeometryPopup")
	btnClose.Text = "×"
	btnClose.TextColor = ColorButText1
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	titleBar.AddView(btnClose, popupW - 52dip, 2dip, 48dip, 48dip)
	
	Dim footerH As Int = 64dip
	scvGeomEditor.Initialize(1800)
	card.AddView(scvGeomEditor, 0, titleH, popupW, popupH - titleH - footerH)
	BuildGeometryEditor(popupW)
	
	Dim footer As Panel
	footer.Initialize("")
	footer.Color = ColorPnlTitle
	card.AddView(footer, 0, popupH - footerH, popupW, footerH)
	
	Dim gap As Int = 8dip
	Dim actionW As Int = (popupW - 32dip - gap) / 2
	Dim btnCopy As Button
	btnCopy.Initialize("btnGeomCopy")
	btnCopy.Text = "COPY ROTOR"
	btnCopy.TextColor = ColorAccentCyan
	btnCopy.Typeface = Typeface.DEFAULT_BOLD
	btnCopy.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	footer.AddView(btnCopy, 16dip, 8dip, actionW, 48dip)
	
	Dim btnDelete As Button
	btnDelete.Initialize("btnGeomDelete")
	btnDelete.Text = "DELETE"
	btnDelete.TextColor = 0xFFFF6B6B
	btnDelete.Typeface = Typeface.DEFAULT_BOLD
	btnDelete.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	footer.AddView(btnDelete, 16dip + actionW + gap, 8dip, actionW, 48dip)
	
	LoadRotorDataToFields(ActiveGeom)
End Sub

Private Sub BuildGeometryEditor(editorW As Int)
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim rowH As Int = (ib * 2 + tb) * sc
	Dim rowCount As Int = 14
	Dim j As Int
	
	For j = 0 To rowCount - 1
		Dim pnlInput As Panel
		Dim pnlline As Panel
		pnlInput.Initialize("")
		pnlline.Initialize("")
		scvGeomEditor.Panel.AddView(pnlInput, 0, j * (rowH + 1dip), editorW, rowH)
		scvGeomEditor.Panel.AddView(pnlline, 0, j * (rowH + 1dip) + rowH - 1dip, editorW, 1dip)
		pnlline.Color = ColorPnlLine3
		If (j Mod 2) = 1 Then pnlInput.Color = ColorPnlInput1 Else pnlInput.Color = ColorPnlInput2
		
		Select j
			Case 0
				edtRotorName = AddTextInputRow(pnlInput, ib, tb, "Rotor Name", ActiveGeom.Name, "edtGeom_TextChanged")
			Case 1
				edtRadius = AddFullInputRow(pnlInput, ib, tb, "Radius R", "5.50", "m", "edtGeom_TextChanged")
			Case 2
				edtRPM = AddFullInputRow(pnlInput, ib, tb, "Rotor RPM", "390.0", "RPM", "edtGeom_TextChanged")
			Case 3
				edtNBlades = AddFullInputRow(pnlInput, ib, tb, "Blade Count", "4", "blades", "edtGeom_TextChanged")
			Case 4
				edtRootCutout = AddFullInputRow(pnlInput, ib, tb, "Root Cutout", "0.15", "r0/R", "edtGeom_TextChanged")
			Case 5
				edtChordRoot = AddFullInputRow(pnlInput, ib, tb, "Root Chord", "0.324", "m", "edtGeom_TextChanged")
			Case 6
				edtChordTip = AddFullInputRow(pnlInput, ib, tb, "Tip Chord", "0.324", "m", "edtGeom_TextChanged")
			Case 7
				edtThetaRoot = AddFullInputRow(pnlInput, ib, tb, "θ Root Pitch", "12.0", "°", "edtGeom_TextChanged")
			Case 8
				edtThetaTip = AddFullInputRow(pnlInput, ib, tb, "θ Tip Pitch", "4.0", "°", "edtGeom_TextChanged")
			Case 9
				edtLiftSlope = AddFullInputRow(pnlInput, ib, tb, "Lift Slope a0", "5.73", "1/rad", "edtGeom_TextChanged")
			Case 10
				edtCd0 = AddFullInputRow(pnlInput, ib, tb, "Profile Cd0", "0.0090", "—", "edtGeom_TextChanged")
			Case 11
				Dim lblAf As Label = CreateRowLabel("Airfoil", "lblRowTip_Click")
				pnlInput.AddView(lblAf, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnSelectAirfoil.Initialize("btnSelectAirfoil")
				btnSelectAirfoil.TextSize = 13 * sc
				btnSelectAirfoil.SingleLine = True
				btnSelectAirfoil.TextColor = ColorAccentCyan
				btnSelectAirfoil.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnSelectAirfoil, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 12
				Dim lblTipLoss As Label = CreateRowLabel("Tip Loss", "lblRowTip_Click")
				pnlInput.AddView(lblTipLoss, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnTipLoss.Initialize("btnTipLoss")
				btnTipLoss.TextSize = 13 * sc
				btnTipLoss.SingleLine = True
				btnTipLoss.TextColor = ColorAccentGreen
				btnTipLoss.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnTipLoss, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 13
				Dim lblCompress As Label = CreateRowLabel("Compressibility", "lblRowTip_Click")
				pnlInput.AddView(lblCompress, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnCompressibility.Initialize("btnCompressibility")
				btnCompressibility.TextSize = 13 * sc
				btnCompressibility.SingleLine = True
				btnCompressibility.TextColor = ColorAccentGreen
				btnCompressibility.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnCompressibility, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
		End Select
	Next
	
	scvGeomEditor.Panel.Height = rowCount * (rowH + 1dip) + 12dip
End Sub

Sub btnCloseGeometryPopup_Click
	CloseGeometryPopup
End Sub

Private Sub CloseGeometryPopup
	If GeometryPopupOpen Then
		pnlGeomPopup.RemoveView
		GeometryPopupOpen = False
	End If
	RefreshRotorList
End Sub

Sub btnGeomCopy_Click
	Dim newIdx As Int = RotorStorage.DuplicateRotor(RotorStorage.ActiveIndex)
	RotorStorage.SetActiveRotor(newIdx)
	ActiveGeom = RotorStorage.GetActiveRotor
	lblGeomPopupTitle.Text = ActiveGeom.Name
	LoadRotorDataToFields(ActiveGeom)
	RefreshDerivedCondition(True)
	RecalculateRotor
	RefreshRotorList
	ToastMessageShow("Rotor copied: " & ActiveGeom.Name, False)
End Sub

Sub btnGeomDelete_Click
	If RotorStorage.Rotors.Size <= 1 Then
		ToastMessageShow("At least one rotor must remain.", False)
		Return
	End If
	Dim deleteName As String = ActiveGeom.Name
	Dim answer As Int = Msgbox2("Delete '" & deleteName & "'?", "Delete Rotor", "DELETE", "Cancel", "", Null)
	If answer <> DialogResponse.POSITIVE Then Return
	If RotorStorage.DeleteRotor(RotorStorage.ActiveIndex) Then
		ActiveGeom = RotorStorage.GetActiveRotor
		CloseGeometryPopup
		RefreshDerivedCondition(True)
		RecalculateRotor
		ToastMessageShow("Deleted: " & deleteName, False)
	End If
End Sub


' ====================================================================
' PAGE 1: CONDITIONS (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageCond
	pnlBack1.Initialize("")
	pnlBack1.Color = ColorPnlInput5
	scvCond.Initialize(2500)
	pnlBack1.AddView(scvCond, 0, 0, root.Width, root.Height - HeaderHeight)
	
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim rowH As Int = (ib * 2 + tb) * sc
	Dim PanelNb As Int = 9
	
	For j = 0 To PanelNb - 1
		Dim pnlInput As Panel
		Dim pnlline As Panel
		pnlInput.Initialize("pnlInput")
		pnlline.Initialize("pnlline")
		scvCond.Panel.AddView(pnlInput, UiContentLeft, (j * (ib * 2 + tb) + j * 1dip) * sc, UiContentW, rowH)
		scvCond.Panel.AddView(pnlline, UiContentLeft, (j * (ib * 2 + tb) + j * 1dip - 1dip) * sc, UiContentW, 1dip * sc)
		pnlline.Color = ColorPnlLine3
		If (j Mod 2) = 1 Then pnlInput.Color = ColorPnlInput1 Else pnlInput.Color = ColorPnlInput2
		
		Select j
			Case 0
				edtAltitude = AddFullInputRow(pnlInput, ib, tb, "Altitude", "0", "m", "edtCond_TextChanged")
			Case 1
				edtTemperature = AddFullInputRow(pnlInput, ib, tb, "Temperature", "15.0", "°C", "edtCond_TextChanged")
			Case 2
				Dim lblHorizontal As Label = CreateRowLabel("Horizontal Flow", "lblRowTip_Click")
				pnlInput.AddView(lblHorizontal, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 28 / 100, tb * sc)
				btnHorizontalInput.Initialize("btnHorizontalInput")
				btnHorizontalInput.Typeface = Typeface.DEFAULT_BOLD
				btnHorizontalInput.TextColor = ColorAccentCyan
				btnHorizontalInput.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				If root.Width <= 340dip Then btnHorizontalInput.TextSize = 11 Else btnHorizontalInput.TextSize = 12 * sc
				pnlInput.AddView(btnHorizontalInput, pnlInput.Width * 32 / 100, ib * sc, pnlInput.Width * 22 / 100, tb * sc)
				edtHorizontalValue.Initialize("edtHorizontalValue")
				edtHorizontalValue.Tag = "Horizontal Flow"
				edtHorizontalValue.TextColor = ColorEdtText
				edtHorizontalValue.Color = ColorEdt
				edtHorizontalValue.Gravity = Gravity.CENTER
				edtHorizontalValue.InputType = Bit.Or(edtHorizontalValue.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
				edtHorizontalValue.ForceDoneButton = True
				edtHorizontalValue.SingleLine = True
				edtHorizontalValue.TextSize = 13 * sc
				pnlInput.AddView(edtHorizontalValue, pnlInput.Width * 56 / 100, ib * sc, pnlInput.Width * 25 / 100, tb * sc)
				lblHorizontalUnit.Initialize("")
				lblHorizontalUnit.TextColor = ColorButText2
				lblHorizontalUnit.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
				lblHorizontalUnit.SingleLine = True
				If root.Width <= 340dip Then lblHorizontalUnit.TextSize = 10 Else lblHorizontalUnit.TextSize = 11 * sc
				pnlInput.AddView(lblHorizontalUnit, pnlInput.Width * 83 / 100, ib * sc, pnlInput.Width * 14 / 100, tb * sc)
			Case 3
				Dim lblAxial As Label = CreateRowLabel("Axial Flow", "lblRowTip_Click")
				pnlInput.AddView(lblAxial, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 28 / 100, tb * sc)
				btnAxialInput.Initialize("btnAxialInput")
				btnAxialInput.Typeface = Typeface.DEFAULT_BOLD
				btnAxialInput.TextColor = ColorAccentCyan
				btnAxialInput.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				If root.Width <= 340dip Then btnAxialInput.TextSize = 11 Else btnAxialInput.TextSize = 12 * sc
				pnlInput.AddView(btnAxialInput, pnlInput.Width * 32 / 100, ib * sc, pnlInput.Width * 22 / 100, tb * sc)
				edtAxialValue.Initialize("edtAxialValue")
				edtAxialValue.Tag = "Axial Flow"
				edtAxialValue.TextColor = ColorEdtText
				edtAxialValue.Color = ColorEdt
				edtAxialValue.Gravity = Gravity.CENTER
				edtAxialValue.InputType = Bit.Or(edtAxialValue.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
				edtAxialValue.ForceDoneButton = True
				edtAxialValue.SingleLine = True
				edtAxialValue.TextSize = 13 * sc
				pnlInput.AddView(edtAxialValue, pnlInput.Width * 56 / 100, ib * sc, pnlInput.Width * 25 / 100, tb * sc)
				lblAxialUnit.Initialize("")
				lblAxialUnit.TextColor = ColorButText2
				lblAxialUnit.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
				lblAxialUnit.SingleLine = True
				If root.Width <= 340dip Then lblAxialUnit.TextSize = 10 Else lblAxialUnit.TextSize = 11 * sc
				pnlInput.AddView(lblAxialUnit, pnlInput.Width * 83 / 100, ib * sc, pnlInput.Width * 14 / 100, tb * sc)
			Case 4
				Dim lblInflow As Label = CreateRowLabel("Inflow Model", "lblRowTip_Click")
				pnlInput.AddView(lblInflow, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnInflowModel.Initialize("btnInflowModel")
				btnInflowModel.Text = "Coleman-Feingold"
				btnInflowModel.TextSize = 13 * sc
				btnInflowModel.SingleLine = True
				btnInflowModel.TextColor = ColorAccentCyan
				btnInflowModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnInflowModel, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 5
				Dim lblDrag As Label = CreateRowLabel("Profile Drag", "lblRowTip_Click")
				pnlInput.AddView(lblDrag, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnProfileDragModel.Initialize("btnProfileDragModel")
				btnProfileDragModel.Text = "Numerical Vectorial"
				btnProfileDragModel.TextSize = 13 * sc
				btnProfileDragModel.SingleLine = True
				btnProfileDragModel.TextColor = ColorTitleText
				btnProfileDragModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnProfileDragModel, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 6
				Dim lblTrim As Label = CreateRowLabel("Hover Trim", "lblRowTip_Click")
				pnlInput.AddView(lblTrim, pnlInput.Width * 3 / 100, ib * sc, pnlInput.Width * 30 / 100, tb * sc)
				btnHoverTrimMode.Initialize("btnHoverTrimMode")
				btnHoverTrimMode.Text = "Collective to Target"
				btnHoverTrimMode.TextSize = 13 * sc
				btnHoverTrimMode.SingleLine = True
				btnHoverTrimMode.TextColor = ColorAccentGreen
				btnHoverTrimMode.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
				pnlInput.AddView(btnHoverTrimMode, pnlInput.Width * 37 / 100, ib * sc, pnlInput.Width * 60 / 100, tb * sc)
			Case 7
				edtTargetThrust = AddFullInputRow(pnlInput, ib, tb, "Target Thrust", "0", "N", "edtCond_TextChanged")
			Case 8
				edtTargetCT = AddFullInputRow(pnlInput, ib, tb, "Target CT", "0.00650", "[-]", "edtCond_TextChanged")
		End Select
	Next
	
	scvCond.Panel.Height = (PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 20dip) * sc
End Sub

' ====================================================================
' PAGE 2: RESULTS / OUTPUTS (AeroCalculator scvMain2 Architecture)
' ====================================================================
Private Sub BuildPageRes
	pnlBack2.Initialize("")
	pnlBack2.Color = ColorPnlInput5
	scvRes.Initialize(2500)
	pnlBack2.AddView(scvRes, 0, 0, root.Width, root.Height - HeaderHeight)
	
	Dim PanelHeight1 As Int = 48dip * sc
	
	' 1. Top Action Button: Open Multi-Parameter μ-Sweep
	btnViewPolarPlot.Initialize("btnViewPolarPlot")
	btnViewPolarPlot.Text = "OPEN PARAMETER SWEEP"
	If root.Width <= 340dip Then btnViewPolarPlot.TextSize = 12 Else btnViewPolarPlot.TextSize = 14 * sc
	btnViewPolarPlot.Typeface = Typeface.DEFAULT_BOLD
	btnViewPolarPlot.TextColor = ColorAccentCyan
	btnViewPolarPlot.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	scvRes.Panel.AddView(btnViewPolarPlot, UiContentLeft + UiContentW * 3 / 100, 8dip * sc, UiContentW * 94 / 100, 48dip * sc)
	
	lblResultStatus.Initialize("lblResultStatus")
	lblResultStatus.Text = "MODEL STATUS · VALID"
	lblResultStatus.TextColor = ColorAccentGreen
	lblResultStatus.Typeface = Typeface.DEFAULT_BOLD
	If root.Width <= 340dip Then lblResultStatus.TextSize = 9.5 Else lblResultStatus.TextSize = 10.5 * sc
	lblResultStatus.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblResultStatus.SingleLine = True
	scvRes.Panel.AddView(lblResultStatus, UiContentLeft + UiContentW * 4 / 100, 58dip * sc, UiContentW * 92 / 100, 30dip * sc)
	
	Dim startY As Int = 94dip * sc
	
	Dim outputLabels As List
	outputLabels.Initialize2(Array As String( _
		"Total Thrust (T)", _
		"Thrust Coef (CT)", _
		"Shaft Power (P)", _
		"Air Power Coef (CPair)", _
		"Total Torque (Q)", _
		"Torque Coef (CQ)", _
		"Induced Torque (CQi)", _
		"Profile Drag Torque (CQ0)", _
		"In-Plane Drag (H)", _
		"In-Plane Coef (CH)", _
		"Side Force Coef (CY)", _
		"Pitch Moment Coef (CMy)", _
		"Roll Moment Coef (CMx)", _
		"Figure of Merit (FoM)", _
		"Effective L/D Ratio", _
		"Total Inflow Ratio (λ)", _
		"Induced Inflow Ratio (λi)", _
		"Longitudinal Inflow (Kx)", _
		"Lateral Inflow (Ky)", _
		"Wake Skew Angle (χ)", _
		"Tip Mach (Hover)", _
		"Advancing Tip Mach (Mat)", _
		"Air Density (ρ)", _
		"Ambient Pressure (p)", _
		"Speed of Sound (a)" _
	))
	
	Dim i As Int
	Dim sectionH As Int = 24dip * sc
	Dim curY As Int = startY
	For i = 0 To outputLabels.Size - 1
		Dim sectionTitle As String = ""
		Select i
			Case 0: sectionTitle = "THRUST & POWER"
			Case 8: sectionTitle = "FORCES & MOMENTS"
			Case 13: sectionTitle = "EFFICIENCY"
			Case 15: sectionTitle = "INFLOW & WAKE"
			Case 20: sectionTitle = "MACH & ATMOSPHERE"
		End Select
		If sectionTitle <> "" Then
			Dim lblSection As Label
			lblSection.Initialize("")
			lblSection.Text = sectionTitle
			lblSection.TextColor = ColorAccentGreen
			lblSection.TextSize = 10 * sc
			lblSection.Typeface = Typeface.DEFAULT_BOLD
			lblSection.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
			scvRes.Panel.AddView(lblSection, UiContentLeft + UiContentW * 4 / 100, curY, UiContentW * 92 / 100, sectionH)
			curY = curY + sectionH
		End If
		
		Dim pnltest As Panel
		Dim pnlline As Panel
		pnltest.Initialize("")
		pnlline.Initialize("")
		
		scvRes.Panel.AddView(pnltest, UiContentLeft, curY, UiContentW, PanelHeight1)
		scvRes.Panel.AddView(pnlline, UiContentLeft, curY + PanelHeight1 - 1dip, UiContentW, 1dip * sc)
		pnlline.Color = ColorPnlLine3
		
		If (i Mod 2) = 1 Then
			pnltest.Color = ColorPnlInput3
		Else
			pnltest.Color = ColorPnlInput4
		End If
		
		Dim fullLabel As String = outputLabels.Get(i)
		Dim lblVar As Label
		lblVar.Initialize("lblResultTip")
		pnltest.AddView(lblVar, pnltest.Width * 4 / 100, 0, pnltest.Width * 52 / 100, PanelHeight1)
		lblVar.Text = ResultDisplayLabel(fullLabel)
		If root.Width <= 340dip Then lblVar.TextSize = 12 Else lblVar.TextSize = 13 * sc
		lblVar.Typeface = Typeface.DEFAULT_BOLD
		lblVar.TextColor = ColorTitleText
		lblVar.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lblVar.SingleLine = True
		lblVar.Tag = fullLabel
		
		lblResults(i).Initialize("")
		pnltest.AddView(lblResults(i), pnltest.Width * 56 / 100, 0, pnltest.Width * 40 / 100, PanelHeight1)
		lblResults(i).Text = "---"
		If root.Width <= 340dip Then lblResults(i).TextSize = 12 Else lblResults(i).TextSize = 13 * sc
		lblResults(i).Typeface = Typeface.DEFAULT_BOLD
		lblResults(i).TextColor = ColorAccentCyan
		lblResults(i).Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
		lblResults(i).SingleLine = True
		curY = curY + PanelHeight1
	Next
	
	scvRes.Panel.Height = curY + 20dip * sc
End Sub

' Compact labels are used only when the available width requires them.
' The full engineering meaning remains available through the row/result tooltip.
Private Sub InputDisplayLabel(fullText As String) As String
	If root.Width > 340dip Then Return fullText
	Select fullText
		Case "Rotor Preset": Return "Preset"
		Case "Rotor Name": Return "Name"
		Case "Blade Count": Return "Blades"
		Case "Root Cutout": Return "Root Cut."
		Case "Root Chord": Return "Root c"
		Case "Tip Chord": Return "Tip c"
		Case "θ Root Pitch": Return "θ Root"
		Case "θ Tip Pitch": Return "θ Tip"
		Case "Lift Slope a0": Return "Lift a0"
		Case "Profile Cd0": Return "Cd0"
		Case "Temperature": Return "Temp."
		Case "Horizontal Flow": Return "Horizontal"
		Case "Axial Flow": Return "Axial"
		Case "Inflow Model": Return "Inflow"
		Case "Compressibility": Return "Compress."
		Case "Target Thrust": Return "Target T"
		Case Else: Return fullText
	End Select
End Sub

Private Sub HeaderRotorName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim n As String = fullName.ToLowerCase
	If n.Contains("uh-60") Then Return "UH-60"
	If n.Contains("bell 206") Then Return "Bell 206"
	If n.Contains("bo 105") Or n.Contains("bo105") Then Return "Bo 105"
	If n.Contains("r44") Then Return "R44"
	If n.Contains("dji") Then Return "DJI"
	If n.Contains("evtol") Then Return "eVTOL"
	Return fullName
End Sub

Private Sub RotorListName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim shortName As String = HeaderRotorName(fullName)
	If fullName.ToLowerCase.Contains("(copy)") And shortName.ToLowerCase.Contains("(copy)") = False Then
		shortName = shortName & " (Copy)"
	End If
	If shortName.Length > 24 Then shortName = shortName.SubString2(0, 21) & "…"
	Return shortName
End Sub

Private Sub ResultDisplayLabel(fullText As String) As String
	If root.Width > 380dip Then Return fullText
	Select fullText
		Case "Air Power Coef (CPair)": Return "Air Power (CPair)"
		Case "Profile Drag Torque (CQ0)": Return "Profile Torque (CQ0)"
		Case "Pitch Moment Coef (CMy)": Return "Pitch Moment (CMy)"
		Case "Roll Moment Coef (CMx)": Return "Roll Moment (CMx)"
		Case "Total Inflow Ratio (λ)": Return "Total Inflow (λ)"
		Case "Induced Inflow Ratio (λi)": Return "Induced Inflow (λi)"
		Case "Longitudinal Inflow (Kx)": Return "Long. Inflow (Kx)"
		Case "Lateral Inflow (Ky)": Return "Lat. Inflow (Ky)"
		Case "Advancing Tip Mach (Mat)": Return "Adv. Tip Mach (Mat)"
		Case "Ambient Pressure (p)": Return "Pressure (p)"
		Case "Speed of Sound (a)": Return "Sound Speed (a)"
		Case Else: Return fullText
	End Select
End Sub

Sub lblResultStatus_Click
	If ActiveRes.SolutionValid = False Then
		Msgbox(ActiveRes.StatusMessage & CRLF & CRLF & "Adjust geometry or operating condition before using the reported performance.", "Model Status")
	Else If ActiveRes.CompressibilityWarning Then
		Msgbox("Advancing-tip Mach is at or above 0.80 while Prandtl-Glauert is enabled." & CRLF & CRLF & "The calculation is kept finite for continuity, but this linear compressibility correction is outside its recommended subsonic range.", "Compressibility Caution")
	Else
		ToastMessageShow("Model status: valid operating point.", False)
	End If
End Sub

Sub lblResultTip_Click
	Dim l As Label = Sender
	ToastMessageShow(ResultTooltip(l.Tag), True)
End Sub

Private Sub ResultTooltip(labelText As String) As String
	Select labelText
		Case "Total Thrust (T)": Return "Total rotor thrust T, dimensional force normal to the rotor disk reference."
		Case "Thrust Coef (CT)": Return "Thrust coefficient CT = T / [ρ A (ΩR)²]."
		Case "Shaft Power (P)": Return "Mechanical shaft power required by the rotor at the current operating point."
		Case "Air Power Coef (CPair)": Return "Air-power coefficient from the zBET energy balance: induced power, imposed axial-flow work, profile drag and translational profile work."
		Case "Total Torque (Q)": Return "Total aerodynamic rotor torque about the shaft."
		Case "Torque Coef (CQ)": Return "Torque coefficient CQ = Q / [ρ A (ΩR)² R]."
		Case "Induced Torque (CQi)": Return "Induced component of rotor torque associated with induced power."
		Case "Profile Drag Torque (CQ0)": Return "Profile-drag contribution to rotor torque from blade section drag."
		Case "In-Plane Drag (H)": Return "Rotor in-plane H force opposing the forward in-plane velocity component."
		Case "In-Plane Coef (CH)": Return "Non-dimensional in-plane H-force coefficient."
		Case "Side Force Coef (CY)": Return "Non-dimensional rotor side-force coefficient."
		Case "Pitch Moment Coef (CMy)": Return "Non-dimensional rotor pitching-moment coefficient about the y axis."
		Case "Roll Moment Coef (CMx)": Return "Non-dimensional rotor rolling-moment coefficient about the x axis."
		Case "Figure of Merit (FoM)": Return "Hover efficiency metric: ideal induced power divided by actual rotor power."
		Case "Effective L/D Ratio": Return "Power-based effective rotor L/D: (L/D)eff = μ·CT / CPair = T·Vx / Pair in forward flight."
		Case "Total Inflow Ratio (λ)": Return "Total non-dimensional axial inflow ratio through the rotor disk."
		Case "Induced Inflow Ratio (λi)": Return "Induced portion of the non-dimensional inflow ratio."
		Case "Longitudinal Inflow (Kx)": Return "Longitudinal first-harmonic inflow gradient coefficient Kx."
		Case "Lateral Inflow (Ky)": Return "Lateral first-harmonic inflow gradient coefficient Ky."
		Case "Wake Skew Angle (χ)": Return "Wake skew angle χ between the rotor wake axis and the rotor shaft reference."
		Case "Tip Mach (Hover)": Return "Blade-tip Mach number from rotational speed ΩR without forward-flight addition."
		Case "Advancing Tip Mach (Mat)": Return "Approximate Mach number at the advancing blade tip in forward flight."
		Case "Air Density (ρ)": Return "Ambient air density used by the aerodynamic calculation."
		Case "Ambient Pressure (p)": Return "Ambient static pressure from the active atmosphere condition."
		Case "Speed of Sound (a)": Return "Local speed of sound used for Mach and compressibility calculations."
		Case Else: Return labelText
	End Select
End Sub

' Text row for rotor names; numeric rows stay numeric-only.
Private Sub AddTextInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, evtName As String) As EditText
	Dim lbl As Label = CreateRowLabel(lblText, "lblRowTip_Click")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 30 / 100, tb * sc)
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	edt.Text = defVal
	edt.TextSize = 13 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	edt.SingleLine = True
	edt.ForceDoneButton = True
	pnl.AddView(edt, pnl.Width * 37 / 100, ib * sc, pnl.Width * 60 / 100, tb * sc)
	Return edt
End Sub

' Helper to create 30%x | 36%x | 20%x standard input rows
Private Sub AddFullInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, unitText As String, evtName As String) As EditText
	Dim lbl As Label = CreateRowLabel(lblText, "lblRowTip_Click")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 30 / 100, tb * sc)
	
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	edt.Text = defVal
	edt.TextSize = 13 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.HintColor = ColorEdtHint
	edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.CENTER_HORIZONTAL)
	edt.InputType = Bit.Or(edt.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edt.ForceDoneButton = True
	edt.SingleLine = True
	
	pnl.AddView(edt, pnl.Width * 37 / 100, ib * sc, pnl.Width * 36 / 100, tb * sc)
	
	Dim lblUnit As Label
	lblUnit.Initialize("")
	lblUnit.Text = unitText
	If root.Width <= 340dip Then lblUnit.TextSize = 11 Else lblUnit.TextSize = 12 * sc
	lblUnit.TextColor = ColorButText2
	lblUnit.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	lblUnit.SingleLine = True
	pnl.AddView(lblUnit, pnl.Width * 77 / 100, ib * sc, pnl.Width * 17 / 100, tb * sc)
	
	Return edt
End Sub

Private Sub CreateRowLabel(txt As String, evt As String) As Label
	Dim lbl As Label
	lbl.Initialize(evt)
	lbl.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then lbl.TextSize = 12 Else lbl.TextSize = 13 * sc
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextColor = ColorButText1
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lbl.SingleLine = True
	lbl.Tag = txt
	Return lbl
End Sub

Private Sub CreateRowButton(txt As String, evt As String) As Button
	Dim btn As Button
	btn.Initialize(evt)
	btn.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then btn.TextSize = 12 Else btn.TextSize = 13 * sc
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorButText1
	btn.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	Return btn
End Sub

' ====================================================================
' AEROCALCULATOR GRADIENTS & DRAWABLES
' ====================================================================
Sub ButtonGradient(ColorList() As Int, ColorList2() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("BOTTOM_TOP", ColorList2)
	gdwPressed.CornerRadius = 6dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("TOP_BOTTOM", ColorList)
	gdwPressed.CornerRadius = 12dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

' ====================================================================
' NATIVE PAGE NAVIGATION
' ====================================================================
Private Sub ShowPage(Position As Int, Animated As Boolean)
	If Position < 0 Or Position > 2 Then Position = 0
	CurrentPage = Position
	pnlBack0.Visible = (Position = 0)
	pnlBack1.Visible = (Position = 1)
	pnlBack2.Visible = (Position = 2)
	
	Dim tabW As Int = root.Width / 3
	Dim duration As Int = 0
	If Animated Then duration = 150
	line.SetLayoutAnimated(duration, Position * tabW, HeaderHeight - 5dip, tabW, 4dip)
	
	btnTabGeom.TextColor = ColorButText2
	btnTabCond.TextColor = ColorButText2
	btnTabRes.TextColor = ColorButText2
	
	Select Position
		Case 0
			btnTabGeom.TextColor = ColorButText3
		Case 1
			btnTabCond.TextColor = ColorButText3
		Case 2
			btnTabRes.TextColor = ColorButText3
			Dim p As Phone
			p.HideKeyboard(Activity)
			RecalculateRotor
	End Select
End Sub

Sub btnTabGeom_Click
	ShowPage(0, True)
End Sub

Sub btnTabCond_Click
	ShowPage(1, True)
End Sub

Sub btnTabRes_Click
	ShowPage(2, True)
End Sub

' ====================================================================
' AERODYNAMIC CALCULATION & TELEMETRY MAPPING
' ====================================================================
Public Sub RecalculateRotor
	If UpdatingUI Then Return
	ActiveRes = zBETEngine.Calculate(ActiveGeom, ActiveCond)
	
	If lblResultStatus.IsInitialized Then
		If ActiveRes.SolutionValid = False Then
			lblResultStatus.Text = "MODEL STATUS · INVALID OPERATING POINT"
			lblResultStatus.TextColor = 0xFFFF6B6B
			For i = 0 To 24
				If lblResults(i).IsInitialized Then lblResults(i).Text = "---"
			Next
			Return
		Else If ActiveRes.CompressibilityWarning Then
			lblResultStatus.Text = "MODEL STATUS · PG CAUTION (Mat ≥ 0.80)"
			lblResultStatus.TextColor = ColorAccentAmber
		Else
			lblResultStatus.Text = "MODEL STATUS · VALID"
			lblResultStatus.TextColor = ColorAccentGreen
		End If
	End If
	
	Dim tipMachHover As Double = 0
	Dim vtip As Double = RotorTipSpeed
	If ActiveCond.SpeedOfSound > 0 Then tipMachHover = vtip / ActiveCond.SpeedOfSound
	
	' Baseline precision is variable-specific. ExtraPrecision adds exactly one
	' decimal place, matching the AeroCalculator Output Format setting.
	If UnitSystem = 0 Then
		lblResults(0).Text = FormatOutputValue(ActiveRes.ThrustN, 0) & " N"
		lblResults(2).Text = FormatOutputValue(ActiveRes.PowerShaftKW, 1) & " kW"
		lblResults(4).Text = FormatOutputValue(ActiveRes.TorqueNm, 1) & " N·m"
		lblResults(8).Text = FormatOutputValue(ActiveRes.DragHN, 1) & " N"
	Else
		lblResults(0).Text = FormatOutputValue(ActiveRes.ThrustLbf, 0) & " lbf"
		lblResults(2).Text = FormatOutputValue(ActiveRes.PowerShaftHP, 1) & " hp"
		lblResults(4).Text = FormatOutputValue(ActiveRes.TorqueLbft, 1) & " lb·ft"
		lblResults(8).Text = FormatOutputValue(ActiveRes.DragHN * 0.224808943, 1) & " lbf"
	End If
	
	lblResults(1).Text = FormatOutputValue(ActiveRes.CT, 5)
	lblResults(3).Text = FormatOutputValue(ActiveRes.CPair, 6)
	lblResults(5).Text = FormatOutputValue(ActiveRes.CQ, 6)
	lblResults(6).Text = FormatOutputValue(ActiveRes.CQi, 6)
	lblResults(7).Text = FormatOutputValue(ActiveRes.CQ0, 6)
	lblResults(9).Text = FormatOutputValue(ActiveRes.CH, 6)
	lblResults(10).Text = FormatOutputValue(ActiveRes.CY, 6)
	lblResults(11).Text = FormatOutputValue(ActiveRes.CMy, 6)
	lblResults(12).Text = FormatOutputValue(ActiveRes.CMx, 6)
	lblResults(13).Text = FormatOutputValue(ActiveRes.FoM, 4)
	lblResults(14).Text = FormatOutputValue(ActiveRes.L_D_eff, 2)
	lblResults(15).Text = FormatOutputValue(ActiveRes.InflowLambda, 5)
	lblResults(16).Text = FormatOutputValue(ActiveRes.InflowLambdaI, 5)
	lblResults(17).Text = FormatOutputValue(ActiveRes.InflowKx, 3)
	lblResults(18).Text = FormatOutputValue(ActiveRes.InflowKy, 3)
	lblResults(19).Text = FormatOutputValue(ActiveRes.WakeSkewChiDeg, 1) & "°"
	lblResults(20).Text = FormatOutputValue(tipMachHover, 3)
	lblResults(21).Text = FormatOutputValue(ActiveRes.AdvancingTipMach, 3)
	If UnitSystem = 0 Then
		lblResults(22).Text = FormatOutputValue(ActiveCond.Rho, 4) & " kg/m³"
		lblResults(23).Text = FormatOutputValue(AmbientPressureHPa, 1) & " hPa"
		lblResults(24).Text = FormatOutputValue(ActiveCond.SpeedOfSound, 1) & " m/s"
	Else
		lblResults(22).Text = FormatOutputValue(ActiveCond.Rho * 0.0019403203, 5) & " slug/ft³"
		lblResults(23).Text = FormatOutputValue(AmbientPressureHPa * 0.0295299831, 2) & " inHg"
		lblResults(24).Text = FormatOutputValue(ActiveCond.SpeedOfSound * 3.280839895, 0) & " ft/s"
	End If
End Sub

Private Sub FormatOutputValue(Value As Double, BaseDigits As Int) As String
	Return FormatResultValue(Value, BaseDigits + ExtraPrecision)
End Sub

Private Sub FormatResultValue(Value As Double, FractionDigits As Int) As String
	Dim scale As Double = 1
	For i = 1 To FractionDigits
		scale = scale * 10
	Next
	If Abs(Value) < (0.5 / scale) Then Value = 0
	Return NumberFormat2(Value, 1, FractionDigits, FractionDigits, False)
End Sub

Public Sub LoadRotorDataToFields(geom As RotorGeometry)
	If edtRadius.IsInitialized = False Then Return
	UpdatingUI = True
	If edtRotorName.IsInitialized Then edtRotorName.Text = geom.Name
	edtRadius.Text = NumberFormat(geom.Radius, 1, 2)
	edtRPM.Text = NumberFormat(geom.RPM, 1, 1)
	edtNBlades.Text = geom.NBlades
	edtRootCutout.Text = NumberFormat(geom.RootCutout, 1, 3)
	edtChordRoot.Text = NumberFormat(geom.ChordRoot, 1, 4)
	edtChordTip.Text = NumberFormat(geom.ChordTip, 1, 4)
	edtThetaRoot.Text = NumberFormat(geom.ThetaRoot * 180.0 / cPI, 1, 2)
	edtThetaTip.Text = NumberFormat(geom.ThetaTip * 180.0 / cPI, 1, 2)
	edtLiftSlope.Text = NumberFormat(geom.LiftSlope0, 1, 2)
	edtCd0.Text = NumberFormat(geom.Cd0, 1, 4)
	
	RefreshTipLossButton(geom)
	btnSelectAirfoil.Text = AirfoilDisplayName(geom)
	
	If geom.UsePrandtlGlauert Then
		btnCompressibility.Text = "Prandtl-Glauert: ON"
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		btnCompressibility.Text = "Prandtl-Glauert: OFF"
		btnCompressibility.TextColor = ColorButText2
	End If
	
	UpdatingUI = False
End Sub

Private Sub RefreshTipLossButton(geom As RotorGeometry)
	Select geom.TipLossMode
		Case "sissingh"
			btnTipLoss.Text = "Sissingh: ON"
			btnTipLoss.TextColor = ColorAccentGreen
		Case "fixed"
			btnTipLoss.Text = "Fixed B=" & NumberFormat(geom.TipLossB, 1, 2)
			btnTipLoss.TextColor = ColorAccentCyan
		Case Else
			btnTipLoss.Text = "Tip Loss: OFF"
			btnTipLoss.TextColor = ColorButText2
	End Select
End Sub

Private Sub AirfoilDisplayName(geom As RotorGeometry) As String
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		If Abs(geom.LiftSlope0 - af.A0) < 0.001 And Abs(geom.Cd0 - af.Cd0) < 0.00001 Then Return af.Name
	Next
	Return "Custom Section"
End Sub

Private Sub LoadConditionDataToFields
	If ActiveCond.TargetThrustN > 0 And ActiveCond.TargetCT > 0 Then ActiveCond.TargetCT = 0
	UpdatingUI = True
	edtAltitude.Text = NumberFormat(ConditionAltitudeM, 1, 0)
	edtTemperature.Text = NumberFormat(ConditionTemperatureC, 1, 1)
	RefreshHorizontalInputDisplay
	RefreshAxialInputDisplay
	edtTargetThrust.Text = NumberFormat(ActiveCond.TargetThrustN, 1, 0)
	edtTargetCT.Text = NumberFormat(ActiveCond.TargetCT, 1, 5)
	
	Select ActiveCond.InflowModel
		Case "uniform": btnInflowModel.Text = "Uniform Benchmark"
		Case "coleman_simple": btnInflowModel.Text = "Coleman Simple"
		Case "drees": btnInflowModel.Text = "Drees Linear"
		Case Else: btnInflowModel.Text = "Coleman-Feingold"
	End Select
	Select ActiveCond.ProfileDragModel
		Case "analytical_tangential": btnProfileDragModel.Text = "Analytical Tangential"
		Case "analytical_vectorial": btnProfileDragModel.Text = "Analytical Vectorial"
		Case Else: btnProfileDragModel.Text = "Numerical Vectorial"
	End Select
	RefreshTrimControls
	UpdatingUI = False
	RefreshDerivedCondition(False)
End Sub

Private Sub RefreshHorizontalInputDisplay
	If btnHorizontalInput.IsInitialized = False Then Return
	If HorizontalInputMode = "vx" Then
		btnHorizontalInput.Text = "Vx"
		lblHorizontalUnit.Text = "m/s"
		edtHorizontalValue.Text = NumberFormat2(ConditionHorizontalValue, 1, 1, 1, False)
	Else
		HorizontalInputMode = "mu"
		btnHorizontalInput.Text = "μ"
		lblHorizontalUnit.Text = "[-]"
		edtHorizontalValue.Text = NumberFormat2(ConditionHorizontalValue, 1, 3, 3, False)
	End If
End Sub

Private Sub RefreshAxialInputDisplay
	If btnAxialInput.IsInitialized = False Then Return
	Select AxialInputMode
		Case "vz"
			btnAxialInput.Text = "Vz"
			lblAxialUnit.Text = "m/s"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 2, 2, False)
		Case "muz"
			btnAxialInput.Text = "μz"
			lblAxialUnit.Text = "[-]"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 4, 4, False)
		Case Else
			AxialInputMode = "alpha"
			btnAxialInput.Text = "α"
			lblAxialUnit.Text = "deg"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 2, 2, False)
	End Select
End Sub

Private Sub RotorTipSpeed As Double
	Dim omega As Double = ActiveGeom.RPM * (cPI / 30.0)
	Return omega * ActiveGeom.Radius
End Sub

Private Sub RefreshTrimControls
	If ActiveCond.HoverTrimMode = "rpm" Then
		If ActiveCond.TargetThrustN <= 0 Then ActiveCond.TargetThrustN = DefaultRPMTargetThrust
		ActiveCond.TargetCT = 0
		Dim wasUpdatingRpm As Boolean = UpdatingUI
		UpdatingUI = True
		If edtTargetThrust.IsInitialized Then edtTargetThrust.Text = NumberFormat(ActiveCond.TargetThrustN, 1, 0)
		If edtTargetCT.IsInitialized Then edtTargetCT.Text = "0"
		UpdatingUI = wasUpdatingRpm
		btnHoverTrimMode.Text = "RPM to Thrust"
		btnHoverTrimMode.TextColor = ColorAccentAmber
		edtTargetThrust.Enabled = True
		edtTargetCT.Enabled = False
		Return
	End If
	If ActiveCond.HoverTrimMode <> "none" And ActiveCond.TargetThrustN <= 0 And ActiveCond.TargetCT <= 0 Then
		ActiveCond.TargetCT = 0.0065
		If edtTargetCT.IsInitialized Then
			Dim wasUpdating As Boolean = UpdatingUI
			UpdatingUI = True
			edtTargetCT.Text = NumberFormat(ActiveCond.TargetCT, 1, 5)
			UpdatingUI = wasUpdating
		End If
	End If
	If ActiveCond.HoverTrimMode = "none" Then
		btnHoverTrimMode.Text = "Manual Pitch"
		btnHoverTrimMode.TextColor = ColorButText2
		edtTargetThrust.Enabled = False
		edtTargetCT.Enabled = False
	Else
		If ActiveCond.TargetThrustN > 0 Then
			btnHoverTrimMode.Text = "Collective to Thrust"
		Else
			btnHoverTrimMode.Text = "Collective to CT"
		End If
		btnHoverTrimMode.TextColor = ColorAccentGreen
		edtTargetThrust.Enabled = True
		edtTargetCT.Enabled = True
	End If
End Sub

Private Sub DefaultRPMTargetThrust As Double
	Dim tempCond As FlightCondition = zBETEngine.CloneCondition(ActiveCond)
	tempCond.HoverTrimMode = "none"
	tempCond.Mu = 0
	tempCond.MuZ = 0
	tempCond.TargetThrustN = 0
	tempCond.TargetCT = 0
	Dim natural As RotorResults = zBETEngine.Calculate(ActiveGeom, tempCond)
	If natural.SolutionValid And natural.ThrustN > 0 Then Return natural.ThrustN
	Dim vtip As Double = RotorTipSpeed
	Dim diskArea As Double = cPI * ActiveGeom.Radius * ActiveGeom.Radius
	Return 0.0065 * ActiveCond.Rho * diskArea * vtip * vtip
End Sub

Private Sub RefreshDerivedCondition(updateDisplayedValues As Boolean)
	Dim vtip As Double = RotorTipSpeed
	If vtip > 0 Then
		If HorizontalInputMode = "vx" Then
			ConditionHorizontalValue = ClampD(ConditionHorizontalValue, 0.0, 0.60 * vtip)
			ActiveCond.Mu = ConditionHorizontalValue / vtip
		Else
			ConditionHorizontalValue = ClampD(ConditionHorizontalValue, 0.0, 0.60)
			ActiveCond.Mu = ConditionHorizontalValue
		End If
		If AxialInputMode = "vz" Then
			ConditionAxialValue = ClampD(ConditionAxialValue, -0.50 * vtip, 0.50 * vtip)
		Else If AxialInputMode = "muz" Then
			ConditionAxialValue = ClampD(ConditionAxialValue, -0.50, 0.50)
		End If
		ActiveCond.MuZ = ClampD(zBETEngine.ResolveMuZ(ActiveCond.Mu, AxialInputMode, ConditionAxialValue, vtip), -0.50, 0.50)
	Else
		ActiveCond.Mu = 0.0
		ActiveCond.MuZ = 0.0
	End If
	If updateDisplayedValues Then
		Dim wasUpdating As Boolean = UpdatingUI
		UpdatingUI = True
		RefreshHorizontalInputDisplay
		RefreshAxialInputDisplay
		UpdatingUI = wasUpdating
	End If
End Sub

Private Sub RefreshRotorSpinner
	RefreshRotorList
End Sub

Sub btnSelectAirfoil_Click
	Dim options As List: options.Initialize
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		options.Add(af.Name & " (a0=" & af.A0 & ", Cd0=" & af.Cd0 & ")")
	Next
	Dim resIndex As Int = InputList(options, "Select Airfoil Section:", -1)
	If resIndex >= 0 Then
		Dim selAf As AirfoilData = RotorPopups.Airfoils.Get(resIndex)
		ActiveGeom.LiftSlope0 = selAf.A0
		ActiveGeom.Cd0 = selAf.Cd0
		Dim wasUpdating As Boolean = UpdatingUI
		UpdatingUI = True
		edtLiftSlope.Text = NumberFormat(selAf.A0, 1, 2)
		edtCd0.Text = NumberFormat(selAf.Cd0, 1, 4)
		UpdatingUI = wasUpdating
		btnSelectAirfoil.Text = selAf.Name
		RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
		RecalculateRotor
	End If
End Sub

Sub btnTipLoss_Click
	Dim options As List
	options.Initialize
	options.Add("Off (B = 1.00)")
	options.Add("Fixed B = " & NumberFormat(ActiveGeom.TipLossB, 1, 2))
	options.Add("Sissingh")
	
	Dim selected As Int = 0
	If ActiveGeom.TipLossMode = "fixed" Then selected = 1
	If ActiveGeom.TipLossMode = "sissingh" Then selected = 2
	
	Dim resIndex As Int = InputList(options, "Tip-Loss Model:", selected)
	If resIndex < 0 Then Return
	
	Select resIndex
		Case 0
			ActiveGeom.TipLossMode = "none"
		Case 1
			ActiveGeom.TipLossMode = "fixed"
			If ActiveGeom.TipLossB <= ActiveGeom.RootCutout Or ActiveGeom.TipLossB > 1.0 Then ActiveGeom.TipLossB = 0.97
		Case 2
			ActiveGeom.TipLossMode = "sissingh"
	End Select
	
	RefreshTipLossButton(ActiveGeom)
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	RecalculateRotor
End Sub

Sub btnCompressibility_Click
	ActiveGeom.UsePrandtlGlauert = Not(ActiveGeom.UsePrandtlGlauert)
	If ActiveGeom.UsePrandtlGlauert Then
		btnCompressibility.Text = "Prandtl-Glauert: ON"
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		btnCompressibility.Text = "Prandtl-Glauert: OFF"
		btnCompressibility.TextColor = ColorButText2
	End If
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	RecalculateRotor
End Sub

Sub btnInflowModel_Click
	Dim options As List
	options.Initialize
	options.Add("Uniform — benchmark")
	options.Add("Coleman Simple — longitudinal gradient")
	options.Add("Coleman-Feingold — longitudinal + lateral")
	options.Add("Drees — classical longitudinal + lateral")
	Dim selected As Int = 2
	Select ActiveCond.InflowModel
		Case "uniform": selected = 0
		Case "coleman_simple": selected = 1
		Case "drees": selected = 3
	End Select
	Dim idx As Int = InputList(options, "Inflow Model", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveCond.InflowModel = "uniform"
		Case 1: ActiveCond.InflowModel = "coleman_simple"
		Case 2: ActiveCond.InflowModel = "coleman_feingold"
		Case 3: ActiveCond.InflowModel = "drees"
	End Select
	LoadConditionDataToFields
	RecalculateRotor
End Sub

Sub btnProfileDragModel_Click
	Dim options As List
	options.Initialize
	options.Add("Analytical Tangential — low-order")
	options.Add("Analytical Vectorial — low-order vector speed")
	options.Add("Numerical Vectorial — azimuth/radius quadrature")
	Dim selected As Int = 2
	If ActiveCond.ProfileDragModel = "analytical_tangential" Then selected = 0
	If ActiveCond.ProfileDragModel = "analytical_vectorial" Then selected = 1
	Dim idx As Int = InputList(options, "Profile Drag Model", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveCond.ProfileDragModel = "analytical_tangential"
		Case 1: ActiveCond.ProfileDragModel = "analytical_vectorial"
		Case 2: ActiveCond.ProfileDragModel = "numerical_vectorial"
	End Select
	LoadConditionDataToFields
	RecalculateRotor
End Sub

Sub btnHoverTrimMode_Click
	Dim options As List
	options.Initialize
	options.Add("Manual Pitch — no trim")
	options.Add("Collective to Target — fixed RPM")
	options.Add("RPM to Thrust — fixed pitch")
	Dim selected As Int = 1
	If ActiveCond.HoverTrimMode = "none" Then selected = 0
	If ActiveCond.HoverTrimMode = "rpm" Then selected = 2
	Dim idx As Int = InputList(options, "Trim Mode", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveCond.HoverTrimMode = "none"
		Case 1: ActiveCond.HoverTrimMode = "collective"
		Case 2: ActiveCond.HoverTrimMode = "rpm"
	End Select
	RefreshTrimControls
	RecalculateRotor
End Sub

Sub lblRowTip_Click
	Dim b As Label = Sender
	Dim tipMsg As String = ""
	Select b.Tag
		Case "Rotor Name"
			tipMsg = "Editable name stored with this rotor geometry."
		Case "Radius R"
			tipMsg = "Rotor radius R measured from hub centerline to blade tip in meters."
		Case "Rotor RPM"
			tipMsg = "Rotational speed of rotor in revolutions per minute (RPM)."
		Case "Blade Count"
			tipMsg = "Number of blades Nb forming the rotor disk."
		Case "Root Cutout"
			tipMsg = "Non-dimensional radius r0/R where blade aerodynamic profile starts."
		Case "Root Chord", "Tip Chord"
			tipMsg = "Blade chord c in meters at root and tip stations (linear taper)."
		Case "θ Root Pitch", "θ Tip Pitch"
			tipMsg = "Blade pitch angle theta at root and tip stations (linear twist)."
		Case "Lift Slope a0"
			tipMsg = "Sectional 2D lift curve slope dCl/dalpha (nominal 5.73 1/rad)."
		Case "Profile Cd0"
			tipMsg = "Baseline profile drag coefficient at zero angle of attack."
		Case "Altitude"
			tipMsg = "Pressure altitude above mean sea level according to standard ISA."
		Case "Temperature"
			tipMsg = "Ambient air temperature in degrees Celsius (ISA default 15°C)."
		Case "Horizontal Flow"
			Msgbox("Choose one equivalent horizontal-flow representation:" & CRLF & CRLF & _
				"μ = Vx/(ΩR), dimensionless advance ratio." & CRLF & _
				"Vx > 0 is forward in-plane free-stream velocity." & CRLF & CRLF & _
				"The selected representation is authoritative; the other is derived from the current rotor tip speed ΩR.", "Horizontal Flow Convention")
			Return
		Case "Axial Flow"
			Msgbox("zBET / zBEMT axial convention:" & CRLF & CRLF & _
				"+z and +Vz are downward through the rotor disk." & CRLF & _
				"μz = Vz/(ΩR), so μz > 0 is also downward." & CRLF & _
				"Rotor angle of attack α is positive when the stream arrives from below." & CRLF & _
				"Therefore μz = -μ·tan(α)." & CRLF & CRLF & _
				"At Vx = 0, use Vz or μz for nonzero axial flow.", "Axial Flow Convention")
			Return
		Case "Target Thrust"
			tipMsg = "Desired total thrust T in Newtons for hover/forward trim."
		Case "Target CT"
			tipMsg = "Desired thrust coefficient CT = T / (ρ·A·(ΩR)²)."
		Case "Rotor Preset"
			tipMsg = "Stored rotor geometry preset. Select a factory rotor or a duplicated custom configuration."
		Case "Airfoil"
			tipMsg = "Blade section aerodynamic model. Selecting an airfoil updates the sectional lift slope and profile drag data."
		Case "Tip Loss"
			tipMsg = "Finite-blade tip-loss correction. Sissingh reduces the ideal loading near the blade tip."
		Case "Compressibility"
			tipMsg = "Compressibility correction applied to sectional aerodynamics as local Mach number increases."
		Case "Inflow Model"
			Msgbox("Uniform: uniform induced velocity; useful as the baseline model." & CRLF & CRLF & _
				"Coleman Simple: adds a longitudinal first-harmonic inflow gradient from wake skew." & CRLF & CRLF & _
				"Coleman-Feingold (NDARC): longitudinal plus lateral harmonic gradients; appropriate for broad forward-flight trade studies." & CRLF & CRLF & _
				"Drees: classical longitudinal and lateral gradients with explicit μ dependence.", "Inflow Models")
			Return
		Case "Profile Drag"
			Msgbox("Analytical Tangential: lowest-order tangential drag approximation." & CRLF & CRLF & _
				"Analytical Vectorial: low-order expansion using the local velocity magnitude." & CRLF & CRLF & _
				"Numerical Vectorial: radial/azimuthal quadrature of vector profile drag; highest-fidelity option in this model.", "Profile Drag Models")
			Return
		Case "Hover Trim"
			Msgbox("Manual Pitch: RPM and blade pitch are prescribed." & CRLF & CRLF & _
				"Collective to Target: fixed RPM; collective shifts to meet Target Thrust or Target CT." & CRLF & CRLF & _
				"RPM to Thrust: fixed pitch; RPM changes to meet dimensional Target Thrust.", "Trim Modes")
			Return
		Case Else
			tipMsg = b.Tag
	End Select
	ToastMessageShow(tipMsg, True)
End Sub

Sub btnUnit_Click
	Dim b As Button = Sender
	ToastMessageShow("Input unit: " & b.Tag & " (inputs use SI)", False)
End Sub

Sub edtGeom_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	If edtRotorName.IsInitialized And edtRotorName.Text.Trim <> "" Then
		Dim newName As String = edtRotorName.Text.Trim
		newName = newName.Replace("|", "/").Replace(CR, " ").Replace(LF, " ")
		If newName.Length > 40 Then newName = newName.SubString2(0, 40)
		ActiveGeom.Name = newName
	End If
	ActiveGeom.Radius = ClampD(ParseDoubleDef(edtRadius.Text, ActiveGeom.Radius), 0.02, 50.0)
	ActiveGeom.RPM = ClampD(ParseDoubleDef(edtRPM.Text, ActiveGeom.RPM), 1.0, 30000.0)
	ActiveGeom.NBlades = Max(1, Min(16, ParseIntDef(edtNBlades.Text, ActiveGeom.NBlades)))
	ActiveGeom.RootCutout = ClampD(ParseDoubleDef(edtRootCutout.Text, ActiveGeom.RootCutout), 0.0, 0.95)
	ActiveGeom.ChordRoot = ClampD(ParseDoubleDef(edtChordRoot.Text, ActiveGeom.ChordRoot), 0.0001, 2.0 * ActiveGeom.Radius)
	ActiveGeom.ChordTip = ClampD(ParseDoubleDef(edtChordTip.Text, ActiveGeom.ChordTip), 0.0001, 2.0 * ActiveGeom.Radius)
	ActiveGeom.SolidityMode = "chords"
	
	Dim thRootDeg As Double = ClampD(ParseDoubleDef(edtThetaRoot.Text, 12.0), -90.0, 90.0)
	Dim thTipDeg As Double = ClampD(ParseDoubleDef(edtThetaTip.Text, 4.0), -90.0, 90.0)
	ActiveGeom.ThetaRoot = thRootDeg * cPI / 180.0
	ActiveGeom.ThetaTip = thTipDeg * cPI / 180.0
	ActiveGeom.PitchMode = "linear_twist"
	
	ActiveGeom.LiftSlope0 = ClampD(ParseDoubleDef(edtLiftSlope.Text, ActiveGeom.LiftSlope0), 0.1, 10.0)
	ActiveGeom.Cd0 = ClampD(ParseDoubleDef(edtCd0.Text, ActiveGeom.Cd0), 0.0, 0.5)
	ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
	If lblGeomPopupTitle.IsInitialized Then lblGeomPopupTitle.Text = ActiveGeom.Name
	btnSelectAirfoil.Text = AirfoilDisplayName(ActiveGeom)
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	RefreshDerivedCondition(True)
	RecalculateRotor
End Sub

Sub edtGeom_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then
		LoadRotorDataToFields(ActiveGeom)
		RefreshRotorList
	End If
End Sub

Sub edtCond_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ConditionAltitudeM = ClampD(ParseDoubleDef(edtAltitude.Text, ConditionAltitudeM), -500.0, 11000.0)
	ConditionTemperatureC = ClampD(ParseDoubleDef(edtTemperature.Text, ConditionTemperatureC), -80.0, 60.0)
	
	Dim pRatio As Double = Power(1.0 - 0.0065 * ConditionAltitudeM / 288.15, 5.2561)
	AmbientPressureHPa = 1013.25 * pRatio
	Dim tKelvin As Double = ConditionTemperatureC + 273.15
	ActiveCond.Rho = (AmbientPressureHPa * 100.0) / (287.058 * tKelvin)
	ActiveCond.SpeedOfSound = Sqrt(1.4 * 287.058 * tKelvin)
	
	ActiveCond.TargetThrustN = ClampD(ParseDoubleDef(edtTargetThrust.Text, ActiveCond.TargetThrustN), 0.0, 1.0e8)
	ActiveCond.TargetCT = ClampD(ParseDoubleDef(edtTargetCT.Text, ActiveCond.TargetCT), 0.0, 0.20)
	
	Dim changedField As String = ""
	Try
		Dim changedEdit As EditText = Sender
		changedField = changedEdit.Tag
	Catch
	End Try
	If changedField = "Target Thrust" And ActiveCond.TargetThrustN > 0 Then
		ActiveCond.TargetCT = 0
		UpdatingUI = True
		edtTargetCT.Text = "0"
		UpdatingUI = False
	Else If changedField = "Target CT" And ActiveCond.TargetCT > 0 Then
		ActiveCond.TargetThrustN = 0
		UpdatingUI = True
		edtTargetThrust.Text = "0"
		UpdatingUI = False
	End If
	If changedField = "Target Thrust" Or changedField = "Target CT" Then RefreshTrimControls
	RecalculateRotor
End Sub

Sub edtHorizontalValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim raw As Double = ParseDoubleDef(edtHorizontalValue.Text, ConditionHorizontalValue)
	If HorizontalInputMode = "vx" Then
		Dim vtip As Double = RotorTipSpeed
		ConditionHorizontalValue = ClampD(raw, 0.0, 0.60 * Max(1.0, vtip))
	Else
		ConditionHorizontalValue = ClampD(raw, 0.0, 0.60)
	End If
	RefreshDerivedCondition(False)
	RecalculateRotor
End Sub

Sub edtAxialValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim raw As Double = ParseDoubleDef(edtAxialValue.Text, ConditionAxialValue)
	Select AxialInputMode
		Case "alpha": ConditionAxialValue = ClampD(raw, -30.0, 30.0)
		Case "vz": ConditionAxialValue = ClampD(raw, -80.0, 80.0)
		Case "muz": ConditionAxialValue = ClampD(raw, -0.50, 0.50)
	End Select
	RefreshDerivedCondition(False)
	RecalculateRotor
End Sub

Sub btnHorizontalInput_Click
	Dim options As List
	options.Initialize
	options.Add("μ — advance ratio = Vx/(ΩR)")
	options.Add("Vx — forward in-plane speed [m/s]")
	Dim selected As Int = 0
	If HorizontalInputMode = "vx" Then selected = 1
	Dim idx As Int = InputList(options, "Horizontal Flow · zBET convention", selected)
	If idx < 0 Then Return
	Dim vtip As Double = RotorTipSpeed
	If idx = 0 Then
		HorizontalInputMode = "mu"
		ConditionHorizontalValue = ActiveCond.Mu
	Else
		HorizontalInputMode = "vx"
		ConditionHorizontalValue = ActiveCond.Mu * vtip
	End If
	UpdatingUI = True
	RefreshHorizontalInputDisplay
	UpdatingUI = False
	ToastMessageShow("Horizontal flow: +Vx is forward; μ = Vx/(ΩR).", False)
End Sub

Sub btnAxialInput_Click
	Dim options As List
	options.Initialize
	options.Add("α — rotor angle of attack [+ stream from below]")
	options.Add("Vz — axial flow [+ downward through disk] [m/s]")
	options.Add("μz — axial ratio [+ downward through disk]")
	Dim selected As Int = 0
	If AxialInputMode = "vz" Then selected = 1
	If AxialInputMode = "muz" Then selected = 2
	Dim idx As Int = InputList(options, "Axial Flow · zBET / zBEMT convention", selected)
	If idx < 0 Then Return
	Dim oldMuZ As Double = ActiveCond.MuZ
	Dim vtip As Double = RotorTipSpeed
	If idx = 0 Then
		If Abs(ActiveCond.Mu) < 1e-8 And Abs(oldMuZ) > 1e-10 Then
			ToastMessageShow("α is undefined at Vx = 0 for nonzero axial flow. Use Vz or μz.", True)
			Return
		End If
		AxialInputMode = "alpha"
		ConditionAxialValue = zBETEngine.AlphaFromMuZ(ActiveCond.Mu, oldMuZ)
	Else If idx = 1 Then
		AxialInputMode = "vz"
		ConditionAxialValue = zBETEngine.VzFromMuZ(oldMuZ, vtip)
	Else
		AxialInputMode = "muz"
		ConditionAxialValue = oldMuZ
	End If
	UpdatingUI = True
	RefreshAxialInputDisplay
	UpdatingUI = False
	RefreshDerivedCondition(False)
	RecalculateRotor
	ShowAxialConventionHint
End Sub

Private Sub ShowAxialConventionHint
	Select AxialInputMode
		Case "alpha": ToastMessageShow("α > 0: stream arrives from below; μz = -μ·tan(α).", True)
		Case "vz": ToastMessageShow("Vz > 0 is downward through the disk; μz = Vz/(ΩR).", True)
		Case Else: ToastMessageShow("μz > 0 is imposed flow downward through the disk.", True)
	End Select
End Sub

Sub edtCond_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtHorizontalValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtAxialValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then
		LoadConditionDataToFields
		If AxialInputMode = "alpha" And Abs(ActiveCond.Mu) < 1e-8 And Abs(ConditionAxialValue) > 1e-8 Then
			ToastMessageShow("At Vx = 0, α does not define nonzero axial flow; use Vz or μz.", True)
		End If
	End If
End Sub

' ====================================================================
' SWEEP POPUP (Multi-Parameter μ-Sweep)
' ====================================================================
Sub btnViewPolarPlot_Click
	If SweepPopupOpen Then CloseSweepPopup
	pnlSweepPopup.Initialize("pnlSweepPopup")
	pnlSweepPopup.Color = ColorPnlInput5
	root.AddView(pnlSweepPopup, 0, 0, root.Width, root.Height)
	SweepPopupOpen = True
	pnlSweepPopup.BringToFront
	
	Dim topBarH As Int
	If ld = 1 Then topBarH = 48dip Else topBarH = 48dip * sc
	Dim footerH As Int
	If ld = 1 Then footerH = 50dip Else footerH = 94dip * sc
	
	Dim pnlHeader As Panel: pnlHeader.Initialize("")
	pnlHeader.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlHeader, 0, 0, root.Width, topBarH)
	
	Dim lblTitle As Label: lblTitle.Initialize("")
	lblTitle.Text = "PARAMETER SWEEP"
	lblTitle.TextColor = ColorAccentCyan
	If root.Width <= 340dip Then lblTitle.TextSize = 12 Else lblTitle.TextSize = 14 * sc
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.Gravity = Gravity.CENTER_VERTICAL
	pnlHeader.AddView(lblTitle, 12dip, 0, root.Width - 60dip, topBarH)
	
	Dim btnClose As Button: btnClose.Initialize("btnCloseSweepPlot")
	btnClose.Text = "×"
	btnClose.TextColor = 0xFFFF5252
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	pnlHeader.AddView(btnClose, root.Width - 52dip, 0, 48dip, topBarH)
	
	Dim pnlControls As Panel: pnlControls.Initialize("")
	pnlControls.Color = ColorPnlInput2
	Dim controlsH As Int
	If ld = 1 Then controlsH = 58dip Else controlsH = 122dip * sc
	pnlSweepPopup.AddView(pnlControls, 0, topBarH, root.Width, controlsH)
	
	spnSweepParam.Initialize("spnSweepParam")
	spnSweepParam.DropdownBackgroundColor = ColorPnlTitle
	spnSweepParam.DropdownTextColor = ColorTitleText
	spnSweepParam.TextColor = ColorTitleText
	spnSweepParam.TextSize = 12 * sc
	
	btnSweepMultiModel.Initialize("btnSweepMultiModel")
	UpdateSweepMultiButtonText
	btnSweepMultiModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	If root.Width <= 340dip Then btnSweepMultiModel.TextSize = 10.5 Else btnSweepMultiModel.TextSize = 11 * sc
	
	btnSweepXAxis.Initialize("btnSweepXAxis")
	UpdateSweepXAxisButtonText
	btnSweepXAxis.TextColor = ColorAccentGreen
	btnSweepXAxis.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	If root.Width <= 340dip Then btnSweepXAxis.TextSize = 10.5 Else btnSweepXAxis.TextSize = 11 * sc
	
	btnSweepMaxMu.Initialize("btnSweepMaxMu")
	UpdateSweepMaxButtonText
	btnSweepMaxMu.TextColor = ColorAccentAmber
	btnSweepMaxMu.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	If root.Width <= 340dip Then btnSweepMaxMu.TextSize = 10.5 Else btnSweepMaxMu.TextSize = 11 * sc
	
	If ld = 1 Then
		' Landscape: one compact control row maximizes useful plot height.
		Dim gap As Int = 6dip
		Dim usableW As Int = root.Width - 24dip
		Dim paramW As Int = usableW * 0.32
		Dim modeW As Int = usableW * 0.32
		Dim axisW As Int = usableW * 0.16
		Dim maxW As Int = usableW - paramW - modeW - axisW - 3 * gap
		pnlControls.AddView(spnSweepParam, 12dip, 5dip, paramW, 48dip)
		pnlControls.AddView(btnSweepMultiModel, 12dip + paramW + gap, 5dip, modeW, 48dip)
		pnlControls.AddView(btnSweepXAxis, 12dip + paramW + gap + modeW + gap, 5dip, axisW, 48dip)
		pnlControls.AddView(btnSweepMaxMu, 12dip + paramW + gap + modeW + gap + axisW + gap, 5dip, maxW, 48dip)
	Else
		Dim lblParamH As Label: lblParamH.Initialize("")
		lblParamH.Text = "Y-AXIS PARAMETER"
		lblParamH.TextColor = ColorButText2
		If root.Width <= 340dip Then lblParamH.TextSize = 10 Else lblParamH.TextSize = 11 * sc
		lblParamH.Typeface = Typeface.DEFAULT_BOLD
		pnlControls.AddView(lblParamH, 12dip, 4dip, root.Width - 24dip, 16dip * sc)
		
		pnlControls.AddView(spnSweepParam, 12dip, 22dip * sc, root.Width - 24dip, 48dip * sc)
		Dim rowW As Int = root.Width - 30dip
		Dim modeW As Int = rowW * 0.50
		Dim axisW As Int = rowW * 0.23
		Dim maxW As Int = rowW - modeW - axisW - 12dip
		pnlControls.AddView(btnSweepMultiModel, 12dip, 72dip * sc, modeW, 48dip * sc)
		pnlControls.AddView(btnSweepXAxis, 18dip + modeW, 72dip * sc, axisW, 48dip * sc)
		pnlControls.AddView(btnSweepMaxMu, 24dip + modeW + axisW, 72dip * sc, maxW, 48dip * sc)
	End If
	
	spnSweepParam.Clear
	For i = 0 To RotorPopups.SweepParamLabels.Size - 1
		spnSweepParam.Add(RotorPopups.SweepParamLabels.Get(i))
	Next
	
	Dim curIdx As Int = 0
	For i = 0 To RotorPopups.SweepParamKeys.Size - 1
		If RotorPopups.SweepParamKeys.Get(i) = SweepParamSelectedKey Then
			curIdx = i
			Exit
		End If
	Next
	spnSweepParam.SelectedIndex = curIdx
	
	Dim plotTop As Int = topBarH + controlsH + 2dip
	Dim plotW As Int = root.Width - 16dip
	Dim plotH As Int = root.Height - plotTop - footerH - 2dip
	If plotH < 120dip Then plotH = 120dip
	
	ivSweepPlot.Initialize("")
	pnlSweepPopup.AddView(ivSweepPlot, 8dip, plotTop, plotW, plotH)
	
	Dim pnlFooter As Panel: pnlFooter.Initialize("")
	pnlFooter.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlFooter, 0, root.Height - footerH, root.Width, footerH)
	
	lblSweepCurrentVal.Initialize("")
	lblSweepCurrentVal.TextColor = ColorAccentAmber
	If root.Width <= 340dip Then lblSweepCurrentVal.TextSize = 9.5 Else lblSweepCurrentVal.TextSize = 10.5 * sc
	lblSweepCurrentVal.Typeface = Typeface.DEFAULT_BOLD
	lblSweepCurrentVal.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblSweepCurrentVal.SingleLine = True
	
	Dim btnTable As Button: btnTable.Initialize("btnSweepTable")
	btnTable.Text = "TABLE"
	btnTable.TextColor = ColorAccentCyan
	btnTable.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnTable.Typeface = Typeface.DEFAULT_BOLD
	Dim btnCsv As Button: btnCsv.Initialize("btnSweepExportCsv")
	btnCsv.Text = "CSV"
	btnCsv.TextColor = ColorAccentGreen
	btnCsv.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnCsv.Typeface = Typeface.DEFAULT_BOLD
	Dim btnPng As Button: btnPng.Initialize("btnSweepExportPng")
	btnPng.Text = "PNG"
	btnPng.TextColor = ColorAccentGreen
	btnPng.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnPng.Typeface = Typeface.DEFAULT_BOLD
	If root.Width <= 340dip Then
		btnTable.TextSize = 10
		btnCsv.TextSize = 10
		btnPng.TextSize = 10
	Else
		btnTable.TextSize = 11 * sc
		btnCsv.TextSize = 11 * sc
		btnPng.TextSize = 11 * sc
	End If
	
	If ld = 1 Then
		Dim infoW As Int = root.Width * 0.38
		pnlFooter.AddView(lblSweepCurrentVal, 10dip, 0, infoW - 12dip, footerH)
		Dim actionLeft As Int = infoW
		Dim actionGap As Int = 5dip
		Dim actionW As Int = (root.Width - actionLeft - 16dip - 2 * actionGap) / 3
		pnlFooter.AddView(btnTable, actionLeft, 1dip, actionW, 48dip)
		pnlFooter.AddView(btnCsv, actionLeft + actionW + actionGap, 1dip, actionW, 48dip)
		pnlFooter.AddView(btnPng, actionLeft + 2 * (actionW + actionGap), 1dip, actionW, 48dip)
	Else
		pnlFooter.AddView(lblSweepCurrentVal, 12dip, 0, root.Width - 24dip, 34dip * sc)
		Dim actionGap As Int = 6dip
		Dim actionW As Int = (root.Width - 24dip - 2 * actionGap) / 3
		Dim actionY As Int = 36dip * sc
		pnlFooter.AddView(btnTable, 12dip, actionY, actionW, 48dip * sc)
		pnlFooter.AddView(btnCsv, 12dip + actionW + actionGap, actionY, actionW, 48dip * sc)
		pnlFooter.AddView(btnPng, 12dip + 2 * (actionW + actionGap), actionY, actionW, 48dip * sc)
	End If
	
	UpdateSweepPlotView
End Sub

Sub spnSweepParam_ItemClick(Position As Int, Value As Object)
	If Position >= 0 And Position < RotorPopups.SweepParamKeys.Size Then
		SweepParamSelectedKey = RotorPopups.SweepParamKeys.Get(Position)
		SweepParamSelectedLabel = RotorPopups.SweepParamLabels.Get(Position)
		UpdateSweepPlotView
	End If
End Sub

Sub btnSweepMultiModel_Click
	Dim options As List
	options.Initialize
	options.Add("Inflow Models — 4 curves")
	options.Add("Rotor α — 5 curves")
	options.Add("Axial Vz — 5 curves")
	options.Add("Axial μz — 5 curves")
	options.Add("Single Active Condition")
	Dim idx As Int = InputList(options, "Curve Family", SweepMultiMode)
	If idx < 0 Then Return
	SweepMultiMode = idx
	UpdateSweepMultiButtonText
	UpdateSweepPlotView
End Sub

Private Sub UpdateSweepMultiButtonText
	Select SweepMultiMode
		Case 0
			btnSweepMultiModel.Text = "Inflow Models (4)"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 1
			btnSweepMultiModel.Text = "α Family (5)"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 2
			btnSweepMultiModel.Text = "Vz Family (5)"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 3
			btnSweepMultiModel.Text = "μz Family (5)"
			btnSweepMultiModel.TextColor = ColorAccentCyan
		Case 4
			btnSweepMultiModel.Text = "Active Only"
			btnSweepMultiModel.TextColor = ColorButText2
	End Select
End Sub

Sub btnSweepXAxis_Click
	SweepXAxisMode = 1 - SweepXAxisMode
	UpdateSweepXAxisButtonText
	UpdateSweepMaxButtonText
	UpdateSweepPlotView
End Sub

Private Sub UpdateSweepXAxisButtonText
	If btnSweepXAxis.IsInitialized = False Then Return
	If SweepXAxisMode = 1 Then
		btnSweepXAxis.Text = "X: Vx"
	Else
		btnSweepXAxis.Text = "X: μ"
	End If
End Sub

Sub btnSweepMaxMu_Click
	If SweepMaxMuVal < 0.45 Then
		SweepMaxMuVal = 0.50
	Else
		SweepMaxMuVal = 0.40
	End If
	UpdateSweepMaxButtonText
	UpdateSweepPlotView
End Sub

Private Sub UpdateSweepMaxButtonText
	If btnSweepMaxMu.IsInitialized = False Then Return
	If SweepXAxisMode = 1 Then
		btnSweepMaxMu.Text = "Vx max " & NumberFormat2(SweepMaxMuVal * RotorTipSpeed, 1, 0, 0, False)
	Else
		btnSweepMaxMu.Text = "μ max " & NumberFormat2(SweepMaxMuVal, 1, 2, 2, False)
	End If
End Sub

Sub btnCloseSweepPlot_Click
	CloseSweepPopup
End Sub

Private Sub CloseSweepPopup
	If SweepPopupOpen Then
		pnlSweepPopup.RemoveView
		SweepPopupOpen = False
	End If
End Sub

Sub UpdateSweepPlotView
	If ivSweepPlot.IsInitialized = False Then Return
	Dim plotW As Int = ivSweepPlot.Width
	Dim plotH As Int = ivSweepPlot.Height
	If plotW <= 10 Then plotW = root.Width - 16dip
	If plotH <= 10 Then plotH = 300dip
	
	Dim bmp As Bitmap = RotorPopups.DrawSweepPlot( _
		plotW, plotH, ActiveGeom, ActiveCond, SweepParamSelectedKey, SweepParamSelectedLabel, _
		SweepMultiMode, SweepMaxMuVal, ActiveCond.Mu, AxialInputMode, ConditionAxialValue, _
		SweepXAxisMode, ThemeMode = 1)
	ivSweepPlot.Bitmap = bmp
	
	Dim vx As Double = ActiveCond.Mu * RotorTipSpeed
	lblSweepCurrentVal.Text = "ACTIVE · μ=" & NumberFormat2(ActiveCond.Mu, 1, 2, 2, False) & " · Vx=" & NumberFormat2(vx, 1, 1, 1, False) & " m/s · μz=" & NumberFormat2(ActiveCond.MuZ, 1, 3, 3, False)
End Sub

Sub btnSweepTable_Click
	Dim sb As StringBuilder: sb.Initialize
	Dim xLabel As String = "μ"
	If SweepXAxisMode = 1 Then xLabel = "Vx [m/s]"
	sb.Append(xLabel).Append(TAB).Append(SweepParamSelectedKey).Append(CRLF)
	sb.Append("----------------------------------------").Append(CRLF)
	
	Dim tempCond As FlightCondition = zBETEngine.CloneCondition(ActiveCond)
	Dim vtip As Double = RotorTipSpeed
	If vtip < 1.0 Then vtip = 1.0
	Dim digits As Int = RotorPopups.SweepParamDigits(SweepParamSelectedKey) + ExtraPrecision
	For i = 0 To 10
		Dim mu As Double = i * (SweepMaxMuVal / 10.0)
		tempCond.Mu = mu
		tempCond.MuZ = zBETEngine.ResolveMuZ(mu, AxialInputMode, ConditionAxialValue, vtip)
		Dim res As RotorResults = zBETEngine.Calculate(ActiveGeom, tempCond)
		Dim xVal As Double = mu
		If SweepXAxisMode = 1 Then xVal = mu * vtip
		Dim xDigits As Int = 2
		If SweepXAxisMode = 1 Then xDigits = 1
		If res.SolutionValid Then
			Dim v As Double = RotorPopups.ExtractParamValue(res, SweepParamSelectedKey)
			sb.Append(FormatResultValue(xVal, xDigits)).Append(TAB).Append(TAB).Append(FormatResultValue(v, digits)).Append(CRLF)
		Else
			sb.Append(FormatResultValue(xVal, xDigits)).Append(TAB).Append(TAB).Append("INVALID").Append(CRLF)
		End If
	Next
	
	Msgbox(sb.ToString, "Active Data Table: " & SweepParamSelectedKey)
End Sub

' ====================================================================
' SWEEP EXPORT — Android Storage Access Framework, no storage permission
' ====================================================================
Sub btnSweepExportCsv_Click
	Dim csv As String = BuildSweepCsv
	Dim tempName As String = "rotor_sweep_export.csv"
	File.WriteString(File.DirInternal, tempName, csv)
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "text/csv", SweepExportBaseName & ".csv")) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("CSV exported.", False)
	Else
		ToastMessageShow("CSV export canceled or failed.", False)
	End If
End Sub

Sub btnSweepExportPng_Click
	If ivSweepPlot.IsInitialized = False Then Return
	Dim bmp As Bitmap = ivSweepPlot.Bitmap
	If bmp.IsInitialized = False Then Return
	Dim tempName As String = "rotor_sweep_export.png"
	Dim out As OutputStream = File.OpenOutput(File.DirInternal, tempName, False)
	bmp.WriteToStream(out, 100, "PNG")
	out.Close
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "image/png", SweepExportBaseName & ".png")) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("PNG exported.", False)
	Else
		ToastMessageShow("PNG export canceled or failed.", False)
	End If
End Sub

Private Sub SweepExportBaseName As String
	Dim n As String = ActiveGeom.Name.Trim.ToLowerCase
	n = n.Replace(" ", "_").Replace("/", "_").Replace(Chr(92), "_").Replace(":", "_").Replace("|", "_")
	If n = "" Then n = "rotor"
	Return n & "_" & SweepParamSelectedKey.ToLowerCase & "_sweep"
End Sub

Private Sub BuildSweepCsv As String
	Dim sb As StringBuilder
	sb.Initialize
	sb.Append("curve,x_axis,x_value,mu,Vx_m_s,axial_mode,axial_input,mu_z,inflow_model,parameter,value,status").Append(CRLF)
	Dim vtip As Double = RotorTipSpeed
	If vtip < 1.0 Then vtip = 1.0
	Dim nPoints As Int = 25
	Dim nCurves As Int = 1
	Select SweepMultiMode
		Case 0: nCurves = 4
		Case 1, 2, 3: nCurves = 5
	End Select
	
	For cIdx = 0 To nCurves - 1
		Dim tempCond As FlightCondition = zBETEngine.CloneCondition(ActiveCond)
		Dim curveAxialMode As String = AxialInputMode
		Dim curveAxialValue As Double = ConditionAxialValue
		Dim curveLabel As String = "Active"
		Select SweepMultiMode
			Case 0
				Select cIdx
					Case 0: tempCond.InflowModel = "uniform": curveLabel = "Uniform"
					Case 1: tempCond.InflowModel = "coleman_simple": curveLabel = "Coleman Simple"
					Case 2: tempCond.InflowModel = "coleman_feingold": curveLabel = "Coleman-Feingold"
					Case 3: tempCond.InflowModel = "drees": curveLabel = "Drees"
				End Select
			Case 1
				curveAxialMode = "alpha"
				Dim valsA() As Double = Array As Double(-10, -5, 0, 5, 10)
				curveAxialValue = valsA(cIdx)
				curveLabel = "alpha=" & NumberFormat2(curveAxialValue, 1, 0, 0, False) & " deg"
			Case 2
				curveAxialMode = "vz"
				Dim valsV() As Double = Array As Double(-10, -5, 0, 5, 10)
				curveAxialValue = valsV(cIdx)
				curveLabel = "Vz=" & NumberFormat2(curveAxialValue, 1, 0, 0, False) & " m/s"
			Case 3
				curveAxialMode = "muz"
				Dim valsM() As Double = Array As Double(-0.05, -0.025, 0, 0.025, 0.05)
				curveAxialValue = valsM(cIdx)
				curveLabel = "mu_z=" & NumberFormat2(curveAxialValue, 1, 3, 3, False)
		End Select
		
		For i = 0 To nPoints - 1
			Dim mu As Double = i * SweepMaxMuVal / (nPoints - 1)
			Dim vx As Double = mu * vtip
			tempCond.Mu = mu
			tempCond.MuZ = zBETEngine.ResolveMuZ(mu, curveAxialMode, curveAxialValue, vtip)
			Dim res As RotorResults = zBETEngine.Calculate(ActiveGeom, tempCond)
			Dim xVal As Double = mu
			If SweepXAxisMode = 1 Then xVal = vx
			Dim xName As String = "mu"
			If SweepXAxisMode = 1 Then xName = "Vx_m_s"
			sb.Append(CsvQ(curveLabel)).Append(",").Append(xName).Append(",")
			sb.Append(CsvNum(xVal, 6)).Append(",")
			sb.Append(CsvNum(mu, 8)).Append(",")
			sb.Append(CsvNum(vx, 6)).Append(",")
			sb.Append(curveAxialMode).Append(",")
			sb.Append(CsvNum(curveAxialValue, 8)).Append(",")
			sb.Append(CsvNum(tempCond.MuZ, 8)).Append(",")
			sb.Append(tempCond.InflowModel).Append(",").Append(SweepParamSelectedKey).Append(",")
			If res.SolutionValid Then
				sb.Append(CsvNum(RotorPopups.ExtractParamValue(res, SweepParamSelectedKey), 10)).Append(",VALID")
			Else
				sb.Append(",INVALID")
			End If
			sb.Append(CRLF)
		Next
	Next
	Return sb.ToString
End Sub

Private Sub CsvQ(value As String) As String
	Return Chr(34) & value.Replace(Chr(34), Chr(34) & Chr(34)) & Chr(34)
End Sub

Private Sub CsvNum(value As Double, digits As Int) As String
	' CSV always uses a period as decimal separator, independent of device locale.
	Return NumberFormat2(value, 1, digits, digits, False).Replace(",", ".")
End Sub

Private Sub SaveAs(Source As InputStream, MimeType As String, Title As String) As ResumableSub
	Dim intent As Intent
	intent.Initialize("android.intent.action.CREATE_DOCUMENT", "")
	intent.AddCategory("android.intent.category.OPENABLE")
	intent.PutExtra("android.intent.extra.TITLE", Title)
	intent.SetType(MimeType)
	Try
		StartActivityForResult(intent)
		Wait For ion_Event (MethodName As String, Args() As Object)
		If Args.Length > 1 And -1 = Args(0) Then
			Dim result As Intent = Args(1)
			Dim jo As JavaObject = result
			Dim ctxt As JavaObject
			Dim resolver As JavaObject = ctxt.InitializeContext.RunMethodJO("getContentResolver", Null)
			Dim target As OutputStream = resolver.RunMethod("openOutputStream", Array(jo.RunMethod("getData", Null), "wt"))
			If target.IsInitialized = False Then
				Source.Close
				Return False
			End If
			File.Copy2(Source, target)
			target.Close
			Source.Close
			Return True
		End If
	Catch
		Log("Export failed: " & LastException.Message)
	End Try
	If Source.IsInitialized Then Source.Close
	Return False
End Sub

Private Sub StartActivityForResult(i As Intent)
	Dim jo As JavaObject = GetBA
	ion = jo.CreateEvent("anywheresoftware.b4a.IOnActivityResult", "ion", Null)
	jo.RunMethod("startActivityForResult", Array(ion, i))
End Sub

Private Sub GetBA As Object
	Dim jo As JavaObject
	Dim cls As String = Me
	cls = cls.SubString("class ".Length)
	jo.InitializeStatic(cls)
	Return jo.GetField("processBA")
End Sub

Sub ion_Event (MethodName As String, Args() As Object) As Object
	Return Null
End Sub

' Parsing Utilities
Private Sub ClampD(value As Double, low As Double, high As Double) As Double
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Sub

Private Sub ParseDoubleDef(txt As String, defVal As Double) As Double
	If txt = "" Or txt = "-" Or txt = "." Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub

Private Sub ParseIntDef(txt As String, defVal As Int) As Int
	If txt = "" Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub
