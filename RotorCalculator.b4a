Sub edtUnitValue_TextChanged (Old As String, New As String)
	If UnitPopupOpen Then UpdateUnitConversion
End Sub

Private Sub UpdateUnitConversion
	If btnUnitMode.IsInitialized = False Or edtUnitValue.IsInitialized = False Or lblUnitResult.IsInitialized = False Then Return
	Dim x As Double = ParseDoubleDef(edtUnitValue.Text, 0)
	Dim y As Double
	Dim unitText As String
	Dim modeText As String = UnitModeText(UnitModeIdx)
	Dim fromUnit As String = modeText.SubString2(0, modeText.IndexOf(" "))
	btnUnitMode.Text = modeText & " " & Chr(9662)
	lblUnitFrom.Text = "VALUE IN " & fromUnit
	Select UnitModeIdx
		Case 0
			y = x * 1.34102209 : unitText = "hp"
		Case 1
			y = x / 1.34102209 : unitText = "kW"
		Case 2
			y = x / 9.80665 : unitText = "kgf"
		Case 3
			y = x * 9.80665 : unitText = "N"
		Case 4
			y = x * 0.224808943 : unitText = "lbf"
		Case 5
			y = x / 0.224808943 : unitText = "N"
		Case 6
			y = x / 1.852 : unitText = "kt"
		Case 7
			y = x * 1.852 : unitText = "km/h"
		Case 8
			y = x / 3.6 : unitText = "m/s"
		Case 9
			y = x * 3.6 : unitText = "km/h"
		Case 10
			y = x * 3.280839895 : unitText = "ft"
		Case 11
			y = x / 3.280839895 : unitText = "m"
		Case 12
			y = x / 25.4 : unitText = "in"
		Case Else
			y = x * 25.4 : unitText = "mm"
	End Select
	lblUnitResult.Text = NumberFormat2(y, 1, 4, 4, False) & " " & unitText
End Sub


' ====================================================================
' AEROCALCULATOR-STYLE INPUT UNITS
' ====================================================================
' ====================================================================
' CANONICAL KEYS, UNITS AND FORMATTING (engine stays SI; docs/nomenclature.md)
' ====================================================================
Private Sub Dash As String
	Return Chr(8211)
End Sub

Private Sub NoVal As Double
	Return -1.0E30
End Sub

Private Sub IsDimless(key As String) As Boolean
	Select key
		Case "Nb", "x0", "taper", "sigmaRef", "sigmaAct", "sigmaT", "AR", "Cd0", "B", "mu", "muz", "CTtgt", "kind"
			Return True
	End Select
	Return False
End Sub

Private Sub UnitKind(key As String) As String
	Select key
		Case "R", "c0", "c1", "h": Return "len"
		Case "A", "Ab", "Aact": Return "area"
		Case "thRoot", "thTip", "thTwist", "coll", "alpha": Return "ang"
		Case "a0": Return "a0"
		Case "T0": Return "temp"
		Case "Vx", "Vz": Return "spd"
		Case "rpm", "rpmNom": Return "rpm"
		Case "Ttgt": Return "thr"
	End Select
	Return ""
End Sub

Private Sub DefaultUnit(key As String) As String
	Dim imp As Boolean = (UnitSystem = 1)
	Select UnitKind(key)
		Case "len"
			If imp Then Return "ft"
			Return "m"
		Case "area"
			If imp Then Return "ft²"
			Return "m²"
		Case "ang"
			Return "deg"
		Case "a0"
			Return "rad⁻¹"
		Case "temp"
			If imp Then Return "°F"
			Return "°C"
		Case "spd"
			If imp Then Return "ft/s"
			Return "m/s"
		Case "rpm"
			Return "rpm"
		Case "thr"
			If imp Then Return "lbf"
			Return "N"
	End Select
	Return Dash
End Sub

Private Sub InitializeInputUnitMaps
	If InputUnits.IsInitialized = False Then InputUnits.Initialize
End Sub

Private Sub CurUnit(key As String) As String
	If IsDimless(key) Then Return Dash
	Dim k As String = UnitKind(key)
	If k = "" Then Return Dash
	InitializeInputUnitMaps
	If InputUnits.ContainsKey(key) Then Return "" & InputUnits.Get(key)
	Dim d As String = DefaultUnit(key)
	InputUnits.Put(key, d)
	Return d
End Sub

Private Sub UnitChoices(key As String) As List
	Dim out As List
	out.Initialize
	Select UnitKind(key)
		Case "len"
			If key = "h" Then out.AddAll(Array As String("m", "ft", "km")) Else out.AddAll(Array As String("m", "ft", "in", "cm", "mm"))
		Case "area"
			out.AddAll(Array As String("m²", "ft²", "in²", "cm²"))
		Case "ang"
			out.AddAll(Array As String("deg", "rad"))
		Case "a0"
			out.AddAll(Array As String("rad⁻¹", "deg⁻¹"))
		Case "temp"
			out.AddAll(Array As String("°C", "°F", "K"))
		Case "spd"
			out.AddAll(Array As String("m/s", "ft/s", "kt", "km/h"))
		Case "rpm"
			out.AddAll(Array As String("rpm", "rad/s"))
		Case "thr"
			out.AddAll(Array As String("N", "kN", "lbf"))
	End Select
	Return out
End Sub

' SI-base units per one display unit (rad for angles, per-rad for a0, rpm for rotation speed)
Private Sub UnitFactor(u As String) As Double
	Select u
		Case "ft": Return 0.3048
		Case "in": Return 0.0254
		Case "cm": Return 0.01
		Case "mm": Return 0.001
		Case "km": Return 1000.0
		Case "ft²": Return 0.09290304
		Case "in²": Return 0.00064516
		Case "cm²": Return 0.0001
		Case "deg": Return cPI / 180.0
		Case "deg⁻¹": Return 180.0 / cPI
		Case "ft/s": Return 0.3048
		Case "kt": Return 0.514444444
		Case "km/h": Return 1.0 / 3.6
		Case "rad/s": Return 60.0 / (2.0 * cPI)
		Case "kN": Return 1000.0
		Case "lbf": Return 4.4482216
	End Select
	Return 1.0
End Sub

' base units per one canonical (stored) unit. Collective and alpha are stored in degrees; thetas in rad; a0 per rad.
Private Sub CanonFactor(key As String) As Double
	If key = "coll" Or key = "alpha" Then Return cPI / 180.0
	Return 1.0
End Sub

Private Sub CanonicalToDisplay(key As String, value As Double) As Double
	If IsDimless(key) Then Return value
	Dim u As String = CurUnit(key)
	If key = "T0" Then
		If u = "°F" Then Return value * 9.0 / 5.0 + 32.0
		If u = "K" Then Return value + 273.15
		Return value
	End If
	Return value * CanonFactor(key) / UnitFactor(u)
End Sub

Private Sub InputToCanonical(key As String, value As Double) As Double
	If IsDimless(key) Then Return value
	Dim u As String = CurUnit(key)
	If key = "T0" Then
		If u = "°F" Then Return (value - 32.0) * 5.0 / 9.0
		If u = "K" Then Return value - 273.15
		Return value
	End If
	Return value * UnitFactor(u) / CanonFactor(key)
End Sub

Private Sub KeyDigits(key As String, disp As Double) As Int
	Select key
		Case "Nb"
			Return 0
		Case "x0", "taper", "B", "kind"
			Return 3
		Case "sigmaRef", "sigmaAct", "sigmaT", "Cd0", "mu", "muz"
			Return 4
		Case "AR", "a0", "T0"
			Return 2
		Case "CTtgt"
			Return 5
		Case "rpm", "rpmNom", "Ttgt"
			Return 1
		Case "thRoot", "thTip", "thTwist", "coll", "alpha"
			If CurUnit(key) = "rad" Then Return 4
			Return 2
	End Select
	Dim a As Double = Abs(disp)
	If a >= 100 Then Return 1
	If a >= 10 Then Return 2
	If a >= 1 Then Return 3
	Return 4
End Sub

Private Sub FormatKey(key As String, canon As Double) As String
	Dim d As Double = CanonicalToDisplay(key, canon)
	Dim dg As Int = KeyDigits(key, d)
	Dim mn As Int = dg
	Select key
		Case "R", "c0", "c1", "h", "T0", "A", "Ab", "Aact", "Vx", "Vz"
			mn = Min(2, dg)
		Case "thRoot", "thTip", "thTwist", "coll", "alpha"
			mn = Min(1, dg)
		Case "rpm", "rpmNom", "Ttgt"
			mn = 0
	End Select
	If Abs(d) < 0.5 / Power(10, dg) Then d = 0
	Return NumberFormat2(d, 1, dg, mn, False)
End Sub

' Parses user text (accepts a comma decimal separator). Returns NoVal while the text is a partial entry such as "-" or "".
Private Sub ParseInput(txt As String) As Double
	Dim t As String = txt.Trim.Replace(",", ".")
	If t.Length = 0 Then Return NoVal
	If IsNumber(t) = False Then Return NoVal
	Try
		Dim d As Double = t
		Return d
	Catch
		Return NoVal
	End Try
End Sub

Private Sub TruncateName(n As String) As String
	If n.Length > 32 Then Return n.SubString2(0, 32)
	Return n
End Sub

' ====================================================================
' ROW GRID: label button | value | unit button (shared by Geometry and Conditions)
' ====================================================================
Private Sub ComputeColumns
	Dim inner As Int = UiContentW - 16dip - 8dip
	ColLblW = inner * 42 / 100
	ColValW = inner * 32 / 100
	ColUnitW = inner - ColLblW - ColValW
	ColLblX = 8dip
	ColValX = ColLblX + ColLblW + 4dip
	ColUnitX = ColValX + ColValW + 4dip
End Sub

' Phones start at M (short name + symbol); full names only where width permits (tablets).
Private Sub MinNameLevel As Int
	If root.Width >= 600dip Then Return 0
	Return 1
End Sub

Private Sub GridRowH As Int
	Return 58dip
End Sub

Private Sub TextSp As Float
	Return 16 * sc
End Sub

Private Sub AddSectionHeader(scv As ScrollView, y As Int, title As String) As Int
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title
	lbl.TextColor = ColorAccentGreen
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextSize = 15 * sc
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scv.Panel.AddView(lbl, UiContentLeft + 12dip, y, UiContentW - 24dip, 30dip)
	Return y + 32dip
End Sub

Private Sub AddFormRowPanelSized(scv As ScrollView, y As Int, rowIndex As Int, rowHeight As Int) As Panel
	Dim pnl As Panel
	pnl.Initialize("")
	If rowIndex Mod 2 = 0 Then pnl.Color = ColorPnlInput2 Else pnl.Color = ColorPnlInput1
	scv.Panel.AddView(pnl, UiContentLeft, y, UiContentW, rowHeight)
	Dim lineRow As Panel
	lineRow.Initialize("")
	lineRow.Color = ColorPnlLine3
	scv.Panel.AddView(lineRow, UiContentLeft, y + rowHeight - 1dip, UiContentW, 1dip)
	Return pnl
End Sub

Private Sub SetTextLines(v As View, maxLines As Int)
	Dim jo As JavaObject = v
	jo.RunMethod("setMaxLines", Array(maxLines))
	Dim ta As JavaObject
	ta.InitializeStatic("android.text.TextUtils$TruncateAt")
	jo.RunMethod("setEllipsize", Array(ta.GetField("END")))
End Sub

' Long-press help on any view whose Tag is a row id or a nomenclature key.
Private Sub AttachHelp(v As View)
	Dim jo As JavaObject = v
	Dim e As Object = jo.CreateEvent("android.view.View$OnLongClickListener", "hl", False)
	jo.RunMethod("setOnLongClickListener", Array(e))
End Sub

Sub hl_Event(MethodName As String, Args() As Object) As Object
	If MethodName = "onLongClick" Then
		Dim v As View = Args(0)
		ShowHelpFor("" & v.Tag)
	End If
	Return True
End Sub

Private Sub ShowHelpFor(tagText As String)
	If sheet.IsInitialized = False Then Return
	If tagText = "status" Then
		lblResultStatus_Click
		Return
	End If
	If tagText = "trim" Then
		lblTrimSummary_Click
		Return
	End If
	Dim key As String = tagText
	If tagText.StartsWith("res:") Then
		key = tagText.SubString(4)
	Else If RowKey.IsInitialized Then
		If RowKey.ContainsKey(tagText) Then key = RowKey.Get(tagText)
	End If
	If RotorNames.HasKey(key) Then sheet.ShowHelp(key)
End Sub

Private Sub CreateRowLabel(rowId As String, key As String, level As Int) As Button
	Dim btn As Button
	btn.Initialize("rowLbl")
	btn.Tag = rowId
	btn.Padding = Array As Int (8dip, 1dip, 4dip, 1dip)
	btn.Text = RotorNames.RichLabel(key, level)
	btn.TextSize = LblSp
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorTitleText
	btn.Background = ButtonGradient(Array As Int(ColorPnlInput2, ColorBut1), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	btn.SingleLine = False
	SetTextLines(btn, 2)
	Return btn
End Sub

Private Sub CreateUnitButton(rowId As String, key As String) As Button
	Dim btn As Button
	btn.Initialize("unitRow")
	btn.Tag = rowId
	btn.Padding = Array As Int (2dip, 1dip, 2dip, 1dip)
	btn.TextSize = TextSp
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	StyleUnitButton(btn, key)
	Return btn
End Sub

' Converting units look like buttons; the dimensionless dash is neutral and flat.
Private Sub StyleUnitButton(btn As Button, key As String)
	Dim u As String = CurUnit(key)
	btn.Text = u
	btn.TextSize = RotorNames.FitTextSize(u, TextSp, 11, ColUnitW - 6dip)
	If u = Dash Then
		btn.TextColor = ColorEdtHint
		btn.Background = ButtonGradient(Array As Int(ColorPnlInput5, ColorPnlInput5), Array As Int(ColorPnlInput5, ColorPnlInput5))
	Else
		btn.TextColor = ColorButText2
		btn.Background = ButtonGradient(Array As Int(ColorPnlInput2, ColorBut1), Array As Int(ColorBut1, ColorPnlTitle))
	End If
End Sub

Private Sub CreateRowButton(rowId As String, evt As String) As Button
	Dim btn As Button
	btn.Initialize(evt)
	btn.Tag = rowId
	btn.Padding = Array As Int (2dip, 1dip, 2dip, 1dip)
	btn.TextSize = TextSp * 0.94
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorAccentCyan
	btn.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = False
	SetTextLines(btn, 2)
	Return btn
End Sub

Private Sub CreateValueEdit(rowId As String, isText As Boolean, evt As String) As EditText
	Dim edt As EditText
	edt.Initialize(evt)
	edt.Tag = rowId
	edt.TextSize = 16 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.HintColor = ColorEdtHint
	edt.SingleLine = True
	edt.ForceDoneButton = True
	If isText Then
		edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		edt.Padding = Array As Int(10dip, 0, 10dip, 0)
		Dim jo As JavaObject = edt
		Dim ta As JavaObject
		ta.InitializeStatic("android.text.TextUtils$TruncateAt")
		jo.RunMethod("setEllipsize", Array(ta.GetField("END")))
	Else
		edt.Gravity = Gravity.CENTER
		edt.InputType = Bit.Or(edt.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	End If
	Return edt
End Sub

Private Sub CreateReadOnlyValue(rowId As String) As Label
	Dim l As Label
	l.Initialize("")
	l.Tag = rowId
	l.TextSize = 16 * sc
	l.TextColor = ColorButText2
	l.Typeface = Typeface.DEFAULT_BOLD
	l.Gravity = Gravity.CENTER
	l.SingleLine = True
	Return l
End Sub

' kind: num | text | sel | ro. evt = event name of the value view.
Private Sub BuildRow(scv As ScrollView, y As Int, rowId As String, key As String, kind As String, level As Int, evt As String) As Int
	Dim pnl As Panel = AddFormRowPanelSized(scv, y, RowIdx, GridRowH)
	RowIdx = RowIdx + 1
	RowKey.Put(rowId, key)
	Dim cy As Int = 3dip
	Dim ch As Int = GridRowH - 6dip
	Dim lbl As Button = CreateRowLabel(rowId, key, level)
	pnl.AddView(lbl, ColLblX, cy, ColLblW, ch)
	RowLbl.Put(rowId, lbl)
	Dim v As View
	Select kind
		Case "num"
			Dim e1 As EditText = CreateValueEdit(rowId, False, evt)
			v = e1
		Case "text"
			Dim e2 As EditText = CreateValueEdit(rowId, True, evt)
			v = e2
		Case "sel"
			Dim b1 As Button = CreateRowButton(rowId, evt)
			v = b1
		Case Else
			Dim l1 As Label = CreateReadOnlyValue(rowId)
			v = l1
	End Select
	pnl.AddView(v, ColValX, cy, ColValW, ch)
	RowVal.Put(rowId, v)
	Dim u As Button = CreateUnitButton(rowId, key)
	pnl.AddView(u, ColUnitX, cy, ColUnitW, ch)
	RowUnit.Put(rowId, u)
	AttachHelp(lbl)
	AttachHelp(v)
	AttachHelp(u)
	Return y + GridRowH
End Sub

' Re-targets a dynamic row (horizontal/axial/trim inputs) to another canonical key.
Private Sub SetRowKey(rowId As String, key As String, level As Int)
	RowKey.Put(rowId, key)
	Dim lbl As Button = RowLbl.Get(rowId)
	lbl.Text = RotorNames.RichLabel(key, level)
	Dim u As Button = RowUnit.Get(rowId)
	StyleUnitButton(u, key)
End Sub

Sub rowLbl_Click
	Dim b As Button = Sender
	Dim rid As String = "" & b.Tag
	Select rid
		Case "airfoil"
			btnSelectAirfoil_Click
		Case "tipModel"
			btnTipLoss_Click
		Case "comp"
			btnCompressibility_Click
		Case "inflow"
			btnInflowModel_Click
		Case "trim"
			btnOperatingPair_Click
		Case "hflow"
			btnHorizontalInput_Click
		Case "aflow"
			btnAxialInput_Click
		Case Else
			ShowHelpFor(rid)
	End Select
End Sub

Sub unitRow_Click
	Dim u As Button = Sender
	Dim rid As String = "" & u.Tag
	Dim key As String = rid
	If RowKey.ContainsKey(rid) Then key = RowKey.Get(rid)
	Dim options As List = UnitChoices(key)
	If options.Size <= 1 Then
		ToastMessageShow("No display unit: this quantity is dimensionless or a selection.", False)
		Return
	End If
	Dim current As String = CurUnit(key)
	Dim selected As Int = 0
	For i = 0 To options.Size - 1
		If ("" & options.Get(i)) = current Then selected = i
	Next
	Dim title As String = "Unit · " & RotorNames.PlainLabel(key, 0)
	Wait For (sheet.ShowChoice(title, options, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	InputUnits.Put(key, "" & options.Get(idx))
	RefreshAllInputFields
End Sub

Private Sub RefreshAllInputFields
	If RowVal.IsInitialized = False Then Return
	If GeomKeys.IsInitialized Then RefreshGeomFields("")
	LoadConditionDataToFields
	RecalculateRotor
End Sub

' ====================================================================
' PAGE 0: GEOMETRY - every quantity is an editable input; edits go through zBETEngine.SetGeometryQuantity
' ====================================================================
Private Sub BuildPageGeom
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
	scvGeom.Initialize(3000dip)
	pnlBack0.AddView(scvGeom, 0, 0, root.Width, root.Height - HeaderHeight)
	BuildGeometryEditorContent
	RefreshGeomFields("")
	RefreshActiveRotorBar
End Sub

Private Sub BuildGeometryEditorContent
	GeomKeys.Initialize
	GeomKeys.AddAll(Array As String("name", "rpmNom", "R", "Nb", "x0", "c0", "c1", "taper", "AR", "sigmaRef", "sigmaAct", "sigmaT", "A", "Ab", "Aact", "thRoot", "thTip", "thTwist", "airfoil", "a0", "Cd0", "tipModel", "B", "comp"))
	ComputeColumns
	GeomLevel = RotorNames.ChooseLevel(GeomKeys, ColLblW - 12dip, TextSp, MinNameLevel)
	LblSp = RotorNames.FitLabelSize(GeomKeys, GeomLevel, ColLblW - 12dip, TextSp, 13)
	Dim lv As Int = GeomLevel
	RowIdx = 0
	Dim y As Int = 8dip
	y = AddActiveBar(y)
	y = AddSectionHeader(scvGeom, y, "ROTOR")
	y = BuildRow(scvGeom, y, "name", "name", "text", lv, "edtGeom")
	AddNameOverlay
	y = BuildRow(scvGeom, y, "rpmNom", "rpmNom", "num", lv, "edtGeom")
	y = AddSectionHeader(scvGeom, y + 6dip, "PLANFORM")
	For Each k1 As String In Array As String("R", "Nb", "x0", "c0", "c1", "taper", "AR")
		y = BuildRow(scvGeom, y, k1, k1, "num", lv, "edtGeom")
	Next
	y = AddSectionHeader(scvGeom, y + 6dip, "SOLIDITY & AREAS")
	For Each k2 As String In Array As String("sigmaRef", "sigmaAct", "sigmaT", "A", "Ab", "Aact")
		y = BuildRow(scvGeom, y, k2, k2, "num", lv, "edtGeom")
	Next
	y = AddSectionHeader(scvGeom, y + 6dip, "BLADE PITCH")
	For Each k3 As String In Array As String("thRoot", "thTip", "thTwist")
		y = BuildRow(scvGeom, y, k3, k3, "num", lv, "edtGeom")
	Next
	y = AddSectionHeader(scvGeom, y + 6dip, "AERODYNAMICS")
	y = BuildRow(scvGeom, y, "airfoil", "airfoil", "sel", lv, "btnSelectAirfoil")
	btnSelectAirfoil = RowVal.Get("airfoil")
	y = BuildRow(scvGeom, y, "a0", "a0", "num", lv, "edtGeom")
	y = BuildRow(scvGeom, y, "Cd0", "Cd0", "num", lv, "edtGeom")
	y = BuildRow(scvGeom, y, "tipModel", "tipModel", "sel", lv, "btnTipLoss")
	btnTipLoss = RowVal.Get("tipModel")
	y = BuildRow(scvGeom, y, "B", "B", "num", lv, "edtGeom")
	edtTipLossB = RowVal.Get("B")
	Dim bPnl As Panel = edtTipLossB.Parent
	lblTipFactorRO = CreateReadOnlyValue("B")
	bPnl.AddView(lblTipFactorRO, ColValX, 3dip, ColValW, GridRowH - 6dip)
	AttachHelp(lblTipFactorRO)
	y = BuildRow(scvGeom, y, "comp", "comp", "sel", lv, "btnCompressibility")
	btnCompressibility = RowVal.Get("comp")
	y = AddActionRow(y + 14dip)
	scvGeom.Panel.Height = y + 24dip
End Sub

Private Sub AddActiveBar(y As Int) As Int
	pnlActiveBar.Initialize("")
	pnlActiveBar.Color = Colors.Transparent
	scvGeom.Panel.AddView(pnlActiveBar, UiContentLeft, y, UiContentW, 56dip)
	btnActiveRotor.Initialize("btnActiveRotor")
	btnActiveRotor.Tag = "activeRotor"
	btnActiveRotor.Typeface = Typeface.DEFAULT_BOLD
	btnActiveRotor.TextColor = ColorAccentCyan
	btnActiveRotor.TextSize = 16 * sc
	btnActiveRotor.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	btnActiveRotor.SingleLine = True
	SetTextLines(btnActiveRotor, 1)
	btnActiveRotor.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	pnlActiveBar.AddView(btnActiveRotor, 8dip, 4dip, UiContentW - 16dip, 48dip)
	lblUnsaved.Initialize("")
	lblUnsaved.Text = "UNSAVED"
	lblUnsaved.TextSize = 13
	lblUnsaved.Typeface = Typeface.DEFAULT_BOLD
	lblUnsaved.TextColor = ColorAccentAmber
	lblUnsaved.Gravity = Gravity.CENTER
	pnlActiveBar.AddView(lblUnsaved, UiContentW - 8dip - 88dip, 4dip, 84dip, 48dip)
	lblUnsaved.Visible = False
	AttachHelp(btnActiveRotor)
	Return y + 62dip
End Sub

Private Sub MakeActionButton(txt As String, evt As String, helpKey As String, fg As Int) As Button
	Dim b As Button
	b.Initialize(evt)
	b.Tag = helpKey
	b.Text = txt
	b.TextSize = 16 * sc
	b.Typeface = Typeface.DEFAULT_BOLD
	b.TextColor = fg
	b.Gravity = Gravity.CENTER
	b.SingleLine = True
	b.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	AttachHelp(b)
	Return b
End Sub

Private Sub AddActionRow(y As Int) As Int
	Dim gap As Int = 8dip
	Dim w As Int = (UiContentW - 16dip - 2 * gap) / 3
	btnSave = MakeActionButton("SAVE", "btnGeometrySave", "save", ColorAccentGreen)
	btnCopy = MakeActionButton("COPY", "btnGeometryCopy", "copy", ColorButText1)
	btnDelete = MakeActionButton("DELETE", "btnGeometryDelete", "delete", ColorAccentRed)
	scvGeom.Panel.AddView(btnSave, UiContentLeft + 8dip, y, w, 52dip)
	scvGeom.Panel.AddView(btnCopy, UiContentLeft + 8dip + w + gap, y, w, 52dip)
	scvGeom.Panel.AddView(btnDelete, UiContentLeft + 8dip + 2 * (w + gap), y, UiContentW - 16dip - 2 * (w + gap), 52dip)
	Return y + 52dip
End Sub

Sub RefreshActiveRotorBar
	If btnActiveRotor.IsInitialized = False Then Return
	btnActiveRotor.Text = ActiveGeom.Name & "  " & Chr(9662)
	If GeometryDirty Then
		btnActiveRotor.TextColor = ColorAccentAmber
		btnActiveRotor.Padding = Array As Int(14dip, 0, 92dip, 0)
	Else
		btnActiveRotor.TextColor = ColorAccentCyan
		btnActiveRotor.Padding = Array As Int(14dip, 0, 14dip, 0)
	End If
	lblUnsaved.Visible = GeometryDirty
	If btnDelete.IsInitialized Then
		Dim jo As JavaObject = btnDelete
		If RotorStorage.Rotors.Size <= 1 Then
			btnDelete.TextColor = ColorEdtHint
			Dim fa As Float = 0.45
			jo.RunMethod("setAlpha", Array As Object(fa))
		Else
			btnDelete.TextColor = ColorAccentRed
			Dim fb As Float = 1
			jo.RunMethod("setAlpha", Array As Object(fb))
		End If
	End If
End Sub

' ---- geometry value plumbing ----
Private Sub GeomValue(g As RotorGeometry, key As String) As Double
	Select key
		Case "a0"
			Return g.LiftSlope0
		Case "Cd0"
			Return g.Cd0
		Case "B"
			Return g.TipLossB
		Case "rpmNom"
			Return g.NominalRPM
	End Select
	Return zBETEngine.GetGeometryQuantity(g, key)
End Sub

Private Sub SetEdit(rowId As String, txt As String)
	Dim e As EditText = RowVal.Get(rowId)
	If e.Text <> txt Then e.Text = txt
	If rowId = "name" Then SyncNameOverlay
End Sub

' An EditText cannot ellipsize while it holds editable text, so when it is not focused a Label
' with the same text and ellipsize END covers it; tapping the label starts editing.
Private Sub AddNameOverlay
	Dim e As EditText = RowVal.Get("name")
	Dim pnl As Panel = e.Parent
	lblNameShow.Initialize("lblNameShow")
	lblNameShow.TextSize = 16 * sc
	lblNameShow.TextColor = ColorEdtText
	lblNameShow.Color = ColorEdt
	lblNameShow.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblNameShow.SingleLine = True
	lblNameShow.Padding = Array As Int(10dip, 0, 10dip, 0)
	Dim jo As JavaObject = lblNameShow
	Dim ta As JavaObject
	ta.InitializeStatic("android.text.TextUtils$TruncateAt")
	jo.RunMethod("setEllipsize", Array(ta.GetField("END")))
	pnl.AddView(lblNameShow, e.Left, e.Top, e.Width, e.Height)
	SyncNameOverlay
End Sub

Private Sub SyncNameOverlay
	If lblNameShow.IsInitialized = False Then Return
	If RowVal.ContainsKey("name") = False Then Return
	Dim e As EditText = RowVal.Get("name")
	lblNameShow.Text = e.Text
	lblNameShow.Visible = (FocusRow <> "name")
End Sub

Sub lblNameShow_Click
	Dim e As EditText = RowVal.Get("name")
	lblNameShow.Visible = False
	e.RequestFocus
	e.SelectionStart = e.Text.Length
	Dim ctxt As JavaObject
	ctxt.InitializeContext
	Dim imm As JavaObject = ctxt.RunMethod("getSystemService", Array("input_method"))
	imm.RunMethod("showSoftInput", Array(e, 1))
End Sub

' Rewrites every row from ActiveGeom except skipId (the field being typed in).
Private Sub RefreshGeomFields(skipId As String)
	If GeomKeys.IsInitialized = False Or RowVal.IsInitialized = False Then Return
	If RowVal.ContainsKey("name") = False Then Return
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	Dim g As RotorGeometry = zBETEngine.ResolveSolidity(zBETEngine.CloneGeometry(ActiveGeom))
	For Each key As String In GeomKeys
		Dim ub As Button = RowUnit.Get(key)
		StyleUnitButton(ub, key)
		Select key
			Case "name"
				If skipId <> "name" Then SetEdit("name", g.Name)
			Case "airfoil"
				btnSelectAirfoil.Text = AirfoilDisplayName(g)
			Case "tipModel"
				RefreshTipLossButton(g)
			Case "comp"
				RefreshCompressibilityButton(g)
			Case "B"
				RefreshTipFactorRow
			Case Else
				If key <> skipId Then SetEdit(key, FormatKey(key, GeomValue(g, key)))
		End Select
	Next
	UpdatingUI = wasUpdating
End Sub

Private Sub RefreshTipLossButton(geom As RotorGeometry)
	Select geom.TipLossMode
		Case "sissingh"
			btnTipLoss.Text = RotorNames.ShortName("tip_sissingh")
			btnTipLoss.TextColor = ColorAccentGreen
		Case "fixed"
			btnTipLoss.Text = RotorNames.ShortName("tip_fixed")
			btnTipLoss.TextColor = ColorAccentCyan
		Case Else
			btnTipLoss.Text = RotorNames.ShortName("tip_none")
			btnTipLoss.TextColor = ColorButText2
	End Select
End Sub

Private Sub RefreshCompressibilityButton(geom As RotorGeometry)
	If geom.UsePrandtlGlauert Then
		btnCompressibility.Text = RotorNames.ShortName("comp_pg")
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		btnCompressibility.Text = RotorNames.ShortName("comp_off")
		btnCompressibility.TextColor = ColorButText2
	End If
	btnCompressibility.TextSize = RotorNames.FitWordSize(btnCompressibility.Text, TextSp * 0.94, 12, ColValW - 6dip)
End Sub

' Tip factor B: editable only for the fixed model; otherwise the computed B is shown read-only.
Private Sub RefreshTipFactorRow
	If edtTipLossB.IsInitialized = False Or lblTipFactorRO.IsInitialized = False Then Return
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	If ActiveGeom.TipLossMode = "fixed" Then
		edtTipLossB.Visible = True
		lblTipFactorRO.Visible = False
		If FocusRow <> "B" Then SetEdit("B", FormatKey("B", ActiveGeom.TipLossB))
	Else
		edtTipLossB.Visible = False
		lblTipFactorRO.Visible = True
		Dim bv As Double = 1.0
		If ActiveGeom.TipLossMode = "sissingh" Then
			If ActiveRes.SolutionValid And ActiveRes.BFactor > 0 Then bv = ActiveRes.BFactor Else bv = ActiveGeom.TipLossB
		End If
		lblTipFactorRO.Text = FormatKey("B", bv)
	End If
	UpdatingUI = wasUpdating
End Sub

Private Sub AirfoilDisplayName(geom As RotorGeometry) As String
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		If Abs(geom.LiftSlope0 - af.A0) < 0.001 And Abs(geom.Cd0 - af.Cd0) < 0.00001 Then Return af.Name
	Next
	Return "Custom"
End Sub

' ---- unsaved-state comparison against the saved library entry ----
Private Sub NearlyEq(a As Double, b As Double) As Boolean
	Return Abs(a - b) <= 1.0E-9 * Max(1.0, Max(Abs(a), Abs(b)))
End Sub

Private Sub GeomEqual(a As RotorGeometry, b As RotorGeometry) As Boolean
	If a.Name.Trim <> b.Name.Trim Then Return False
	If a.NBlades <> b.NBlades Then Return False
	If a.TipLossMode <> b.TipLossMode Then Return False
	If a.UsePrandtlGlauert <> b.UsePrandtlGlauert Then Return False
	If NearlyEq(a.Radius, b.Radius) = False Then Return False
	If NearlyEq(a.RootCutout, b.RootCutout) = False Then Return False
	If NearlyEq(a.ChordRoot, b.ChordRoot) = False Then Return False
	If NearlyEq(a.ChordTip, b.ChordTip) = False Then Return False
	If NearlyEq(a.ThetaRoot, b.ThetaRoot) = False Then Return False
	If NearlyEq(a.ThetaTip, b.ThetaTip) = False Then Return False
	If NearlyEq(a.LiftSlope0, b.LiftSlope0) = False Then Return False
	If NearlyEq(a.Cd0, b.Cd0) = False Then Return False
	If NearlyEq(a.TipLossB, b.TipLossB) = False Then Return False
	If NearlyEq(a.NominalRPM, b.NominalRPM) = False Then Return False
	Return True
End Sub

Private Sub CheckDirty
	GeometryDirty = False
	If RotorStorage.Rotors.IsInitialized = False Then Return
	If RotorStorage.ActiveIndex < 0 Or RotorStorage.ActiveIndex >= RotorStorage.Rotors.Size Then Return
	Dim saved As RotorGeometry = RotorStorage.Rotors.Get(RotorStorage.ActiveIndex)
	GeometryDirty = Not(GeomEqual(ActiveGeom, saved))
End Sub

' ---- editing ----
Sub edtGeom_TextChanged (Old As String, New As String)
	If UpdatingUI Or Old = New Then Return
	If RowVal.IsInitialized = False Then Return
	Dim edt As EditText = Sender
	Dim key As String = "" & edt.Tag
	If key = "name" Then
		Dim n As String = New.Replace("|", "/").Replace(Chr(13), " ").Replace(Chr(10), " ")
		If n.Length > 32 Then
			n = n.SubString2(0, 32)
			UpdatingUI = True
			edt.Text = n
			edt.SelectionStart = n.Length
			UpdatingUI = False
		End If
		If n.Trim.Length > 0 Then ActiveGeom.Name = n.Trim
		CheckDirty
		RefreshActiveRotorBar
		Return
	End If
	Dim dv As Double = ParseInput(New)
	If dv = NoVal Then Return
	Dim si As Double = InputToCanonical(key, dv)
	Select key
		Case "R", "Nb", "c0", "c1", "taper", "sigmaRef", "sigmaAct", "sigmaT", "AR", "A", "Ab", "Aact"
			If si <= 0 Then Return
	End Select
	Select key
		Case "a0"
			ActiveGeom.LiftSlope0 = ClampD(si, 0.1, 10.0)
		Case "Cd0"
			ActiveGeom.Cd0 = ClampD(si, 0.0, 0.5)
		Case "B"
			ActiveGeom.TipLossB = ClampD(si, ActiveGeom.RootCutout + 0.001, 1.0)
		Case "rpmNom"
			ActiveGeom.NominalRPM = ClampD(si, 1.0, 30000.0)
		Case Else
			ActiveGeom = zBETEngine.SetGeometryQuantity(ActiveGeom, key, si)
	End Select
	CheckDirty
	RefreshGeomFields(key)
	RefreshActiveRotorBar
	RecalculateRotor
End Sub

Sub edtGeom_FocusChanged (HasFocus As Boolean)
	Dim e As EditText = Sender
	Dim rid As String = "" & e.Tag
	If HasFocus Then
		FocusRow = rid
	Else
		If FocusRow = rid Then FocusRow = ""
		If UpdatingUI = False Then RefreshGeomFields("")
	End If
	If rid = "name" Then SyncNameOverlay
End Sub

Sub edtGeom_EnterPressed
	FocusRow = ""
	RefreshGeomFields("")
	Dim p As Phone
	p.HideKeyboard(Activity)
End Sub

' ---- selectors ----
Sub btnSelectAirfoil_Click
	Dim items As List
	items.Initialize
	Dim selected As Int = -1
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		items.Add(af.Name & "|a_0 = " & NumberFormat2(af.A0, 1, 2, 2, False) & " /rad  ·  C_d0 = " & NumberFormat2(af.Cd0, 1, 4, 4, False))
		If Abs(af.A0 - ActiveGeom.LiftSlope0) < 0.001 And Abs(af.Cd0 - ActiveGeom.Cd0) < 0.00001 Then selected = i
	Next
	items.Add("Custom|Keep a_0 and C_d0 as entered")
	If selected = -1 Then selected = items.Size - 1
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("airfoil", 0), items, selected)) Complete (idx As Int)
	If idx < 0 Or idx >= RotorPopups.Airfoils.Size Then Return
	Dim selAf As AirfoilData = RotorPopups.Airfoils.Get(idx)
	ActiveGeom.LiftSlope0 = selAf.A0
	ActiveGeom.Cd0 = selAf.Cd0
	AfterGeometryEdit
End Sub

Private Sub AfterGeometryEdit
	CheckDirty
	RefreshGeomFields("")
	RefreshActiveRotorBar
	RecalculateRotor
End Sub

Sub btnTipLoss_Click
	Dim items As List
	items.Initialize
	items.Add(RotorNames.ShortName("tip_none") & "|Full aerodynamic span, B = 1")
	items.Add(RotorNames.ShortName("tip_fixed") & "|Prescribed effective tip factor B")
	items.Add(RotorNames.ShortName("tip_sissingh") & "|Thrust-dependent tip factor")
	Dim selected As Int = 0
	If ActiveGeom.TipLossMode = "fixed" Then selected = 1
	If ActiveGeom.TipLossMode = "sissingh" Then selected = 2
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("tipModel", 0), items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	Select idx
		Case 0
			ActiveGeom.TipLossMode = "none"
		Case 1
			ActiveGeom.TipLossMode = "fixed"
		Case 2
			ActiveGeom.TipLossMode = "sissingh"
	End Select
	AfterGeometryEdit
End Sub

Sub btnCompressibility_Click
	Dim items As List
	items.Initialize
	items.Add(RotorNames.ShortName("comp_off") & "|No compressibility correction")
	items.Add(RotorNames.ShortName("comp_pg") & "|Linear compressibility correction")
	Dim selected As Int = 0
	If ActiveGeom.UsePrandtlGlauert Then selected = 1
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("comp", 0), items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	ActiveGeom.UsePrandtlGlauert = (idx = 1)
	AfterGeometryEdit
End Sub

' ---- rotor selection / actions ----
Private Sub RotorOrder As List
	Dim order As List
	order.Initialize
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g1 As RotorGeometry = RotorStorage.Rotors.Get(i)
		If RotorStorage.IsFactoryPresetName(g1.Name) Then order.Add(i)
	Next
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g2 As RotorGeometry = RotorStorage.Rotors.Get(i)
		If RotorStorage.IsFactoryPresetName(g2.Name) = False Then order.Add(i)
	Next
	Return order
End Sub

Sub btnActiveRotor_Click
	Dim order As List = RotorOrder
	Dim items As List
	items.Initialize
	items.Add(Chr(65291) & " New Rotor|Create a custom rotor")
	Dim selected As Int = -1
	For j = 0 To order.Size - 1
		Dim ri As Int = order.Get(j)
		Dim g As RotorGeometry = RotorStorage.Rotors.Get(ri)
		Dim kindTxt As String = "Custom"
		If RotorStorage.IsFactoryPresetName(g.Name) Then kindTxt = "Preset"
		items.Add(g.Name & "|" & kindTxt)
		If ri = RotorStorage.ActiveIndex Then selected = items.Size - 1
	Next
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("activeRotor", 0), items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	If idx = 0 Then
		btnNewRotor_Click
		Return
	End If
	Dim target As Int = order.Get(idx - 1)
	If target = RotorStorage.ActiveIndex Then Return
	Wait For (ResolveUnsavedGeometry("switching rotors")) Complete (ok As Boolean)
	If ok = False Then Return
	RotorStorage.SetActiveRotor(target)
	AfterRotorChange
End Sub

Sub btnNewRotor_Click
	Wait For (ResolveUnsavedGeometry("creating a new rotor")) Complete (ok As Boolean)
	If ok = False Then Return
	Dim idx As Int = RotorStorage.CreateNewRotor
	RotorStorage.SetActiveRotor(idx)
	AfterRotorChange
End Sub

' Loads the library's active rotor into the editor; Conditions speed follows the rotor's nominal speed.
Private Sub AfterRotorChange
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	RotorStorage.ClearDraft
	If ActiveGeom.NominalRPM > 0 Then ActiveCond.RPM = ActiveGeom.NominalRPM
	RefreshGeomFields("")
	LoadConditionDataToFields
	RefreshActiveRotorBar
	RecalculateRotor
End Sub

Sub SaveCurrentRotor
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	RotorStorage.ClearDraft
	RefreshGeomFields("")
	RefreshActiveRotorBar
	RecalculateRotor
	ToastMessageShow("Rotor saved.", False)
End Sub

' Returns True when it is safe to continue (nothing unsaved, or saved, or discarded).
Private Sub ResolveUnsavedGeometry(ActionText As String) As ResumableSub
	CheckDirty
	If GeometryDirty = False Then Return True
	Wait For (sheet.ShowConfirm("Unsaved Geometry", "Save the changes to " & ActiveGeom.Name & " before " & ActionText & "?", "Save", "Discard", "Cancel", False)) Complete (r As Int)
	If r = DialogResponse.POSITIVE Then
		SaveCurrentRotor
		Return True
	Else If r = DialogResponse.NEGATIVE Then
		ActiveGeom = RotorStorage.GetActiveRotor
		GeometryDirty = False
		RotorStorage.ClearDraft
		RefreshGeomFields("")
		RefreshActiveRotorBar
		RecalculateRotor
		Return True
	End If
	Return False
End Sub

Sub btnGeometrySave_Click
	SaveCurrentRotor
End Sub

Sub btnGeometryCopy_Click
	Dim suggested As String = TruncateName(RotorStorage.MakeCopyName(ActiveGeom.Name))
	Wait For (sheet.ShowInput("Copy Rotor", "Name for the new rotor (max 32 characters)", suggested, "Copy", 32)) Complete (nm As String)
	If nm.Length = 0 Then Return
	Dim copyGeom As RotorGeometry = zBETEngine.CloneGeometry(ActiveGeom)
	copyGeom.Name = TruncateName(nm)
	RotorStorage.AddRotor(copyGeom)
	AfterRotorChange
	ToastMessageShow("Rotor copied: " & ActiveGeom.Name, False)
End Sub

Sub btnGeometryDelete_Click
	If RotorStorage.Rotors.Size <= 1 Then
		ToastMessageShow("At least one rotor must remain.", False)
		Return
	End If
	Wait For (sheet.ShowConfirm("Delete Rotor", "Delete " & ActiveGeom.Name & "? This removes the saved geometry from the local library.", "Delete", "Cancel", "", True)) Complete (r As Int)
	If r <> DialogResponse.POSITIVE Then Return
	If RotorStorage.DeleteRotor(RotorStorage.ActiveIndex) Then
		AfterRotorChange
		ToastMessageShow("Rotor deleted.", False)
	End If
End Sub

' ====================================================================
' PAGE 1: CONDITIONS
' ====================================================================
Private Sub HKey As String
	If HorizontalInputMode = "vx" Then Return "Vx"
	Return "mu"
End Sub

Private Sub AKey As String
	If AxialInputMode = "vz" Then Return "Vz"
	If AxialInputMode = "muz" Then Return "muz"
	Return "alpha"
End Sub

Private Sub BuildPageCond
	pnlBack1.Initialize("")
	pnlBack1.Color = ColorPnlInput5
	scvCond.Initialize(2300)
	pnlBack1.AddView(scvCond, 0, 0, root.Width, root.Height - HeaderHeight)
	CondKeys.Initialize
	CondKeys.AddAll(Array As String("h", "T0", "mu", "Vx", "alpha", "Vz", "muz", "trim", "rpm", "coll", "CTtgt", "Ttgt", "inflow", "kind", "drag"))
	ComputeColumns
	CondLevel = RotorNames.ChooseLevel(CondKeys, ColLblW - 12dip, TextSp, MinNameLevel)
	LblSp = RotorNames.FitLabelSize(CondKeys, CondLevel, ColLblW - 12dip, TextSp, 13)
	Dim lv As Int = CondLevel
	RowIdx = 0
	Dim y As Int = 8dip
	y = AddSectionHeader(scvCond, y, "ATMOSPHERE & FLOW")
	y = BuildRow(scvCond, y, "h", "h", "num", lv, "edtCond")
	edtAltitude = RowVal.Get("h")
	y = BuildRow(scvCond, y, "T0", "T0", "num", lv, "edtCond")
	edtTemperature = RowVal.Get("T0")
	y = BuildRow(scvCond, y, "hflow", HKey, "num", lv, "edtHorizontalValue")
	btnHorizontalInput = RowLbl.Get("hflow")
	edtHorizontalValue = RowVal.Get("hflow")
	lblHorizontalUnit = RowUnit.Get("hflow")
	y = BuildRow(scvCond, y, "aflow", AKey, "num", lv, "edtAxialValue")
	btnAxialInput = RowLbl.Get("aflow")
	edtAxialValue = RowVal.Get("aflow")
	lblAxialUnit = RowUnit.Get("aflow")
	y = AddSectionHeader(scvCond, y + 6dip, "OPERATING CONSTRAINTS")
	y = BuildRow(scvCond, y, "trim", "trim", "sel", lv, "btnOperatingPair")
	btnOperatingPair = RowVal.Get("trim")
	y = BuildRow(scvCond, y, "op1", "rpm", "num", lv, "edtOperatingInput")
	lblOperatingInput1 = RowLbl.Get("op1")
	edtOperatingInput1 = RowVal.Get("op1")
	lblOperatingUnit1 = RowUnit.Get("op1")
	y = BuildRow(scvCond, y, "op2", "CTtgt", "num", lv, "edtOperatingInput")
	lblOperatingInput2 = RowLbl.Get("op2")
	edtOperatingInput2 = RowVal.Get("op2")
	lblOperatingUnit2 = RowUnit.Get("op2")
	y = AddSectionHeader(scvCond, y + 6dip, "AERODYNAMIC MODEL")
	y = BuildRow(scvCond, y, "inflow", "inflow", "sel", lv, "btnInflowModel")
	btnInflowModel = RowVal.Get("inflow")
	y = BuildRow(scvCond, y, "kind", "kind", "num", lv, "edtKInd")
	edtKInd = RowVal.Get("kind")
	y = BuildRow(scvCond, y, "drag", "drag", "sel", lv, "btnDragInfo")
	Dim btnDrag As Button = RowVal.Get("drag")
	btnDrag.Text = RotorNames.FullName("drag_numerical")
	scvCond.Panel.Height = y + 24dip
End Sub

Sub btnDragInfo_Click
	sheet.ShowHelp("drag_numerical")
End Sub

' ====================================================================
' PAGE 2: RESULTS / OUTPUTS (AeroCalculator scvMain2 Architecture)
' ====================================================================
Private Sub BuildPageRes
	pnlBack2.Initialize("")
	pnlBack2.Color = ColorPnlInput5
	scvRes.Initialize(4800)
	pnlBack2.AddView(scvRes, 0, 0, root.Width, root.Height - HeaderHeight)

	btnViewPolarPlot.Initialize("btnViewPolarPlot")
	btnViewPolarPlot.Tag = "sweep"
	AttachHelp(btnViewPolarPlot)
	btnViewPolarPlot.Text = "OPEN PARAMETER SWEEP"
	btnViewPolarPlot.Typeface = Typeface.DEFAULT_BOLD
	btnViewPolarPlot.TextColor = ColorAccentCyan
	btnViewPolarPlot.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnViewPolarPlot.TextSize = 15 * sc
	scvRes.Panel.AddView(btnViewPolarPlot, UiContentLeft + UiContentW*3/100, 8dip, UiContentW*94/100, 48dip)

	' Status cards: model validity / Mach caution, and the active operating solution.
	Dim y As Int = 64dip
	lblResultStatus = NewChip("lblResultStatus", "status")
	scvRes.Panel.AddView(lblResultStatus, UiContentLeft + 8dip, y, UiContentW - 16dip, 60dip)
	y = y + 66dip
	lblTrimSummary = NewChip("lblTrimSummary", "trim")
	scvRes.Panel.AddView(lblTrimSummary, UiContentLeft + 8dip, y, UiContentW - 16dip, 48dip)
	y = y + 56dip

	' One canonical key per row (docs/nomenclature.md). Operating state shows rotor speed and collective pitch.
	ResKeys.Initialize
	ResKeys.AddAll(Array As String( _
		"T", "P", "Pi", "P0", "Q", "H", "Y", "Mx", "My", _
		"DL", "PL", "vi", "CTs", "FM", "LDe", _
		"CT", "CQ", "CQi", "CQ0", "CH", "CHi", "CH0", "CY", "CMx", "CMy", "CPair", _
		"lam", "lami", "Kx", "Ky", "chi", "Bres", _
		"rpm", "coll", "mu", "Vx", "muz", "Vz", "alpha", "OmR", "Mtip", "Madv", "h", "T0", "rho", "p", "a"))
	Dim rowW As Int = UiContentW
	Dim nameW As Int = rowW * 42 / 100
	Dim valW As Int = rowW * 33 / 100
	Dim rowH As Int = 54dip
	ResLevel = RotorNames.ChooseLevel(ResKeys, nameW - 10dip, TextSp, MinNameLevel)
	Dim resLblSp As Float = RotorNames.FitLabelSize(ResKeys, ResLevel, nameW - 10dip, TextSp, 14)
	For i = 0 To ResKeys.Size - 1
		Dim sectionTitle As String = ""
		Select i
			Case 0: sectionTitle = "DIMENSIONAL PERFORMANCE"
			Case 9: sectionTitle = "LOADING & EFFICIENCY"
			Case 15: sectionTitle = "AERODYNAMIC COEFFICIENTS"
			Case 26: sectionTitle = "INFLOW & WAKE"
			Case 32: sectionTitle = "STATE & ATMOSPHERE"
		End Select
		If sectionTitle <> "" Then y = AddSectionHeader(scvRes, y, sectionTitle)
		Dim k As String = ResKeys.Get(i)
		Dim row As Panel
		row.Initialize("resRow")
		row.Tag = "res:" & k
		If i Mod 2 = 0 Then row.Color = ColorPnlInput4 Else row.Color = ColorPnlInput3
		scvRes.Panel.AddView(row, UiContentLeft, y, rowW, rowH)
		AttachHelp(row)
		Dim lbl As Label
		lbl.Initialize("")
		lbl.Text = RotorNames.RichLabel(k, ResLevel)
		lbl.TextColor = ColorTitleText
		lbl.Typeface = Typeface.DEFAULT_BOLD
		lbl.TextSize = resLblSp
		lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lbl.SingleLine = False
		SetTextLines(lbl, 2)
		row.AddView(lbl, 10dip, 0, nameW - 10dip, rowH)
		lblResults(i).Initialize("")
		lblResults(i).Text = Dash
		lblResults(i).TextColor = ColorAccentCyan
		lblResults(i).Typeface = Typeface.DEFAULT_BOLD
		lblResults(i).TextSize = 16 * sc
		lblResults(i).Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
		lblResults(i).SingleLine = True
		row.AddView(lblResults(i), nameW, 0, valW, rowH)
		lblResultUnits(i).Initialize("")
		lblResultUnits(i).Text = ResUnitFor(k)
		lblResultUnits(i).TextColor = ColorButText2
		lblResultUnits(i).Typeface = Typeface.DEFAULT_BOLD
		lblResultUnits(i).TextSize = TextSp
		lblResultUnits(i).Gravity = Gravity.CENTER
		lblResultUnits(i).SingleLine = True
		row.AddView(lblResultUnits(i), nameW + valW + 2dip, 0, rowW - nameW - valW - 4dip, rowH)
		Dim sep As Panel
		sep.Initialize("")
		sep.Color = ColorPnlLine3
		row.AddView(sep, 0, rowH - 1dip, rowW, 1dip)
		y = y + rowH
	Next
	scvRes.Panel.Height = y + 24dip
End Sub

Private Sub NewChip(ev As String, tg As String) As Label
	Dim l As Label
	l.Initialize(ev)
	l.Tag = tg
	l.TextSize = 14.5 * sc
	l.Typeface = Typeface.DEFAULT_BOLD
	l.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	l.Padding = Array As Int(14dip, 4dip, 14dip, 4dip)
	l.SingleLine = False
	l.Text = Dash
	SetTextLines(l, 3)
	AttachHelp(l)
	Return l
End Sub

Private Sub StyleChip(l As Label, col As Int)
	Dim fill As Int = Bit.Or(0x26000000, Bit.And(col, 0x00FFFFFF))
	Dim cd As ColorDrawable
	cd.Initialize2(fill, 12dip, 1dip, col)
	l.Background = cd
	l.TextColor = col
End Sub

Sub resRow_Click
	Dim p As Panel = Sender
	ShowHelpFor("" & p.Tag)
End Sub

Private Sub UpdateStatusChips
	If lblResultStatus.IsInitialized = False Then Return
	Dim r As RotorResults = ActiveRes
	Dim tipMach As Double = 0.0
	If r.SpeedOfSound > 0 Then tipMach = r.TipSpeed / r.SpeedOfSound
	Dim txt As String
	Dim col As Int
	If r.CompressibilityInvalid Then
		col = ColorAccentRed
		txt = "Advancing tip Mach M_adv = " & FormatSig(r.AdvancingTipMach, 3) & " " & Chr(8212) & " Prandtl-Glauert invalid"
	Else If r.SolutionValid = False Then
		col = ColorAccentRed
		txt = "Invalid operating point"
		Dim sm As String = r.StatusMessage.Replace("INVALID: ", "").Replace("INVALID:", "").Trim
		If sm <> "" And sm.Contains("could not be trimmed") = False Then txt = txt & " " & Chr(8212) & " " & sm
	Else If r.AdvancingTipMach >= 0.9 Then
		col = ColorAccentAmber
		txt = "Advancing tip Mach M_adv = " & FormatSig(r.AdvancingTipMach, 3) & " " & Chr(8212) & " compressibility caution"
	Else If tipMach >= 0.8 Or r.CompressibilityWarning Then
		col = ColorAccentAmber
		txt = "Tip Mach M_tip = " & FormatSig(tipMach, 3) & " " & Chr(8212) & " compressibility caution"
	Else
		col = ColorAccentGreen
		txt = "Model valid " & Chr(8212) & " M_tip = " & FormatSig(tipMach, 3) & ", M_adv = " & FormatSig(r.AdvancingTipMach, 3)
	End If
	lblResultStatus.Text = RotorNames.RichText(txt)
	StyleChip(lblResultStatus, col)
	If lblTrimSummary.IsInitialized = False Then Return
	Dim pairTxt As String = PairChipText(ActiveCond.OperatingPair)
	If r.SolutionValid Then
		lblTrimSummary.Text = RotorNames.RichText("Trim: " & pairTxt)
		StyleChip(lblTrimSummary, ColorAccentCyan)
	Else
		lblTrimSummary.Text = RotorNames.RichText("Trim: " & pairTxt & " " & Chr(8212) & " no solution")
		StyleChip(lblTrimSummary, ColorAccentRed)
	End If
End Sub

Private Sub PairChipText(pair As String) As String
	Select pair
		Case "rpm_collective": Return "RPM + Δθ"
		Case "rpm_ct": Return "RPM + C_T"
		Case "rpm_thrust": Return "RPM + T"
		Case "collective_ct": Return "Δθ + C_T"
		Case "collective_thrust": Return "Δθ + T"
		Case "ct_thrust": Return "C_T + T"
		Case Else: Return "Trim Mode"
	End Select
End Sub

Sub lblResultStatus_Click
	If ActiveRes.CompressibilityInvalid Then
		sheet.ShowMessage("Prandtl-Glauert Invalid", "The advancing-tip Mach number has reached or passed the Prandtl-Glauert singularity (M = 1)." & CRLF & CRLF & _
			"Lower the rotor speed or the forward speed, or switch Compressibility to Off in Geometry.")
	Else If ActiveRes.SolutionValid = False Then
		sheet.ShowMessage("Model Status", ActiveRes.StatusMessage & CRLF & CRLF & "Adjust the prescribed operating pair, flight condition, or rotor definition.")
	Else If ActiveRes.CompressibilityWarning Or ActiveRes.AdvancingTipMach >= 0.9 Then
		sheet.ShowMessage("Compressibility Caution", "Tip Mach is at or above 0.80, or advancing-tip Mach is at or above 0.90." & CRLF & CRLF & _
			"The calculation remains finite, but the linear Prandtl-Glauert approximation is outside its preferred range.")
	Else
		sheet.ShowMessage("Model Status", "Valid operating point. Tip Mach and advancing-tip Mach are inside the preferred range.")
	End If
End Sub

Sub lblTrimSummary_Click
	sheet.ShowMessage("Operating Solution", "The operating solution always reports all four linked quantities: Ω, collective Δθ, C_T and thrust T." & CRLF & CRLF & _
		"You prescribe any two in Conditions. RotorCalculator solves the remaining two at the current forward/axial flight condition.")
End Sub

' ====================================================================
' AEROCALCULATOR GRADIENTS & DRAWABLES
' ====================================================================
Sub ButtonGradient(ColorList() As Int, ColorList2() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("BOTTOM_TOP", ColorList2)
	gdwPressed.CornerRadius = 6dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("TOP_BOTTOM", ColorList)
	gdwPressed.CornerRadius = 12dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

' ====================================================================
' NATIVE PAGE NAVIGATION
' ====================================================================
Private Sub ShowPage(Position As Int, Animated As Boolean)
	If Position < 0 Or Position > 2 Then Position = 0
	CurrentPage = Position
	pnlBack0.Visible = (Position = 0)
	pnlBack1.Visible = (Position = 1)
	pnlBack2.Visible = (Position = 2)
	
	Dim tabW As Int = root.Width / 3
	Dim duration As Int = 0
	If Animated Then duration = 150
	line.SetLayoutAnimated(duration, Position * tabW, HeaderHeight - 5dip, tabW, 4dip)
	
	btnTabGeom.TextColor = ColorButText2
	btnTabCond.TextColor = ColorButText2
	btnTabRes.TextColor = ColorButText2
	
	Select Position
		Case 0
			btnTabGeom.TextColor = ColorButText3
		Case 1
			btnTabCond.TextColor = ColorButText3
		Case 2
			btnTabRes.TextColor = ColorButText3
			Dim p As Phone
			p.HideKeyboard(Activity)
			RecalculateRotor
	End Select
End Sub

Sub btnTabGeom_Click
	ShowPage(0, True)
End Sub

Sub btnTabCond_Click
	ShowPage(1, True)
End Sub

Sub btnTabRes_Click
	ShowPage(2, True)
End Sub

' ====================================================================
' AERODYNAMIC CALCULATION & TELEMETRY MAPPING
' ====================================================================
Private Sub ResUnitFor(key As String) As String
	Dim imp As Boolean = (UnitSystem = 1)
	If key.CompareTo("p") = 0 Then
		If imp Then Return "inHg" Else Return "hPa"
	End If
	If key.CompareTo("h") = 0 Then
		If imp Then Return "ft" Else Return "m"
	End If
	Select key
		Case "T", "H", "Y"
			If imp Then Return "lbf" Else Return "N"
		Case "P", "Pi", "P0"
			If imp Then Return "hp" Else Return "kW"
		Case "Q", "Mx", "My"
			If imp Then Return "lb·ft" Else Return "N·m"
		Case "DL"
			If imp Then Return "lbf/ft²" Else Return "N/m²"
		Case "PL"
			If imp Then Return "lbf/hp" Else Return "N/kW"
		Case "vi", "OmR", "Vx", "Vz", "a"
			If imp Then Return "ft/s" Else Return "m/s"
		Case "chi", "alpha", "coll"
			Return "deg"
		Case "rpm"
			Return "rpm"
		Case "T0"
			If imp Then Return "°F" Else Return "°C"
		Case "rho"
			If imp Then Return "slug/ft³" Else Return "kg/m³"
		Case Else
			Return Dash
	End Select
End Sub

' Formatted result value in the active unit system (engine values stay SI).
Private Sub ResTextFor(key As String) As String
	Dim r As RotorResults = ActiveRes
	Dim imp As Boolean = (UnitSystem = 1)
	Dim sg As Int = 4 + ExtraPrecision
	Dim ft As Double = 3.280839895
	Dim omR As Double = r.TipSpeed
	Dim area As Double = cPI * ActiveGeom.Radius * ActiveGeom.Radius
	Dim v As Double = 0
	If key.CompareTo("p") = 0 Then
		If imp Then v = r.PressurePa / 3386.389 Else v = r.PressurePa / 100.0
		Return FormatSig(v, sg)
	End If
	If key.CompareTo("h") = 0 Then
		v = r.AltitudeM
		If imp Then v = v * ft
		Return FormatSig(v, sg)
	End If
	Select key
		Case "T"
			If imp Then v = r.ThrustLbf Else v = r.ThrustN
		Case "P"
			If imp Then v = r.PowerShaftHP Else v = r.PowerShaftKW
		Case "Pi"
			v = r.CQi * r.DensityRho * area * omR * omR * omR / 1000.0
			If imp Then v = v * 1.34102209
		Case "P0"
			v = r.CQ0 * r.DensityRho * area * omR * omR * omR / 1000.0
			If imp Then v = v * 1.34102209
		Case "Q"
			If imp Then v = r.TorqueLbft Else v = r.TorqueNm
		Case "H"
			If imp Then v = r.DragHN * 0.224808943 Else v = r.DragHN
		Case "Y"
			If imp Then v = r.SideForceYLbf Else v = r.SideForceYN
		Case "Mx"
			If imp Then v = r.RollMomentLbft Else v = r.RollMomentNm
		Case "My"
			If imp Then v = r.PitchMomentLbft Else v = r.PitchMomentNm
		Case "DL"
			If area <= 0 Then Return Dash
			v = r.ThrustN / area
			If imp Then v = v * 0.0208854342
		Case "PL"
			If r.PowerShaftKW <= 0.000001 Then Return Dash
			v = r.ThrustN / r.PowerShaftKW
			If imp Then v = v * 0.224808943 / 1.34102209
		Case "vi"
			v = r.InflowLambdaI * omR
			If imp Then v = v * ft
		Case "CTs"
			Dim sg2 As RotorGeometry = zBETEngine.ResolveSolidity(zBETEngine.CloneGeometry(ActiveGeom))
			Dim sigma As Double = sg2.SigmaThrust
			If sigma <= 0 Then sigma = sg2.SigmaRef
			If sigma <= 0 Then Return Dash
			v = r.CT / sigma
		Case "FM"
			If Abs(r.OperatingMu) > 0.0005 Or Abs(r.OperatingMuZ) > 0.0005 Then Return Dash
			v = r.FoM
		Case "LDe": v = r.L_D_eff
		Case "CT": v = r.CT
		Case "CQ": v = r.CQ
		Case "CQi": v = r.CQi
		Case "CQ0": v = r.CQ0
		Case "CH": v = r.CH
		Case "CHi": v = r.CHi
		Case "CH0": v = r.CH0
		Case "CY": v = r.CY
		Case "CMx": v = r.CMx
		Case "CMy": v = r.CMy
		Case "CPair": v = r.CPair
		Case "lam": v = r.InflowLambda
		Case "lami": v = r.InflowLambdaI
		Case "Kx": v = r.InflowKx
		Case "Ky": v = r.InflowKy
		Case "chi": v = r.WakeSkewChiDeg
		Case "Bres": v = r.BFactor
		Case "rpm": v = r.TrimmedRPM
		Case "coll": v = r.TrimmedCollectiveDeg
		Case "mu": v = r.OperatingMu
		Case "muz": v = r.OperatingMuZ
		Case "alpha": v = r.OperatingAlphaDeg
		Case "Vx"
			v = r.OperatingVx
			If imp Then v = v * ft
		Case "Vz"
			v = r.OperatingVz
			If imp Then v = v * ft
		Case "OmR"
			v = omR
			If imp Then v = v * ft
		Case "a"
			v = r.SpeedOfSound
			If imp Then v = v * ft
		Case "Mtip"
			If r.SpeedOfSound <= 0 Then Return Dash
			v = omR / r.SpeedOfSound
		Case "Madv": v = r.AdvancingTipMach
		Case "T0"
			v = r.TemperatureC
			If imp Then v = v * 9.0 / 5.0 + 32.0
		Case "rho"
			v = r.DensityRho
			If imp Then v = v * 0.0019403203
		Case Else
			Return Dash
	End Select
	Return FormatSig(v, sg)
End Sub

Public Sub RecalculateRotor
	If UpdatingUI Then Return
	SyncConditionRepresentations
	ActiveRes = zBETEngine.Calculate(ActiveGeom, ActiveCond)
	RefreshTipFactorRow
	UpdateStatusChips
	SaveSessionState
	Dim cellsReady As Boolean = ResKeys.IsInitialized
	If cellsReady Then
		For i = 0 To ResKeys.Size - 1
			If lblResultUnits(i).IsInitialized Then
				Dim ru As String = ResUnitFor(ResKeys.Get(i))
				If lblResultUnits(i).Text <> ru Then
					lblResultUnits(i).Text = ru
					lblResultUnits(i).TextSize = RotorNames.FitTextSize(ru, TextSp, 11, lblResultUnits(i).Width - 4dip)
				End If
			End If
		Next
	End If
	If ActiveRes.SolutionValid = False Then
		If cellsReady Then
			For i = 0 To ResKeys.Size - 1
				If lblResults(i).IsInitialized Then lblResults(i).Text = Dash
			Next
		End If
		' Keep equivalent μₓ/Vx and μz/Vz/α labels synchronized even when trim fails.
		Dim fallbackGeom As RotorGeometry = zBETEngine.CloneGeometry(ActiveGeom)
		fallbackGeom.RPM = Max(1.0, Min(30000.0, ActiveCond.RPM))
		Dim fallbackCond As FlightCondition = zBETEngine.ResolveConditionAtRPM(ActiveCond, fallbackGeom)
		ActiveCond.Mu = fallbackCond.Mu
		ActiveCond.MuZ = fallbackCond.MuZ
		Return
	End If

	' Keep derived nondimensional state synchronized with the solved operating RPM.
	ActiveCond.Mu = ActiveRes.OperatingMu
	ActiveCond.MuZ = ActiveRes.OperatingMuZ
	If cellsReady = False Then Return
	For i = 0 To ResKeys.Size - 1
		If lblResults(i).IsInitialized Then lblResults(i).Text = ResTextFor(ResKeys.Get(i))
	Next
End Sub

' Significant-digit formatting: sig digits, "." decimal point, non-breaking space as the
' thousands separator for |x| >= 10000, never a negative zero.
Private Sub FormatSig(Value As Double, sig As Int) As String
	If Value <> Value Or Abs(Value) > 1.0E15 Then Return Dash
	Dim a As Double = Abs(Value)
	If a < 1.0E-12 Then Return "0"
	Dim mag As Int = Floor(Logarithm(a, 10))
	Dim dec As Int = Max(0, Min(9, sig - 1 - mag))
	Dim scale As Double = Power(10, dec)
	Dim rounded As Double = Round(a * scale) / scale
	If rounded = 0 Then Return "0"
	Dim mag2 As Int = Floor(Logarithm(rounded, 10))
	If mag2 > mag Then dec = Max(0, Min(9, sig - 1 - mag2))
	Dim s As String = NumberFormat2(rounded, 1, dec, dec, False).Replace(",", ".")
	Dim ip As String = s
	Dim fp As String = ""
	Dim dot As Int = s.IndexOf(".")
	If dot >= 0 Then
		ip = s.SubString2(0, dot)
		fp = s.SubString(dot)
	End If
	If ip.Length >= 5 Then
		Dim sb As StringBuilder
		sb.Initialize
		For j = 0 To ip.Length - 1
			If j > 0 And (ip.Length - j) Mod 3 = 0 Then sb.Append(Chr(160))
			sb.Append(ip.SubString2(j, j + 1))
		Next
		ip = sb.ToString
	End If
	If Value < 0 Then ip = "-" & ip
	Return ip & fp
End Sub

Private Sub RotorTipSpeed As Double
	If ActiveRes.SolutionValid And ActiveRes.TipSpeed > 0 Then Return ActiveRes.TipSpeed
	Dim rpm As Double = Max(1.0, Min(30000.0, ActiveCond.RPM))
	Dim radius As Double = Max(0.02, ActiveGeom.Radius)
	Return rpm * cPI / 30.0 * radius
End Sub

Private Sub UpdateAtmosphere
	ConditionAltitudeM = ClampD(ConditionAltitudeM, -500.0, 11000.0)
	ConditionTemperatureC = ClampD(ConditionTemperatureC, -80.0, 60.0)
	Dim base As Double = Max(0.05, 1.0 - 0.0065 * ConditionAltitudeM / 288.15)
	Dim pRatio As Double = Power(base, 5.2561)
	AmbientPressureHPa = 1013.25 * pRatio
	Dim tKelvin As Double = ConditionTemperatureC + 273.15
	ActiveCond.AltitudeM = ConditionAltitudeM
	ActiveCond.TemperatureC = ConditionTemperatureC
	ActiveCond.PressurePa = AmbientPressureHPa * 100.0
	ActiveCond.Rho = ActiveCond.PressurePa / (287.058 * tKelvin)
	ActiveCond.SpeedOfSound = Sqrt(1.4 * 287.058 * tKelvin)
End Sub

Private Sub SyncConditionRepresentations
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	ActiveCond.ProfileDragModel = "numerical_vectorial"
	UpdateAtmosphere
End Sub

Sub LoadConditionDataToFields
	ConditionAltitudeM = ActiveCond.AltitudeM
	ConditionTemperatureC = ActiveCond.TemperatureC
	If ActiveCond.HorizontalMode <> "" Then HorizontalInputMode = ActiveCond.HorizontalMode
	ConditionHorizontalValue = ActiveCond.HorizontalValue
	If ActiveCond.AxialMode <> "" Then AxialInputMode = ActiveCond.AxialMode
	ConditionAxialValue = ActiveCond.AxialValue
	If RowVal.IsInitialized = False Then
		SyncConditionRepresentations
		Return
	End If
	If RowVal.ContainsKey("h") = False Then
		SyncConditionRepresentations
		Return
	End If
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	StyleUnitButton(RowUnit.Get("h"), "h")
	StyleUnitButton(RowUnit.Get("T0"), "T0")
	SetEdit("h", FormatKey("h", ConditionAltitudeM))
	SetEdit("T0", FormatKey("T0", ConditionTemperatureC))
	RefreshHorizontalInputDisplay
	RefreshAxialInputDisplay
	btnInflowModel.Text = RotorNames.ShortName("inflow_" & ActiveCond.InflowModel).Replace("Coleman-", "Coleman-" & Chr(10))
	SetEdit("kind", FormatKey("kind", ActiveCond.KInd))
	RefreshOperatingControls
	UpdatingUI = wasUpdating
	SyncConditionRepresentations
End Sub

Sub RefreshHorizontalInputDisplay
	If btnHorizontalInput.IsInitialized = False Then Return
	If HorizontalInputMode <> "vx" Then HorizontalInputMode = "mu"
	Dim key As String = HKey
	SetRowKey("hflow", key, CondLevel)
	SetEdit("hflow", FormatKey(key, ConditionHorizontalValue))
End Sub

Sub RefreshAxialInputDisplay
	If btnAxialInput.IsInitialized = False Then Return
	If AxialInputMode <> "vz" And AxialInputMode <> "muz" Then AxialInputMode = "alpha"
	Dim key As String = AKey
	SetRowKey("aflow", key, CondLevel)
	SetEdit("aflow", FormatKey(key, ConditionAxialValue))
End Sub

' ---- trim pair ----
Private Sub PairKey(pair As String, position As Int) As String
	Dim k1 As String = "CTtgt"
	Dim k2 As String = "Ttgt"
	Select pair
		Case "rpm_collective"
			k1 = "rpm"
			k2 = "coll"
		Case "rpm_ct"
			k1 = "rpm"
			k2 = "CTtgt"
		Case "rpm_thrust"
			k1 = "rpm"
			k2 = "Ttgt"
		Case "collective_ct"
			k1 = "coll"
			k2 = "CTtgt"
		Case "collective_thrust"
			k1 = "coll"
			k2 = "Ttgt"
	End Select
	If position = 1 Then Return k1
	Return k2
End Sub

Private Sub PairShort(pair As String) As String
	Select pair
		Case "rpm_collective": Return "Ω + Δθ"
		Case "rpm_ct": Return "Ω + C_T"
		Case "rpm_thrust": Return "Ω + T"
		Case "collective_ct": Return "Δθ + C_T"
		Case "collective_thrust": Return "Δθ + T"
	End Select
	Return "C_T + T"
End Sub

Private Sub PairValue(key As String) As Double
	Select key
		Case "rpm": Return ActiveCond.RPM
		Case "coll": Return ActiveCond.CollectiveDeg
		Case "CTtgt": Return ActiveCond.TargetCT
	End Select
	Return ActiveCond.TargetThrustN
End Sub

Sub RefreshOperatingControls
	If btnOperatingPair.IsInitialized = False Then Return
	btnOperatingPair.Text = RotorNames.RichText(PairShort(ActiveCond.OperatingPair))
	Dim k1 As String = PairKey(ActiveCond.OperatingPair, 1)
	Dim k2 As String = PairKey(ActiveCond.OperatingPair, 2)
	SetRowKey("op1", k1, CondLevel)
	SetRowKey("op2", k2, CondLevel)
	SetEdit("op1", FormatKey(k1, PairValue(k1)))
	SetEdit("op2", FormatKey(k2, PairValue(k2)))
End Sub

' ---- editing: parse leniently, clamp, recalculate; the text itself is committed on Enter / focus loss ----
Sub edtCond_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim e As EditText = Sender
	Dim key As String = "" & e.Tag
	Dim dv As Double = ParseInput(New)
	If dv = NoVal Then Return
	Dim si As Double = InputToCanonical(key, dv)
	If key = "h" Then ConditionAltitudeM = ClampD(si, -500.0, 11000.0)
	If key = "T0" Then ConditionTemperatureC = ClampD(si, -80.0, 60.0)
	UpdateAtmosphere
	RecalculateRotor
End Sub

Sub edtHorizontalValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim dv As Double = ParseInput(New)
	If dv = NoVal Then Return
	Dim key As String = HKey
	ConditionHorizontalValue = InputToCanonical(key, dv)
	If key = "mu" Then ConditionHorizontalValue = ClampD(ConditionHorizontalValue, -0.60, 0.60)
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	RecalculateRotor
End Sub

Sub edtAxialValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim dv As Double = ParseInput(New)
	If dv = NoVal Then Return
	Dim raw As Double = InputToCanonical(AKey, dv)
	Select AxialInputMode
		Case "alpha"
			ConditionAxialValue = ClampD(raw, -89.0, 89.0)
		Case "vz"
			ConditionAxialValue = ClampD(raw, -200.0, 200.0)
		Case "muz"
			ConditionAxialValue = ClampD(raw, -0.50, 0.50)
	End Select
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	RecalculateRotor
End Sub

Sub edtOperatingInput_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim edt As EditText = Sender
	Dim key As String = "" & RowKey.Get("" & edt.Tag)
	Dim dv As Double = ParseInput(New)
	If dv = NoVal Then Return
	Dim value As Double = InputToCanonical(key, dv)
	Select key
		Case "rpm"
			ActiveCond.RPM = ClampD(value, 1.0, 30000.0)
		Case "coll"
			ActiveCond.CollectiveDeg = ClampD(value, -60.0, 60.0)
		Case "CTtgt"
			ActiveCond.TargetCT = ClampD(value, 0.000001, 0.20)
		Case "Ttgt"
			ActiveCond.TargetThrustN = ClampD(value, 0.001, 1.0e8)
	End Select
	RecalculateRotor
End Sub

Sub edtKInd_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim dv As Double = ParseInput(New)
	If dv = NoVal Then Return
	ActiveCond.KInd = ClampD(dv, 1.0, 3.0)
	RecalculateRotor
End Sub

Private Sub CommitCondFields
	Dim p As Phone
	p.HideKeyboard(Activity)
	LoadConditionDataToFields
End Sub

Sub edtCond_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtHorizontalValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtAxialValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtOperatingInput_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtKInd_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtCond_EnterPressed
	CommitCondFields
End Sub

Sub edtHorizontalValue_EnterPressed
	CommitCondFields
End Sub

Sub edtAxialValue_EnterPressed
	CommitCondFields
End Sub

Sub edtOperatingInput_EnterPressed
	CommitCondFields
End Sub

Sub edtKInd_EnterPressed
	CommitCondFields
End Sub

' ---- selectors (themed sheets) ----
Sub btnInflowModel_Click
	Dim keys() As String = Array As String("uniform", "coleman_simple", "coleman_feingold", "drees")
	Dim secs() As String = Array As String("Benchmark, no gradient", "Longitudinal gradient", "Longitudinal and lateral gradients", "Classical longitudinal and lateral")
	Dim items As List
	items.Initialize
	Dim selected As Int = 2
	For i = 0 To keys.Length - 1
		items.Add(RotorNames.FullName("inflow_" & keys(i)) & "|" & secs(i))
		If keys(i) = ActiveCond.InflowModel Then selected = i
	Next
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("inflow", 0), items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	ActiveCond.InflowModel = keys(idx)
	LoadConditionDataToFields
	RecalculateRotor
End Sub

Sub btnOperatingPair_Click
	Dim keys() As String = Array As String("rpm_collective", "rpm_ct", "rpm_thrust", "collective_ct", "collective_thrust", "ct_thrust")
	Dim items As List
	items.Initialize
	items.Add("Rotor Speed Ω + Collective Δθ|Solves C_T and T")
	items.Add("Rotor Speed Ω + Target C_T|Solves Δθ and T")
	items.Add("Rotor Speed Ω + Target Thrust T|Solves Δθ and C_T")
	items.Add("Collective Δθ + Target C_T|Solves Ω and T")
	items.Add("Collective Δθ + Target Thrust T|Solves Ω and C_T")
	items.Add("Target C_T + Target Thrust T|Solves Ω and Δθ")
	Dim selected As Int = 1
	For i = 0 To keys.Length - 1
		If keys(i) = ActiveCond.OperatingPair Then selected = i
	Next
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("trim", 0) & " · prescribe any two", items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	' Only seed after a committed choice: Cancel must leave the physical state intact.
	If ActiveRes.SolutionValid Then
		ActiveCond.RPM = ActiveRes.TrimmedRPM
		ActiveCond.CollectiveDeg = ActiveRes.TrimmedCollectiveDeg
		ActiveCond.TargetCT = Max(1.0e-8, ActiveRes.CT)
		ActiveCond.TargetThrustN = Max(1.0e-6, ActiveRes.ThrustN)
	End If
	ActiveCond.OperatingPair = keys(idx)
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	RefreshOperatingControls
	UpdatingUI = wasUpdating
	RecalculateRotor
End Sub

Sub btnHorizontalInput_Click
	Dim items As List
	items.Initialize
	items.Add(RotorNames.PlainLabel("mu", 0) & "|V_x / (ΩR), dimensionless")
	items.Add(RotorNames.PlainLabel("Vx", 0) & "|Positive forward in the rotor plane")
	Dim selected As Int = 0
	If HorizontalInputMode = "vx" Then selected = 1
	Wait For (sheet.ShowChoice("Horizontal Flow Input", items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim vx As Double = 0.0
	If ActiveRes.SolutionValid Then vx = ActiveRes.OperatingVx Else vx = mu * RotorTipSpeed
	If idx = 0 Then
		HorizontalInputMode = "mu"
		ConditionHorizontalValue = mu
	Else
		HorizontalInputMode = "vx"
		ConditionHorizontalValue = vx
	End If
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	RefreshHorizontalInputDisplay
	UpdatingUI = wasUpdating
	RecalculateRotor
End Sub

Sub btnAxialInput_Click
	Dim items As List
	items.Initialize
	items.Add(RotorNames.PlainLabel("alpha", 0) & "|Positive when the stream arrives from below")
	items.Add(RotorNames.PlainLabel("Vz", 0) & "|Positive when the relative flow goes downward through the disk")
	items.Add(RotorNames.PlainLabel("muz", 0) & "|V_z / (ΩR), positive downward through the disk")
	Dim selected As Int = 0
	If AxialInputMode = "vz" Then selected = 1
	If AxialInputMode = "muz" Then selected = 2
	Wait For (sheet.ShowChoice("Axial Flow Input", items, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim muz As Double = ActiveCond.MuZ
	Dim vtip As Double = RotorTipSpeed
	If idx = 0 Then
		If Abs(mu) < 1.0e-8 And Abs(muz) > 1.0e-10 Then
			ToastMessageShow("At zero airspeed use V_z or μ_z for nonzero axial flow.", True)
			Return
		End If
		AxialInputMode = "alpha"
		ConditionAxialValue = zBETEngine.AlphaFromMuZ(mu, muz)
	Else If idx = 1 Then
		AxialInputMode = "vz"
		ConditionAxialValue = zBETEngine.VzFromMuZ(muz, vtip)
	Else
		AxialInputMode = "muz"
		ConditionAxialValue = muz
	End If
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	RefreshAxialInputDisplay
	UpdatingUI = wasUpdating
	RecalculateRotor
End Sub

