Sub UpdateSweepPlotView
	If ivSweepPlot.IsInitialized = False Then Return
	SyncConditionRepresentations
	Dim plotW As Int = ivSweepPlot.Width
	Dim plotH As Int = ivSweepPlot.Height
	If plotW <= 10 Then plotW = root.Width - 16dip
	If plotH <= 10 Then plotH = 300dip
	Dim familyValues As List = CurrentSweepFamilyValues
	SweepSamplesCache = RotorPopups.BuildSweepSamples(ActiveGeom, ActiveCond, SweepParamSelectedKey, SweepMultiMode, SweepMaxMuVal, familyValues, SweepTrimOnlyHover)
	Dim bmp As Bitmap = RotorPopups.DrawSweepPlot(plotW, plotH, ActiveGeom, ActiveCond, SweepParamSelectedKey, _
		SweepMultiMode, SweepMaxMuVal, SweepXAxisMode, ThemeMode = 1, ExtraPrecision, SweepSamplesCache)
	ivSweepPlot.Bitmap = bmp
	If ActiveRes.SolutionValid Then
		If root.Width <= 360dip Then
			lblSweepCurrentVal.Text = "μ " & NumberFormat2(ActiveRes.OperatingMu, 1, 2, 2, False) & _
				" · Vx " & NumberFormat2(ActiveRes.OperatingVx, 1, 1, 1, False) & " · μz " & NumberFormat2(ActiveRes.OperatingMuZ, 1, 3, 3, False)
		Else
			lblSweepCurrentVal.Text = "ACTIVE · μ=" & NumberFormat2(ActiveRes.OperatingMu, 1, 2, 2, False) & _
				" · Vx=" & NumberFormat2(ActiveRes.OperatingVx, 1, 1, 1, False) & " m/s · μz=" & NumberFormat2(ActiveRes.OperatingMuZ, 1, 3, 3, False)
		End If
	Else
		lblSweepCurrentVal.Text = "ACTIVE · INVALID"
	End If
	UpdateSweepMultiButtonText
	UpdateSweepAuxControls
End Sub

