Private Sub NewSweepButton(ev As String) As Button
	Dim b As Button
	b.Initialize(ev)
	b.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	b.TextColor = ColorAccentCyan
	b.Typeface = Typeface.DEFAULT_BOLD
	b.TextSize = 13 * sc
	b.Padding = Array As Int(3dip, 1dip, 3dip, 1dip)
	b.SingleLine = False
	SetTextLines(b, 2)
	Return b
End Sub

Sub btnViewPolarPlot_Click
	If SweepPopupOpen Then CloseSweepPopup
	pnlSweepPopup.Initialize("pnlSweepPopup")
	pnlSweepPopup.Color = ColorPnlInput5
	root.AddView(pnlSweepPopup, 0, 0, root.Width, root.Height)
	SweepPopupOpen = True
	SweepCrossX = -1
	pnlSweepPopup.BringToFront

	Dim topBarH As Int = 52dip
	Dim gap As Int = 6dip
	Dim btnH As Int = 52dip
	Dim controlsH As Int = 2 * btnH + 3 * gap
	Dim footerH As Int = 58dip

	Dim pnlHeader As Panel
	pnlHeader.Initialize("")
	pnlHeader.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlHeader, 0, 0, root.Width, topBarH)
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "PARAMETER SWEEP"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 15 * sc
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	pnlHeader.AddView(lblTitle, 12dip, 2dip, root.Width - 64dip, 48dip)
	Dim btnClose As Button
	btnClose.Initialize("btnCloseSweepPlot")
	btnClose.Text = "×"
	btnClose.TextColor = ColorAccentRed
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	pnlHeader.AddView(btnClose, root.Width - 52dip, 2dip, 48dip, 48dip)

	' Control grid: row 1 = Y-axis result selector, row 2 = four equal-width selectors.
	Dim pnlControls As Panel
	pnlControls.Initialize("")
	pnlControls.Color = ColorPnlInput2
	pnlSweepPopup.AddView(pnlControls, 0, topBarH, root.Width, controlsH)
	btnSweepParam = NewSweepButton("btnSweepParam")
	btnSweepParam.TextSize = 14 * sc
	btnSweepParam.Tag = "sweepParam"
	pnlControls.AddView(btnSweepParam, 12dip, gap, root.Width - 24dip, btnH)
	btnSweepMultiModel = NewSweepButton("btnSweepMultiModel")
	btnSweepXAxis = NewSweepButton("btnSweepXAxis")
	btnSweepMaxMu = NewSweepButton("btnSweepMaxMu")
	btnSweepTrim = NewSweepButton("btnSweepTrim")
	Dim bw As Int = (root.Width - 24dip - 3 * gap) / 4
	Dim ry As Int = 2 * gap + btnH
	pnlControls.AddView(btnSweepMultiModel, 12dip, ry, bw, btnH)
	pnlControls.AddView(btnSweepXAxis, 12dip + bw + gap, ry, bw, btnH)
	pnlControls.AddView(btnSweepMaxMu, 12dip + 2 * (bw + gap), ry, bw, btnH)
	pnlControls.AddView(btnSweepTrim, 12dip + 3 * (bw + gap), ry, bw, btnH)

	' Scrollable body: plot, status line, readout text area.
	Dim bodyTop As Int = topBarH + controlsH
	Dim bodyH As Int = root.Height - bodyTop - footerH
	svSweep.Initialize(bodyH)
	pnlSweepPopup.AddView(svSweep, 0, bodyTop, root.Width, bodyH)
	Dim plotW As Int = root.Width - 16dip
	Dim plotH As Int
	If ld = 1 Then
		plotH = Max(220dip, bodyH - 8dip)
	Else If root.Width < 600dip Then
		plotH = plotW * 95 / 100
	Else
		plotH = plotW * 70 / 100
	End If
	ivSweepPlot.Initialize("")
	svSweep.Panel.AddView(ivSweepPlot, 8dip, 4dip, plotW, plotH)
	pnlSweepTouch.Initialize("pnlSweepTouch")
	pnlSweepTouch.Color = Colors.Transparent
	svSweep.Panel.AddView(pnlSweepTouch, 8dip, 4dip, plotW, plotH)
	Dim yy As Int = 4dip + plotH + 6dip
	lblSweepCurrentVal.Initialize("")
	lblSweepCurrentVal.TextColor = ColorAccentAmber
	lblSweepCurrentVal.TextSize = 14 * sc
	lblSweepCurrentVal.Typeface = Typeface.DEFAULT_BOLD
	lblSweepCurrentVal.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblSweepCurrentVal.SingleLine = False
	SetTextLines(lblSweepCurrentVal, 6)
	svSweep.Panel.AddView(lblSweepCurrentVal, 12dip, yy, root.Width - 24dip, 46dip)
	lblSweepReadout.Initialize("")
	lblSweepReadout.TextColor = ColorTitleText
	lblSweepReadout.TextSize = 15 * sc
	lblSweepReadout.Gravity = Bit.Or(Gravity.TOP, Gravity.LEFT)
	lblSweepReadout.SingleLine = False
	svSweep.Panel.AddView(lblSweepReadout, 12dip, yy + 50dip, root.Width - 24dip, 40dip)
	svSweep.Panel.Height = yy + 100dip

	Dim pnlFooter As Panel
	pnlFooter.Initialize("")
	pnlFooter.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlFooter, 0, root.Height - footerH, root.Width, footerH)
	Dim btnTable As Button = NewSweepButton("btnSweepTable")
	btnTable.Text = "TABLE"
	Dim btnCsv As Button = NewSweepButton("btnSweepExportCsv")
	btnCsv.Text = "CSV"
	btnCsv.TextColor = ColorAccentGreen
	Dim btnPng As Button = NewSweepButton("btnSweepExportPng")
	btnPng.Text = "PNG"
	btnPng.TextColor = ColorAccentGreen
	btnTable.TextSize = 14 * sc: btnCsv.TextSize = 14 * sc: btnPng.TextSize = 14 * sc
	Dim fw As Int = (root.Width - 24dip - 2 * gap) / 3
	pnlFooter.AddView(btnTable, 12dip, 5dip, fw, 48dip)
	pnlFooter.AddView(btnCsv, 12dip + fw + gap, 5dip, fw, 48dip)
	pnlFooter.AddView(btnPng, 12dip + 2 * (fw + gap), 5dip, fw, 48dip)
	UpdateSweepPlotView
End Sub

' Tap or drag on the plot: crosshair + readout text area.
Sub pnlSweepTouch_Touch(Action As Int, X As Float, Y As Float) As Boolean
	If Action = 0 Then
		Dim jo As JavaObject = pnlSweepTouch
		Dim par As JavaObject = jo.RunMethod("getParent", Null)
		par.RunMethod("requestDisallowInterceptTouchEvent", Array(True))
	End If
	If RotorPopups.LastPlotW > 1 And RotorPopups.LastXMax > 0 Then
		Dim xv As Double = (X - RotorPopups.LastPlotLeft) / RotorPopups.LastPlotW * RotorPopups.LastXMax
		SweepCrossX = ClampD(xv, 0, RotorPopups.LastXMax)
		RedrawSweepPlot
	End If
	Return True
End Sub

Sub btnSweepParam_Click
	Dim items As List
	items.Initialize
	For i = 0 To RotorPopups.SweepParamKeys.Size - 1
		items.Add(RotorPopups.SweepParamLabels.Get(i) & "|" & RotorPopups.SweepParamUnit(RotorPopups.SweepParamKeys.Get(i)))
	Next
	Dim selected As Int = RotorPopups.SweepParamKeys.IndexOf(SweepParamSelectedKey)
	Wait For (sheet.ShowChoice("Y-Axis Result", items, selected)) Complete (idx As Int)
	If idx < 0 Or idx >= RotorPopups.SweepParamKeys.Size Then Return
	SweepParamSelectedKey = RotorPopups.SweepParamKeys.Get(idx)
	SweepParamSelectedLabel = RotorPopups.SweepParamLabels.Get(idx)
	UpdateSweepPlotView
End Sub

Private Sub SweepBtnText(caption As String, value As String) As CSBuilder
	Dim chev As String = " " & Chr(9662)
	If root.Width <= 340dip Then chev = ""
	Return RotorNames.RichText(caption & CRLF & value & chev)
End Sub

Private Sub RefreshSweepControls
	If btnSweepParam.IsInitialized = False Then Return
	Dim idx As Int = RotorPopups.SweepParamKeys.IndexOf(SweepParamSelectedKey)
	If idx < 0 Then idx = 0
	SweepParamSelectedLabel = RotorPopups.SweepParamLabels.Get(idx)
	btnSweepParam.Text = RotorNames.RichText(SweepParamSelectedLabel & " " & Chr(9662))
	Dim cv As String
	Select SweepMultiMode
		Case 0: cv = "Models"
		Case 1: cv = "α Set"
		Case 2: cv = "Vz Set"
		Case 3: cv = "μz Set"
		Case Else: cv = "Active"
	End Select
	btnSweepMultiModel.Text = SweepBtnText("Curves", cv)
	If SweepXAxisMode = 1 Then btnSweepXAxis.Text = SweepBtnText("X axis", "V_x") Else btnSweepXAxis.Text = SweepBtnText("X axis", "μ_x")
	btnSweepMaxMu.Text = SweepBtnText("Range", "≤ " & NumberFormat2(SweepMaxMuVal, 1, 2, 2, False))
	If ActiveCond.OperatingPair = "rpm_collective" Then
		btnSweepTrim.Text = SweepBtnText("Trim", "Fixed")
		btnSweepTrim.Enabled = False
	Else
		btnSweepTrim.Enabled = True
		Dim tv As String
		Select SweepTrimMode
			Case "coll_all": tv = "Δθ All"
			Case "rpm_all": tv = "Ω All"
			Case "coll_hover": tv = "Δθ Hover"
			Case "rpm_hover": tv = "Ω Hover"
			Case Else: tv = "None"
		End Select
		btnSweepTrim.Text = SweepBtnText("Trim", tv)
	End If
End Sub

Sub btnSweepMultiModel_Click
	Dim options As List
	options.Initialize
	options.Add("Inflow Models|All four inflow models, active settings")
	options.Add("Rotor α Family|Several disk angles of attack")
	options.Add("Axial Vz Family|Several climb speeds")
	options.Add("Axial μz Family|Several axial flow ratios")
	options.Add("Active Only|Only the current condition")
	Dim hasValues As Boolean = (SweepMultiMode >= 1 And SweepMultiMode <= 3)
	If hasValues Then options.Add("Edit Family Values…|Comma-separated list for the selected family")
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("family", 0), options, SweepMultiMode)) Complete (idx As Int)
	If idx < 0 Then Return
	If idx = 5 Then
		btnSweepValues_Click
		Return
	End If
	SweepMultiMode = idx
	SweepCrossX = -1
	UpdateSweepPlotView
End Sub

Private Sub CurrentSweepFamilyText As String
	Select SweepMultiMode
		Case 1: Return SweepAlphaValues
		Case 2: Return SweepVzValues
		Case 3: Return SweepMuZValues
	End Select
	Return ""
End Sub

Private Sub SetCurrentSweepFamilyText(value As String)
	Select SweepMultiMode
		Case 1: SweepAlphaValues = value
		Case 2: SweepVzValues = value
		Case 3: SweepMuZValues = value
	End Select
End Sub

Private Sub ParseSweepFamilyValues(raw As String) As List
	Dim values As List
	values.Initialize
	Dim parts() As String = Regex.Split(",", raw)
	If parts.Length < 1 Or parts.Length > 9 Then Return values
	For valueIndex = 0 To parts.Length - 1
		Dim token As String = parts(valueIndex).Trim
		If token = "" Then
			values.Clear
			Return values
		End If
		Try
			Dim v As Double = token
			values.Add(v)
		Catch
			values.Clear
			Return values
		End Try
	Next
	Return values
End Sub

Private Sub CurrentSweepFamilyValues As List
	Dim values As List
	If SweepMultiMode >= 1 And SweepMultiMode <= 3 Then values = ParseSweepFamilyValues(CurrentSweepFamilyText) Else values.Initialize
	If SweepMultiMode = 1 And values.Size = 0 Then values = ParseSweepFamilyValues("-10,-5,0,5,10")
	If SweepMultiMode = 2 And values.Size = 0 Then values = ParseSweepFamilyValues("-10,-5,0,5,10")
	If SweepMultiMode = 3 And values.Size = 0 Then values = ParseSweepFamilyValues("-0.05,-0.025,0,0.025,0.05")
	Return values
End Sub

Sub btnSweepValues_Click
	If SweepMultiMode < 1 Or SweepMultiMode > 3 Then Return
	If SweepValuesPopupOpen Then CloseSweepValuesPopup
	pnlSweepValuesPopup.Initialize("")
	pnlSweepValuesPopup.Color = 0x99000000
	root.AddView(pnlSweepValuesPopup, 0, 0, root.Width, root.Height)
	SweepValuesPopupOpen = True
	pnlSweepValuesPopup.BringToFront
	Dim cardW As Int = Min(root.Width - 24dip, 520dip)
	Dim cardH As Int = 230dip
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlSweepValuesPopup.AddView(card, (root.Width-cardW)/2, (root.Height-cardH)/2, cardW, cardH)
	Dim title As Label
	title.Initialize("")
	Select SweepMultiMode
		Case 1: title.Text = "α FAMILY VALUES [deg]"
		Case 2: title.Text = "Vz FAMILY VALUES [m/s]"
		Case Else: title.Text = "μz FAMILY VALUES [-]"
	End Select
	title.TextColor = ColorAccentCyan
	title.Typeface = Typeface.DEFAULT_BOLD
	title.TextSize = 15
	card.AddView(title, 16dip, 12dip, cardW-32dip, 28dip)
	Dim hint As Label
	hint.Initialize("")
	If SweepMultiMode = 3 Then
		hint.Text = "Enter 1–9 comma-separated axial ratios. Example: -0.05, 0, 0.05"
	Else
		hint.Text = "Enter 1–9 comma-separated values. Example: -10, -5, 0, 5, 10"
	End If
	hint.TextColor = ColorButText2
	hint.TextSize = 12.5
	hint.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	card.AddView(hint, 16dip, 44dip, cardW-32dip, 40dip)
	edtSweepValues.Initialize("")
	edtSweepValues.Text = CurrentSweepFamilyText
	edtSweepValues.TextColor = ColorEdtText
	edtSweepValues.Color = ColorEdt
	edtSweepValues.TextSize = 15
	edtSweepValues.SingleLine = True
	card.AddView(edtSweepValues, 16dip, 90dip, cardW-32dip, 48dip)
	Dim btnCancel As Button = CreateRowButton("CANCEL", "btnCancelSweepValues")
	Dim btnApply As Button = CreateRowButton("APPLY", "btnApplySweepValues")
	card.AddView(btnCancel, 16dip, 158dip, (cardW-38dip)/2, 48dip)
	card.AddView(btnApply, 22dip+(cardW-38dip)/2, 158dip, (cardW-38dip)/2, 48dip)
End Sub

Sub btnApplySweepValues_Click
	Dim values As List = ParseSweepFamilyValues(edtSweepValues.Text)
	If values.Size = 0 Then
		ToastMessageShow("Enter 1–9 valid numbers separated by commas.", True)
		Return
	End If
	For familyIndex = 0 To values.Size - 1
		Dim familyValue As Double = values.Get(familyIndex)
		If SweepMultiMode = 1 And (familyValue <= -89 Or familyValue >= 89) Then
			ToastMessageShow("α family values must stay between -89° and +89°.", True)
			Return
		End If
		If SweepMultiMode = 2 And Abs(familyValue) > 200 Then
			ToastMessageShow("Vz family values must stay within ±200 m/s.", True)
			Return
		End If
		If SweepMultiMode = 3 And Abs(familyValue) > 0.50 Then
			ToastMessageShow("μz family values must stay within ±0.50.", True)
			Return
		End If
	Next
	SetCurrentSweepFamilyText(edtSweepValues.Text.Trim)
	CloseSweepValuesPopup
	UpdateSweepPlotView
End Sub

Sub btnCancelSweepValues_Click
	CloseSweepValuesPopup
End Sub

Private Sub CloseSweepValuesPopup
	If SweepValuesPopupOpen Then
		pnlSweepValuesPopup.RemoveView
		SweepValuesPopupOpen = False
	End If
End Sub

