	Private btnTabRes As Button
	Private line As Panel
	Private lblAppTitle As Label
	Private PopupMenu As RSPopupMenu
	Private pnlMenuAnchor As Panel
	Private pnlUnitPopup As Panel
	Private UnitPopupOpen As Boolean = False
	Private pnlSettingsPopup As Panel
	Private SettingsPopupOpen As Boolean = False
	Private pnlHelpPopup As Panel
	Private HelpPopupOpen As Boolean = False
	Private wvHelp As WebView
	Private btnSettingTheme As Button
	Private btnSettingUnits As Button
	Private btnSettingPrecision As Button
	Private btnSettingPalette As Button
	Private btnUnitMode As Button
	Private btnUnitSwap As Button
	Private lblUnitFrom As Label
	Private UnitModeIdx As Int
	Private edtUnitValue As EditText
	Private lblUnitResult As Label
	
