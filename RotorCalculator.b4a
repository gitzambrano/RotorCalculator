Private Sub AddConditionSectionHeader(y As Int, title As String) As Int
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title
	lbl.TextColor = ColorAccentGreen
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextSize = 10 * sc
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scvCond.Panel.AddView(lbl, UiContentLeft + 12dip, y, UiContentW - 24dip, 26dip)
	Return y + 28dip
End Sub

' ====================================================================
' PAGE 2: RESULTS / OUTPUTS (AeroCalculator scvMain2 Architecture)
' ====================================================================
Private Sub BuildPageRes
	pnlBack2.Initialize("")
	pnlBack2.Color = ColorPnlInput5
	scvRes.Initialize(3600)
	pnlBack2.AddView(scvRes, 0, 0, root.Width, root.Height - HeaderHeight)
	
	btnViewPolarPlot.Initialize("btnViewPolarPlot")
	btnViewPolarPlot.Text = "OPEN PARAMETER SWEEP"
	btnViewPolarPlot.Typeface = Typeface.DEFAULT_BOLD
	btnViewPolarPlot.TextColor = ColorAccentCyan
	btnViewPolarPlot.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	If root.Width <= 340dip Then btnViewPolarPlot.TextSize = 12 Else btnViewPolarPlot.TextSize = 14 * sc
	scvRes.Panel.AddView(btnViewPolarPlot, UiContentLeft + UiContentW*3/100, 8dip, UiContentW*94/100, 48dip)
	
	lblResultStatus.Initialize("lblResultStatus")
	lblResultStatus.Text = "MODEL STATUS · ---"
	lblResultStatus.TextColor = ColorButText2
	lblResultStatus.Typeface = Typeface.DEFAULT_BOLD
	lblResultStatus.TextSize = 10 * sc
	lblResultStatus.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scvRes.Panel.AddView(lblResultStatus, UiContentLeft + UiContentW*4/100, 58dip, UiContentW*92/100, 28dip)
	
	lblTrimSummary.Initialize("lblTrimSummary")
	lblTrimSummary.Text = "TRIM SOLUTION · ---"
	lblTrimSummary.TextColor = ColorAccentCyan
	lblTrimSummary.Typeface = Typeface.DEFAULT_BOLD
	lblTrimSummary.TextSize = 9.5 * sc
	lblTrimSummary.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblTrimSummary.SingleLine = True
	scvRes.Panel.AddView(lblTrimSummary, UiContentLeft + UiContentW*4/100, 86dip, UiContentW*92/100, 28dip)
	
	Dim labels As List
	labels.Initialize2(Array As String( _
		"Total Thrust (T)", "Shaft Power (P)", "Total Torque (Q)", "In-Plane Drag (H)", _
		"Thrust Coef (CT)", "Torque Coef (CQ)", "Induced Torque (CQi)", "Profile Torque (CQ0)", _
		"In-Plane Coef (CH)", "Induced In-Plane (CHi)", "Profile In-Plane (CH0)", "Side Force Coef (CY)", _
		"Roll Moment Coef (CMx)", "Pitch Moment Coef (CMy)", "Air Power Coef (CPair)", _
		"Figure of Merit (FoM)", "Effective L/D Ratio", _
		"Total Inflow Ratio (λ)", "Induced Inflow Ratio (λi)", "Longitudinal Inflow (Kx)", _
		"Lateral Inflow (Ky)", "Wake Skew Angle (χ)", "Tip-Loss Factor (B)", _
		"Solved RPM", "Collective Increment (Δθ)", "Solved CT", "Solved Thrust", _
		"Advance Ratio (μ)", "Forward Speed (Vx)", "Axial Ratio (μz)", "Axial Speed (Vz)", "Rotor AoA (α)", _
		"Tip Speed (ΩR)", "Tip Mach", "Advancing Tip Mach (Mat)", _
		"Altitude", "Temperature", "Air Density (ρ)", "Ambient Pressure (p)", "Speed of Sound (a)" _
	))
	Dim y As Int = 120dip
	Dim rowH As Int = 48dip
	Dim sectionH As Int = 25dip
	For i = 0 To labels.Size - 1
		Dim sectionTitle As String = ""
		Select i
			Case 0: sectionTitle = "DIMENSIONAL PERFORMANCE"
			Case 4: sectionTitle = "AERODYNAMIC COEFFICIENTS"
			Case 15: sectionTitle = "EFFICIENCY"
			Case 17: sectionTitle = "INFLOW & WAKE"
			Case 23: sectionTitle = "OPERATING STATE & ATMOSPHERE"
		End Select
		If sectionTitle <> "" Then
			Dim sh As Label
			sh.Initialize("")
			sh.Text = sectionTitle
			sh.TextColor = ColorAccentGreen
			sh.Typeface = Typeface.DEFAULT_BOLD
			sh.TextSize = 10 * sc
			sh.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
			scvRes.Panel.AddView(sh, UiContentLeft + UiContentW*4/100, y, UiContentW*92/100, sectionH)
			y = y + sectionH
		End If
		Dim row As Panel
		row.Initialize("")
		If i Mod 2 = 0 Then row.Color = ColorPnlInput4 Else row.Color = ColorPnlInput3
		scvRes.Panel.AddView(row, UiContentLeft, y, UiContentW, rowH)
		Dim sep As Panel
		sep.Initialize("")
		sep.Color = ColorPnlLine3
		scvRes.Panel.AddView(sep, UiContentLeft, y + rowH - 1dip, UiContentW, 1dip)
		Dim fullLabel As String = labels.Get(i)
		Dim lbl As Label
		lbl.Initialize("lblResultTip")
		lbl.Tag = fullLabel
		lbl.Text = ResultDisplayLabel(fullLabel)
		lbl.TextColor = ColorTitleText
		lbl.Typeface = Typeface.DEFAULT_BOLD
		If root.Width <= 340dip Then lbl.TextSize = 11 Else lbl.TextSize = 12.5 * sc
		lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lbl.SingleLine = True
		row.AddView(lbl, row.Width*4/100, 0, row.Width*58/100, rowH)
		lblResults(i).Initialize("")
		lblResults(i).Text = "---"
		lblResults(i).TextColor = ColorAccentCyan
		lblResults(i).Typeface = Typeface.DEFAULT_BOLD
		If root.Width <= 340dip Then lblResults(i).TextSize = 11 Else lblResults(i).TextSize = 12.5 * sc
		lblResults(i).Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
		lblResults(i).SingleLine = True
		row.AddView(lblResults(i), row.Width*62/100, 0, row.Width*34/100, rowH)
		y = y + rowH
	Next
	scvRes.Panel.Height = y + 24dip
End Sub

' Compact labels are used only when the available width requires them.
' The full engineering meaning remains available through the row/result tooltip.
Private Sub InputDisplayLabel(fullText As String) As String
	If root.Width > 340dip Then Return fullText
	Select fullText
		Case "Rotor Preset": Return "Preset"
		Case "Rotor Name": Return "Name"
		Case "Blade Count": Return "Blades"
		Case "Root Cutout": Return "Root cut."
		Case "Root Chord c0": Return "Root c0"
		Case "Tip Chord c1": Return "Tip c1"
		Case "Reference Solidity": Return "σref"
		Case "Aspect Ratio": Return "AR"
		Case "Root Incidence": Return "θ root"
		Case "Tip Incidence": Return "θ tip"
		Case "Geometric Solidity": Return "σgeom"
		Case "Thrust Solidity": Return "σthrust"
		Case "Reference Blade Area": Return "Ref. area"
		Case "Active Blade Area": Return "Active area"
		Case "Total Twist": Return "Twist"
		Case "Lift Slope a0": Return "Lift a0"
		Case "Profile Cd0": Return "Cd0"
		Case "Fixed Tip Factor B": Return "Tip factor B"
		Case "Temperature": Return "Temp."
		Case "Horizontal Flow": Return "Horizontal"
		Case "Axial Flow": Return "Axial"
		Case "Operating Inputs": Return "Operating pair"
		Case "Induced Factor Kind": Return "Kind"
		Case "Inflow Model": Return "Inflow"
		Case "Compressibility": Return "Compress."
		Case Else: Return fullText
	End Select
End Sub

Private Sub HeaderRotorName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim n As String = fullName.ToLowerCase
	If n.Contains("uh-60") Then Return "UH-60"
	If n.Contains("bell 206") Then Return "Bell 206"
	If n.Contains("bo 105") Or n.Contains("bo105") Then Return "Bo 105"
	If n.Contains("r44") Then Return "R44"
	If n.Contains("dji") Then Return "DJI"
	If n.Contains("evtol") Then Return "eVTOL"
	Return fullName
End Sub

Private Sub RotorListName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim shortName As String = HeaderRotorName(fullName)
	If fullName.ToLowerCase.Contains("(copy)") And shortName.ToLowerCase.Contains("(copy)") = False Then
		shortName = shortName & " (Copy)"
	End If
	If shortName.Length > 24 Then shortName = shortName.SubString2(0, 21) & "…"
	Return shortName
End Sub

Private Sub ResultDisplayLabel(fullText As String) As String
	If root.Width > 380dip Then Return fullText
	Select fullText
		Case "Induced Torque (CQi)": Return "Induced (CQi)"
		Case "Profile Torque (CQ0)": Return "Profile (CQ0)"
		Case "Induced In-Plane (CHi)": Return "Induced (CHi)"
		Case "Profile In-Plane (CH0)": Return "Profile (CH0)"
		Case "Air Power Coef (CPair)": Return "Air Power (CPair)"
		Case "Pitch Moment Coef (CMy)": Return "Pitch Moment (CMy)"
		Case "Roll Moment Coef (CMx)": Return "Roll Moment (CMx)"
		Case "Total Inflow Ratio (λ)": Return "Total Inflow (λ)"
		Case "Induced Inflow Ratio (λi)": Return "Induced Inflow (λi)"
		Case "Longitudinal Inflow (Kx)": Return "Long. Inflow (Kx)"
		Case "Lateral Inflow (Ky)": Return "Lat. Inflow (Ky)"
		Case "Advancing Tip Mach (Mat)": Return "Adv. Tip Mach (Mat)"
		Case "Forward Speed (Vx)": Return "Forward Vx"
		Case "Axial Speed (Vz)": Return "Axial Vz"
		Case "Solved RPM": Return "RPM"
		Case "Collective Increment (Δθ)": Return "Collective Δθ"
		Case "Solved CT": Return "CT (solved)"
		Case "Solved Thrust": Return "Thrust (solved)"
		Case "Ambient Pressure (p)": Return "Pressure (p)"
		Case "Speed of Sound (a)": Return "Sound Speed (a)"
		Case Else: Return fullText
	End Select
End Sub

Sub lblResultStatus_Click
	If ActiveRes.SolutionValid = False Then
		Msgbox(ActiveRes.StatusMessage & CRLF & CRLF & "Adjust the prescribed operating pair, flight condition, or rotor definition.", "Model Status")
	Else If ActiveRes.CompressibilityWarning Then
		Msgbox("Advancing-tip Mach is at or above 0.80 while Prandtl-Glauert is enabled." & CRLF & CRLF & _
			"The calculation remains finite, but the linear compressibility approximation is outside its preferred range.", "Compressibility Caution")
	Else
		ToastMessageShow("Model status: valid operating point.", False)
	End If
End Sub

Sub lblResultTip_Click
	Dim l As Label = Sender
	ToastMessageShow(ResultTooltip("" & l.Tag), True)
End Sub

Private Sub ResultTooltip(labelText As String) As String
	Select labelText
		Case "Total Thrust (T)": Return "Solved rotor thrust T at the current flight condition."
		Case "Shaft Power (P)": Return "Mechanical shaft power P = ΩQ."
		Case "Total Torque (Q)": Return "Aerodynamic torque about the rotor shaft."
		Case "In-Plane Drag (H)": Return "Rotor in-plane H force along the longitudinal disk axis."
		Case "Thrust Coef (CT)": Return "CT = T / [ρ A (ΩR)²]."
		Case "Torque Coef (CQ)": Return "CQ = Q / [ρ A (ΩR)² R], equal to shaft-power coefficient CPshaft."
		Case "Induced Torque (CQi)": Return "Induced torque/power contribution from the blade-element torque integral or configured energy balance."
		Case "Profile Torque (CQ0)": Return "Profile-drag torque from Numerical Vectorial radial/azimuthal integration."
		Case "In-Plane Coef (CH)": Return "Total longitudinal in-plane force coefficient CH = CHi + CH0."
		Case "Induced In-Plane (CHi)": Return "Induced contribution to longitudinal in-plane force coefficient."
		Case "Profile In-Plane (CH0)": Return "Numerical Vectorial profile-drag contribution to CH."
		Case "Side Force Coef (CY)": Return "Rotor lateral side-force coefficient."
		Case "Roll Moment Coef (CMx)": Return "Rotor rolling-moment coefficient about the x axis."
		Case "Pitch Moment Coef (CMy)": Return "Rotor pitching-moment coefficient about the y axis."
		Case "Air Power Coef (CPair)": Return "Air-power coefficient from induced, axial-flow, profile and translational energy terms."
		Case "Figure of Merit (FoM)": Return "Hover efficiency metric using ideal induced power divided by Kind·ideal induced power plus profile power."
		Case "Effective L/D Ratio": Return "(L/D)eff = μ CT / CPair = T Vx / Pair when the forward-power interpretation is applicable."
		Case "Total Inflow Ratio (λ)": Return "λ = μz + λi."
		Case "Induced Inflow Ratio (λi)": Return "Positive induced downwash inflow ratio."
		Case "Longitudinal Inflow (Kx)": Return "Longitudinal first-harmonic inflow-gradient factor."
		Case "Lateral Inflow (Ky)": Return "Lateral first-harmonic inflow-gradient factor."
		Case "Wake Skew Angle (χ)": Return "Wake-skew angle derived from in-plane and total inflow components."
		Case "Tip-Loss Factor (B)": Return "Effective tip-radius factor used by the selected tip-loss model."
		Case "Solved RPM": Return "Operating RPM after solving the selected pair of RPM, collective, CT and thrust constraints."
		Case "Collective Increment (Δθ)": Return "Solved uniform collective increment added equally to root and tip incidence."
		Case "Solved CT": Return "CT from the final trimmed operating state."
		Case "Solved Thrust": Return "Dimensional thrust from the final trimmed operating state."
		Case "Advance Ratio (μ)": Return "μ = Vx/(ΩR) at the solved operating RPM."
		Case "Forward Speed (Vx)": Return "Dimensional forward in-plane relative velocity corresponding to μ."
		Case "Axial Ratio (μz)": Return "μz = Vz/(ΩR); positive means downward relative flow through the disk."
		Case "Axial Speed (Vz)": Return "Positive Vz represents positive climb rate: relative wind arrives from above and passes downward through the disk."
		Case "Rotor AoA (α)": Return "Rotor angle of attack; positive α means relative wind arrives from below. μz = -μ tan α."
		Case "Tip Speed (ΩR)": Return "Solved rotational tip speed ΩR."
		Case "Tip Mach": Return "Rotational tip Mach ΩR/a."
		Case "Advancing Tip Mach (Mat)": Return "Approximate advancing-tip Mach using ΩR(1+μ)/a."
		Case "Altitude": Return "Pressure altitude used by the atmosphere model."
		Case "Temperature": Return "Ambient temperature used by density and speed-of-sound calculations."
		Case "Air Density (ρ)": Return "Ambient density ρ used in dimensional aerodynamic scaling."
		Case "Ambient Pressure (p)": Return "Ambient static pressure from the active atmosphere."
		Case "Speed of Sound (a)": Return "Local speed of sound used for Mach and compressibility."
		Case Else: Return labelText
	End Select
End Sub

' Text row for rotor names; numeric rows stay numeric-only.
Private Sub AddTextInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, evtName As String) As EditText
	Dim lbl As Label = CreateRowLabel(lblText, "lblRowTip")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 30 / 100, tb * sc)
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	edt.Text = defVal
	edt.TextSize = 13 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	edt.SingleLine = True
	edt.ForceDoneButton = True
	pnl.AddView(edt, pnl.Width * 37 / 100, ib * sc, pnl.Width * 60 / 100, tb * sc)
	Return edt
End Sub

' Helper to create 30%x | 36%x | 20%x standard input rows
Private Sub AddFullInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, unitText As String, evtName As String) As EditText
	Dim lbl As Label = CreateRowLabel(lblText, "lblRowTip")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 30 / 100, tb * sc)
	
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	edt.Text = defVal
	edt.TextSize = 13 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.HintColor = ColorEdtHint
	edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.CENTER_HORIZONTAL)
	edt.InputType = Bit.Or(edt.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edt.ForceDoneButton = True
	edt.SingleLine = True
	
	pnl.AddView(edt, pnl.Width * 37 / 100, ib * sc, pnl.Width * 36 / 100, tb * sc)
	
	Dim lblUnit As Label
	lblUnit.Initialize("")
	lblUnit.Text = unitText
	If root.Width <= 340dip Then lblUnit.TextSize = 11 Else lblUnit.TextSize = 12 * sc
	lblUnit.TextColor = ColorButText2
	lblUnit.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	lblUnit.SingleLine = True
	pnl.AddView(lblUnit, pnl.Width * 77 / 100, ib * sc, pnl.Width * 17 / 100, tb * sc)
	
	Return edt
End Sub

Private Sub CreateRowLabel(txt As String, evt As String) As Label
	Dim lbl As Label
	lbl.Initialize(evt)
	lbl.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then lbl.TextSize = 12 Else lbl.TextSize = 13 * sc
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextColor = ColorButText1
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lbl.SingleLine = True
	lbl.Tag = txt
	Return lbl
End Sub

Private Sub CreateRowButton(txt As String, evt As String) As Button
	Dim btn As Button
	btn.Initialize(evt)
	btn.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then btn.TextSize = 12 Else btn.TextSize = 13 * sc
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorButText1
	btn.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	Return btn
End Sub

' ====================================================================
' AEROCALCULATOR GRADIENTS & DRAWABLES
' ====================================================================
Sub ButtonGradient(ColorList() As Int, ColorList2() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("BOTTOM_TOP", ColorList2)
	gdwPressed.CornerRadius = 6dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("TOP_BOTTOM", ColorList)
	gdwPressed.CornerRadius = 12dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

' ====================================================================
' NATIVE PAGE NAVIGATION
' ====================================================================
Private Sub ShowPage(Position As Int, Animated As Boolean)
	If Position < 0 Or Position > 2 Then Position = 0
	CurrentPage = Position
	pnlBack0.Visible = (Position = 0)
	pnlBack1.Visible = (Position = 1)
	pnlBack2.Visible = (Position = 2)
	
	Dim tabW As Int = root.Width / 3
	Dim duration As Int = 0
	If Animated Then duration = 150
	line.SetLayoutAnimated(duration, Position * tabW, HeaderHeight - 5dip, tabW, 4dip)
	
	btnTabGeom.TextColor = ColorButText2
	btnTabCond.TextColor = ColorButText2
	btnTabRes.TextColor = ColorButText2
	
	Select Position
		Case 0
			btnTabGeom.TextColor = ColorButText3
		Case 1
			btnTabCond.TextColor = ColorButText3
		Case 2
			btnTabRes.TextColor = ColorButText3
			Dim p As Phone
			p.HideKeyboard(Activity)
			RecalculateRotor
	End Select
End Sub

Sub btnTabGeom_Click
	ShowPage(0, True)
End Sub

Sub btnTabCond_Click
	ShowPage(1, True)
End Sub

Sub btnTabRes_Click
	ShowPage(2, True)
End Sub

' ====================================================================
' AERODYNAMIC CALCULATION & TELEMETRY MAPPING
' ====================================================================
Public Sub RecalculateRotor
	If UpdatingUI Then Return
	SyncConditionRepresentations
	ActiveRes = zBETEngine.Calculate(ActiveGeom, ActiveCond)
	UpdateTrimSummary
	
	If lblResultStatus.IsInitialized Then
		If ActiveRes.SolutionValid = False Then
			lblResultStatus.Text = "MODEL STATUS · INVALID OPERATING POINT"
			lblResultStatus.TextColor = ColorAccentRed
			For i = 0 To 39
				If lblResults(i).IsInitialized Then lblResults(i).Text = "---"
			Next
			Return
		Else If ActiveRes.CompressibilityWarning Then
			lblResultStatus.Text = "MODEL STATUS · PG CAUTION (Mat ≥ 0.80)"
			lblResultStatus.TextColor = ColorAccentAmber
		Else
			lblResultStatus.Text = "MODEL STATUS · VALID"
			lblResultStatus.TextColor = ColorAccentGreen
		End If
	End If
	
	' Keep derived nondimensional state synchronized with the solved operating RPM.
	ActiveCond.Mu = ActiveRes.OperatingMu
	ActiveCond.MuZ = ActiveRes.OperatingMuZ
	If lblHorizontalDerived.IsInitialized Then RefreshFlowDerivedLabels
	
	Dim tipMach As Double = 0.0
	If ActiveRes.SpeedOfSound > 0 Then tipMach = ActiveRes.TipSpeed / ActiveRes.SpeedOfSound
	
	If UnitSystem = 0 Then
		lblResults(0).Text = FormatOutputValue(ActiveRes.ThrustN, 0) & " N"
		lblResults(1).Text = FormatOutputValue(ActiveRes.PowerShaftKW, 1) & " kW"
		lblResults(2).Text = FormatOutputValue(ActiveRes.TorqueNm, 1) & " N·m"
		lblResults(3).Text = FormatOutputValue(ActiveRes.DragHN, 1) & " N"
	Else
		lblResults(0).Text = FormatOutputValue(ActiveRes.ThrustLbf, 0) & " lbf"
		lblResults(1).Text = FormatOutputValue(ActiveRes.PowerShaftHP, 1) & " hp"
		lblResults(2).Text = FormatOutputValue(ActiveRes.TorqueLbft, 1) & " lb·ft"
		lblResults(3).Text = FormatOutputValue(ActiveRes.DragHN * 0.224808943, 1) & " lbf"
	End If
	
	' All aerodynamic coefficients stay together.
	lblResults(4).Text = FormatOutputValue(ActiveRes.CT, 5)
	lblResults(5).Text = FormatOutputValue(ActiveRes.CQ, 6)
	lblResults(6).Text = FormatOutputValue(ActiveRes.CQi, 6)
	lblResults(7).Text = FormatOutputValue(ActiveRes.CQ0, 6)
	lblResults(8).Text = FormatOutputValue(ActiveRes.CH, 6)
	lblResults(9).Text = FormatOutputValue(ActiveRes.CHi, 6)
	lblResults(10).Text = FormatOutputValue(ActiveRes.CH0, 6)
	lblResults(11).Text = FormatOutputValue(ActiveRes.CY, 6)
	lblResults(12).Text = FormatOutputValue(ActiveRes.CMx, 6)
	lblResults(13).Text = FormatOutputValue(ActiveRes.CMy, 6)
	lblResults(14).Text = FormatOutputValue(ActiveRes.CPair, 6)
	lblResults(15).Text = FormatOutputValue(ActiveRes.FoM, 4)
	lblResults(16).Text = FormatOutputValue(ActiveRes.L_D_eff, 2)
	lblResults(17).Text = FormatOutputValue(ActiveRes.InflowLambda, 5)
	lblResults(18).Text = FormatOutputValue(ActiveRes.InflowLambdaI, 5)
	lblResults(19).Text = FormatOutputValue(ActiveRes.InflowKx, 3)
	lblResults(20).Text = FormatOutputValue(ActiveRes.InflowKy, 3)
	lblResults(21).Text = FormatOutputValue(ActiveRes.WakeSkewChiDeg, 1) & "°"
	lblResults(22).Text = FormatOutputValue(ActiveRes.BFactor, 4)
	' Explicit trim solution, followed by flow and atmosphere state.
	lblResults(23).Text = FormatOutputValue(ActiveRes.TrimmedRPM, 0) & " rpm"
	lblResults(24).Text = FormatOutputValue(ActiveRes.TrimmedCollectiveDeg, 2) & "°"
	lblResults(25).Text = FormatOutputValue(ActiveRes.CT, 5)
	lblResults(27).Text = FormatOutputValue(ActiveRes.OperatingMu, 4)
	lblResults(29).Text = FormatOutputValue(ActiveRes.OperatingMuZ, 4)
	lblResults(31).Text = FormatOutputValue(ActiveRes.OperatingAlphaDeg, 2) & "°"
	lblResults(33).Text = FormatOutputValue(tipMach, 3)
	lblResults(34).Text = FormatOutputValue(ActiveRes.AdvancingTipMach, 3)
	
	If UnitSystem = 0 Then
		lblResults(26).Text = FormatOutputValue(ActiveRes.ThrustN, 0) & " N"
		lblResults(28).Text = FormatOutputValue(ActiveRes.OperatingVx, 1) & " m/s"
		lblResults(30).Text = FormatOutputValue(ActiveRes.OperatingVz, 1) & " m/s"
		lblResults(32).Text = FormatOutputValue(ActiveRes.TipSpeed, 1) & " m/s"
		lblResults(35).Text = FormatOutputValue(ActiveRes.AltitudeM, 0) & " m"
		lblResults(36).Text = FormatOutputValue(ActiveRes.TemperatureC, 1) & " °C"
		lblResults(37).Text = FormatOutputValue(ActiveRes.Density, 4) & " kg/m³"
		lblResults(38).Text = FormatOutputValue(ActiveRes.PressurePa / 100.0, 1) & " hPa"
		lblResults(39).Text = FormatOutputValue(ActiveRes.SpeedOfSound, 1) & " m/s"
	Else
		lblResults(26).Text = FormatOutputValue(ActiveRes.ThrustLbf, 0) & " lbf"
		lblResults(28).Text = FormatOutputValue(ActiveRes.OperatingVx * 3.280839895, 1) & " ft/s"
		lblResults(30).Text = FormatOutputValue(ActiveRes.OperatingVz * 3.280839895, 1) & " ft/s"
		lblResults(32).Text = FormatOutputValue(ActiveRes.TipSpeed * 3.280839895, 1) & " ft/s"
		lblResults(35).Text = FormatOutputValue(ActiveRes.AltitudeM * 3.280839895, 0) & " ft"
		lblResults(36).Text = FormatOutputValue(ActiveRes.TemperatureC * 9.0 / 5.0 + 32.0, 1) & " °F"
		lblResults(37).Text = FormatOutputValue(ActiveRes.Density * 0.0019403203, 5) & " slug/ft³"
		lblResults(38).Text = FormatOutputValue(ActiveRes.PressurePa / 3386.389, 2) & " inHg"
		lblResults(39).Text = FormatOutputValue(ActiveRes.SpeedOfSound * 3.280839895, 0) & " ft/s"
	End If
End Sub

Private Sub OperatingPairDisplayName(pair As String) As String
	Select pair
		Case "rpm_collective": Return "RPM + Collective"
		Case "rpm_ct": Return "RPM + CT"
		Case "rpm_thrust": Return "RPM + Thrust"
		Case "collective_ct": Return "Collective + CT"
		Case "collective_thrust": Return "Collective + Thrust"
		Case "ct_thrust": Return "CT + Thrust"
		Case Else: Return "Operating Inputs"
	End Select
End Sub

Private Sub UpdateTrimSummary
	If lblTrimSummary.IsInitialized = False Then Return
	If ActiveRes.SolutionValid = False Then
		lblTrimSummary.Text = OperatingPairDisplayName(ActiveCond.OperatingPair) & " · NO SOLUTION"
		lblTrimSummary.TextColor = ColorAccentRed
		Return
	End If
	lblTrimSummary.Text = "OPERATING SOLUTION · " & OperatingPairDisplayName(ActiveCond.OperatingPair)
	lblTrimSummary.TextColor = ColorAccentCyan
End Sub

Sub lblTrimSummary_Click
	Msgbox("The operating solution always reports all four linked quantities: RPM, collective increment Δθ, CT and thrust." & CRLF & CRLF & _
		"You prescribe any two in Conditions. RotorCalculator solves the remaining two at the current forward/axial flight condition.", "Operating Solution")
End Sub

Private Sub FormatOutputValue(Value As Double, BaseDigits As Int) As String
	Return FormatResultValue(Value, BaseDigits + ExtraPrecision)
End Sub

Private Sub FormatResultValue(Value As Double, FractionDigits As Int) As String
	Dim scale As Double = 1
	For i = 1 To FractionDigits
		scale = scale * 10
	Next
	If Abs(Value) < (0.5 / scale) Then Value = 0
	Return NumberFormat2(Value, 1, FractionDigits, FractionDigits, False)
End Sub

Public Sub LoadRotorDataToFields(geom As RotorGeometry)
	If edtRadius.IsInitialized = False Then Return
	Dim g As RotorGeometry = zBETEngine.ResolveSolidity(zBETEngine.CloneGeometry(geom))
	UpdatingUI = True
	edtRotorName.Text = g.Name
	edtRadius.Text = NumberFormat2(g.Radius, 1, 2, 2, False)
	edtNBlades.Text = g.NBlades
	edtRootCutout.Text = NumberFormat2(g.RootCutout, 1, 3, 3, False)
	edtChordRoot.Text = NumberFormat2(g.ChordRoot, 1, 4, 4, False)
	edtChordTip.Text = NumberFormat2(g.ChordTip, 1, 4, 4, False)
	edtSigmaRef.Text = NumberFormat2(g.SigmaRef, 1, 5, 5, False)
	edtAspectRatio.Text = NumberFormat2(zBETEngine.ReferenceAspectRatio(g), 1, 3, 3, False)
	edtThetaRoot.Text = NumberFormat2(g.ThetaRoot * 180.0 / cPI, 1, 2, 2, False)
	edtThetaTip.Text = NumberFormat2(g.ThetaTip * 180.0 / cPI, 1, 2, 2, False)
	edtLiftSlope.Text = NumberFormat2(g.LiftSlope0, 1, 3, 3, False)
	edtCd0.Text = NumberFormat2(g.Cd0, 1, 5, 5, False)
	edtTipLossB.Text = NumberFormat2(g.TipLossB, 1, 4, 4, False)
	btnSelectAirfoil.Text = AirfoilDisplayName(g)
	RefreshTipLossButton(g)
	If g.UsePrandtlGlauert Then
		btnCompressibility.Text = "Prandtl-Glauert: ON"
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		btnCompressibility.Text = "Prandtl-Glauert: OFF"
		btnCompressibility.TextColor = ColorButText2
	End If
	UpdatingUI = False
	RefreshGeometryDerivedFields
	RefreshLoadedRotorStrip
End Sub

Private Sub RefreshGeometryDerivedFields
	If lblSigmaGeomDerived.IsInitialized = False Then Return
	Dim g As RotorGeometry = zBETEngine.ResolveSolidity(zBETEngine.CloneGeometry(ActiveGeom))
	lblSigmaGeomDerived.Text = FormatResultValue(g.SigmaGeom, 5)
	lblSigmaThrustDerived.Text = FormatResultValue(g.SigmaThrust, 5)
	lblTaperDerived.Text = FormatResultValue(zBETEngine.TaperRatio(g), 3)
	lblDiskAreaDerived.Text = FormatResultValue(cPI * g.Radius * g.Radius, 2)
	lblRefBladeAreaDerived.Text = FormatResultValue(zBETEngine.ReferenceBladeArea(g), 3)
	lblActiveBladeAreaDerived.Text = FormatResultValue(zBETEngine.ActiveBladeArea(g), 3)
	lblTwistDerived.Text = FormatResultValue((g.ThetaTip - g.ThetaRoot) * 180.0 / cPI, 2)
	If edtTipLossB.IsInitialized Then edtTipLossB.Enabled = (g.TipLossMode = "fixed")
End Sub

Private Sub RefreshTipLossButton(geom As RotorGeometry)
	Select geom.TipLossMode
		Case "sissingh"
			btnTipLoss.Text = "Sissingh"
			btnTipLoss.TextColor = ColorAccentGreen
		Case "fixed"
			btnTipLoss.Text = "Fixed B"
			btnTipLoss.TextColor = ColorAccentCyan
		Case Else
			btnTipLoss.Text = "None"
			btnTipLoss.TextColor = ColorButText2
	End Select
	If edtTipLossB.IsInitialized Then edtTipLossB.Enabled = (geom.TipLossMode = "fixed")
End Sub

Private Sub AirfoilDisplayName(geom As RotorGeometry) As String
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		If Abs(geom.LiftSlope0 - af.A0) < 0.001 And Abs(geom.Cd0 - af.Cd0) < 0.00001 Then Return af.Name
	Next
	Return "Custom Section"
End Sub

Private Sub UpdateAtmosphere
	ConditionAltitudeM = ClampD(ConditionAltitudeM, -500.0, 11000.0)
	ConditionTemperatureC = ClampD(ConditionTemperatureC, -80.0, 60.0)
	Dim base As Double = Max(0.05, 1.0 - 0.0065 * ConditionAltitudeM / 288.15)
	Dim pRatio As Double = Power(base, 5.2561)
	AmbientPressureHPa = 1013.25 * pRatio
	Dim tKelvin As Double = ConditionTemperatureC + 273.15
	ActiveCond.AltitudeM = ConditionAltitudeM
	ActiveCond.TemperatureC = ConditionTemperatureC
	ActiveCond.PressurePa = AmbientPressureHPa * 100.0
	ActiveCond.Rho = ActiveCond.PressurePa / (287.058 * tKelvin)
	ActiveCond.SpeedOfSound = Sqrt(1.4 * 287.058 * tKelvin)
End Sub

Private Sub SyncConditionRepresentations
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	ActiveCond.ProfileDragModel = "numerical_vectorial"
	UpdateAtmosphere
End Sub

Private Sub LoadConditionDataToFields
	ConditionAltitudeM = ActiveCond.AltitudeM
	ConditionTemperatureC = ActiveCond.TemperatureC
	If ActiveCond.HorizontalMode <> "" Then HorizontalInputMode = ActiveCond.HorizontalMode
	ConditionHorizontalValue = ActiveCond.HorizontalValue
	If ActiveCond.AxialMode <> "" Then AxialInputMode = ActiveCond.AxialMode
	ConditionAxialValue = ActiveCond.AxialValue
	UpdatingUI = True
	edtAltitude.Text = NumberFormat2(ConditionAltitudeM, 1, 0, 0, False)
	edtTemperature.Text = NumberFormat2(ConditionTemperatureC, 1, 1, 1, False)
	RefreshHorizontalInputDisplay
	RefreshAxialInputDisplay
	Select ActiveCond.InflowModel
		Case "uniform": btnInflowModel.Text = "Uniform"
		Case "coleman_simple": btnInflowModel.Text = "Coleman Simple"
		Case "drees": btnInflowModel.Text = "Drees"
		Case Else: btnInflowModel.Text = "Coleman-Feingold"
	End Select
	If edtKInd.IsInitialized Then edtKInd.Text = NumberFormat2(ActiveCond.KInd, 1, 3, 3, False)
	RefreshOperatingControls
	UpdatingUI = False
	SyncConditionRepresentations
	RefreshFlowDerivedLabels
End Sub

Private Sub RefreshHorizontalInputDisplay
	If btnHorizontalInput.IsInitialized = False Then Return
	If HorizontalInputMode = "vx" Then
		btnHorizontalInput.Text = "Vx"
		lblHorizontalUnit.Text = "m/s"
		edtHorizontalValue.Text = NumberFormat2(ConditionHorizontalValue, 1, 2, 2, False)
	Else
		HorizontalInputMode = "mu"
		btnHorizontalInput.Text = "μ"
		lblHorizontalUnit.Text = "[-]"
		edtHorizontalValue.Text = NumberFormat2(ConditionHorizontalValue, 1, 4, 4, False)
	End If
End Sub

Private Sub RefreshAxialInputDisplay
	If btnAxialInput.IsInitialized = False Then Return
	Select AxialInputMode
		Case "vz"
			btnAxialInput.Text = "Vz"
			lblAxialUnit.Text = "m/s"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 2, 2, False)
		Case "muz"
			btnAxialInput.Text = "μz"
			lblAxialUnit.Text = "[-]"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 4, 4, False)
		Case Else
			AxialInputMode = "alpha"
			btnAxialInput.Text = "α"
			lblAxialUnit.Text = "deg"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 2, 2, False)
	End Select
End Sub

Private Sub RotorTipSpeed As Double
	If ActiveRes.SolutionValid And ActiveRes.TipSpeed > 0 Then Return ActiveRes.TipSpeed
	Dim g As RotorGeometry = zBETEngine.ResolveOperatingGeometry(ActiveGeom, ActiveCond)
	Return g.RPM * cPI / 30.0 * g.Radius
End Sub

Private Sub RefreshFlowDerivedLabels
	If lblHorizontalDerived.IsInitialized = False Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim muz As Double = ActiveCond.MuZ
	Dim vtip As Double = RotorTipSpeed
	Dim vx As Double = mu * vtip
	Dim vz As Double = muz * vtip
	Dim alpha As Double = zBETEngine.AlphaFromMuZ(mu, muz)
	If HorizontalInputMode = "vx" Then
		lblHorizontalDerived.Text = "μ " & FormatResultValue(mu, 4)
	Else
		lblHorizontalDerived.Text = "Vx " & FormatResultValue(vx, 1)
	End If
	Select AxialInputMode
		Case "alpha"
			lblAxialDerived.Text = "Vz " & FormatResultValue(vz, 1) & " · μz " & FormatResultValue(muz, 3)
		Case "vz"
			lblAxialDerived.Text = "α " & FormatResultValue(alpha, 1) & "° · μz " & FormatResultValue(muz, 3)
		Case Else
			lblAxialDerived.Text = "Vz " & FormatResultValue(vz, 1) & " · α " & FormatResultValue(alpha, 1) & "°"
	End Select
End Sub

Private Sub PairInputName(pair As String, position As Int) As String
	Select pair
		Case "rpm_collective"
			If position = 1 Then Return "RPM" Else Return "Collective Δθ"
		Case "rpm_ct"
			If position = 1 Then Return "RPM" Else Return "Target CT"
		Case "rpm_thrust"
			If position = 1 Then Return "RPM" Else Return "Target Thrust"
		Case "collective_ct"
			If position = 1 Then Return "Collective Δθ" Else Return "Target CT"
		Case "collective_thrust"
			If position = 1 Then Return "Collective Δθ" Else Return "Target Thrust"
		Case Else
			If position = 1 Then Return "Target CT" Else Return "Target Thrust"
	End Select
End Sub

Private Sub PairInputUnit(name As String) As String
	If name = "RPM" Then Return "rpm"
	If name.Contains("Collective") Then Return "deg"
	If name.Contains("CT") Then Return "[-]"
	Return "N"
End Sub

Private Sub PairInputValue(name As String) As Double
	If name = "RPM" Then Return ActiveCond.RPM
	If name.Contains("Collective") Then Return ActiveCond.CollectiveDeg
	If name.Contains("CT") Then Return ActiveCond.TargetCT
	Return ActiveCond.TargetThrustN
End Sub

Private Sub RefreshOperatingControls
	If btnOperatingPair.IsInitialized = False Then Return
	btnOperatingPair.Text = OperatingPairDisplayName(ActiveCond.OperatingPair)
	Dim n1 As String = PairInputName(ActiveCond.OperatingPair, 1)
	Dim n2 As String = PairInputName(ActiveCond.OperatingPair, 2)
	lblOperatingInput1.Text = n1
	lblOperatingInput1.Tag = n1
	lblOperatingInput2.Text = n2
	lblOperatingInput2.Tag = n2
	lblOperatingUnit1.Text = PairInputUnit(n1)
	lblOperatingUnit2.Text = PairInputUnit(n2)
	edtOperatingInput1.Text = FormatOperatingInput(n1, PairInputValue(n1))
	edtOperatingInput2.Text = FormatOperatingInput(n2, PairInputValue(n2))
End Sub

Private Sub FormatOperatingInput(name As String, value As Double) As String
	If name = "RPM" Or name.Contains("Thrust") Then Return NumberFormat2(value, 1, 0, 0, False)
	If name.Contains("CT") Then Return NumberFormat2(value, 1, 5, 5, False)
	Return NumberFormat2(value, 1, 2, 2, False)
End Sub

Private Sub RefreshDerivedCondition(updateDisplayedValues As Boolean)
	SyncConditionRepresentations
	If updateDisplayedValues Then
		Dim wasUpdating As Boolean = UpdatingUI
		UpdatingUI = True
		RefreshHorizontalInputDisplay
		RefreshAxialInputDisplay
		RefreshOperatingControls
		UpdatingUI = wasUpdating
	End If
	If ActiveRes.SolutionValid Then RefreshFlowDerivedLabels
End Sub

Private Sub RefreshRotorSpinner
	RefreshLoadedRotorStrip
End Sub

Sub btnSelectAirfoil_Click
	Dim options As List
	options.Initialize
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		options.Add(af.Name & "  ·  a0=" & af.A0 & "  Cd0=" & af.Cd0)
	Next
	Dim resIndex As Int = InputList(options, "Airfoil Section", -1)
	If resIndex < 0 Then Return
	Dim selAf As AirfoilData = RotorPopups.Airfoils.Get(resIndex)
	ActiveGeom.LiftSlope0 = selAf.A0
	ActiveGeom.Cd0 = selAf.Cd0
	GeometryDirty = True
	LoadRotorDataToFields(ActiveGeom)
	RecalculateRotor
End Sub

Sub btnTipLoss_Click
	Dim options As List
	options.Initialize
	options.Add("None")
	options.Add("Fixed B")
	options.Add("Sissingh")
	Dim selected As Int = 0
	If ActiveGeom.TipLossMode = "fixed" Then selected = 1
	If ActiveGeom.TipLossMode = "sissingh" Then selected = 2
	Dim idx As Int = InputList(options, "Tip-Loss Model", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveGeom.TipLossMode = "none"
		Case 1: ActiveGeom.TipLossMode = "fixed"
		Case 2: ActiveGeom.TipLossMode = "sissingh"
	End Select
	GeometryDirty = True
	RefreshTipLossButton(ActiveGeom)
	RefreshGeometryDerivedFields
	RefreshLoadedRotorStrip
	RecalculateRotor
End Sub

Sub btnCompressibility_Click
	ActiveGeom.UsePrandtlGlauert = Not(ActiveGeom.UsePrandtlGlauert)
	GeometryDirty = True
	LoadRotorDataToFields(ActiveGeom)
	RecalculateRotor
End Sub

Sub btnInflowModel_Click
	Dim options As List
	options.Initialize
	options.Add("Uniform — benchmark")
	options.Add("Coleman Simple — longitudinal gradient")
	options.Add("Coleman-Feingold — longitudinal + lateral")
	options.Add("Drees — classical longitudinal + lateral")
	Dim selected As Int = 2
	Select ActiveCond.InflowModel
		Case "uniform": selected = 0
		Case "coleman_simple": selected = 1
		Case "drees": selected = 3
	End Select
	Dim idx As Int = InputList(options, "Inflow Model", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveCond.InflowModel = "uniform"
		Case 1: ActiveCond.InflowModel = "coleman_simple"
		Case 2: ActiveCond.InflowModel = "coleman_feingold"
		Case 3: ActiveCond.InflowModel = "drees"
	End Select
	LoadConditionDataToFields
	RecalculateRotor
End Sub

Sub btnOperatingPair_Click
	' Seed every possible new pair with the current solved state so mode changes are continuous.
	If ActiveRes.SolutionValid Then
		ActiveCond.RPM = ActiveRes.TrimmedRPM
		ActiveCond.CollectiveDeg = ActiveRes.TrimmedCollectiveDeg
		ActiveCond.TargetCT = Max(1.0e-8, ActiveRes.CT)
		ActiveCond.TargetThrustN = Max(1.0e-6, ActiveRes.ThrustN)
	End If
	Dim options As List
	options.Initialize
	options.Add("RPM + Collective")
	options.Add("RPM + CT")
	options.Add("RPM + Thrust")
	options.Add("Collective + CT")
	options.Add("Collective + Thrust")
	options.Add("CT + Thrust")
	Dim selected As Int = 1
	Select ActiveCond.OperatingPair
		Case "rpm_collective": selected = 0
		Case "rpm_ct": selected = 1
		Case "rpm_thrust": selected = 2
		Case "collective_ct": selected = 3
		Case "collective_thrust": selected = 4
		Case "ct_thrust": selected = 5
	End Select
	Dim idx As Int = InputList(options, "Operating Inputs · prescribe any two", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveCond.OperatingPair = "rpm_collective"
		Case 1: ActiveCond.OperatingPair = "rpm_ct"
		Case 2: ActiveCond.OperatingPair = "rpm_thrust"
		Case 3: ActiveCond.OperatingPair = "collective_ct"
		Case 4: ActiveCond.OperatingPair = "collective_thrust"
		Case 5: ActiveCond.OperatingPair = "ct_thrust"
	End Select
	UpdatingUI = True
	RefreshOperatingControls
	UpdatingUI = False
	RecalculateRotor
End Sub

Sub edtOperatingInput_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim edt As EditText = Sender
	Dim position As Int = ParseIntDef("" & edt.Tag, 1)
	Dim name As String = PairInputName(ActiveCond.OperatingPair, position)
	Dim value As Double = ParseDoubleDef(edt.Text, PairInputValue(name))
	If name = "RPM" Then ActiveCond.RPM = ClampD(value, 1.0, 30000.0)
	If name.Contains("Collective") Then ActiveCond.CollectiveDeg = ClampD(value, -60.0, 60.0)
	If name.Contains("CT") Then ActiveCond.TargetCT = ClampD(value, 0.000001, 0.20)
	If name.Contains("Thrust") Then ActiveCond.TargetThrustN = ClampD(value, 0.001, 1.0e8)
	RecalculateRotor
End Sub

Sub edtKInd_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ActiveCond.KInd = ClampD(ParseDoubleDef(edtKInd.Text, ActiveCond.KInd), 1.0, 3.0)
	RecalculateRotor
End Sub

Sub lblRowTip_Click
	Dim b As Label = Sender
	Dim tipMsg As String = ""
	Select b.Tag
		Case "Rotor Name"
			tipMsg = "Name stored with this rotor geometry."
		Case "Radius R"
			tipMsg = "Rotor radius R. Editing R scales c0 and c1 proportionally, preserving reference solidity, aspect ratio and taper."
		Case "Blade Count"
			tipMsg = "Number of blades Nb. Changing Nb changes reference solidity while preserving the blade planform and aspect ratio."
		Case "Root Cutout"
			tipMsg = "x0 = r0/R, the first active aerodynamic station. It changes active-span metrics, not the reference planform."
		Case "Root Chord c0"
			tipMsg = "Reference-axis chord c0 at r/R = 0. The active blade starts at root cutout x0."
		Case "Tip Chord c1"
			tipMsg = "Reference tip chord c1 at r/R = 1. Chord varies linearly between c0 and c1."
		Case "Reference Solidity"
			tipMsg = "σref = Nb/(π AR). Editing σref scales both chords by one factor and preserves taper ratio."
		Case "Aspect Ratio"
			tipMsg = "Reference blade AR = R²/Sref,b = 2R/(c0+c1). Editing AR scales both chords while preserving taper."
		Case "Root Incidence", "Tip Incidence"
			tipMsg = "Baseline blade incidence. Operating collective Δθ is added equally to root and tip, preserving total twist."
		Case "Geometric Solidity"
			tipMsg = "Physical-area solidity over the active blade span x0 ≤ r/R ≤ 1."
		Case "Thrust Solidity"
			tipMsg = "Thrust-weighted solidity: 3∫x²σ(x)dx over the active aerodynamic span."
		Case "Taper Ratio"
			tipMsg = "Reference taper ratio c1/c0."
		Case "Disk Area"
			tipMsg = "Rotor disk area A = πR²."
		Case "Reference Blade Area"
			tipMsg = "Single-blade reference planform area from the rotor axis to the tip."
		Case "Active Blade Area"
			tipMsg = "Single-blade physical planform area from root cutout x0 to the tip."
		Case "Total Twist"
			tipMsg = "Baseline linear twist θtip − θroot. Collective trim preserves this difference."
		Case "Lift Slope a0"
			tipMsg = "Section lift-curve slope dCl/dα before optional compressibility correction."
		Case "Profile Cd0"
			tipMsg = "Baseline section profile-drag coefficient used by the Numerical Vectorial integration."
		Case "Fixed Tip Factor B"
			tipMsg = "Fixed effective tip radius factor B. Editable only when Fixed B tip loss is selected."
		Case "Altitude"
			tipMsg = "Pressure altitude used by the atmosphere model."
		Case "Temperature"
			tipMsg = "Ambient temperature used for density and speed of sound."
		Case "Horizontal Flow"
			Msgbox("Choose μ or Vx as equivalent horizontal inputs." & CRLF & CRLF & _
				"μ = Vx/(ΩR)." & CRLF & _
				"+Vx is forward in-plane flow." & CRLF & _
				"The non-selected representation is shown as a derived value.", "Horizontal Flow")
			Return
		Case "Axial Flow"
			Msgbox("Choose α, Vz or μz as one equivalent axial input." & CRLF & CRLF & _
				"+Vz means positive climb rate: the relative wind comes from above and passes downward through the disk." & CRLF & _
				"+μz is the corresponding positive downward relative flow." & CRLF & _
				"+α means relative wind arriving from below." & CRLF & _
				"μz = Vz/(ΩR) = -μ tan(α).", "Axial Flow")
			Return
		Case "Operating Inputs"
			Msgbox("RPM, collective Δθ, CT and thrust form one operating solution." & CRLF & CRLF & _
				"Choose any two as prescribed inputs. RotorCalculator solves the other two at the current forward/axial flight condition.", "Operating Constraints")
			Return
		Case "RPM"
			tipMsg = "Prescribed rotational speed for the selected operating pair."
		Case "Collective Δθ"
			tipMsg = "Uniform pitch increment added equally to root and tip incidence."
		Case "Target CT"
			tipMsg = "Prescribed CT = T/[ρA(ΩR)²] for the selected operating pair."
		Case "Target Thrust"
			tipMsg = "Prescribed dimensional rotor thrust for the selected operating pair."
		Case "Induced Factor Kind"
			tipMsg = "Induced-power factor Kind used in induced power and air-power calculations. Typical ideal value is 1; practical values are greater than 1."
		Case "Airfoil"
			tipMsg = "Section preset. Selecting it populates a0 and Cd0; the numerical values remain visible."
		Case "Tip Loss"
			tipMsg = "Finite-blade tip-loss model: None, Fixed B, or Sissingh."
		Case "Compressibility"
			tipMsg = "Optional Prandtl-Glauert correction using the zBET representative subsonic Mach definition."
		Case "Inflow Model"
			Msgbox("Uniform: no harmonic gradient." & CRLF & CRLF & _
				"Coleman Simple: longitudinal first harmonic." & CRLF & CRLF & _
				"Coleman-Feingold: longitudinal and lateral harmonics." & CRLF & CRLF & _
				"Drees: classical longitudinal and lateral gradients.", "Inflow Models")
			Return
		Case "Profile Drag"
			tipMsg = "Profile drag is always evaluated with Numerical Vectorial radial/azimuthal quadrature."
		Case Else
			tipMsg = "" & b.Tag
	End Select
	ToastMessageShow(tipMsg, True)
End Sub

Sub btnUnit_Click
	Dim b As Button = Sender
	ToastMessageShow("Input unit: " & b.Tag & " (inputs use SI)", False)
End Sub

Sub edtGeom_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim edt As EditText = Sender
	Dim field As String = "" & edt.Tag
	Select field
		Case "Rotor Name"
			Dim n As String = edt.Text.Trim.Replace("|", "/").Replace(CR, " ").Replace(LF, " ")
			If n <> "" Then ActiveGeom.Name = n
		Case "Radius R"
			Dim newR As Double = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.Radius), 0.02, 50.0)
			ActiveGeom = zBETEngine.ScaleRadiusPreserveReference(ActiveGeom, newR)
		Case "Blade Count"
			ActiveGeom.NBlades = Max(1, Min(16, ParseIntDef(edt.Text, ActiveGeom.NBlades)))
			ActiveGeom.SolidityMode = "chords"
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Root Cutout"
			ActiveGeom.RootCutout = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.RootCutout), 0.0, 0.95)
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Root Chord c0"
			ActiveGeom.ChordRoot = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.ChordRoot), 0.0001, 2.0 * ActiveGeom.Radius)
			ActiveGeom.SolidityMode = "chords"
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Tip Chord c1"
			ActiveGeom.ChordTip = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.ChordTip), 0.0001, 2.0 * ActiveGeom.Radius)
			ActiveGeom.SolidityMode = "chords"
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Reference Solidity"
			ActiveGeom = zBETEngine.ScaleChordsToSigmaRef(ActiveGeom, ParseDoubleDef(edt.Text, ActiveGeom.SigmaRef))
		Case "Aspect Ratio"
			ActiveGeom = zBETEngine.ScaleChordsToAspectRatio(ActiveGeom, ParseDoubleDef(edt.Text, zBETEngine.ReferenceAspectRatio(ActiveGeom)))
		Case "Root Incidence"
			ActiveGeom.ThetaRoot = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.ThetaRoot*180/cPI), -90.0, 90.0) * cPI / 180.0
		Case "Tip Incidence"
			ActiveGeom.ThetaTip = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.ThetaTip*180/cPI), -90.0, 90.0) * cPI / 180.0
		Case "Lift Slope a0"
			ActiveGeom.LiftSlope0 = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.LiftSlope0), 0.1, 10.0)
		Case "Profile Cd0"
			ActiveGeom.Cd0 = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.Cd0), 0.0, 0.5)
		Case "Fixed Tip Factor B"
			ActiveGeom.TipLossB = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.TipLossB), ActiveGeom.RootCutout + 0.001, 1.0)
	End Select
	ActiveGeom.PitchMode = "linear_twist"
	ActiveGeom.Theta0 = 0.5 * (ActiveGeom.ThetaRoot + ActiveGeom.ThetaTip)
	GeometryDirty = True
	RefreshGeometryDependentInputs(field)
	RefreshGeometryDerivedFields
	RefreshLoadedRotorStrip
	RecalculateRotor
End Sub

Private Sub RefreshGeometryDependentInputs(sourceField As String)
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	If sourceField <> "Radius R" Then edtRadius.Text = NumberFormat2(ActiveGeom.Radius, 1, 2, 2, False)
	If sourceField <> "Blade Count" Then edtNBlades.Text = ActiveGeom.NBlades
	If sourceField <> "Root Cutout" Then edtRootCutout.Text = NumberFormat2(ActiveGeom.RootCutout, 1, 3, 3, False)
	If sourceField <> "Root Chord c0" Then edtChordRoot.Text = NumberFormat2(ActiveGeom.ChordRoot, 1, 4, 4, False)
	If sourceField <> "Tip Chord c1" Then edtChordTip.Text = NumberFormat2(ActiveGeom.ChordTip, 1, 4, 4, False)
	If sourceField <> "Reference Solidity" Then edtSigmaRef.Text = NumberFormat2(ActiveGeom.SigmaRef, 1, 5, 5, False)
	If sourceField <> "Aspect Ratio" Then edtAspectRatio.Text = NumberFormat2(zBETEngine.ReferenceAspectRatio(ActiveGeom), 1, 3, 3, False)
	UpdatingUI = wasUpdating
End Sub

Sub edtGeom_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadRotorDataToFields(ActiveGeom)
End Sub

Sub edtCond_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ConditionAltitudeM = ClampD(ParseDoubleDef(edtAltitude.Text, ConditionAltitudeM), -500.0, 11000.0)
	ConditionTemperatureC = ClampD(ParseDoubleDef(edtTemperature.Text, ConditionTemperatureC), -80.0, 60.0)
	UpdateAtmosphere
	RecalculateRotor
End Sub

Sub edtHorizontalValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ConditionHorizontalValue = ParseDoubleDef(edtHorizontalValue.Text, ConditionHorizontalValue)
	If HorizontalInputMode = "mu" Then ConditionHorizontalValue = ClampD(ConditionHorizontalValue, -0.60, 0.60)
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	RecalculateRotor
End Sub

Sub edtAxialValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim raw As Double = ParseDoubleDef(edtAxialValue.Text, ConditionAxialValue)
	Select AxialInputMode
		Case "alpha": ConditionAxialValue = ClampD(raw, -89.0, 89.0)
		Case "vz": ConditionAxialValue = ClampD(raw, -200.0, 200.0)
		Case "muz": ConditionAxialValue = ClampD(raw, -0.50, 0.50)
	End Select
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	RecalculateRotor
End Sub

Sub btnHorizontalInput_Click
	Dim options As List
	options.Initialize
	options.Add("μ — advance ratio")
	options.Add("Vx — forward speed [m/s]")
	Dim selected As Int = 0
	If HorizontalInputMode = "vx" Then selected = 1
	Dim idx As Int = InputList(options, "Horizontal Flow", selected)
	If idx < 0 Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim vx As Double = 0.0
	If ActiveRes.SolutionValid Then vx = ActiveRes.OperatingVx Else vx = mu * RotorTipSpeed
	If idx = 0 Then
		HorizontalInputMode = "mu"
		ConditionHorizontalValue = mu
	Else
		HorizontalInputMode = "vx"
		ConditionHorizontalValue = vx
	End If
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	UpdatingUI = True
	RefreshHorizontalInputDisplay
	UpdatingUI = False
	RecalculateRotor
	ToastMessageShow("+Vx is forward; μ = Vx/(ΩR).", False)
End Sub

Sub btnAxialInput_Click
	Dim options As List
	options.Initialize
	options.Add("α — wind from below when positive")
	options.Add("Vz — climb rate; positive means wind from above")
	options.Add("μz — axial ratio; positive downward relative flow")
	Dim selected As Int = 0
	If AxialInputMode = "vz" Then selected = 1
	If AxialInputMode = "muz" Then selected = 2
	Dim idx As Int = InputList(options, "Axial Flow", selected)
	If idx < 0 Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim muz As Double = ActiveCond.MuZ
	Dim vtip As Double = RotorTipSpeed
	If idx = 0 Then
		If Abs(mu) < 1.0e-8 And Abs(muz) > 1.0e-10 Then
			ToastMessageShow("At Vx = 0, use Vz or μz for nonzero axial flow.", True)
			Return
		End If
		AxialInputMode = "alpha"
		ConditionAxialValue = zBETEngine.AlphaFromMuZ(mu, muz)
	Else If idx = 1 Then
		AxialInputMode = "vz"
		ConditionAxialValue = zBETEngine.VzFromMuZ(muz, vtip)
	Else
		AxialInputMode = "muz"
		ConditionAxialValue = muz
	End If
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	UpdatingUI = True
	RefreshAxialInputDisplay
	UpdatingUI = False
	RecalculateRotor
	ShowAxialConventionHint
End Sub

Private Sub ShowAxialConventionHint
	Select AxialInputMode
		Case "alpha": ToastMessageShow("α > 0: relative wind arrives from below.", True)
		Case "vz": ToastMessageShow("Vz > 0: positive climb rate, relative wind from above.", True)
		Case Else: ToastMessageShow("μz > 0: relative flow downward through the disk.", True)
	End Select
End Sub

