	If Abs(SweepMaxMuVal - 0.30) < 0.001 Then selected = 0
	If Abs(SweepMaxMuVal - 0.50) < 0.001 Then selected = 2
	If Abs(SweepMaxMuVal - 0.60) < 0.001 Then selected = 3
