End Sub

Sub btnClosePhysicsHelp_Click
	ClosePhysicsHelp
End Sub

Private Sub ClosePhysicsHelp
	If HelpPopupOpen Then
		pnlHelpPopup.RemoveView
		HelpPopupOpen = False
	End If
End Sub

' ====================================================================
' QUICK UNIT CONVERTER
' ====================================================================
Private Sub OpenUnitConverter
	If UnitPopupOpen Then CloseUnitConverter
	pnlUnitPopup.Initialize("pnlUnitPopup")
	pnlUnitPopup.Color = 0xA0000000
	root.AddView(pnlUnitPopup, 0, 0, root.Width, root.Height)
	UnitPopupOpen = True
	pnlUnitPopup.BringToFront
	
	Dim cardW As Int = root.Width - 24dip
	If cardW > 520dip Then cardW = 520dip
	Dim cardH As Int = 294dip
	If cardH > root.Height - 24dip Then cardH = root.Height - 24dip
	Dim cardLeft As Int = (root.Width - cardW) / 2
	Dim cardTop As Int = (root.Height - cardH) / 2
	
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlUnitPopup.AddView(card, cardLeft, cardTop, cardW, cardH)
	
	Dim titleBar As Panel
	titleBar.Initialize("")
	titleBar.Color = ColorPnlTitle
	card.AddView(titleBar, 0, 0, cardW, 52dip)
	
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "QUICK UNIT CONVERTER"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 13
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	titleBar.AddView(lblTitle, 16dip, 0, cardW - 72dip, 52dip)
	
	Dim btnClose As Button
	btnClose.Initialize("btnCloseUnitConverter")
	btnClose.Text = "×"
	btnClose.TextColor = ColorButText1
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	titleBar.AddView(btnClose, cardW - 52dip, 2dip, 48dip, 48dip)
	
	spnUnitMode.Initialize("spnUnitMode")
	spnUnitMode.DropdownBackgroundColor = ColorPnlTitle
	spnUnitMode.DropdownTextColor = ColorTitleText
	spnUnitMode.TextColor = ColorTitleText
	spnUnitMode.TextSize = 12
	Dim modes() As String = Array As String("kW → hp", "hp → kW", "N → kgf", "kgf → N", "N → lbf", "lbf → N", "km/h → kt", "kt → km/h", "km/h → m/s", "m/s → km/h", "m → ft", "ft → m", "mm → in", "in → mm")
	For Each mode As String In modes
		spnUnitMode.Add(mode)
	Next
	card.AddView(spnUnitMode, 16dip, 68dip, cardW - 32dip, 48dip)
	
	edtUnitValue.Initialize("edtUnitValue")
	edtUnitValue.Text = "1"
	edtUnitValue.TextSize = 16
	edtUnitValue.TextColor = ColorEdtText
	edtUnitValue.Color = ColorEdt
	edtUnitValue.Gravity = Gravity.CENTER
	edtUnitValue.InputType = Bit.Or(edtUnitValue.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edtUnitValue.SingleLine = True
	card.AddView(edtUnitValue, 16dip, 128dip, cardW - 32dip, 48dip)
	
	lblUnitResult.Initialize("")
	lblUnitResult.TextColor = ColorAccentGreen
	lblUnitResult.Typeface = Typeface.DEFAULT_BOLD
	lblUnitResult.TextSize = 19
	lblUnitResult.Gravity = Gravity.CENTER
	card.AddView(lblUnitResult, 16dip, 190dip, cardW - 32dip, 72dip)
	UpdateUnitConversion
End Sub

Private Sub CloseUnitConverter
	If UnitPopupOpen Then
		pnlUnitPopup.RemoveView
		UnitPopupOpen = False
	End If
End Sub

Sub btnCloseUnitConverter_Click
	CloseUnitConverter
End Sub

Sub spnUnitMode_ItemClick(Position As Int, Value As Object)
	UpdateUnitConversion
End Sub

Sub edtUnitValue_TextChanged (Old As String, New As String)
	If UnitPopupOpen Then UpdateUnitConversion
End Sub

Private Sub UpdateUnitConversion
	If spnUnitMode.IsInitialized = False Or edtUnitValue.IsInitialized = False Or lblUnitResult.IsInitialized = False Then Return
	Dim x As Double = ParseDoubleDef(edtUnitValue.Text, 0)
	Dim y As Double
	Dim unitText As String
	Select spnUnitMode.SelectedIndex
		Case 0
			y = x * 1.34102209 : unitText = "hp"
		Case 1
			y = x / 1.34102209 : unitText = "kW"
		Case 2
			y = x / 9.80665 : unitText = "kgf"
		Case 3
			y = x * 9.80665 : unitText = "N"
		Case 4
			y = x * 0.224808943 : unitText = "lbf"
		Case 5
			y = x / 0.224808943 : unitText = "N"
		Case 6
			y = x / 1.852 : unitText = "kt"
		Case 7
			y = x * 1.852 : unitText = "km/h"
		Case 8
			y = x / 3.6 : unitText = "m/s"
		Case 9
			y = x * 3.6 : unitText = "km/h"
		Case 10
			y = x * 3.280839895 : unitText = "ft"
		Case 11
			y = x / 3.280839895 : unitText = "m"
		Case 12
			y = x / 25.4 : unitText = "in"
		Case Else
			y = x * 25.4 : unitText = "mm"
	End Select
	lblUnitResult.Text = NumberFormat2(y, 1, 4, 4, False) & " " & unitText
End Sub

' ====================================================================
' PAGE 0: GEOMETRY (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageGeom
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
	scvGeom.Initialize(3200)
	pnlBack0.AddView(scvGeom, 0, 0, root.Width, root.Height - HeaderHeight)
	Dim y As Int = 8dip
	Dim rowIndex As Int = 0
	Dim rowH As Int = 57dip
	
	Dim loaded As Panel
	loaded.Initialize("")
	loaded.Color = ColorPnlTitle
	scvGeom.Panel.AddView(loaded, UiContentLeft, y, UiContentW, 52dip)
	lblLoadedRotor.Initialize("")
	lblLoadedRotor.TextColor = ColorAccentCyan
	lblLoadedRotor.Typeface = Typeface.DEFAULT_BOLD
	lblLoadedRotor.TextSize = 12 * sc
	lblLoadedRotor.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	loaded.AddView(lblLoadedRotor, 14dip, 0, UiContentW - 28dip, 52dip)
	y = y + 60dip
	
	y = AddGeometrySectionHeader(y, "BLADE GEOMETRY")
	Dim pnl As Panel
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRotorName = AddTextInputRow(pnl, 4dip, 48dip, "Rotor Name", ActiveGeom.Name, "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRadius = AddFullInputRow(pnl, 4dip, 48dip, "Radius R", "", "m", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtNBlades = AddFullInputRow(pnl, 4dip, 48dip, "Blade Count", "", "[-]", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRootCutout = AddFullInputRow(pnl, 4dip, 48dip, "Root Cutout", "", "r/R", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtChordRoot = AddFullInputRow(pnl, 4dip, 48dip, "Root Chord c0", "", "m", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtChordTip = AddFullInputRow(pnl, 4dip, 48dip, "Tip Chord c1", "", "m", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtSigmaRef = AddFullInputRow(pnl, 4dip, 48dip, "Reference Solidity", "", "[-]", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtAspectRatio = AddFullInputRow(pnl, 4dip, 48dip, "Aspect Ratio", "", "[-]", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtThetaRoot = AddFullInputRow(pnl, 4dip, 48dip, "Root Incidence", "", "deg", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtThetaTip = AddFullInputRow(pnl, 4dip, 48dip, "Tip Incidence", "", "deg", "edtGeom_TextChanged"): y = y + rowH: rowIndex=rowIndex+1
	
	y = AddGeometrySectionHeader(y + 4dip, "DERIVED GEOMETRY")
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblSigmaGeomDerived = AddDerivedRow(pnl, "Geometric Solidity", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblSigmaThrustDerived = AddDerivedRow(pnl, "Thrust Solidity", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblTaperDerived = AddDerivedRow(pnl, "Taper Ratio", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblDiskAreaDerived = AddDerivedRow(pnl, "Disk Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblRefBladeAreaDerived = AddDerivedRow(pnl, "Reference Blade Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblActiveBladeAreaDerived = AddDerivedRow(pnl, "Active Blade Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblTwistDerived = AddDerivedRow(pnl, "Total Twist", "deg"): y=y+rowH: rowIndex=rowIndex+1
	
	y = AddGeometrySectionHeader(y + 4dip, "ROTOR AERODYNAMICS")
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblAirfoil As Label = CreateRowLabel("Airfoil", "lblRowTip_Click")
	pnl.AddView(lblAirfoil, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnSelectAirfoil = CreateRowButton("Airfoil", "btnSelectAirfoil")
	pnl.AddView(btnSelectAirfoil, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtLiftSlope = AddFullInputRow(pnl, 4dip, 48dip, "Lift Slope a0", "", "1/rad", "edtGeom_TextChanged"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtCd0 = AddFullInputRow(pnl, 4dip, 48dip, "Profile Cd0", "", "[-]", "edtGeom_TextChanged"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblTip As Label = CreateRowLabel("Tip Loss", "lblRowTip_Click")
	pnl.AddView(lblTip, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnTipLoss = CreateRowButton("Tip Loss", "btnTipLoss")
	pnl.AddView(btnTipLoss, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtTipLossB = AddFullInputRow(pnl, 4dip, 48dip, "Fixed Tip Factor B", "", "[-]", "edtGeom_TextChanged"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblComp As Label = CreateRowLabel("Compressibility", "lblRowTip_Click")
	pnl.AddView(lblComp, pnl.Width*3/100, 4dip, pnl.Width*30/100, 48dip)
	btnCompressibility = CreateRowButton("Compressibility", "btnCompressibility")
	pnl.AddView(btnCompressibility, pnl.Width*37/100, 4dip, pnl.Width*60/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	
	Dim actions As Panel
	actions.Initialize("")
	actions.Color = ColorPnlInput5
	scvGeom.Panel.AddView(actions, UiContentLeft, y + 8dip, UiContentW, 64dip)
	Dim gap As Int = 6dip
	Dim bw As Int = (UiContentW - gap*4) / 3
	Dim bLoad As Button = CreateRowButton("LOAD ROTOR", "btnLoadRotor")
	Dim bSave As Button = CreateRowButton("SAVE", "btnSaveRotor")
	Dim bNew As Button = CreateRowButton("SAVE AS NEW", "btnSaveAsNewRotor")
	actions.AddView(bLoad, gap, 8dip, bw, 48dip)
	actions.AddView(bSave, gap*2+bw, 8dip, bw, 48dip)
	actions.AddView(bNew, gap*3+bw*2, 8dip, bw, 48dip)
	y = y + 82dip
	scvGeom.Panel.Height = y + 16dip
	LoadRotorDataToFields(ActiveGeom)
	RefreshLoadedRotorStrip
End Sub

Private Sub AddGeometrySectionHeader(y As Int, title As String) As Int
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title
	lbl.TextColor = ColorAccentGreen
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextSize = 10 * sc
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scvGeom.Panel.AddView(lbl, UiContentLeft + 12dip, y, UiContentW - 24dip, 26dip)
	Return y + 28dip
End Sub

Private Sub AddFormRowPanel(scv As ScrollView, y As Int, rowIndex As Int) As Panel
	Dim pnl As Panel
	pnl.Initialize("")
	If rowIndex Mod 2 = 0 Then pnl.Color = ColorPnlInput2 Else pnl.Color = ColorPnlInput1
	scv.Panel.AddView(pnl, UiContentLeft, y, UiContentW, 56dip)
	Dim lineRow As Panel
	lineRow.Initialize("")
	lineRow.Color = ColorPnlLine3
	scv.Panel.AddView(lineRow, UiContentLeft, y + 55dip, UiContentW, 1dip)
	Return pnl
End Sub

Private Sub AddDerivedRow(pnl As Panel, title As String, unit As String) As Label
	Dim lbl As Label = CreateRowLabel(title, "lblRowTip_Click")
	pnl.AddView(lbl, pnl.Width*3/100, 4dip, pnl.Width*48/100, 48dip)
	Dim value As Label
	value.Initialize("")
	value.Text = "---"
	value.TextColor = ColorAccentCyan
	value.Typeface = Typeface.DEFAULT_BOLD
	value.TextSize = 13 * sc
	value.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	pnl.AddView(value, pnl.Width*52/100, 4dip, pnl.Width*28/100, 48dip)
	Dim u As Label
	u.Initialize("")
	u.Text = unit
	u.TextColor = ColorButText2
	u.TextSize = 11 * sc
	u.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
	pnl.AddView(u, pnl.Width*82/100, 4dip, pnl.Width*15/100, 48dip)
	Return value
End Sub

Private Sub RefreshLoadedRotorStrip
	If lblLoadedRotor.IsInitialized = False Then Return
	Dim suffix As String = ""
	If GeometryDirty Then suffix = "  •  UNSAVED"
	lblLoadedRotor.Text = "Loaded rotor: " & ActiveGeom.Name & suffix
End Sub

Private Sub SaveCurrentRotor
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	GeometryDirty = False
	RefreshLoadedRotorStrip
	ToastMessageShow("Rotor saved.", False)
End Sub

Sub btnLoadRotor_Click
	If GeometryDirty Then
		Dim answer As Int = Msgbox2("Save current geometry changes before loading another rotor?", "Unsaved Geometry", "SAVE", "Cancel", "Discard", Null)
		If answer = DialogResponse.CANCEL Then Return
		If answer = DialogResponse.POSITIVE Then SaveCurrentRotor
	End If
	Dim options As List
	options.Initialize
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g As RotorGeometry = RotorStorage.Rotors.Get(i)
		options.Add(g.Name)
	Next
	Dim idx As Int = InputList(options, "Load Rotor", RotorStorage.ActiveIndex)
	If idx < 0 Then Return
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshLoadedRotorStrip
	RecalculateRotor
End Sub

Sub btnSaveRotor_Click
	SaveCurrentRotor
End Sub

Sub btnSaveAsNewRotor_Click
	Dim clone As RotorGeometry = zBETEngine.CloneGeometry(ActiveGeom)
	clone.Name = RotorStorage.MakeUniqueName(clone.Name)
	Dim idx As Int = RotorStorage.AddRotor(clone)
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshLoadedRotorStrip
	ToastMessageShow("Saved as new rotor: " & ActiveGeom.Name, False)
End Sub


' ====================================================================
' PAGE 1: CONDITIONS (AeroCalculator Row-by-Row Layout)
' ====================================================================
Private Sub BuildPageCond
	pnlBack1.Initialize("")
