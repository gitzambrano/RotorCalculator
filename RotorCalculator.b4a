	If UnitPopupOpen Then CloseUnitConverter
	root.RemoveAllViews
	root.Color = ColorPnlInput5
	Activity.Color = ColorPnlInput5
	ApplySystemBars
	InitSheet
	BuildAllPages
	BuildUnifiedHeader
	LoadConditionDataToFields
	RecalculateRotor
	ShowPage(CurrentPage, False)
End Sub

Private Sub ShowConventionDialog
	sheet.ShowMessage("zBET / zBEMT Conventions", "zBET / zBEMT rotor convention:" & CRLF & CRLF & _
		"+x / +V_x: forward in the rotor plane." & CRLF & _
		"+y: starboard." & CRLF & _
		"+V_z: positive downward through the disk; the relative wind arrives from above." & CRLF & _
		"Thrust T > 0 acts upward (-z)." & CRLF & CRLF & _
		"μ_x = V_x/(ΩR)." & CRLF & _
		"μ_z = V_z/(ΩR), positive for that downward relative flow." & CRLF & _
		"α > 0 means the stream arrives from below, so μ_z = -μ_x tan α." & CRLF & _
		"λ = μ_z + λ_i, with λ_i ≥ 0 induced downward." & CRLF & CRLF & _
		"CCW rotation viewed from above; advancing side is the right side.")
End Sub

