@EndOfDesignText@
#Region  Project Attributes 
	#ApplicationLabel: RotorCalculator
	#MultiDex: False
	#VersionCode: 3
	#VersionName: 1.20
	#SupportedOrientations: unspecified
	#CanInstallToExternalStorage: True
#End Region

#Region  Activity Attributes 
	#FullScreen: False
	#IncludeTitle: False
#End Region

#Region  Module Attributes 
	#IgnoreWarnings: 1, 2, 3, 4, 5, 6
#End Region
Sub Process_Globals
	
	' Theme Colors (AeroCalculator Cockpit Stealth Palette)
	Public ColorPnlTitle As Int = 0xFF0D121B     ' Dark Stealth Cockpit Header
	Public ColorTitleText As Int = 0xFFFFFFFF    ' Crisp White Title
	Public ColorPnlLine As Int = 0xFF00E5FF      ' Active Aero Cyan Indicator
	Public ColorPnlLine2 As Int = 0xFF1E2738     ' Header Hairline Divider
	Public ColorPnlLine3 As Int = 0xFF171E2B     ' Row Divider
	Public ColorBut3 As Int = 0x00000000         ' Transparent Tab Button
	Public ColorBut4 As Int = 0x00000000         ' Transparent Tab Button
	Public ColorButText2 As Int = 0xFF94A3B8     ' Unselected Tab Text (Slate)
	Public ColorButText3 As Int = 0xFF00E5FF     ' Active Tab Text (Cyan)
	Public ColorBut1 As Int = 0xFF1A2332         ' Button Gradient Top
	Public ColorBut2 As Int = 0xFF121925         ' Button Gradient Bottom
	Public ColorButText1 As Int = 0xFFF1F5F9     ' Button Text Main
	Public ColorEdt As Int = 0xFF0F141E          ' Edit Box Background
	Public ColorEdtText As Int = 0xFF00E5FF      ' Edit Text Cyan
	Public ColorEdtHint As Int = 0xFF64748B      ' Edit Hint Slate
	Public ColorPnlInput1 As Int = 0xFF0A0E15    ' Row 1 Background
	Public ColorPnlInput2 As Int = 0xFF0E131C    ' Row 2 Background
	Public ColorPnlInput3 As Int = 0xFF0A0E15    ' Output Row 1
	Public ColorPnlInput4 As Int = 0xFF0E131C    ' Output Row 2
	Public ColorPnlInput5 As Int = 0xFF07090E    ' Page Background
	Public ColorAccentCyan As Int = 0xFF00E5FF   ' Cyan Accent
	Public ColorAccentGreen As Int = 0xFF00E676  ' Emerald Accent
	Public ColorAccentAmber As Int = 0xFFFFB300  ' Amber Accent
	
	' Aerodynamic Global State
	Public ActiveGeom As RotorGeometry
	Public ActiveCond As FlightCondition
	Public ActiveRes As RotorResults
	Public AmbientPressureHPa As Double = 1013.25
	
	' Navigation & Scaling
	Public sc As Double = 1.0
	Public ld As Int = 0
	Public CurrentPage As Int = 0
	Public UnitSystem As Int = 0 ' 0=Metric (SI), 1=Imperial
	Public ThemeMode As Int = 0 ' 0=Dark, 1=Light
	Public ExtraPrecision As Int = 0 ' AeroCalculator-compatible +1 decimal
	Public ConditionAltitudeM As Double = 0.0
	Public ConditionTemperatureC As Double = 15.0
	Public HorizontalInputMode As String = "mu"   ' mu | vx
	Public ConditionHorizontalValue As Double = 0.0
	Public AxialInputMode As String = "alpha"     ' alpha | vz | muz
	Public ConditionAxialValue As Double = 0.0
	Private ion As Object ' Storage Access Framework activity-result callback

End Sub

Sub Globals
	
	' Activity content root. B4A activity content already excludes standard system bars.
	Private root As Panel
	
	' Unified Header (Title + Tabs)
	Private pnltitle As Panel
	Private btnTabGeom As Button
	Private btnTabCond As Button
	Private btnTabRes As Button
	Private line As Panel
	Private lblAppTitle As Label
	Private PopupMenu As RSPopupMenu
	Private pnlMenuAnchor As Panel
	Private pnlUnitPopup As Panel
	Private UnitPopupOpen As Boolean = False
	Private pnlSettingsPopup As Panel
	Private SettingsPopupOpen As Boolean = False
	Private pnlHelpPopup As Panel
	Private HelpPopupOpen As Boolean = False
	Private wvHelp As WebView
	Private ion As Object
	Private btnSettingTheme As Button
	Private btnSettingUnits As Button
	Private btnSettingPrecision As Button
	Private spnUnitMode As Spinner
	Private edtUnitValue As EditText
	Private lblUnitResult As Label
	
	' Page 0: Geometry Views
	Private pnlBack0 As Panel
	Private scvGeom As ScrollView
	Private pnlGeomPopup As Panel
	Private GeometryPopupOpen As Boolean = False
	Private scvGeomEditor As ScrollView
	Private lblGeomPopupTitle As Label
	Private edtRotorName As EditText
	Private edtRadius As EditText
	Private edtRPM As EditText
	Private edtNBlades As EditText
	Private edtRootCutout As EditText
	Private edtChordRoot As EditText
	Private edtChordTip As EditText
	Private edtThetaRoot As EditText
	Private edtThetaTip As EditText
	Private edtLiftSlope As EditText
	Private edtCd0 As EditText
	Private btnSelectAirfoil As Button
	Private btnTipLoss As Button
	Private btnCompressibility As Button
	
	' Page 1: Conditions Views
	Private pnlBack1 As Panel
	Private scvCond As ScrollView
	Private edtAltitude As EditText
	Private edtTemperature As EditText
	Private btnHorizontalInput As Button
	Private edtHorizontalValue As EditText
	Private lblHorizontalUnit As Label
	Private btnAxialInput As Button
	Private edtAxialValue As EditText
	Private lblAxialUnit As Label
	Private btnInflowModel As Button
	Private btnProfileDragModel As Button
	Private btnHoverTrimMode As Button
	Private edtTargetThrust As EditText
	Private edtTargetCT As EditText
	
	' Page 2: Results Views
	Private pnlBack2 As Panel
	Private scvRes As ScrollView
	Private btnViewPolarPlot As Button
	Private lblResultStatus As Label
	Private lblResults(25) As Label
	
	' Multi-Parameter μ-Sweep Popup
	Private pnlSweepPopup As Panel
	Private SweepPopupOpen As Boolean = False
	Private spnSweepParam As Spinner
	Private btnSweepMultiModel As Button
	Private btnSweepXAxis As Button
	Private btnSweepMaxMu As Button
	Private ivSweepPlot As ImageView
	Private lblSweepCurrentVal As Label
	Private SweepMultiMode As Int = 0
	Private SweepXAxisMode As Int = 0 ' 0=mu, 1=Vx
	Private SweepMaxMuVal As Double = 0.40
	Private SweepParamSelectedKey As String = "CP"
	Private SweepParamSelectedLabel As String = "CQ / CPshaft — Shaft Power"
	
	Private UpdatingUI As Boolean = False
	
	' Responsive layout metrics
	Private HeaderHeight As Int
	Private HeaderTopH As Int
	Private HeaderTabsY As Int
	Private HeaderTabsH As Int
	Private UiContentW As Int
	Private UiContentLeft As Int

End Sub

Sub Activity_Create(FirstTime As Boolean)
	
	' Initialize Independent Sub-Modules
	If FirstTime Then
		RotorStorage.Initialize
		RotorPopups.Initialize
		ActiveGeom = RotorStorage.GetActiveRotor
		ActiveCond = zBETEngine.CreateDefaultCondition
		LoadUiSettings
	End If
	ApplyThemePalette
	
	' B4A's Activity content area is the layout viewport. Keep all UI inside it.
	root.Initialize("")
	Activity.Color = ColorPnlInput5
	root.Color = ColorPnlInput5
	Activity.AddView(root, 0, 0, 100%x, 100%y)
	
	' Responsive scaling: both width and height constrain growth.
	' This prevents tall/narrow phones from enlarging the header until it clips.
	Dim hh As Double
	Dim ib As Int = 4dip
	Dim tb As Int = 48dip
	Dim PanelNb As Int = 14
	hh = 99dip + PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 1dip
	If root.Width > root.Height Then ld = 1 Else ld = 0
	Dim widthScale As Double = root.Width / 360dip
	Dim heightScale As Double = root.Height / hh
	sc = Min(widthScale, heightScale)
	If sc < 1 Then sc = 1
	If sc > 1.12 Then sc = 1.12
	
	' Compact landscape header; portrait preserves the AeroCalculator proportions.
	If ld = 1 Then
		sc = 1
		HeaderTopH = 48dip
		HeaderTabsY = 48dip
		HeaderTabsH = 48dip
		HeaderHeight = 97dip
	Else
		HeaderTopH = 56dip * sc
		HeaderTabsY = 56dip * sc
		HeaderTabsH = 48dip * sc
		HeaderHeight = 105dip * sc
	End If
	
	' Phone-width form on large screens: readable line lengths, no stretched controls.
	UiContentW = root.Width
	If UiContentW > 620dip Then UiContentW = 620dip
	UiContentLeft = (root.Width - UiContentW) / 2
	
	' Build three native pages. Custom header tabs control visibility.
	BuildPageGeom
	BuildPageCond
	BuildPageRes
	root.AddView(pnlBack0, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack1, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack2, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	
	' Header stays above page content.
	BuildUnifiedHeader
	
	' Restore persistent condition controls; geometry is edited only inside its modal.
	LoadConditionDataToFields
	RecalculateRotor
	ShowPage(CurrentPage, False)
	
End Sub

Sub Activity_Resume
	ShowPage(CurrentPage, False)
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean
	If KeyCode = KeyCodes.KEYCODE_BACK Then
		If HelpPopupOpen Then
			ClosePhysicsHelp
			Return True
		End If
		If SettingsPopupOpen Then
			CloseSettingsPopup
			Return True
		End If
		If UnitPopupOpen Then
			CloseUnitConverter
			Return True
		End If
		If GeometryPopupOpen Then
			CloseGeometryPopup
			Return True
		End If
		If SweepPopupOpen Then
			CloseSweepPopup
			Return True
		End If
		If CurrentPage = 2 Then
			ShowPage(1, True)
			Return True
		Else If CurrentPage = 1 Then
			ShowPage(0, True)
			Return True
		End If
	End If
	Return False
End Sub

' ====================================================================
' UNIFIED HEADER (AeroCalculator Style)
' ====================================================================
Private Sub BuildUnifiedHeader
	pnltitle.Initialize("pnltitle")
	root.AddView(pnltitle, 0, 0, root.Width, HeaderHeight)
	pnltitle.Color = ColorPnlTitle
	
	Dim edge As Int = Max(8dip, root.Width * 2 / 100)
	Dim iconSize As Int = 38dip * sc
	If ld = 1 Then iconSize = 34dip
	Dim iconTop As Int = (HeaderTopH - iconSize) / 2
	
	' 1. Left BEMT rotor icon
	Dim img1 As ImageView
	Dim bmpImage1 As Bitmap
	bmpImage1.Initialize(File.DirAssets, "icon.png")
	img1.Initialize("")
	img1.Bitmap = bmpImage1
	img1.Gravity = Gravity.FILL
	pnltitle.AddView(img1, edge, iconTop, iconSize, iconSize)
	
	' 2. 3-dot menu: keep a full 48dip touch target on every screen.
	Dim menuW As Int = 48dip
	pnlMenuAnchor.Initialize("pnlMenuAnchor")
	pnlMenuAnchor.Color = Colors.Transparent
	pnltitle.AddView(pnlMenuAnchor, root.Width - menuW - edge, 0, menuW, HeaderTopH)
	
	' Theme-aware overflow glyph. The old white PNG vanished on the Light header.
	Dim lblMenuDots As Label
	lblMenuDots.Initialize("pnlMenuAnchor")
	lblMenuDots.Text = "⋮"
	lblMenuDots.TextColor = ColorButText1
	lblMenuDots.TextSize = 28
	lblMenuDots.Gravity = Gravity.CENTER
	lblMenuDots.Typeface = Typeface.DEFAULT_BOLD
	pnlMenuAnchor.AddView(lblMenuDots, 0, 0, menuW, HeaderTopH)
	
	PopupMenu.Initialize("PopupMenu", pnlMenuAnchor)
	PopupMenu.AddMenuItem(0, 0, "Settings")
	PopupMenu.AddMenuItem(1, 1, "Quick Unit Converter")
	PopupMenu.AddMenuItem(2, 2, "Physics & Equations")
	PopupMenu.AddMenuItem(3, 3, "zBET Conventions & Physical Axes")
	PopupMenu.AddMenuItem(4, 4, "Reset to Factory Rotor Presets")
	PopupMenu.AddMenuItem(5, 5, "About RotorCalculator")
	
	' 3. App title uses the whole header between app icon and menu.
	Dim titleLeft As Int = edge + iconSize + 8dip
	Dim titleW As Int = root.Width - menuW - edge - titleLeft - 8dip
	lblAppTitle.Initialize("")
	lblAppTitle.Text = "RotorCalculator"
	lblAppTitle.TextColor = ColorTitleText
	Dim titleSize As Float = 20 * sc
	If titleW < 170dip Then titleSize = 18
	If titleW < 145dip Then titleSize = 17
	If titleW < 125dip Then titleSize = 15.5
	If root.Width <= 340dip Then titleSize = 14
	lblAppTitle.TextSize = titleSize
	lblAppTitle.Gravity = Gravity.CENTER_VERTICAL
	lblAppTitle.SingleLine = True
	Try
		lblAppTitle.Typeface = Typeface.LoadFromAssets("xenara-bold.ttf")
	Catch
		lblAppTitle.Typeface = Typeface.DEFAULT_BOLD
	End Try
	pnltitle.AddView(lblAppTitle, titleLeft, 0, titleW, HeaderTopH)
	
	' 4. Three large navigation tabs
	Dim tabW As Int = root.Width / 3
	Dim tabTextSize As Float = 13 * sc
	If root.Width <= 340dip Then tabTextSize = 12
	
	btnTabGeom.Initialize("btnTabGeom")
	pnltitle.AddView(btnTabGeom, 0, HeaderTabsY, tabW, HeaderTabsH)
	btnTabGeom.Text = "GEOMETRY"
	btnTabGeom.TextSize = tabTextSize
	btnTabGeom.Typeface = Typeface.DEFAULT_BOLD
	btnTabGeom.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabGeom.TextColor = ColorButText3
	btnTabGeom.Gravity = Gravity.CENTER
	btnTabGeom.Padding = Array As Int (0, 0, 0, 4dip)
	
	btnTabCond.Initialize("btnTabCond")
	pnltitle.AddView(btnTabCond, tabW, HeaderTabsY, tabW, HeaderTabsH)
	btnTabCond.Text = "CONDITIONS"
	btnTabCond.TextSize = tabTextSize
	btnTabCond.Typeface = Typeface.DEFAULT_BOLD
	btnTabCond.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabCond.TextColor = ColorButText2
	btnTabCond.Gravity = Gravity.CENTER
	btnTabCond.Padding = Array As Int (0, 0, 0, 4dip)
	
	btnTabRes.Initialize("btnTabRes")
	pnltitle.AddView(btnTabRes, tabW * 2, HeaderTabsY, root.Width - tabW * 2, HeaderTabsH)
	btnTabRes.Text = "RESULTS"
	btnTabRes.TextSize = tabTextSize
	btnTabRes.Typeface = Typeface.DEFAULT_BOLD
	btnTabRes.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnTabRes.TextColor = ColorButText2
	btnTabRes.Gravity = Gravity.CENTER
	btnTabRes.Padding = Array As Int (0, 0, 0, 4dip)
	
	' 5. Header divider and sliding active-tab indicator
	Dim line2 As Panel
	line2.Initialize("line2")
	pnltitle.AddView(line2, 0, HeaderHeight - 1dip, root.Width, 1dip)
	line2.Color = ColorPnlLine2
	line2.Elevation = 5dip
	
	line.Initialize("line")
	pnltitle.AddView(line, 0, HeaderHeight - 5dip, tabW, 4dip)
	line.Color = ColorPnlLine
	line.Elevation = 5dip
End Sub

Sub pnlMenuAnchor_Click
	PopupMenu.Show
End Sub

Sub PopupMenu_MenuItemClick(ItemId As Int) As Boolean
	Select ItemId
		Case 0
			OpenSettingsPopup
		Case 1
			OpenUnitConverter
		Case 2
			OpenPhysicsHelp
		Case 3
			ShowConventionDialog
		Case 4
			Dim resetAnswer As Int = Msgbox2("Restore all factory rotor presets? Custom copies and edits will be removed.", "Reset Rotor Presets", "RESET", "Cancel", "", Null)
			If resetAnswer = DialogResponse.POSITIVE Then
				If GeometryPopupOpen Then CloseGeometryPopup
				RotorStorage.ResetToDefaults
				ActiveGeom = RotorStorage.GetActiveRotor
				RefreshRotorList
				RefreshDerivedCondition(True)
				RecalculateRotor
				ToastMessageShow("Factory presets restored.", False)
			End If
		Case 5
			Dim pm As PackageManager
			Dim ver As String = "1.0.0"
			Try
				ver = pm.GetVersionName("flightdyn.rotorcalculator")
			Catch
			End Try
			Msgbox("RotorCalculator v" & ver & CRLF & CRLF & _
				"Rotor performance calculator using the zBET analytical model." & CRLF & _
				"Conventions aligned with zBET and zBEMT." & CRLF & CRLF & _
				"Developed by Gustavo Zambrano", "About RotorCalculator")
	End Select
	Return False
End Sub


' ====================================================================
' SETTINGS / THEME / OUTPUT FORMAT
' ====================================================================
Private Sub LoadUiSettings
	If File.Exists(File.DirInternal, "ui_settings.txt") = False Then Return
	Try
		Dim m As Map = File.ReadMap(File.DirInternal, "ui_settings.txt")
		ThemeMode = Max(0, Min(1, ParseIntDef("" & m.GetDefault("theme", 0), 0)))
		UnitSystem = Max(0, Min(1, ParseIntDef("" & m.GetDefault("units", 0), 0)))
		ExtraPrecision = Max(0, Min(1, ParseIntDef("" & m.GetDefault("precision", 0), 0)))
	Catch
		ThemeMode = 0
		UnitSystem = 0
		ExtraPrecision = 0
	End Try
End Sub

Private Sub SaveUiSettings
	Dim m As Map
	m.Initialize
	m.Put("theme", ThemeMode)
	m.Put("units", UnitSystem)
	m.Put("precision", ExtraPrecision)
	File.WriteMap(File.DirInternal, "ui_settings.txt", m)
End Sub

Private Sub ApplyThemePalette
	If ThemeMode = 1 Then
		ColorPnlTitle = 0xFFFFFFFF
		ColorTitleText = 0xFF0B1220
		ColorPnlLine = 0xFF007F95
		ColorPnlLine2 = 0xFFD5DCE6
		ColorPnlLine3 = 0xFFE3E8EF
		ColorBut3 = Colors.Transparent
		ColorBut4 = Colors.Transparent
		ColorButText2 = 0xFF667085
		ColorButText3 = 0xFF007F95
		ColorBut1 = 0xFFF8FAFC
		ColorBut2 = 0xFFE9EEF4
		ColorButText1 = 0xFF172033
		ColorEdt = 0xFFFFFFFF
		ColorEdtText = 0xFF006B7D
		ColorEdtHint = 0xFF78879A
		ColorPnlInput1 = 0xFFF7F9FC
		ColorPnlInput2 = 0xFFFFFFFF
		ColorPnlInput3 = 0xFFF7F9FC
		ColorPnlInput4 = 0xFFFFFFFF
		ColorPnlInput5 = 0xFFF1F4F8
		ColorAccentCyan = 0xFF007F95
		ColorAccentGreen = 0xFF007A52
		ColorAccentAmber = 0xFFAA5A00
	Else
		ColorPnlTitle = 0xFF0D121B
		ColorTitleText = 0xFFFFFFFF
		ColorPnlLine = 0xFF00E5FF
		ColorPnlLine2 = 0xFF1E2738
		ColorPnlLine3 = 0xFF171E2B
		ColorBut3 = Colors.Transparent
		ColorBut4 = Colors.Transparent
		ColorButText2 = 0xFF94A3B8
		ColorButText3 = 0xFF00E5FF
		ColorBut1 = 0xFF1A2332
		ColorBut2 = 0xFF121925
		ColorButText1 = 0xFFF1F5F9
		ColorEdt = 0xFF0F141E
		ColorEdtText = 0xFF00E5FF
		ColorEdtHint = 0xFF64748B
		ColorPnlInput1 = 0xFF0A0E15
		ColorPnlInput2 = 0xFF0E131C
		ColorPnlInput3 = 0xFF0A0E15
		ColorPnlInput4 = 0xFF0E131C
		ColorPnlInput5 = 0xFF07090E
		ColorAccentCyan = 0xFF00E5FF
		ColorAccentGreen = 0xFF00E676
		ColorAccentAmber = 0xFFFFB300
	End If
End Sub

Private Sub OpenSettingsPopup
	If SettingsPopupOpen Then CloseSettingsPopup
	pnlSettingsPopup.Initialize("pnlSettingsPopup")
	pnlSettingsPopup.Color = 0x99000000
	root.AddView(pnlSettingsPopup, 0, 0, root.Width, root.Height)
	SettingsPopupOpen = True
	pnlSettingsPopup.BringToFront
	
	Dim cardW As Int = root.Width - 24dip
	If cardW > 540dip Then cardW = 540dip
	Dim cardH As Int = 360dip
	If cardH > root.Height - 24dip Then cardH = root.Height - 24dip
	Dim cardLeft As Int = (root.Width - cardW) / 2
	Dim cardTop As Int = (root.Height - cardH) / 2
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlSettingsPopup.AddView(card, cardLeft, cardTop, cardW, cardH)
	
	Dim titleBar As Panel
	titleBar.Initialize("")
	titleBar.Color = ColorPnlTitle
	card.AddView(titleBar, 0, 0, cardW, 52dip)
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "SETTINGS"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 14
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	titleBar.AddView(lblTitle, 16dip, 0, cardW - 72dip, 52dip)
	Dim btnClose As Button
	btnClose.Initialize("btnCloseSettings")
	btnClose.Text = "×"
	btnClose.TextColor = ColorButText1
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	titleBar.AddView(btnClose, cardW - 52dip, 2dip, 48dip, 48dip)
	
	AddSettingsRow(card, 68dip, "Theme", "Dark or light cockpit palette", "btnSettingTheme")
	AddSettingsRow(card, 150dip, "Result Units", "Dimensional outputs only", "btnSettingUnits")
	AddSettingsRow(card, 232dip, "Output Format", "AeroCalculator-style precision", "btnSettingPrecision")
	RefreshSettingsButtons
End Sub

Private Sub AddSettingsRow(card As Panel, y As Int, title As String, subtitle As String, eventName As String)
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title & CRLF & subtitle
	lbl.TextColor = ColorButText1
	lbl.TextSize = 12
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	card.AddView(lbl, 16dip, y, card.Width * 0.48, 64dip)
	Dim b As Button
	b.Initialize(eventName)
	b.TextColor = ColorAccentCyan
	b.Typeface = Typeface.DEFAULT_BOLD
	b.TextSize = 12
	b.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	card.AddView(b, card.Width * 0.53, y + 8dip, card.Width * 0.42, 48dip)
	If eventName = "btnSettingTheme" Then btnSettingTheme = b
	If eventName = "btnSettingUnits" Then btnSettingUnits = b
	If eventName = "btnSettingPrecision" Then btnSettingPrecision = b
End Sub

Private Sub RefreshSettingsButtons
	If btnSettingTheme.IsInitialized Then
		If ThemeMode = 1 Then btnSettingTheme.Text = "LIGHT" Else btnSettingTheme.Text = "DARK"
	End If
	If btnSettingUnits.IsInitialized Then
		If UnitSystem = 1 Then btnSettingUnits.Text = "IMPERIAL" Else btnSettingUnits.Text = "SI"
	End If
	If btnSettingPrecision.IsInitialized Then
		If ExtraPrecision = 1 Then btnSettingPrecision.Text = "+1 DECIMAL" Else btnSettingPrecision.Text = "STANDARD"
	End If
End Sub

Sub btnSettingTheme_Click
	ThemeMode = 1 - ThemeMode
	SaveUiSettings
	CloseSettingsPopup
	ApplyThemePalette
	RebuildApplicationUI
End Sub

Sub btnSettingUnits_Click
	UnitSystem = 1 - UnitSystem
	SaveUiSettings
	RefreshSettingsButtons
	RecalculateRotor
End Sub

Sub btnSettingPrecision_Click
	ExtraPrecision = 1 - ExtraPrecision
	SaveUiSettings
	RefreshSettingsButtons
	RecalculateRotor
End Sub

Sub btnCloseSettings_Click
	CloseSettingsPopup
End Sub

Private Sub CloseSettingsPopup
	If SettingsPopupOpen Then
		pnlSettingsPopup.RemoveView
		SettingsPopupOpen = False
	End If
End Sub

Private Sub RebuildApplicationUI
	If GeometryPopupOpen Then CloseGeometryPopup
	If HelpPopupOpen Then ClosePhysicsHelp
	If SweepPopupOpen Then CloseSweepPopup
	If UnitPopupOpen Then CloseUnitConverter
	root.RemoveAllViews
	root.Color = ColorPnlInput5
	Activity.Color = ColorPnlInput5
	BuildPageGeom
	BuildPageCond
	BuildPageRes
	root.AddView(pnlBack0, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack1, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	root.AddView(pnlBack2, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	BuildUnifiedHeader
	LoadConditionDataToFields
	RecalculateRotor
	ShowPage(CurrentPage, False)
End Sub

Private Sub ShowConventionDialog
	Msgbox("zBET / zBEMT rotor convention:" & CRLF & CRLF & _
		"+x / +Vx: forward in the rotor plane." & CRLF & _
		"+y: starboard." & CRLF & _
		"+z / +Vz: downward through the disk." & CRLF & _
		"Thrust T > 0 acts upward (-z)." & CRLF & CRLF & _
		"μ = Vx/(ΩR)." & CRLF & _
		"μz = Vz/(ΩR), positive downward." & CRLF & _
		"α > 0 means the stream arrives from below, so μz = -μ tan α." & CRLF & _
		"λ = μz + λi, with λi ≥ 0 induced downward." & CRLF & CRLF & _
		"CCW rotation viewed from above; advancing side is the right side.", "zBET / zBEMT Conventions")
End Sub

