Private Sub BuildPageCond
	pnlBack1.Initialize("")
	pnlBack1.Color = ColorPnlInput5
	scvCond.Initialize(2300)
	pnlBack1.AddView(scvCond, 0, 0, root.Width, root.Height - HeaderHeight)
	Dim y As Int = 8dip
	Dim rowIndex As Int = 0
	Dim rowH As Int = 57dip
	Dim pnl As Panel
	
	y = AddConditionSectionHeader(y, "ATMOSPHERE & FLOW")
	pnl = AddFormRowPanel(scvCond, y, rowIndex): edtAltitude = AddFullInputRow(pnl, 4dip, 48dip, "h — Altitude", "0", "m", "edtCond"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvCond, y, rowIndex): edtTemperature = AddFullInputRow(pnl, 4dip, 48dip, "Tair — Temperature", "15", "°C", "edtCond"): y=y+rowH: rowIndex=rowIndex+1
	
