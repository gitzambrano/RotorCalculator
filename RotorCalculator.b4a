' ====================================================================
' PAGE 2: RESULTS / OUTPUTS (AeroCalculator scvMain2 Architecture)
' ====================================================================
Private Sub BuildPageRes
	pnlBack2.Initialize("")
	pnlBack2.Color = ColorPnlInput5
	scvRes.Initialize(3600)
	pnlBack2.AddView(scvRes, 0, 0, root.Width, root.Height - HeaderHeight)
	
	btnViewPolarPlot.Initialize("btnViewPolarPlot")
	btnViewPolarPlot.Text = "OPEN PARAMETER SWEEP"
	btnViewPolarPlot.Typeface = Typeface.DEFAULT_BOLD
	btnViewPolarPlot.TextColor = ColorAccentCyan
	btnViewPolarPlot.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnViewPolarPlot.TextSize = 15 * sc
	scvRes.Panel.AddView(btnViewPolarPlot, UiContentLeft + UiContentW*3/100, 8dip, UiContentW*94/100, 48dip)
	
	lblResultStatus.Initialize("lblResultStatus")
	lblResultStatus.Text = "MODEL STATUS · ---"
	lblResultStatus.TextColor = ColorButText2
	lblResultStatus.Typeface = Typeface.DEFAULT_BOLD
	lblResultStatus.TextSize = 13.5 * sc
	lblResultStatus.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblResultStatus.SingleLine = True
	scvRes.Panel.AddView(lblResultStatus, UiContentLeft + UiContentW*4/100, 60dip, UiContentW*92/100, 30dip)
	
	lblTrimSummary.Initialize("lblTrimSummary")
	lblTrimSummary.Text = "OPERATING SOLUTION · ---"
	lblTrimSummary.TextColor = ColorAccentCyan
	lblTrimSummary.Typeface = Typeface.DEFAULT_BOLD
	lblTrimSummary.TextSize = 13.5 * sc
	lblTrimSummary.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblTrimSummary.SingleLine = True
	scvRes.Panel.AddView(lblTrimSummary, UiContentLeft + UiContentW*4/100, 90dip, UiContentW*92/100, 30dip)
	
	Dim labels As List
	labels.Initialize2(Array As String( _
		"T — Thrust", "Pshaft — Shaft Power", "Q — Shaft Torque", "H — In-Plane Force", _
		"Y — Side Force", "Mx — Roll Moment", "My — Pitch Moment", _
		"CT — Thrust", "CQ — Torque", "CQi — Induced Torque", "CQ0 — Profile Torque", _
		"CH — In-Plane", "CHi — Induced In-Plane", "CH0 — Profile In-Plane", "CY — Side Force", _
		"CMx — Roll Moment", "CMy — Pitch Moment", "CPair — Air Power", _
		"FoM — Figure of Merit", "L/D eff — Effective L/D", _
		"λ — Total Inflow", "λi — Induced Inflow", "Kx — Longitudinal Inflow", _
		"Ky — Lateral Inflow", "χ — Wake Skew Angle", "B — Tip-Loss Factor", _
		"RPM — Solved Speed", "Δθ — Collective Increment", "CT — Solved", "T — Solved Thrust", _
		"μ — Advance Ratio", "Vx — Forward Speed", "μz — Axial Ratio", "Vz — Axial Speed", "α — Rotor AoA", _
		"ΩR — Tip Speed", "Mtip — Tip Mach", "Mat — Advancing Tip Mach", _
		"h — Altitude", "Tair — Temperature", "ρ — Air Density", "p — Ambient Pressure", "a — Speed of Sound" _
	))
	Dim y As Int = 126dip
	Dim rowH As Int = 50dip
	Dim sectionH As Int = 30dip
	For i = 0 To labels.Size - 1
		Dim sectionTitle As String = ""
		Select i
			Case 0: sectionTitle = "DIMENSIONAL PERFORMANCE"
			Case 7: sectionTitle = "AERODYNAMIC COEFFICIENTS"
			Case 18: sectionTitle = "EFFICIENCY"
			Case 20: sectionTitle = "INFLOW & WAKE"
			Case 26: sectionTitle = "OPERATING STATE & ATMOSPHERE"
		End Select
		If sectionTitle <> "" Then
			Dim sh As Label
			sh.Initialize("")
			sh.Text = sectionTitle
			sh.TextColor = ColorAccentGreen
			sh.Typeface = Typeface.DEFAULT_BOLD
			sh.TextSize = 13.5 * sc
			sh.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
			scvRes.Panel.AddView(sh, UiContentLeft + UiContentW*4/100, y, UiContentW*92/100, sectionH)
			y = y + sectionH
		End If
		Dim row As Panel
		row.Initialize("")
		If i Mod 2 = 0 Then row.Color = ColorPnlInput4 Else row.Color = ColorPnlInput3
		scvRes.Panel.AddView(row, UiContentLeft, y, UiContentW, rowH)
		Dim sep As Panel
		sep.Initialize("")
		sep.Color = ColorPnlLine3
		scvRes.Panel.AddView(sep, UiContentLeft, y + rowH - 1dip, UiContentW, 1dip)
		Dim canonical As String = labels.Get(i)
		Dim lbl As Label
		lbl.Initialize("lblResultTip")
		lbl.Tag = canonical
		lbl.Text = ResultDisplayLabel(canonical)
		lbl.TextColor = ColorTitleText
		lbl.Typeface = Typeface.DEFAULT_BOLD
		lbl.TextSize = 15 * sc
		lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		lbl.SingleLine = True
		If root.Width <= 360dip Then
			row.AddView(lbl, row.Width*3/100, 0, row.Width*36/100, rowH)
		Else
			row.AddView(lbl, row.Width*3/100, 0, row.Width*47/100, rowH)
		End If
		lblResults(i).Initialize("")
		lblResults(i).Text = "---"
		lblResults(i).TextColor = ColorAccentCyan
		lblResults(i).Typeface = Typeface.DEFAULT_BOLD
		lblResults(i).TextSize = 15.5 * sc
		lblResults(i).Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.RIGHT)
		lblResults(i).SingleLine = True
		If root.Width <= 360dip Then
			row.AddView(lblResults(i), row.Width*40/100, 0, row.Width*32/100, rowH)
		Else
			row.AddView(lblResults(i), row.Width*52/100, 0, row.Width*24/100, rowH)
		End If
		lblResultUnits(i).Initialize("")
		lblResultUnits(i).Text = ResultDefaultUnit(i)
		lblResultUnits(i).TextColor = ColorButText2
		lblResultUnits(i).Typeface = Typeface.DEFAULT_BOLD
		If root.Width <= 360dip Then lblResultUnits(i).TextSize = 14 Else lblResultUnits(i).TextSize = 14.5 * sc
		lblResultUnits(i).Gravity = Gravity.CENTER
		lblResultUnits(i).SingleLine = True
		If root.Width <= 360dip Then
			row.AddView(lblResultUnits(i), row.Width*73/100, 0, row.Width*25/100, rowH)
		Else
			row.AddView(lblResultUnits(i), row.Width*77/100, 0, row.Width*20/100, rowH)
		End If
		y = y + rowH
	Next
	scvRes.Panel.Height = y + 24dip
End Sub

' Compact labels are used only when the available width requires them.
' The full engineering meaning remains available through the row/result tooltip.
Private Sub InputDisplayLabel(fullText As String) As String
	If root.Width <= 360dip Then
		Select fullText
			Case "Rotor Name": Return "Name"
			Case "Radius R": Return "R"
			Case "Blade Count": Return "Nb"
			Case "Root Cutout": Return "x₀"
			Case "Root Chord c0": Return "c₀"
			Case "Tip Chord c1": Return "c₁"
			Case "Reference Solidity": Return "σref"
			Case "Aspect Ratio": Return "AR"
			Case "Root Incidence": Return "θroot"
			Case "Tip Incidence": Return "θtip"
			Case "Geometric Solidity": Return "σgeom"
			Case "Thrust Solidity": Return "σthrust"
			Case "Disk Area": Return "A"
			Case "Reference Blade Area": Return "Sref,b"
			Case "Active Blade Area": Return "Sactive,b"
			Case "Total Twist": Return "Δθtwist"
			Case "Taper Ratio": Return "Taper"
			Case "Lift Slope a0": Return "a₀"
			Case "Profile Cd0": Return "Cd₀"
			Case "Fixed Tip Factor B": Return "Fixed B"
			Case "h — Altitude": Return "h"
			Case "Tair — Temperature": Return "Tair"
			Case "Operating Inputs": Return "Inputs"
			Case "Collective Δθ": Return "Δθ"
			Case "Target CT": Return "CT"
			Case "Target Thrust": Return "T"
			Case "K_ind": Return "K_ind"
			Case "Inflow Model": Return "Inflow"
			Case "Compressibility": Return "Comp."
			Case "Profile Drag": Return "Drag"
			Case Else: Return fullText
		End Select
	End If
	If root.Width <= 430dip Then
		Select fullText
			Case "Rotor Name": Return "Name"
			Case "Blade Count": Return "Blades"
			Case "Root Cutout": Return "Root x₀"
			Case "Root Chord c0": Return "Root c₀"
			Case "Tip Chord c1": Return "Tip c₁"
			Case "Reference Solidity": Return "σref"
			Case "Aspect Ratio": Return "AR"
			Case "Root Incidence": Return "θroot"
			Case "Tip Incidence": Return "θtip"
			Case "Geometric Solidity": Return "σgeom"
			Case "Thrust Solidity": Return "σthrust"
			Case "Reference Blade Area": Return "Ref. area"
			Case "Active Blade Area": Return "Active area"
			Case "Total Twist": Return "Twist"
			Case "Lift Slope a0": Return "a₀"
			Case "Profile Cd0": Return "Cd₀"
			Case "Fixed Tip Factor B": Return "Fixed B"
			Case "Tair — Temperature": Return "Temperature"
			Case "Operating Inputs": Return "Operating pair"
			Case "Collective Δθ": Return "Collective"
			Case "Target Thrust": Return "Target T"
			Case "Inflow Model": Return "Inflow"
			Case "Compressibility": Return "Compress."
			Case Else: Return fullText
		End Select
	End If
	Select fullText
		Case "Root Chord c0": Return "Root Chord c₀"
		Case "Tip Chord c1": Return "Tip Chord c₁"
		Case "Lift Slope a0": Return "Lift Slope a₀"
		Case "Profile Cd0": Return "Profile Cd₀"
	End Select
	Return fullText
End Sub

Private Sub HeaderRotorName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim n As String = fullName.ToLowerCase
	If n.Contains("uh-60") Then Return "UH-60"
	If n.Contains("bell 206") Then Return "Bell 206"
	If n.Contains("bo 105") Or n.Contains("bo105") Then Return "Bo 105"
	If n.Contains("r44") Then Return "R44"
	If n.Contains("dji") Then Return "DJI"
	If n.Contains("evtol") Then Return "eVTOL"
	Return fullName
End Sub

Private Sub RotorListName(fullName As String) As String
	If root.Width > 430dip Then Return fullName
	Dim lowerName As String = fullName.ToLowerCase
	Dim shortName As String = HeaderRotorName(fullName)
	If shortName.ToLowerCase.Contains("copy") = False Then
		If lowerName.Contains(" copy") Then
			Dim copyPos As Int = lowerName.IndexOf(" copy")
			If copyPos >= 0 Then
				Dim copySuffix As String = fullName.SubString(copyPos + 1).Trim
				Dim suffixLower As String = copySuffix.ToLowerCase
				If suffixLower = "copy" Or (suffixLower.StartsWith("copy ") And IsNumber(copySuffix.SubString(5).Trim)) Then
					shortName = shortName & " (" & copySuffix & ")"
				End If
			End If
		Else If lowerName.Contains("(copy)") Then
			shortName = shortName & " (Copy)"
		End If
	End If
	If shortName.Length > 24 Then shortName = shortName.SubString2(0, 21) & "…"
	Return shortName
End Sub

Sub ResultDisplayLabel(canonical As String) As String
	If root.Width <= 360dip Then
		Dim cut As Int = canonical.IndexOf(" — ")
		If cut > 0 Then Return canonical.SubString2(0, cut)
		Return canonical
	End If
	If root.Width <= 430dip Then
		Select canonical
			Case "Pshaft — Shaft Power": Return "Pshaft — Power"
			Case "Q — Shaft Torque": Return "Q — Torque"
			Case "H — In-Plane Force": Return "H — In-Plane"
			Case "CQi — Induced Torque": Return "CQi — Induced Q"
			Case "CQ0 — Profile Torque": Return "CQ0 — Profile Q"
			Case "CHi — Induced In-Plane": Return "CHi — Induced H"
			Case "CH0 — Profile In-Plane": Return "CH0 — Profile H"
			Case "FoM — Figure of Merit": Return "FoM — Merit"
			Case "L/D eff — Effective L/D": Return "L/D eff"
			Case "Kx — Longitudinal Inflow": Return "Kx — Long. Inflow"
			Case "Ky — Lateral Inflow": Return "Ky — Lat. Inflow"
			Case "χ — Wake Skew Angle": Return "χ — Wake Skew"
			Case "RPM — Solved Speed": Return "RPM — Solved"
			Case "Δθ — Collective Increment": Return "Δθ — Collective"
			Case "T — Solved Thrust": Return "T — Solved"
			Case "Mat — Advancing Tip Mach": Return "Mat — Adv. Mach"
			Case "Tair — Temperature": Return "Tair — Temp."
		End Select
	End If
	Return canonical
End Sub

Sub lblResultStatus_Click
	If ActiveRes.SolutionValid = False Then
		Msgbox(ActiveRes.StatusMessage & CRLF & CRLF & "Adjust the prescribed operating pair, flight condition, or rotor definition.", "Model Status")
	Else If ActiveRes.CompressibilityWarning Then
		Msgbox("Advancing-tip Mach is at or above 0.80 while Prandtl-Glauert is enabled." & CRLF & CRLF & _
			"The calculation remains finite, but the linear compressibility approximation is outside its preferred range.", "Compressibility Caution")
	Else
		ToastMessageShow("Model status: valid operating point.", False)
	End If
End Sub

Sub lblResultTip_Click
	Dim l As Label = Sender
	Msgbox(ResultTooltip("" & l.Tag), "About · " & l.Tag)
End Sub

Private Sub ResultTooltip(labelText As String) As String
	Select labelText
		Case "T — Thrust": Return "Solved rotor thrust T at the current flight condition."
		Case "Pshaft — Shaft Power": Return "Mechanical shaft power P = ΩQ."
		Case "Q — Shaft Torque": Return "Aerodynamic torque about the rotor shaft."
		Case "H — In-Plane Force": Return "Dimensional longitudinal in-plane rotor force H."
		Case "Y — Side Force": Return "Dimensional lateral rotor side force Y."
		Case "Mx — Roll Moment": Return "Dimensional rotor rolling moment Mx."
		Case "My — Pitch Moment": Return "Dimensional rotor pitching moment My."
		Case "CT — Thrust": Return "CT = T / [ρ A (ΩR)²]."
		Case "CQ — Torque": Return "CQ = Q / [ρ A (ΩR)² R], equal to shaft-power coefficient CPshaft."
		Case "CQi — Induced Torque": Return "Induced torque/power contribution from the blade-element torque integral or configured energy balance."
		Case "CQ0 — Profile Torque": Return "Profile-drag torque from Numerical Vectorial radial/azimuthal integration."
		Case "CH — In-Plane": Return "Total longitudinal in-plane force coefficient CH = CHi + CH0."
		Case "CHi — Induced In-Plane": Return "Induced contribution to longitudinal in-plane force coefficient."
		Case "CH0 — Profile In-Plane": Return "Numerical Vectorial profile-drag contribution to CH."
		Case "CY — Side Force": Return "Rotor lateral side-force coefficient."
		Case "CMx — Roll Moment": Return "Rotor rolling-moment coefficient about the x axis."
		Case "CMy — Pitch Moment": Return "Rotor pitching-moment coefficient about the y axis."
		Case "CPair — Air Power": Return "Air-power coefficient from induced, axial-flow, profile and translational energy terms."
		Case "FoM — Figure of Merit": Return "Hover efficiency metric using ideal induced power divided by K_ind·ideal induced power plus profile power."
		Case "L/D eff — Effective L/D": Return "(L/D)eff = μ CT / CPair = T Vx / Pair when the forward-power interpretation is applicable."
		Case "λ — Total Inflow": Return "λ = μz + λi."
		Case "λi — Induced Inflow": Return "Positive induced downwash inflow ratio."
		Case "Kx — Longitudinal Inflow": Return "Longitudinal first-harmonic inflow-gradient factor."
		Case "Ky — Lateral Inflow": Return "Lateral first-harmonic inflow-gradient factor."
		Case "χ — Wake Skew Angle": Return "Wake-skew angle derived from in-plane and total inflow components."
		Case "B — Tip-Loss Factor": Return "Effective tip-radius factor used by the selected tip-loss model."
		Case "RPM — Solved Speed": Return "Operating RPM after solving the selected pair of RPM, collective, CT and thrust constraints."
		Case "Δθ — Collective Increment": Return "Solved uniform collective increment added equally to root and tip incidence."
		Case "CT — Solved": Return "CT from the final trimmed operating state."
		Case "T — Solved Thrust": Return "Dimensional thrust from the final trimmed operating state."
		Case "μ — Advance Ratio": Return "μ = Vx/(ΩR) at the solved operating RPM."
		Case "Vx — Forward Speed": Return "Dimensional forward in-plane relative velocity corresponding to μ."
		Case "μz — Axial Ratio": Return "μz = Vz/(ΩR); positive means downward relative flow through the disk."
		Case "Vz — Axial Speed": Return "Positive Vz represents positive climb rate: relative wind arrives from above and passes downward through the disk."
		Case "α — Rotor AoA": Return "Rotor angle of attack; positive α means relative wind arrives from below. μz = -μ tan α."
		Case "ΩR — Tip Speed": Return "Solved rotational tip speed ΩR."
		Case "Mtip — Tip Mach": Return "Rotational tip Mach ΩR/a."
		Case "Mat — Advancing Tip Mach": Return "Approximate advancing-tip Mach using ΩR(1+μ)/a."
		Case "h — Altitude": Return "Pressure altitude used by the atmosphere model."
		Case "Tair — Temperature": Return "Ambient temperature used by density and speed-of-sound calculations."
		Case "ρ — Air Density": Return "Ambient density ρ used in dimensional aerodynamic scaling."
		Case "p — Ambient Pressure": Return "Ambient static pressure from the active atmosphere."
		Case "a — Speed of Sound": Return "Local speed of sound used for Mach and compressibility."
		Case Else: Return labelText
	End Select
End Sub

' Text row for rotor names; numeric rows stay numeric-only.
Sub AddTextInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, evtName As String) As EditText
	Dim lbl As Button = CreateRowLabel(lblText, "lblRowTip")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 31 / 100, tb * sc)
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	edt.Text = defVal
	UpdatingUI = wasUpdating
	If root.Width <= 360dip And lblText = "Rotor Name" Then
		edt.TextSize = 14.5
	Else
		edt.TextSize = 16 * sc
	End If
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	If lblText = "Rotor Name" Then
		edt.SingleLine = False
	Else
		edt.SingleLine = True
	End If
	edt.ForceDoneButton = True
	pnl.AddView(edt, pnl.Width * 36 / 100, ib * sc, pnl.Width * 39 / 100, tb * sc)
	Dim u As Button = CreateUnitButton(lblText, "—")
	pnl.AddView(u, pnl.Width * 77 / 100, ib * sc, pnl.Width * 20 / 100, tb * sc)
	Return edt
End Sub

' Helper to create 30%x | 36%x | 20%x standard input rows
Sub AddFullInputRow(pnl As Panel, ib As Int, tb As Int, lblText As String, defVal As String, unitText As String, evtName As String) As EditText
	Dim lbl As Button = CreateRowLabel(lblText, "lblRowTip")
	pnl.AddView(lbl, pnl.Width * 3 / 100, ib * sc, pnl.Width * 31 / 100, tb * sc)
	Dim edt As EditText
	edt.Initialize(evtName)
	edt.Tag = lblText
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	edt.Text = defVal
	UpdatingUI = wasUpdating
	edt.TextSize = 16 * sc
	edt.TextColor = ColorEdtText
	edt.Color = ColorEdt
	edt.HintColor = ColorEdtHint
	edt.Gravity = Gravity.CENTER
	edt.InputType = Bit.Or(edt.INPUT_TYPE_DECIMAL_NUMBERS, 4096)
	edt.ForceDoneButton = True
	edt.SingleLine = True
	pnl.AddView(edt, pnl.Width * 36 / 100, ib * sc, pnl.Width * 39 / 100, tb * sc)
	Dim u As Button = CreateUnitButton(lblText, unitText)
	pnl.AddView(u, pnl.Width * 77 / 100, ib * sc, pnl.Width * 20 / 100, tb * sc)
	Return edt
End Sub

Sub CreateRowLabel(txt As String, evt As String) As Button
	Dim btn As Button
	btn.Initialize(evt)
	btn.Text = InputDisplayLabel(txt)
	If root.Width <= 360dip Then btn.TextSize = 14.5 Else btn.TextSize = 15 * sc
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorTitleText
	btn.Background = ButtonGradient(Array As Int(ColorPnlInput2, ColorBut1), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	btn.Tag = txt
	Return btn
End Sub

Sub CreateUnitButton(field As String, unitText As String) As Button
	Dim btn As Button
	btn.Initialize("unitRow")
	btn.Tag = field
	btn.Text = UnitForField(field, unitText)
	If unitText = "—" Then btn.Text = "—"
	If root.Width <= 360dip Then btn.TextSize = 14.5 Else btn.TextSize = 15 * sc
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorButText2
	btn.Background = ButtonGradient(Array As Int(ColorPnlInput2, ColorBut1), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	Return btn
End Sub

Sub CreateRowButton(txt As String, evt As String) As Button
	Dim btn As Button
	btn.Initialize(evt)
	btn.Text = InputDisplayLabel(txt)
	If root.Width <= 340dip Then btn.TextSize = 14 Else btn.TextSize = 15 * sc
	btn.Typeface = Typeface.DEFAULT_BOLD
	btn.TextColor = ColorButText1
	btn.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btn.Gravity = Gravity.CENTER
	btn.SingleLine = True
	Return btn
End Sub

' ====================================================================
' AEROCALCULATOR GRADIENTS & DRAWABLES
' ====================================================================
Sub ButtonGradient(ColorList() As Int, ColorList2() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("BOTTOM_TOP", ColorList2)
	gdwPressed.CornerRadius = 6dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
	Dim gdwEnabled As GradientDrawable
	gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
	gdwEnabled.CornerRadius = 4dip
	Dim gdwPressed As GradientDrawable
	gdwPressed.Initialize("TOP_BOTTOM", ColorList)
	gdwPressed.CornerRadius = 12dip
	Dim gdwDisabled As GradientDrawable
	gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
	gdwDisabled.CornerRadius = 4dip
	Dim stdGradient As StateListDrawable
	stdGradient.Initialize
	stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
	stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
	stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
	Return stdGradient
End Sub

' ====================================================================
' NATIVE PAGE NAVIGATION
' ====================================================================
Private Sub ShowPage(Position As Int, Animated As Boolean)
	If Position < 0 Or Position > 2 Then Position = 0
	CurrentPage = Position
	pnlBack0.Visible = (Position = 0)
	pnlBack1.Visible = (Position = 1)
	pnlBack2.Visible = (Position = 2)
	
	Dim tabW As Int = root.Width / 3
	Dim duration As Int = 0
	If Animated Then duration = 150
	line.SetLayoutAnimated(duration, Position * tabW, HeaderHeight - 5dip, tabW, 4dip)
	
	btnTabGeom.TextColor = ColorButText2
	btnTabCond.TextColor = ColorButText2
	btnTabRes.TextColor = ColorButText2
	
	Select Position
		Case 0
			btnTabGeom.TextColor = ColorButText3
		Case 1
			btnTabCond.TextColor = ColorButText3
		Case 2
			btnTabRes.TextColor = ColorButText3
			Dim p As Phone
			p.HideKeyboard(Activity)
			RecalculateRotor
	End Select
End Sub

Sub btnTabGeom_Click
	ShowPage(0, True)
End Sub

Sub btnTabCond_Click
	ShowPage(1, True)
End Sub

Sub btnTabRes_Click
	ShowPage(2, True)
End Sub

' ====================================================================
' AERODYNAMIC CALCULATION & TELEMETRY MAPPING
' ====================================================================
Private Sub ResultDefaultUnit(Index As Int) As String
	If UnitSystem = 0 Then
		Select Index
			Case 0, 3, 4, 29: Return "N"
			Case 1: Return "kW"
			Case 2, 5, 6: Return "N·m"
			Case 24, 27, 34: Return "deg"
			Case 26: Return "rpm"
			Case 31, 33, 35, 42: Return "m/s"
			Case 38: Return "m"
			Case 39: Return "°C"
			Case 40: Return "kg/m³"
			Case 41: Return "hPa"
			Case Else: Return "[-]"
		End Select
	Else
		Select Index
			Case 0, 3, 4, 29: Return "lbf"
			Case 1: Return "hp"
			Case 2, 5, 6: Return "lb·ft"
			Case 24, 27, 34: Return "deg"
			Case 26: Return "rpm"
			Case 31, 33, 35, 42: Return "ft/s"
			Case 38: Return "ft"
			Case 39: Return "°F"
			Case 40: Return "slug/ft³"
			Case 41: Return "inHg"
			Case Else: Return "[-]"
		End Select
	End If
End Sub

Private Sub SetResultCell(Index As Int, ValueText As String, UnitText As String)
	If Index < 0 Or Index > 42 Then Return
	If lblResults(Index).IsInitialized Then lblResults(Index).Text = ValueText
	If lblResultUnits(Index).IsInitialized Then lblResultUnits(Index).Text = UnitText
End Sub

Public Sub RecalculateRotor
	If UpdatingUI Then Return
	SyncConditionRepresentations
	ActiveRes = zBETEngine.Calculate(ActiveGeom, ActiveCond)
	UpdateTrimSummary
	
	If lblResultStatus.IsInitialized Then
		If ActiveRes.SolutionValid = False Then
			If root.Width <= 360dip Then lblResultStatus.Text = "STATUS · INVALID" Else lblResultStatus.Text = "MODEL STATUS · INVALID OPERATING POINT"
			lblResultStatus.TextColor = ColorAccentRed
			For i = 0 To 42
				If lblResults(i).IsInitialized Then lblResults(i).Text = "---"
			Next
			' Keep equivalent μ/Vx and μz/Vz/α labels synchronized even when trim fails.
			Dim fallbackGeom As RotorGeometry = zBETEngine.CloneGeometry(ActiveGeom)
			fallbackGeom.RPM = Max(1.0, Min(30000.0, ActiveCond.RPM))
			Dim fallbackCond As FlightCondition = zBETEngine.ResolveConditionAtRPM(ActiveCond, fallbackGeom)
			ActiveCond.Mu = fallbackCond.Mu
			ActiveCond.MuZ = fallbackCond.MuZ
			Return
		Else If ActiveRes.CompressibilityWarning Then
			If root.Width <= 360dip Then lblResultStatus.Text = "CAUTION · TIP MACH ≥ 0.80" Else lblResultStatus.Text = "MODEL CAUTION · TIP MACH ≥ 0.80"
			lblResultStatus.TextColor = ColorAccentAmber
		Else
			If root.Width <= 360dip Then lblResultStatus.Text = "STATUS · VALID" Else lblResultStatus.Text = "MODEL STATUS · VALID"
			lblResultStatus.TextColor = ColorAccentGreen
		End If
	End If
	
	' Keep derived nondimensional state synchronized with the solved operating RPM.
	ActiveCond.Mu = ActiveRes.OperatingMu
	ActiveCond.MuZ = ActiveRes.OperatingMuZ
	
	Dim tipMach As Double = 0.0
	If ActiveRes.SpeedOfSound > 0 Then tipMach = ActiveRes.TipSpeed / ActiveRes.SpeedOfSound
	
	If UnitSystem = 0 Then
		SetResultCell(0, FormatOutputValue(ActiveRes.ThrustN, 0), "N")
		SetResultCell(1, FormatOutputValue(ActiveRes.PowerShaftKW, 1), "kW")
		SetResultCell(2, FormatOutputValue(ActiveRes.TorqueNm, 1), "N·m")
		SetResultCell(3, FormatOutputValue(ActiveRes.DragHN, 1), "N")
		SetResultCell(4, FormatOutputValue(ActiveRes.SideForceYN, 1), "N")
		SetResultCell(5, FormatOutputValue(ActiveRes.RollMomentNm, 1), "N·m")
		SetResultCell(6, FormatOutputValue(ActiveRes.PitchMomentNm, 1), "N·m")
	Else
		SetResultCell(0, FormatOutputValue(ActiveRes.ThrustLbf, 0), "lbf")
		SetResultCell(1, FormatOutputValue(ActiveRes.PowerShaftHP, 1), "hp")
		SetResultCell(2, FormatOutputValue(ActiveRes.TorqueLbft, 1), "lb·ft")
		SetResultCell(3, FormatOutputValue(ActiveRes.DragHN * 0.224808943, 1), "lbf")
		SetResultCell(4, FormatOutputValue(ActiveRes.SideForceYLbf, 1), "lbf")
		SetResultCell(5, FormatOutputValue(ActiveRes.RollMomentLbft, 1), "lb·ft")
		SetResultCell(6, FormatOutputValue(ActiveRes.PitchMomentLbft, 1), "lb·ft")
	End If
	
	' All aerodynamic coefficients stay together.
	SetResultCell(7, FormatOutputValue(ActiveRes.CT, 5), "[-]")
	SetResultCell(8, FormatOutputValue(ActiveRes.CQ, 6), "[-]")
	SetResultCell(9, FormatOutputValue(ActiveRes.CQi, 6), "[-]")
	SetResultCell(10, FormatOutputValue(ActiveRes.CQ0, 6), "[-]")
	SetResultCell(11, FormatOutputValue(ActiveRes.CH, 6), "[-]")
	SetResultCell(12, FormatOutputValue(ActiveRes.CHi, 6), "[-]")
	SetResultCell(13, FormatOutputValue(ActiveRes.CH0, 6), "[-]")
	SetResultCell(14, FormatOutputValue(ActiveRes.CY, 6), "[-]")
	SetResultCell(15, FormatOutputValue(ActiveRes.CMx, 6), "[-]")
	SetResultCell(16, FormatOutputValue(ActiveRes.CMy, 6), "[-]")
	SetResultCell(17, FormatOutputValue(ActiveRes.CPair, 6), "[-]")
	SetResultCell(18, FormatOutputValue(ActiveRes.FoM, 4), "[-]")
	SetResultCell(19, FormatOutputValue(ActiveRes.L_D_eff, 2), "[-]")
	SetResultCell(20, FormatOutputValue(ActiveRes.InflowLambda, 5), "[-]")
	SetResultCell(21, FormatOutputValue(ActiveRes.InflowLambdaI, 5), "[-]")
	SetResultCell(22, FormatOutputValue(ActiveRes.InflowKx, 3), "[-]")
	SetResultCell(23, FormatOutputValue(ActiveRes.InflowKy, 3), "[-]")
	SetResultCell(24, FormatOutputValue(ActiveRes.WakeSkewChiDeg, 1), "deg")
	SetResultCell(25, FormatOutputValue(ActiveRes.BFactor, 4), "[-]")
	
	SetResultCell(26, FormatOutputValue(ActiveRes.TrimmedRPM, 0), "rpm")
	SetResultCell(27, FormatOutputValue(ActiveRes.TrimmedCollectiveDeg, 2), "deg")
	SetResultCell(28, FormatOutputValue(ActiveRes.CT, 5), "[-]")
	SetResultCell(30, FormatOutputValue(ActiveRes.OperatingMu, 4), "[-]")
	SetResultCell(32, FormatOutputValue(ActiveRes.OperatingMuZ, 4), "[-]")
	SetResultCell(34, FormatOutputValue(ActiveRes.OperatingAlphaDeg, 2), "deg")
	SetResultCell(36, FormatOutputValue(tipMach, 3), "[-]")
	SetResultCell(37, FormatOutputValue(ActiveRes.AdvancingTipMach, 3), "[-]")
	
	If UnitSystem = 0 Then
		SetResultCell(29, FormatOutputValue(ActiveRes.ThrustN, 0), "N")
		SetResultCell(31, FormatOutputValue(ActiveRes.OperatingVx, 1), "m/s")
		SetResultCell(33, FormatOutputValue(ActiveRes.OperatingVz, 1), "m/s")
		SetResultCell(35, FormatOutputValue(ActiveRes.TipSpeed, 1), "m/s")
		SetResultCell(38, FormatOutputValue(ActiveRes.AltitudeM, 0), "m")
		SetResultCell(39, FormatOutputValue(ActiveRes.TemperatureC, 1), "°C")
		SetResultCell(40, FormatOutputValue(ActiveRes.DensityRho, 4), "kg/m³")
		SetResultCell(41, FormatOutputValue(ActiveRes.PressurePa / 100.0, 1), "hPa")
		SetResultCell(42, FormatOutputValue(ActiveRes.SpeedOfSound, 1), "m/s")
	Else
		SetResultCell(29, FormatOutputValue(ActiveRes.ThrustLbf, 0), "lbf")
		SetResultCell(31, FormatOutputValue(ActiveRes.OperatingVx * 3.280839895, 1), "ft/s")
		SetResultCell(33, FormatOutputValue(ActiveRes.OperatingVz * 3.280839895, 1), "ft/s")
		SetResultCell(35, FormatOutputValue(ActiveRes.TipSpeed * 3.280839895, 1), "ft/s")
		SetResultCell(38, FormatOutputValue(ActiveRes.AltitudeM * 3.280839895, 0), "ft")
		SetResultCell(39, FormatOutputValue(ActiveRes.TemperatureC * 9.0 / 5.0 + 32.0, 1), "°F")
		SetResultCell(40, FormatOutputValue(ActiveRes.DensityRho * 0.0019403203, 5), "slug/ft³")
		SetResultCell(41, FormatOutputValue(ActiveRes.PressurePa / 3386.389, 2), "inHg")
		SetResultCell(42, FormatOutputValue(ActiveRes.SpeedOfSound * 3.280839895, 0), "ft/s")
	End If
End Sub

Private Sub OperatingPairDisplayName(pair As String) As String
	Select pair
		Case "rpm_collective": Return "RPM + Collective"
		Case "rpm_ct": Return "RPM + CT"
		Case "rpm_thrust": Return "RPM + Thrust"
		Case "collective_ct": Return "Collective + CT"
		Case "collective_thrust": Return "Collective + Thrust"
		Case "ct_thrust": Return "CT + Thrust"
		Case Else: Return "Operating Inputs"
	End Select
End Sub

Private Sub UpdateTrimSummary
	If lblTrimSummary.IsInitialized = False Then Return
	If ActiveRes.SolutionValid = False Then
		If root.Width <= 360dip Then
			lblTrimSummary.Text = OperatingPairDisplayName(ActiveCond.OperatingPair) & " · NO SOLUTION"
		Else
			lblTrimSummary.Text = OperatingPairDisplayName(ActiveCond.OperatingPair) & " · NO SOLUTION"
		End If
		lblTrimSummary.TextColor = ColorAccentRed
		Return
	End If
	If root.Width <= 360dip Then
		lblTrimSummary.Text = "SOLUTION · " & OperatingPairDisplayName(ActiveCond.OperatingPair)
	Else
		lblTrimSummary.Text = "OPERATING SOLUTION · " & OperatingPairDisplayName(ActiveCond.OperatingPair)
	End If
	lblTrimSummary.TextColor = ColorAccentCyan
End Sub

Sub lblTrimSummary_Click
	Msgbox("The operating solution always reports all four linked quantities: RPM, collective increment Δθ, CT and thrust." & CRLF & CRLF & _
		"You prescribe any two in Conditions. RotorCalculator solves the remaining two at the current forward/axial flight condition.", "Operating Solution")
End Sub

Private Sub FormatOutputValue(Value As Double, BaseDigits As Int) As String
	Return FormatResultValue(Value, BaseDigits + ExtraPrecision)
End Sub

Private Sub FormatResultValue(Value As Double, FractionDigits As Int) As String
	Dim scale As Double = 1
	For i = 1 To FractionDigits
		scale = scale * 10
	Next
	If Abs(Value) < (0.5 / scale) Then Value = 0
	Return NumberFormat2(Value, 1, FractionDigits, FractionDigits, False)
End Sub

Sub LoadRotorDataToFields(geom As RotorGeometry)
	If edtRadius.IsInitialized = False Then Return
	Dim g As RotorGeometry = zBETEngine.ResolveSolidity(zBETEngine.CloneGeometry(geom))
	UpdatingUI = True
	edtRotorName.Text = g.Name
	edtRadius.Text = FormatInputValue("Radius R", g.Radius, RadiusDisplayDigits(g.Radius))
	edtNBlades.Text = g.NBlades
	edtRootCutout.Text = NumberFormat2(g.RootCutout, 1, 3, 3, False)
	edtChordRoot.Text = FormatInputValue("Root Chord c0", g.ChordRoot, ChordDisplayDigits(g.ChordRoot))
	edtChordTip.Text = FormatInputValue("Tip Chord c1", g.ChordTip, ChordDisplayDigits(g.ChordTip))
	edtSigmaRef.Text = NumberFormat2(g.SigmaRef, 1, 4, 4, False)
	edtAspectRatio.Text = NumberFormat2(zBETEngine.ReferenceAspectRatio(g), 1, 2, 2, False)
	edtThetaRoot.Text = FormatInputValue("Root Incidence", g.ThetaRoot * 180.0 / cPI, 1)
	edtThetaTip.Text = FormatInputValue("Tip Incidence", g.ThetaTip * 180.0 / cPI, 1)
	edtLiftSlope.Text = FormatInputValue("Lift Slope a0", g.LiftSlope0, 2)
	edtCd0.Text = NumberFormat2(g.Cd0, 1, 4, 4, False)
	edtTipLossB.Text = NumberFormat2(g.TipLossB, 1, 3, 3, False)
	btnSelectAirfoil.Text = AirfoilDisplayName(g)
	RefreshTipLossButton(g)
	If g.UsePrandtlGlauert Then
		If root.Width <= 430dip Then btnCompressibility.Text = "PG · ON" Else btnCompressibility.Text = "Prandtl-Glauert: ON"
		btnCompressibility.TextColor = ColorAccentGreen
	Else
		If root.Width <= 430dip Then btnCompressibility.Text = "PG · OFF" Else btnCompressibility.Text = "Prandtl-Glauert: OFF"
		btnCompressibility.TextColor = ColorButText2
	End If
	UpdatingUI = False
	RefreshGeometryDerivedFields
	RefreshActiveRotorBar
End Sub

Sub RefreshGeometryDerivedFields
	If lblSigmaGeomDerived.IsInitialized = False Then Return
	Dim g As RotorGeometry = zBETEngine.ResolveSolidity(zBETEngine.CloneGeometry(ActiveGeom))
	lblSigmaGeomDerived.Text = FormatResultValue(g.SigmaGeom, 5)
	lblSigmaThrustDerived.Text = FormatResultValue(g.SigmaThrust, 5)
	lblTaperDerived.Text = FormatResultValue(zBETEngine.TaperRatio(g), 3)
	lblDiskAreaDerived.Text = FormatInputValue("Disk Area", cPI * g.Radius * g.Radius, 3)
	lblRefBladeAreaDerived.Text = FormatInputValue("Reference Blade Area", zBETEngine.ReferenceBladeArea(g), 3)
	lblActiveBladeAreaDerived.Text = FormatInputValue("Active Blade Area", zBETEngine.ActiveBladeArea(g), 3)
	lblTwistDerived.Text = FormatInputValue("Total Twist", (g.ThetaTip - g.ThetaRoot) * 180.0 / cPI, 3)
	If edtTipLossB.IsInitialized Then edtTipLossB.Enabled = (g.TipLossMode = "fixed")
End Sub

Private Sub RefreshTipLossButton(geom As RotorGeometry)
	Select geom.TipLossMode
		Case "sissingh"
			btnTipLoss.Text = "Sissingh"
			btnTipLoss.TextColor = ColorAccentGreen
		Case "fixed"
			btnTipLoss.Text = "Fixed B"
			btnTipLoss.TextColor = ColorAccentCyan
		Case Else
			btnTipLoss.Text = "None"
			btnTipLoss.TextColor = ColorButText2
	End Select
	If edtTipLossB.IsInitialized Then edtTipLossB.Enabled = (geom.TipLossMode = "fixed")
End Sub

Private Sub AirfoilDisplayName(geom As RotorGeometry) As String
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		If Abs(geom.LiftSlope0 - af.A0) < 0.001 And Abs(geom.Cd0 - af.Cd0) < 0.00001 Then
			If root.Width <= 360dip And af.Name.StartsWith("Sikorsky ") Then Return af.Name.SubString(9)
			Return af.Name
		End If
	Next
	If root.Width <= 360dip Then Return "Custom"
	Return "Custom Section"
End Sub

Private Sub UpdateAtmosphere
	ConditionAltitudeM = ClampD(ConditionAltitudeM, -500.0, 11000.0)
	ConditionTemperatureC = ClampD(ConditionTemperatureC, -80.0, 60.0)
	Dim base As Double = Max(0.05, 1.0 - 0.0065 * ConditionAltitudeM / 288.15)
	Dim pRatio As Double = Power(base, 5.2561)
	AmbientPressureHPa = 1013.25 * pRatio
	Dim tKelvin As Double = ConditionTemperatureC + 273.15
	ActiveCond.AltitudeM = ConditionAltitudeM
	ActiveCond.TemperatureC = ConditionTemperatureC
	ActiveCond.PressurePa = AmbientPressureHPa * 100.0
	ActiveCond.Rho = ActiveCond.PressurePa / (287.058 * tKelvin)
	ActiveCond.SpeedOfSound = Sqrt(1.4 * 287.058 * tKelvin)
End Sub

Private Sub SyncConditionRepresentations
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	ActiveCond.ProfileDragModel = "numerical_vectorial"
	UpdateAtmosphere
End Sub

Sub LoadConditionDataToFields
	ConditionAltitudeM = ActiveCond.AltitudeM
	ConditionTemperatureC = ActiveCond.TemperatureC
	If ActiveCond.HorizontalMode <> "" Then HorizontalInputMode = ActiveCond.HorizontalMode
	ConditionHorizontalValue = ActiveCond.HorizontalValue
	If ActiveCond.AxialMode <> "" Then AxialInputMode = ActiveCond.AxialMode
	ConditionAxialValue = ActiveCond.AxialValue
	UpdatingUI = True
	edtAltitude.Text = FormatInputValue("h — Altitude", ConditionAltitudeM, 2)
	edtTemperature.Text = FormatInputValue("Tair — Temperature", ConditionTemperatureC, 2)
	RefreshHorizontalInputDisplay
	RefreshAxialInputDisplay
	Select ActiveCond.InflowModel
		Case "uniform": btnInflowModel.Text = "Uniform"
		Case "coleman_simple": btnInflowModel.Text = "Coleman Simple"
		Case "drees": btnInflowModel.Text = "Drees"
		Case Else
			If root.Width <= 360dip Then
				btnInflowModel.Text = "Coleman-F."
			Else If root.Width <= 430dip Then
				btnInflowModel.Text = "Coleman-Feing."
			Else
				btnInflowModel.Text = "Coleman-Feingold"
			End If
	End Select
	If edtKInd.IsInitialized Then edtKInd.Text = NumberFormat2(ActiveCond.KInd, 1, 3, 3, False)
	RefreshOperatingControls
	UpdatingUI = False
	SyncConditionRepresentations
End Sub

Sub RefreshHorizontalInputDisplay
	If btnHorizontalInput.IsInitialized = False Then Return
	If HorizontalInputMode = "vx" Then
		btnHorizontalInput.Text = "Vx"
		lblHorizontalUnit.Text = UnitForField("Horizontal Flow", "m/s")
		edtHorizontalValue.Text = FormatInputValue("Horizontal Flow", ConditionHorizontalValue, 3)
	Else
		HorizontalInputMode = "mu"
		btnHorizontalInput.Text = "μ"
		lblHorizontalUnit.Text = "[-]"
		edtHorizontalValue.Text = NumberFormat2(ConditionHorizontalValue, 1, 4, 4, False)
	End If
End Sub

Sub RefreshAxialInputDisplay
	If btnAxialInput.IsInitialized = False Then Return
	Select AxialInputMode
		Case "vz"
			btnAxialInput.Text = "Vz"
			lblAxialUnit.Text = UnitForField("Axial Flow", "m/s")
			edtAxialValue.Text = FormatInputValue("Axial Flow", ConditionAxialValue, 3)
		Case "muz"
			btnAxialInput.Text = "μz"
			lblAxialUnit.Text = "[-]"
			edtAxialValue.Text = NumberFormat2(ConditionAxialValue, 1, 4, 4, False)
		Case Else
			AxialInputMode = "alpha"
			btnAxialInput.Text = "α"
			lblAxialUnit.Text = UnitForField("Axial Flow", "deg")
			edtAxialValue.Text = FormatInputValue("Axial Flow", ConditionAxialValue, 3)
	End Select
End Sub

Private Sub RotorTipSpeed As Double
	If ActiveRes.SolutionValid And ActiveRes.TipSpeed > 0 Then Return ActiveRes.TipSpeed
	Dim rpm As Double = Max(1.0, Min(30000.0, ActiveCond.RPM))
	Dim radius As Double = Max(0.02, ActiveGeom.Radius)
	Return rpm * cPI / 30.0 * radius
End Sub

Private Sub PairInputName(pair As String, position As Int) As String
	Select pair
		Case "rpm_collective"
			If position = 1 Then Return "RPM" Else Return "Collective Δθ"
		Case "rpm_ct"
			If position = 1 Then Return "RPM" Else Return "Target CT"
		Case "rpm_thrust"
			If position = 1 Then Return "RPM" Else Return "Target Thrust"
		Case "collective_ct"
			If position = 1 Then Return "Collective Δθ" Else Return "Target CT"
		Case "collective_thrust"
			If position = 1 Then Return "Collective Δθ" Else Return "Target Thrust"
		Case Else
			If position = 1 Then Return "Target CT" Else Return "Target Thrust"
	End Select
End Sub

Sub PairInputUnit(name As String) As String
	Return UnitForField(name, "[-]")
End Sub

Private Sub PairInputValue(name As String) As Double
	If name = "RPM" Then Return ActiveCond.RPM
	If name.Contains("Collective") Then Return ActiveCond.CollectiveDeg
	If name.Contains("CT") Then Return ActiveCond.TargetCT
	Return ActiveCond.TargetThrustN
End Sub

Sub RefreshOperatingControls
	If btnOperatingPair.IsInitialized = False Then Return
	btnOperatingPair.Text = OperatingPairDisplayName(ActiveCond.OperatingPair)
	Dim n1 As String = PairInputName(ActiveCond.OperatingPair, 1)
	Dim n2 As String = PairInputName(ActiveCond.OperatingPair, 2)
	lblOperatingInput1.Text = InputDisplayLabel(n1)
	lblOperatingInput1.Tag = n1
	lblOperatingInput2.Text = InputDisplayLabel(n2)
	lblOperatingInput2.Tag = n2
	lblOperatingUnit1.Tag = n1
	lblOperatingUnit2.Tag = n2
	lblOperatingUnit1.Text = PairInputUnit(n1)
	lblOperatingUnit2.Text = PairInputUnit(n2)
	edtOperatingInput1.Text = FormatOperatingInput(n1, PairInputValue(n1))
	edtOperatingInput2.Text = FormatOperatingInput(n2, PairInputValue(n2))
End Sub

Sub FormatOperatingInput(name As String, value As Double) As String
	Dim shown As Double = CanonicalToDisplay(name, value)
	If name.Contains("CT") Then Return NumberFormat2(shown, 1, 5, 5, False)
	If name = "RPM" Or name.Contains("Thrust") Then Return NumberFormat2(shown, 1, 1, 1, False)
	Return NumberFormat2(shown, 1, 3, 3, False)
End Sub

Private Sub RefreshDerivedCondition(updateDisplayedValues As Boolean)
	SyncConditionRepresentations
	If updateDisplayedValues Then
		Dim wasUpdating As Boolean = UpdatingUI
		UpdatingUI = True
		RefreshHorizontalInputDisplay
		RefreshAxialInputDisplay
		RefreshOperatingControls
		UpdatingUI = wasUpdating
	End If
End Sub


Sub btnSelectAirfoil_Click
	Dim options As List
	options.Initialize
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim af As AirfoilData = RotorPopups.Airfoils.Get(i)
		options.Add(af.Name & "  ·  a0=" & af.A0 & "  Cd0=" & af.Cd0)
	Next
	Dim selected As Int = -1
	For i = 0 To RotorPopups.Airfoils.Size - 1
		Dim currentAf As AirfoilData = RotorPopups.Airfoils.Get(i)
		If Abs(currentAf.A0 - ActiveGeom.LiftSlope0) < 0.000001 And Abs(currentAf.Cd0 - ActiveGeom.Cd0) < 0.000001 Then selected = i
	Next
	Dim resIndex As Int = InputList(options, "Airfoil Section · sets a0 and Cd0", selected)
	If resIndex < 0 Then Return
	Dim selAf As AirfoilData = RotorPopups.Airfoils.Get(resIndex)
	ActiveGeom.LiftSlope0 = selAf.A0
	ActiveGeom.Cd0 = selAf.Cd0
	GeometryDirty = True
	LoadRotorDataToFields(ActiveGeom)
	RecalculateRotor
End Sub

Sub btnTipLoss_Click
	Dim options As List
	options.Initialize
	options.Add("None — full aerodynamic span")
	options.Add("Fixed B — prescribed effective tip radius")
	options.Add("Sissingh — thrust-dependent tip factor")
	Dim selected As Int = 0
	If ActiveGeom.TipLossMode = "fixed" Then selected = 1
	If ActiveGeom.TipLossMode = "sissingh" Then selected = 2
	Dim idx As Int = InputList(options, "Tip-Loss Model", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveGeom.TipLossMode = "none"
		Case 1: ActiveGeom.TipLossMode = "fixed"
		Case 2: ActiveGeom.TipLossMode = "sissingh"
	End Select
	GeometryDirty = True
	RefreshTipLossButton(ActiveGeom)
	RefreshGeometryDerivedFields
	RefreshActiveRotorBar
	RecalculateRotor
End Sub

Sub btnCompressibility_Click
	Dim options As List
	options.Initialize2(Array As String("Off — no compressibility correction", "On — Prandtl-Glauert correction"))
	Dim selected As Int = 0
	If ActiveGeom.UsePrandtlGlauert Then selected = 1
	Dim idx As Int = InputList(options, "Compressibility Model", selected)
	If idx < 0 Then Return
	ActiveGeom.UsePrandtlGlauert = (idx = 1)
	GeometryDirty = True
	LoadRotorDataToFields(ActiveGeom)
	RecalculateRotor
End Sub

Sub btnInflowModel_Click
	Dim options As List
	options.Initialize
	options.Add("Uniform — benchmark")
	options.Add("Coleman Simple — longitudinal gradient")
	options.Add("Coleman-Feingold — longitudinal + lateral")
	options.Add("Drees — classical longitudinal + lateral")
	Dim selected As Int = 2
	Select ActiveCond.InflowModel
		Case "uniform": selected = 0
		Case "coleman_simple": selected = 1
		Case "drees": selected = 3
	End Select
	Dim idx As Int = InputList(options, "Inflow Model", selected)
	If idx < 0 Then Return
	Select idx
		Case 0: ActiveCond.InflowModel = "uniform"
		Case 1: ActiveCond.InflowModel = "coleman_simple"
		Case 2: ActiveCond.InflowModel = "coleman_feingold"
		Case 3: ActiveCond.InflowModel = "drees"
	End Select
	LoadConditionDataToFields
	RecalculateRotor
End Sub

Sub btnOperatingPair_Click
	Dim options As List
	options.Initialize
	options.Add("RPM + Collective")
	options.Add("RPM + CT")
	options.Add("RPM + Thrust")
	options.Add("Collective + CT")
	options.Add("Collective + Thrust")
	options.Add("CT + Thrust")
	Dim selected As Int = 1
	Select ActiveCond.OperatingPair
		Case "rpm_collective": selected = 0
		Case "rpm_ct": selected = 1
		Case "rpm_thrust": selected = 2
		Case "collective_ct": selected = 3
		Case "collective_thrust": selected = 4
		Case "ct_thrust": selected = 5
	End Select
	Dim idx As Int = InputList(options, "Operating Inputs · prescribe any two", selected)
	If idx < 0 Then Return
	' Only seed after a committed choice: Cancel must leave the physical state intact.
	If ActiveRes.SolutionValid Then
		ActiveCond.RPM = ActiveRes.TrimmedRPM
		ActiveCond.CollectiveDeg = ActiveRes.TrimmedCollectiveDeg
		ActiveCond.TargetCT = Max(1.0e-8, ActiveRes.CT)
		ActiveCond.TargetThrustN = Max(1.0e-6, ActiveRes.ThrustN)
	End If
	Select idx
		Case 0: ActiveCond.OperatingPair = "rpm_collective"
		Case 1: ActiveCond.OperatingPair = "rpm_ct"
		Case 2: ActiveCond.OperatingPair = "rpm_thrust"
		Case 3: ActiveCond.OperatingPair = "collective_ct"
		Case 4: ActiveCond.OperatingPair = "collective_thrust"
		Case 5: ActiveCond.OperatingPair = "ct_thrust"
	End Select
	UpdatingUI = True
	RefreshOperatingControls
	UpdatingUI = False
	RecalculateRotor
End Sub

Sub edtOperatingInput_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim edt As EditText = Sender
	Dim position As Int = ParseIntDef("" & edt.Tag, 1)
	Dim name As String = PairInputName(ActiveCond.OperatingPair, position)
	Dim fallback As Double = CanonicalToDisplay(name, PairInputValue(name))
	Dim value As Double = InputToCanonical(name, ParseDoubleDef(edt.Text, fallback))
	If name = "RPM" Then ActiveCond.RPM = ClampD(value, 1.0, 30000.0)
	If name.Contains("Collective") Then ActiveCond.CollectiveDeg = ClampD(value, -60.0, 60.0)
	If name.Contains("CT") Then ActiveCond.TargetCT = ClampD(value, 0.000001, 0.20)
	If name.Contains("Thrust") Then ActiveCond.TargetThrustN = ClampD(value, 0.001, 1.0e8)
	RecalculateRotor
End Sub

Sub edtKInd_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ActiveCond.KInd = ClampD(ParseDoubleDef(edtKInd.Text, ActiveCond.KInd), 1.0, 3.0)
	RecalculateRotor
End Sub

Sub lblRowTip_Click
	Dim b As Button = Sender
	Select b.Tag
		Case "Airfoil": btnSelectAirfoil_Click: Return
		Case "Tip Loss": btnTipLoss_Click: Return
		Case "Compressibility": btnCompressibility_Click: Return
		Case "Inflow Model": btnInflowModel_Click: Return
		Case "Operating Inputs": btnOperatingPair_Click: Return
	End Select
	Dim tipMsg As String = ""
	Select b.Tag
		Case "Rotor Name"
			tipMsg = "Current name: " & ActiveGeom.Name & CRLF & CRLF & "Edit the value to rename this rotor; SAVE stores the change."
		Case "Radius R"
			tipMsg = "Rotor radius R. Editing R scales c0 and c1 proportionally, preserving reference solidity, aspect ratio and taper."
		Case "Blade Count"
			tipMsg = "Number of blades Nb. Changing Nb changes reference solidity while preserving the blade planform and aspect ratio."
		Case "Root Cutout"
			tipMsg = "x0 = r0/R, the first active aerodynamic station. It changes active-span metrics, not the reference planform."
		Case "Root Chord c0"
			tipMsg = "Reference-axis chord c0 at r/R = 0. The active blade starts at root cutout x0."
		Case "Tip Chord c1"
			tipMsg = "Reference tip chord c1 at r/R = 1. Chord varies linearly between c0 and c1."
		Case "Reference Solidity"
			tipMsg = "σref = Nb/(π AR). Editing σref scales both chords by one factor and preserves taper ratio."
		Case "Aspect Ratio"
			tipMsg = "Reference blade AR = R²/Sref,b = 2R/(c0+c1). Editing AR scales both chords while preserving taper."
		Case "Root Incidence", "Tip Incidence"
			tipMsg = "Baseline blade incidence. Operating collective Δθ is added equally to root and tip, preserving total twist."
		Case "Geometric Solidity"
			tipMsg = "Physical-area solidity over the active blade span x0 ≤ r/R ≤ 1."
		Case "Thrust Solidity"
			tipMsg = "Thrust-weighted solidity: 3∫x²σ(x)dx over the active aerodynamic span."
		Case "Taper Ratio"
			tipMsg = "Reference taper ratio c1/c0."
		Case "Disk Area"
			tipMsg = "Rotor disk area A = πR²."
		Case "Reference Blade Area"
			tipMsg = "Single-blade reference planform area from the rotor axis to the tip."
		Case "Active Blade Area"
			tipMsg = "Single-blade physical planform area from root cutout x0 to the tip."
		Case "Total Twist"
			tipMsg = "Baseline linear twist θtip − θroot. Collective trim preserves this difference."
		Case "Lift Slope a0"
			tipMsg = "Section lift-curve slope dCl/dα before optional compressibility correction."
		Case "Profile Cd0"
			tipMsg = "Baseline section profile-drag coefficient used by the Numerical Vectorial integration."
		Case "Fixed Tip Factor B"
			tipMsg = "Prescribed effective tip radius factor B. Used and editable only with Fixed B tip loss; None and Sissingh ignore this stored setting. The effective operating B is shown in Results."
		Case "h — Altitude"
			tipMsg = "Pressure altitude used by the atmosphere model."
		Case "Tair — Temperature"
			tipMsg = "Ambient temperature used for density and speed of sound."
		Case "RPM"
			tipMsg = "Prescribed rotational speed for the selected operating pair."
		Case "Collective Δθ"
			tipMsg = "Uniform pitch increment added equally to root and tip incidence."
		Case "Target CT"
			tipMsg = "Prescribed CT = T/[ρA(ΩR)²] for the selected operating pair."
		Case "Target Thrust"
			tipMsg = "Prescribed dimensional rotor thrust for the selected operating pair."
		Case "K_ind"
			tipMsg = "Induced-power factor K_ind used in induced power and air-power calculations. Typical ideal value is 1; practical values are greater than 1."
		Case "Profile Drag"
			tipMsg = "Profile drag is always evaluated with Numerical Vectorial radial/azimuthal quadrature."
		Case Else
			tipMsg = "" & b.Tag
	End Select
	Msgbox(tipMsg, "About · " & b.Tag)
End Sub

Private Sub RadiusDisplayDigits(value As Double) As Int
	If Abs(value) < 1 Then Return 3
	Return 2
End Sub

Private Sub ChordDisplayDigits(value As Double) As Int
	If Abs(value) < 0.1 Then Return 4
	Return 3
End Sub

Sub edtGeom_TextChanged (Old As String, New As String)
	If UpdatingUI Or Old = New Or edtRadius.IsInitialized = False Or edtAspectRatio.IsInitialized = False Then Return
	Dim edt As EditText = Sender
	Dim field As String = "" & edt.Tag
	Dim raw As Double
	Select field
		Case "Rotor Name"
			Dim n As String = edt.Text.Trim.Replace("|", "/").Replace(Chr(13), " ").Replace(Chr(10), " ")
			If n <> "" Then ActiveGeom.Name = n
		Case "Radius R"
			raw = InputToCanonical(field, ParseDoubleDef(edt.Text, CanonicalToDisplay(field, ActiveGeom.Radius)))
			ActiveGeom = zBETEngine.ScaleRadiusPreserveReference(ActiveGeom, ClampD(raw, 0.02, 50.0))
		Case "Blade Count"
			ActiveGeom.NBlades = Max(1, Min(16, ParseIntDef(edt.Text, ActiveGeom.NBlades)))
			ActiveGeom.SolidityMode = "chords"
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Root Cutout"
			ActiveGeom.RootCutout = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.RootCutout), 0.0, 0.95)
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Root Chord c0"
			raw = InputToCanonical(field, ParseDoubleDef(edt.Text, CanonicalToDisplay(field, ActiveGeom.ChordRoot)))
			ActiveGeom.ChordRoot = ClampD(raw, 0.0001, 2.0 * ActiveGeom.Radius)
			ActiveGeom.SolidityMode = "chords"
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Tip Chord c1"
			raw = InputToCanonical(field, ParseDoubleDef(edt.Text, CanonicalToDisplay(field, ActiveGeom.ChordTip)))
			ActiveGeom.ChordTip = ClampD(raw, 0.0001, 2.0 * ActiveGeom.Radius)
			ActiveGeom.SolidityMode = "chords"
			ActiveGeom = zBETEngine.ResolveSolidity(ActiveGeom)
		Case "Reference Solidity"
			ActiveGeom = zBETEngine.ScaleChordsToSigmaRef(ActiveGeom, ParseDoubleDef(edt.Text, ActiveGeom.SigmaRef))
		Case "Aspect Ratio"
			ActiveGeom = zBETEngine.ScaleChordsToAspectRatio(ActiveGeom, ParseDoubleDef(edt.Text, zBETEngine.ReferenceAspectRatio(ActiveGeom)))
		Case "Root Incidence"
			raw = InputToCanonical(field, ParseDoubleDef(edt.Text, CanonicalToDisplay(field, ActiveGeom.ThetaRoot*180/cPI)))
			ActiveGeom.ThetaRoot = ClampD(raw, -90.0, 90.0) * cPI / 180.0
		Case "Tip Incidence"
			raw = InputToCanonical(field, ParseDoubleDef(edt.Text, CanonicalToDisplay(field, ActiveGeom.ThetaTip*180/cPI)))
			ActiveGeom.ThetaTip = ClampD(raw, -90.0, 90.0) * cPI / 180.0
		Case "Lift Slope a0"
			raw = InputToCanonical(field, ParseDoubleDef(edt.Text, CanonicalToDisplay(field, ActiveGeom.LiftSlope0)))
			ActiveGeom.LiftSlope0 = ClampD(raw, 0.1, 10.0)
		Case "Profile Cd0"
			ActiveGeom.Cd0 = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.Cd0), 0.0, 0.5)
		Case "Fixed Tip Factor B"
			ActiveGeom.TipLossB = ClampD(ParseDoubleDef(edt.Text, ActiveGeom.TipLossB), ActiveGeom.RootCutout + 0.001, 1.0)
	End Select
	ActiveGeom.PitchMode = "linear_twist"
	ActiveGeom.Theta0 = 0.5 * (ActiveGeom.ThetaRoot + ActiveGeom.ThetaTip)
	GeometryDirty = True
	RefreshGeometryDependentInputs(field)
	RefreshGeometryDerivedFields
	RefreshActiveRotorBar
	RecalculateRotor
End Sub

Sub RefreshGeometryDependentInputs(sourceField As String)
	If edtRadius.IsInitialized = False Or edtAspectRatio.IsInitialized = False Then Return
	Dim wasUpdating As Boolean = UpdatingUI
	UpdatingUI = True
	If sourceField <> "Radius R" Then edtRadius.Text = FormatInputValue("Radius R", ActiveGeom.Radius, RadiusDisplayDigits(ActiveGeom.Radius))
	If sourceField <> "Blade Count" Then edtNBlades.Text = ActiveGeom.NBlades
	If sourceField <> "Root Cutout" Then edtRootCutout.Text = NumberFormat2(ActiveGeom.RootCutout, 1, 3, 3, False)
	If sourceField <> "Root Chord c0" Then edtChordRoot.Text = FormatInputValue("Root Chord c0", ActiveGeom.ChordRoot, ChordDisplayDigits(ActiveGeom.ChordRoot))
	If sourceField <> "Tip Chord c1" Then edtChordTip.Text = FormatInputValue("Tip Chord c1", ActiveGeom.ChordTip, ChordDisplayDigits(ActiveGeom.ChordTip))
	If sourceField <> "Reference Solidity" Then edtSigmaRef.Text = NumberFormat2(ActiveGeom.SigmaRef, 1, 4, 4, False)
	If sourceField <> "Aspect Ratio" Then edtAspectRatio.Text = NumberFormat2(zBETEngine.ReferenceAspectRatio(ActiveGeom), 1, 2, 2, False)
	UpdatingUI = wasUpdating
End Sub

Sub edtGeom_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadRotorDataToFields(ActiveGeom)
End Sub

Sub edtCond_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	ConditionAltitudeM = ClampD(InputToCanonical("h — Altitude", ParseDoubleDef(edtAltitude.Text, CanonicalToDisplay("h — Altitude", ConditionAltitudeM))), -500.0, 11000.0)
	ConditionTemperatureC = ClampD(InputToCanonical("Tair — Temperature", ParseDoubleDef(edtTemperature.Text, CanonicalToDisplay("Tair — Temperature", ConditionTemperatureC))), -80.0, 60.0)
	UpdateAtmosphere
	RecalculateRotor
End Sub

Sub edtHorizontalValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim raw As Double = ParseDoubleDef(edtHorizontalValue.Text, CanonicalToDisplay("Horizontal Flow", ConditionHorizontalValue))
	ConditionHorizontalValue = InputToCanonical("Horizontal Flow", raw)
	If HorizontalInputMode = "mu" Then ConditionHorizontalValue = ClampD(ConditionHorizontalValue, -0.60, 0.60)
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	RecalculateRotor
End Sub

Sub edtAxialValue_TextChanged (Old As String, New As String)
	If UpdatingUI Then Return
	Dim rawDisplay As Double = ParseDoubleDef(edtAxialValue.Text, CanonicalToDisplay("Axial Flow", ConditionAxialValue))
	Dim raw As Double = InputToCanonical("Axial Flow", rawDisplay)
	Select AxialInputMode
		Case "alpha": ConditionAxialValue = ClampD(raw, -89.0, 89.0)
		Case "vz": ConditionAxialValue = ClampD(raw, -200.0, 200.0)
		Case "muz": ConditionAxialValue = ClampD(raw, -0.50, 0.50)
	End Select
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	RecalculateRotor
End Sub

Sub btnHorizontalInput_Click
	Dim options As List
	options.Initialize
	options.Add("μ — advance ratio")
	options.Add("Vx — forward speed [m/s]")
	Dim selected As Int = 0
	If HorizontalInputMode = "vx" Then selected = 1
	Dim idx As Int = InputList(options, "Horizontal Flow", selected)
	If idx < 0 Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim vx As Double = 0.0
	If ActiveRes.SolutionValid Then vx = ActiveRes.OperatingVx Else vx = mu * RotorTipSpeed
	If idx = 0 Then
		HorizontalInputMode = "mu"
		ConditionHorizontalValue = mu
	Else
		HorizontalInputMode = "vx"
		ConditionHorizontalValue = vx
	End If
	ActiveCond.HorizontalMode = HorizontalInputMode
	ActiveCond.HorizontalValue = ConditionHorizontalValue
	UpdatingUI = True
	RefreshHorizontalInputDisplay
	UpdatingUI = False
	RecalculateRotor
	ToastMessageShow("+Vx is forward; μ = Vx/(ΩR).", False)
End Sub

Sub btnAxialInput_Click
	Dim options As List
	options.Initialize
	options.Add("α — wind from below when positive")
	options.Add("Vz — climb rate; positive means wind from above")
	options.Add("μz — axial ratio; positive downward relative flow")
	Dim selected As Int = 0
	If AxialInputMode = "vz" Then selected = 1
	If AxialInputMode = "muz" Then selected = 2
	Dim idx As Int = InputList(options, "Axial Flow", selected)
	If idx < 0 Then Return
	Dim mu As Double = ActiveCond.Mu
	Dim muz As Double = ActiveCond.MuZ
	Dim vtip As Double = RotorTipSpeed
	If idx = 0 Then
		If Abs(mu) < 1.0e-8 And Abs(muz) > 1.0e-10 Then
			ToastMessageShow("At Vx = 0, use Vz or μz for nonzero axial flow.", True)
			Return
		End If
		AxialInputMode = "alpha"
		ConditionAxialValue = zBETEngine.AlphaFromMuZ(mu, muz)
	Else If idx = 1 Then
		AxialInputMode = "vz"
		ConditionAxialValue = zBETEngine.VzFromMuZ(muz, vtip)
	Else
		AxialInputMode = "muz"
		ConditionAxialValue = muz
	End If
	ActiveCond.AxialMode = AxialInputMode
	ActiveCond.AxialValue = ConditionAxialValue
	UpdatingUI = True
	RefreshAxialInputDisplay
	UpdatingUI = False
	RecalculateRotor
	ShowAxialConventionHint
End Sub

Private Sub ShowAxialConventionHint
	Select AxialInputMode
		Case "alpha": ToastMessageShow("α > 0: relative wind arrives from below.", True)
		Case "vz": ToastMessageShow("Vz > 0: positive climb rate, relative wind from above.", True)
		Case Else: ToastMessageShow("μz > 0: relative flow downward through the disk.", True)
	End Select
End Sub

Sub edtCond_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtHorizontalValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

Sub edtAxialValue_FocusChanged (HasFocus As Boolean)
	If HasFocus = False And UpdatingUI = False Then LoadConditionDataToFields
End Sub

' ====================================================================
' SWEEP POPUP (Multi-Parameter μ-Sweep)
' ====================================================================
Sub btnViewPolarPlot_Click
	If SweepPopupOpen Then CloseSweepPopup
	pnlSweepPopup.Initialize("pnlSweepPopup")
	pnlSweepPopup.Color = ColorPnlInput5
	root.AddView(pnlSweepPopup, 0, 0, root.Width, root.Height)
	SweepPopupOpen = True
	pnlSweepPopup.BringToFront
	
	Dim topBarH As Int = 52dip
	Dim footerH As Int
	If ld = 1 Then footerH = 50dip Else footerH = 94dip * sc
	Dim controlsH As Int
	If ld = 1 Then
		controlsH = 58dip
	Else If root.Width <= 360dip Then
		controlsH = 178dip * sc
	Else
		controlsH = 172dip * sc
	End If
	
	Dim pnlHeader As Panel
	pnlHeader.Initialize("")
	pnlHeader.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlHeader, 0, 0, root.Width, topBarH)
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "PARAMETER SWEEP"
	lblTitle.TextColor = ColorAccentCyan
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 15 * sc
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	pnlHeader.AddView(lblTitle, 12dip, 2dip, root.Width - 64dip, 48dip)
	Dim btnClose As Button
	btnClose.Initialize("btnCloseSweepPlot")
	btnClose.Text = "×"
	btnClose.TextColor = ColorAccentRed
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	pnlHeader.AddView(btnClose, root.Width - 52dip, 2dip, 48dip, 48dip)
	
	Dim pnlControls As Panel
	pnlControls.Initialize("")
	pnlControls.Color = ColorPnlInput2
	pnlSweepPopup.AddView(pnlControls, 0, topBarH, root.Width, controlsH)
	
	spnSweepParam.Initialize("spnSweepParam")
	spnSweepParam.DropdownBackgroundColor = ColorPnlTitle
	spnSweepParam.DropdownTextColor = ColorTitleText
	spnSweepParam.TextColor = ColorTitleText
	spnSweepParam.TextSize = 14 * sc
	
	btnSweepMultiModel.Initialize("btnSweepMultiModel")
	btnSweepMultiModel.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepMultiModel.TextSize = 13.5 * sc
	btnSweepXAxis.Initialize("btnSweepXAxis")
	btnSweepXAxis.TextColor = ColorAccentGreen
	btnSweepXAxis.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepXAxis.TextSize = 13.5 * sc
	btnSweepMaxMu.Initialize("btnSweepMaxMu")
	btnSweepMaxMu.TextColor = ColorAccentAmber
	btnSweepMaxMu.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepMaxMu.TextSize = 13.5 * sc
	btnSweepValues.Initialize("btnSweepValues")
	btnSweepValues.Text = "VALUES"
	btnSweepValues.TextColor = ColorAccentCyan
	btnSweepValues.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepValues.TextSize = 13.5 * sc
	btnSweepTrimHover.Initialize("btnSweepTrimHover")
	btnSweepTrimHover.TextColor = ColorAccentGreen
	btnSweepTrimHover.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnSweepTrimHover.TextSize = 13 * sc
	
	spnSweepParam.Clear
	For paramIndex = 0 To RotorPopups.SweepParamLabels.Size - 1
		spnSweepParam.Add(RotorPopups.SweepParamLabels.Get(paramIndex))
	Next
	Dim selectedParamIndex As Int = 0
	For paramIndex = 0 To RotorPopups.SweepParamKeys.Size - 1
		If RotorPopups.SweepParamKeys.Get(paramIndex) = SweepParamSelectedKey Then
			selectedParamIndex = paramIndex
			Exit
		End If
	Next
	spnSweepParam.SelectedIndex = selectedParamIndex
	
	If ld = 1 Then
		Dim gapL As Int = 5dip
		Dim usable As Int = root.Width - 24dip
		Dim wParam As Int = usable * 0.28
		Dim wFamily As Int = usable * 0.23
		Dim wValues As Int = usable * 0.10
		Dim wAxis As Int = usable * 0.10
		Dim wRange As Int = usable * 0.12
		Dim wTrim As Int = usable - wParam - wFamily - wValues - wAxis - wRange - 5 * gapL
		Dim xL As Int = 12dip
		pnlControls.AddView(spnSweepParam, xL, 5dip, wParam, 48dip): xL=xL+wParam+gapL
		pnlControls.AddView(btnSweepMultiModel, xL, 5dip, wFamily, 48dip): xL=xL+wFamily+gapL
		pnlControls.AddView(btnSweepValues, xL, 5dip, wValues, 48dip): xL=xL+wValues+gapL
		pnlControls.AddView(btnSweepXAxis, xL, 5dip, wAxis, 48dip): xL=xL+wAxis+gapL
		pnlControls.AddView(btnSweepMaxMu, xL, 5dip, wRange, 48dip): xL=xL+wRange+gapL
		pnlControls.AddView(btnSweepTrimHover, xL, 5dip, wTrim, 48dip)
	Else
		Dim lblY As Label
		lblY.Initialize("")
		lblY.Text = "Y-AXIS RESULT"
		lblY.TextColor = ColorButText2
		lblY.Typeface = Typeface.DEFAULT_BOLD
		lblY.TextSize = 12.5 * sc
		pnlControls.AddView(lblY, 12dip, 3dip, root.Width - 24dip, 22dip)
		pnlControls.AddView(spnSweepParam, 12dip, 26dip * sc, root.Width - 24dip, 42dip * sc)
		Dim rowWidth As Int = root.Width - 30dip
		Dim familyW As Int = rowWidth * 0.68
		Dim valuesW As Int = rowWidth - familyW - 6dip
		pnlControls.AddView(btnSweepMultiModel, 12dip, 72dip * sc, familyW, 48dip * sc)
		pnlControls.AddView(btnSweepValues, 18dip + familyW, 72dip * sc, valuesW, 48dip * sc)
		Dim thirdGap As Int = 6dip
		Dim axisW2 As Int = rowWidth * 0.22
		Dim rangeW2 As Int = rowWidth * 0.27
		Dim trimW2 As Int = rowWidth - axisW2 - rangeW2 - 2 * thirdGap
		pnlControls.AddView(btnSweepXAxis, 12dip, 120dip * sc, axisW2, 48dip * sc)
		pnlControls.AddView(btnSweepMaxMu, 12dip + axisW2 + thirdGap, 120dip * sc, rangeW2, 48dip * sc)
		pnlControls.AddView(btnSweepTrimHover, 12dip + axisW2 + rangeW2 + 2 * thirdGap, 120dip * sc, trimW2, 48dip * sc)
	End If
	
	UpdateSweepMultiButtonText
	UpdateSweepXAxisButtonText
	UpdateSweepMaxButtonText
	UpdateSweepAuxControls
	
	Dim plotTop As Int = topBarH + controlsH + 2dip
	Dim plotW As Int = root.Width - 16dip
	Dim plotH As Int = root.Height - plotTop - footerH - 2dip
	If plotH < 120dip Then plotH = 120dip
	ivSweepPlot.Initialize("")
	pnlSweepPopup.AddView(ivSweepPlot, 8dip, plotTop, plotW, plotH)
	
	Dim pnlFooter As Panel
	pnlFooter.Initialize("")
	pnlFooter.Color = ColorPnlTitle
	pnlSweepPopup.AddView(pnlFooter, 0, root.Height - footerH, root.Width, footerH)
	lblSweepCurrentVal.Initialize("")
	lblSweepCurrentVal.TextColor = ColorAccentAmber
	lblSweepCurrentVal.TextSize = 13 * sc
	lblSweepCurrentVal.Typeface = Typeface.DEFAULT_BOLD
	lblSweepCurrentVal.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	lblSweepCurrentVal.SingleLine = True
	Dim btnTable As Button
	btnTable.Initialize("btnSweepTable")
	btnTable.Text = "TABLE"
	btnTable.TextColor = ColorAccentCyan
	btnTable.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	Dim btnCsv As Button
	btnCsv.Initialize("btnSweepExportCsv")
	btnCsv.Text = "CSV"
	btnCsv.TextColor = ColorAccentGreen
	btnCsv.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	Dim btnPng As Button
	btnPng.Initialize("btnSweepExportPng")
	btnPng.Text = "PNG"
	btnPng.TextColor = ColorAccentGreen
	btnPng.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	btnTable.Typeface = Typeface.DEFAULT_BOLD: btnCsv.Typeface = Typeface.DEFAULT_BOLD: btnPng.Typeface = Typeface.DEFAULT_BOLD
	btnTable.TextSize = 14 * sc: btnCsv.TextSize = 14 * sc: btnPng.TextSize = 14 * sc
	
	If ld = 1 Then
		Dim infoWidth As Int = root.Width * 0.38
		pnlFooter.AddView(lblSweepCurrentVal, 10dip, 0, infoWidth - 12dip, footerH)
		Dim actionLeft As Int = infoWidth
		Dim actionGap As Int = 5dip
		Dim actionWidth As Int = (root.Width - actionLeft - 16dip - 2 * actionGap) / 3
		pnlFooter.AddView(btnTable, actionLeft, 1dip, actionWidth, 48dip)
		pnlFooter.AddView(btnCsv, actionLeft + actionWidth + actionGap, 1dip, actionWidth, 48dip)
		pnlFooter.AddView(btnPng, actionLeft + 2 * (actionWidth + actionGap), 1dip, actionWidth, 48dip)
	Else
		pnlFooter.AddView(lblSweepCurrentVal, 12dip, 0, root.Width - 24dip, 34dip * sc)
		Dim footerGap As Int = 6dip
		Dim footerButtonW As Int = (root.Width - 24dip - 2 * footerGap) / 3
		Dim footerButtonY As Int = 36dip * sc
		pnlFooter.AddView(btnTable, 12dip, footerButtonY, footerButtonW, 48dip * sc)
		pnlFooter.AddView(btnCsv, 12dip + footerButtonW + footerGap, footerButtonY, footerButtonW, 48dip * sc)
		pnlFooter.AddView(btnPng, 12dip + 2 * (footerButtonW + footerGap), footerButtonY, footerButtonW, 48dip * sc)
	End If
	UpdateSweepPlotView
End Sub

