	options.Initialize
	options.Add(RotorNames.PlainLabel("mu", 0))
	options.Add(RotorNames.PlainLabel("Vx", 0))
	Wait For (sheet.ShowChoice(RotorNames.PlainLabel("xAxis", 0), options, SweepXAxisMode)) Complete (idx As Int)
	If idx < 0 Then Return
	SweepXAxisMode = idx
	SweepCrossX = -1
