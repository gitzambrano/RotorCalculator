Sub btnSweepMaxMu_Click
	Dim options As List
	options.Initialize
	options.Add("μ_x max = 0.30")
	options.Add("μ_x max = 0.40")
	options.Add("μ_x max = 0.50")
	options.Add("μ_x max = 0.60")
	Dim selected As Int = 1
	If Abs(SweepMaxMuVal - 0.30) < 0.001 Then selected = 0
	If Abs(SweepMaxMuVal - 0.50) < 0.001 Then selected = 2
	If Abs(SweepMaxMuVal - 0.60) < 0.001 Then selected = 3
	Wait For (sheet.ShowChoice("Sweep Range", options, selected)) Complete (idx As Int)
	If idx < 0 Then Return
	Select idx
		Case 0: SweepMaxMuVal = 0.30
		Case 1: SweepMaxMuVal = 0.40
		Case 2: SweepMaxMuVal = 0.50
		Case 3: SweepMaxMuVal = 0.60
	End Select
	SweepCrossX = -1
	UpdateSweepPlotView
End Sub

Sub btnCloseSweepPlot_Click
	CloseSweepPopup
End Sub

Private Sub CloseSweepPopup
	If SweepValuesPopupOpen Then CloseSweepValuesPopup
	If SweepTablePopupOpen Then CloseSweepTablePopup
	If SweepPopupOpen Then
		pnlSweepPopup.RemoveView
		SweepPopupOpen = False
	End If
End Sub

Sub UpdateSweepPlotView
	If ivSweepPlot.IsInitialized = False Then Return
	SyncConditionRepresentations
	Dim familyValues As List = CurrentSweepFamilyValues
	SweepSamplesCache = RotorPopups.BuildSweepSamples(ActiveGeom, ActiveCond, SweepParamSelectedKey, SweepMultiMode, SweepMaxMuVal, familyValues, SweepTrimMode)
	RefreshSweepControls
	RedrawSweepPlot
End Sub

' Redraws the bitmap (with the crosshair, if any) from the cached samples and refreshes the text areas.
Private Sub RedrawSweepPlot
	If ivSweepPlot.IsInitialized = False Then Return
	If SweepSamplesCache.IsInitialized = False Then Return
	Dim plotW As Int = ivSweepPlot.Width
	Dim plotH As Int = ivSweepPlot.Height
	If plotW <= 10 Then plotW = root.Width - 16dip
	If plotH <= 10 Then plotH = plotW * 95 / 100
	Dim bmp As Bitmap = RotorPopups.DrawSweepPlot(plotW, plotH, ActiveGeom, ActiveCond, SweepParamSelectedKey, _
		SweepMultiMode, SweepMaxMuVal, SweepXAxisMode, ThemeMode = 1, ExtraPrecision, SweepSamplesCache, PlotPalette, SweepCrossX)
	ivSweepPlot.Bitmap = bmp
	If ActiveRes.SolutionValid Then
		lblSweepCurrentVal.Text = RotorNames.RichText("Active point:" & CRLF & "μ_x = " & FormatSig(ActiveRes.OperatingMu, 3) & _
			" · V_x = " & FormatSig(ActiveRes.OperatingVx, 3) & " m/s · μ_z = " & FormatSig(ActiveRes.OperatingMuZ, 3))
	Else
		lblSweepCurrentVal.Text = "Active point: invalid operating point"
	End If
	Dim t As String = "Tap or drag on the plot to read the curve values."
	If SweepCrossX >= 0 And SweepSamplesCache.Size > 0 Then
		t = RotorPopups.SweepReadout(SweepSamplesCache, SweepParamSelectedKey, SweepXAxisMode, SweepCrossX, ExtraPrecision)
	End If
	lblSweepReadout.Text = RotorNames.RichText(t)
	' Real measured heights (wrapping + font scale) so nothing hides behind the footer buttons.
	lblSweepCurrentVal.Height = Max(46dip, MeasuredTextHeight(lblSweepCurrentVal.Text, lblSweepCurrentVal.TextSize, lblSweepCurrentVal.Width) + 8dip)
	lblSweepReadout.Top = lblSweepCurrentVal.Top + lblSweepCurrentVal.Height + 4dip
	lblSweepReadout.Height = MeasuredTextHeight(t, lblSweepReadout.TextSize, lblSweepReadout.Width) + 12dip
	svSweep.Panel.Height = Max(lblSweepReadout.Top + lblSweepReadout.Height + 24dip, svSweep.Height + 1dip)
End Sub

' Height of text wrapped at widthPx, measured on a fresh TextView (honours font scale and wrapping).
Private Sub MeasuredTextHeight(txt As String, sizeSp As Float, widthPx As Int) As Int
	Dim ctxt As JavaObject
	ctxt.InitializeContext
	Dim tv As JavaObject
	tv.InitializeNewInstance("android.widget.TextView", Array(ctxt))
	tv.RunMethod("setTextSize", Array(sizeSp))
	tv.RunMethod("setText", Array(txt.Replace("_", "")))
	Dim ms As JavaObject
	ms.InitializeStatic("android.view.View$MeasureSpec")
	Dim wSpec As Int = ms.RunMethod("makeMeasureSpec", Array(widthPx, 1073741824))
	Dim hSpec As Int = ms.RunMethod("makeMeasureSpec", Array(0, 0))
	tv.RunMethod("measure", Array(wSpec, hSpec))
	Dim h As Int = tv.RunMethod("getMeasuredHeight", Null)
	Return h
End Sub

Sub btnSweepTable_Click
	If SweepSamplesCache.IsInitialized = False Or SweepSamplesCache.Size = 0 Then UpdateSweepPlotView
	OpenSweepTablePopup
End Sub

Private Sub OpenSweepTablePopup
	If SweepTablePopupOpen Then CloseSweepTablePopup
	pnlSweepTablePopup.Initialize("")
	pnlSweepTablePopup.Color = ColorPnlInput5
	root.AddView(pnlSweepTablePopup, 0, 0, root.Width, root.Height)
	SweepTablePopupOpen = True
	pnlSweepTablePopup.BringToFront
	Dim headerH As Int = 52dip
	Dim header As Panel
	header.Initialize("")
	header.Color = ColorPnlTitle
	pnlSweepTablePopup.AddView(header, 0, 0, root.Width, headerH)
	Dim title As Label
	title.Initialize("")
	title.Text = RotorNames.RichText(RotorPopups.SweepParamFullName(SweepParamSelectedKey) & " " & RotorPopups.PrettySymbol(RotorPopups.SweepParamSymbol(SweepParamSelectedKey)))
	title.TextColor = ColorAccentCyan
	title.Typeface = Typeface.DEFAULT_BOLD
	title.TextSize = 15 * sc
	title.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	title.SingleLine = False
	SetTextLines(title, 2)
	header.AddView(title, 16dip, 0, root.Width - 72dip, headerH)
	Dim close As Button
	close.Initialize("btnCloseSweepTable")
	close.Text = "×"
	close.TextColor = ColorAccentRed
	close.TextSize = 20
	close.Color = Colors.Transparent
	header.AddView(close, root.Width - 52dip, 2dip, 48dip, 48dip)
	Dim wv As WebView
	wv.Initialize("")
	pnlSweepTablePopup.AddView(wv, 0, headerH, root.Width, root.Height - headerH)
	wv.LoadHtml(BuildSweepTableHtml)
End Sub

Sub btnCloseSweepTable_Click
	CloseSweepTablePopup
End Sub

Private Sub CloseSweepTablePopup
	If SweepTablePopupOpen Then
		pnlSweepTablePopup.RemoveView
		SweepTablePopupOpen = False
	End If
End Sub

Private Sub HtmlEscape(textValue As String) As String
	Return textValue.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;")
End Sub

' Wide table with a sticky header row and a sticky first column; 15 px text, units in the headers.
Private Sub BuildSweepTableHtml As String
	Dim dark As Boolean = (ThemeMode = 0)
	Dim bg As String = "#ffffff"
	Dim fg As String = "#172033"
	Dim grid As String = "#d5dce6"
	Dim hint As String = "#5b6b82"
	If dark Then
		bg = "#10141c"
		fg = "#f1f5f9"
		grid = "#273244"
		hint = "#94a3b8"
	End If
	Dim rows As List = RotorPopups.BuildSweepTableRows(SweepSamplesCache, SweepParamSelectedKey, SweepXAxisMode, ExtraPrecision, False)
	Dim cols As Int = 0
	If rows.Size > 0 Then
		Dim h0() As String = rows.Get(0)
		cols = h0.Length
	End If
	Dim strategy As String = RotorPopups.SweepTrimModeLabel(SweepTrimMode)
	If ActiveCond.OperatingPair = "rpm_collective" Then strategy = "Prescribed RPM + Δθ (no trim)"
	Dim sb As StringBuilder
	sb.Initialize
	sb.Append("<html><head><meta name='viewport' content='width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no'><style>")
	sb.Append("html,body{margin:0;height:100%;background:").Append(bg).Append(";color:").Append(fg).Append(";font-family:sans-serif;font-size:15px}")
	sb.Append(".hint{padding:6px 12px;font-size:13px;color:").Append(hint).Append(";height:36px;box-sizing:border-box;overflow:hidden}")
	sb.Append(".wrap{overflow:auto;height:calc(100% - 36px)}")
	sb.Append("table{border-collapse:separate;border-spacing:0;white-space:nowrap}")
	sb.Append("th,td{padding:10px 14px;border-bottom:1px solid ").Append(grid).Append(";border-right:1px solid ").Append(grid).Append(";text-align:right;background:").Append(bg).Append("}")
	sb.Append("th{position:sticky;top:0;z-index:2;font-weight:bold}")
	sb.Append("td:first-child,th:first-child{position:sticky;left:0;z-index:1;text-align:left;font-weight:bold}")
	sb.Append("th:first-child{z-index:3}</style></head><body>")
	sb.Append("<div class='hint'>").Append(HtmlEscape(strategy))
	If cols > 2 Then sb.Append(" &nbsp;·&nbsp; swipe sideways for more columns &#8596;")
	sb.Append("</div><div class='wrap'><table>")
	For r = 0 To rows.Size - 1
		Dim cells() As String = rows.Get(r)
		sb.Append("<tr>")
		For c = 0 To cells.Length - 1
			If r = 0 Then
				sb.Append("<th>").Append(Regex.Replace("_([A-Za-z0-9]+)", HtmlEscape(cells(c)), "<sub>$1</sub>")).Append("</th>")
			Else
				sb.Append("<td>").Append(HtmlEscape(cells(c))).Append("</td>")
			End If
		Next
		sb.Append("</tr>")
	Next
	sb.Append("</table></div></body></html>")
	Return sb.ToString
End Sub

' ====================================================================
' SWEEP EXPORT — Android Storage Access Framework, no storage permission
' ====================================================================
Sub btnSweepExportCsv_Click
	Dim csv As String = BuildSweepCsv
	Dim tempName As String = "rotor_sweep_export.csv"
	File.WriteString(File.DirInternal, tempName, csv)
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "text/csv", SweepExportBaseName & ".csv")) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("CSV exported.", False)
	Else
		ToastMessageShow("CSV export canceled or failed.", False)
	End If
End Sub

Sub btnSweepExportPng_Click
	If ivSweepPlot.IsInitialized = False Then Return
	Dim bmp As Bitmap = ivSweepPlot.Bitmap
	If bmp.IsInitialized = False Then Return
	Dim tempName As String = "rotor_sweep_export.png"
	Dim out As OutputStream = File.OpenOutput(File.DirInternal, tempName, False)
	bmp.WriteToStream(out, 100, "PNG")
	out.Close
	Dim input As InputStream = File.OpenInput(File.DirInternal, tempName)
	Wait For (SaveAs(input, "image/png", SweepExportBaseName & ".png")) Complete (Success As Boolean)
	If Success Then
		ToastMessageShow("PNG exported.", False)
	Else
		ToastMessageShow("PNG export canceled or failed.", False)
	End If
End Sub

Private Sub SweepExportBaseName As String
	Dim n As String = ActiveGeom.Name.Trim.ToLowerCase
	n = n.Replace(" ", "_").Replace("/", "_").Replace(Chr(92), "_").Replace(":", "_").Replace("|", "_")
	If n = "" Then n = "rotor"
	Return n & "_" & SweepParamSelectedKey.ToLowerCase & "_sweep"
End Sub

Private Sub BuildSweepCsv As String
	If SweepSamplesCache.IsInitialized = False Or SweepSamplesCache.Size = 0 Then UpdateSweepPlotView
	Dim rows As List = RotorPopups.BuildSweepTableRows(SweepSamplesCache, SweepParamSelectedKey, SweepXAxisMode, ExtraPrecision, True)
	Dim sb As StringBuilder
	sb.Initialize
	For r = 0 To rows.Size - 1
		Dim cells() As String = rows.Get(r)
		For c = 0 To cells.Length - 1
			If c > 0 Then sb.Append(",")
			If r = 0 Or cells(c).Contains(",") Or cells(c).Contains(Chr(34)) Then sb.Append(CsvQ(cells(c))) Else sb.Append(cells(c))
		Next
		sb.Append(CRLF)
	Next
	Return sb.ToString
End Sub

Private Sub CsvQ(value As String) As String
	Return Chr(34) & value.Replace(Chr(34), Chr(34) & Chr(34)) & Chr(34)
End Sub

Private Sub SaveAs(Source As InputStream, MimeType As String, Title As String) As ResumableSub
	Dim intent As Intent
	intent.Initialize("android.intent.action.CREATE_DOCUMENT", "")
	intent.AddCategory("android.intent.category.OPENABLE")
	intent.PutExtra("android.intent.extra.TITLE", Title)
	intent.SetType(MimeType)
	Try
		StartActivityForResult(intent)
		Wait For ion_Event (MethodName As String, Args() As Object)
		If Args.Length > 1 And -1 = Args(0) Then
			Dim result As Intent = Args(1)
			Dim jo As JavaObject = result
			Dim ctxt As JavaObject
			Dim resolver As JavaObject = ctxt.InitializeContext.RunMethodJO("getContentResolver", Null)
			Dim target As OutputStream = resolver.RunMethod("openOutputStream", Array(jo.RunMethod("getData", Null), "wt"))
			If target.IsInitialized = False Then
				Source.Close
				Return False
			End If
			File.Copy2(Source, target)
			target.Close
			Source.Close
			Return True
		End If
	Catch
		Log("Export failed: " & LastException.Message)
	End Try
	If Source.IsInitialized Then Source.Close
	Return False
End Sub

Private Sub StartActivityForResult(i As Intent)
	Dim jo As JavaObject = GetBA
	ion = jo.CreateEvent("anywheresoftware.b4a.IOnActivityResult", "ion", Null)
	jo.RunMethod("startActivityForResult", Array(ion, i))
End Sub

Private Sub GetBA As Object
	Dim jo As JavaObject
	Dim cls As String = Me
	cls = cls.SubString("class ".Length)
	jo.InitializeStatic(cls)
	Return jo.GetField("processBA")
End Sub

Sub ion_Event (MethodName As String, Args() As Object) As Object
	Return Null
End Sub

' Parsing Utilities
Private Sub ClampD(value As Double, low As Double, high As Double) As Double
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Sub

Private Sub ParseDoubleDef(txt As String, defVal As Double) As Double
	If txt = "" Or txt = "-" Or txt = "." Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub

Private Sub ParseIntDef(txt As String, defVal As Int) As Int
	If txt = "" Then Return defVal
	Try
		Return txt
	Catch
		Return defVal
	End Try
End Sub

' Android 16 enforces edge-to-edge. Insets are read natively without IME,
' runtime permissions, or JavaObject layout calls. They only define the viewport.
Sub SafeContent_Changed(left As Int, top As Int, width As Int, height As Int)
    If width <= 0 Or height <= 0 Then Return
    If left = SafeContentLeft And top = SafeContentTop And width = SafeContentWidth And height = SafeContentHeight Then Return
    SafeContentLeft = left
    SafeContentTop = top
    SafeContentWidth = width
    SafeContentHeight = height
    Activity.RemoveAllViews
    BuildMainUi
End Sub

#If JAVA
@Override
public void onAttachedToWindow() {
    super.onAttachedToWindow();
    final android.view.View decor = getWindow().getDecorView();
    decor.getViewTreeObserver().addOnGlobalLayoutListener(new android.view.ViewTreeObserver.OnGlobalLayoutListener() {
        @Override public void onGlobalLayout() {
            if (android.os.Build.VERSION.SDK_INT < 23 || isFinishing() || _root == null || !_root.IsInitialized() || _activity == null) return;
            final android.view.View content = _activity.getObject();
            final android.view.WindowInsets insets = decor.getRootWindowInsets();
            if (insets == null) return;
            int il, it, ir, ib;
            if (android.os.Build.VERSION.SDK_INT >= 30) {
                android.graphics.Insets bars = insets.getInsets(android.view.WindowInsets.Type.systemBars() | android.view.WindowInsets.Type.displayCutout());
                il = bars.left; it = bars.top; ir = bars.right; ib = bars.bottom;
            } else {
                il = insets.getStableInsetLeft(); it = insets.getStableInsetTop();
                ir = insets.getStableInsetRight(); ib = insets.getStableInsetBottom();
            }
            int[] origin = new int[2];
            content.getLocationOnScreen(origin);
            android.graphics.Point real = new android.graphics.Point();
            getWindowManager().getDefaultDisplay().getRealSize(real);
            int left = Math.max(0, il - origin[0]);
            int top = Math.max(0, it - origin[1]);
            int width = Math.min(content.getWidth(), real.x - ir - origin[0]) - left;
            int height = Math.min(content.getHeight(), real.y - ib - origin[1]) - top;
            if (width > 0 && height > 0) decor.getViewTreeObserver().removeOnGlobalLayoutListener(this);
            if (width > 0 && height > 0 && (left != _safecontentleft || top != _safecontenttop || width != _safecontentwidth || height != _safecontentheight)) {
                activityBA.raiseEventFromUI(this, "safecontent_changed", left, top, width, height);
            }
        }
    });
}
#End If
