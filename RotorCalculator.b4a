Private Sub CurrentSweepFamilyText As String
	Select SweepMultiMode
		Case 1: Return SweepAlphaValues
		Case 2: Return SweepVzValues
		Case 3: Return SweepMuZValues
	End Select
	Return ""
End Sub

Private Sub SetCurrentSweepFamilyText(value As String)
	Select SweepMultiMode
		Case 1: SweepAlphaValues = value
		Case 2: SweepVzValues = value
		Case 3: SweepMuZValues = value
	End Select
End Sub

Private Sub ParseSweepFamilyValues(raw As String) As List
	Dim values As List
	values.Initialize
	Dim parts() As String = Regex.Split(",", raw)
	If parts.Length < 1 Or parts.Length > 9 Then Return values
	For valueIndex = 0 To parts.Length - 1
		Dim token As String = parts(valueIndex).Trim
		If token = "" Then
			values.Clear
			Return values
		End If
		Try
			Dim v As Double = token
			values.Add(v)
		Catch
			values.Clear
			Return values
		End Try
	Next
	Return values
End Sub

Private Sub CurrentSweepFamilyValues As List
	Dim values As List
	If SweepMultiMode >= 1 And SweepMultiMode <= 3 Then values = ParseSweepFamilyValues(CurrentSweepFamilyText) Else values.Initialize
	If SweepMultiMode = 1 And values.Size = 0 Then values = ParseSweepFamilyValues("-10,-5,0,5,10")
	If SweepMultiMode = 2 And values.Size = 0 Then values = ParseSweepFamilyValues("-10,-5,0,5,10")
	If SweepMultiMode = 3 And values.Size = 0 Then values = ParseSweepFamilyValues("-0.05,-0.025,0,0.025,0.05")
	Return values
End Sub

Private Sub UpdateSweepMultiButtonText
	If btnSweepMultiModel.IsInitialized = False Then Return
	Dim count As Int = RotorPopups.SweepCurveCount(SweepMultiMode, CurrentSweepFamilyValues)
	Dim compactLandscape As Boolean = (ld = 1 And root.Width <= 700dip)
	If compactLandscape Then
		Select SweepMultiMode
			Case 0: btnSweepMultiModel.Text = "Models (4)"
			Case 1: btnSweepMultiModel.Text = "α (" & count & ")"
			Case 2: btnSweepMultiModel.Text = "Vz (" & count & ")"
			Case 3: btnSweepMultiModel.Text = "μz (" & count & ")"
			Case Else: btnSweepMultiModel.Text = "Active"
		End Select
	Else
		Select SweepMultiMode
			Case 0: btnSweepMultiModel.Text = "Inflow Models (4)"
			Case 1: btnSweepMultiModel.Text = "α Family (" & count & ")"
			Case 2: btnSweepMultiModel.Text = "Vz Family (" & count & ")"
			Case 3: btnSweepMultiModel.Text = "μz Family (" & count & ")"
			Case Else: btnSweepMultiModel.Text = "Active Only"
		End Select
	End If
	If SweepMultiMode = 4 Then btnSweepMultiModel.TextColor = ColorButText2 Else btnSweepMultiModel.TextColor = ColorAccentCyan
End Sub

Private Sub UpdateSweepAuxControls
	If btnSweepValues.IsInitialized Then btnSweepValues.Visible = (SweepMultiMode >= 1 And SweepMultiMode <= 3)
	If btnSweepTrimHover.IsInitialized Then
		btnSweepTrimHover.Visible = (ActiveCond.OperatingPair <> "rpm_collective")
		Dim compactControls As Boolean = ((ld = 1 And root.Width <= 700dip) Or root.Width <= 360dip)
		If SweepTrimOnlyHover Then
			If compactControls Then btnSweepTrimHover.Text = "HOVER TRIM ✓" Else btnSweepTrimHover.Text = "☑ TRIM ONLY HOVER"
			btnSweepTrimHover.TextColor = ColorAccentGreen
		Else
			If compactControls Then btnSweepTrimHover.Text = "HOVER TRIM" Else btnSweepTrimHover.Text = "☐ TRIM ONLY HOVER"
			btnSweepTrimHover.TextColor = ColorButText2
		End If
	End If
End Sub

Sub btnSweepValues_Click
	If SweepMultiMode < 1 Or SweepMultiMode > 3 Then Return
	If SweepValuesPopupOpen Then CloseSweepValuesPopup
	pnlSweepValuesPopup.Initialize("")
	pnlSweepValuesPopup.Color = 0x99000000
	root.AddView(pnlSweepValuesPopup, 0, 0, root.Width, root.Height)
	SweepValuesPopupOpen = True
	pnlSweepValuesPopup.BringToFront
	Dim cardW As Int = Min(root.Width - 24dip, 520dip)
	Dim cardH As Int = 230dip
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput5
	pnlSweepValuesPopup.AddView(card, (root.Width-cardW)/2, (root.Height-cardH)/2, cardW, cardH)
	Dim title As Label
	title.Initialize("")
	Select SweepMultiMode
		Case 1: title.Text = "α FAMILY VALUES [deg]"
		Case 2: title.Text = "Vz FAMILY VALUES [m/s]"
		Case Else: title.Text = "μz FAMILY VALUES [-]"
	End Select
	title.TextColor = ColorAccentCyan
	title.Typeface = Typeface.DEFAULT_BOLD
	title.TextSize = 15
	card.AddView(title, 16dip, 12dip, cardW-32dip, 28dip)
	Dim hint As Label
	hint.Initialize("")
	If SweepMultiMode = 3 Then
		hint.Text = "Enter 1–9 comma-separated axial ratios. Example: -0.05, 0, 0.05"
	Else
		hint.Text = "Enter 1–9 comma-separated values. Example: -10, -5, 0, 5, 10"
	End If
	hint.TextColor = ColorButText2
	hint.TextSize = 12.5
	hint.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	card.AddView(hint, 16dip, 44dip, cardW-32dip, 40dip)
	edtSweepValues.Initialize("")
	edtSweepValues.Text = CurrentSweepFamilyText
	edtSweepValues.TextColor = ColorEdtText
	edtSweepValues.Color = ColorEdt
	edtSweepValues.TextSize = 15
	edtSweepValues.SingleLine = True
	card.AddView(edtSweepValues, 16dip, 90dip, cardW-32dip, 48dip)
	Dim btnCancel As Button = CreateRowButton("CANCEL", "btnCancelSweepValues")
	Dim btnApply As Button = CreateRowButton("APPLY", "btnApplySweepValues")
	card.AddView(btnCancel, 16dip, 158dip, (cardW-38dip)/2, 48dip)
	card.AddView(btnApply, 22dip+(cardW-38dip)/2, 158dip, (cardW-38dip)/2, 48dip)
End Sub

Sub btnApplySweepValues_Click
	Dim values As List = ParseSweepFamilyValues(edtSweepValues.Text)
	If values.Size = 0 Then
		ToastMessageShow("Enter 1–9 valid numbers separated by commas.", True)
		Return
	End If
	For familyIndex = 0 To values.Size - 1
		Dim familyValue As Double = values.Get(familyIndex)
		If SweepMultiMode = 1 And (familyValue <= -89 Or familyValue >= 89) Then
			ToastMessageShow("α family values must stay between -89° and +89°.", True)
			Return
		End If
		If SweepMultiMode = 2 And Abs(familyValue) > 200 Then
			ToastMessageShow("Vz family values must stay within ±200 m/s.", True)
			Return
		End If
		If SweepMultiMode = 3 And Abs(familyValue) > 0.50 Then
			ToastMessageShow("μz family values must stay within ±0.50.", True)
			Return
		End If
	Next
	SetCurrentSweepFamilyText(edtSweepValues.Text.Trim)
	CloseSweepValuesPopup
	UpdateSweepMultiButtonText
	UpdateSweepPlotView
End Sub

