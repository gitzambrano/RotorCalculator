Sub spnUnitMode_ItemClick(Position As Int, Value As Object)
	UpdateUnitConversion
End Sub

Sub edtUnitValue_TextChanged (Old As String, New As String)
	If UnitPopupOpen Then UpdateUnitConversion
End Sub

Private Sub UpdateUnitConversion
	If spnUnitMode.IsInitialized = False Or edtUnitValue.IsInitialized = False Or lblUnitResult.IsInitialized = False Then Return
	Dim x As Double = ParseDoubleDef(edtUnitValue.Text, 0)
	Dim y As Double
	Dim unitText As String
	Select spnUnitMode.SelectedIndex
		Case 0
			y = x * 1.34102209 : unitText = "hp"
		Case 1
			y = x / 1.34102209 : unitText = "kW"
		Case 2
			y = x / 9.80665 : unitText = "kgf"
		Case 3
			y = x * 9.80665 : unitText = "N"
		Case 4
			y = x * 0.224808943 : unitText = "lbf"
		Case 5
			y = x / 0.224808943 : unitText = "N"
		Case 6
			y = x / 1.852 : unitText = "kt"
		Case 7
			y = x * 1.852 : unitText = "km/h"
		Case 8
			y = x / 3.6 : unitText = "m/s"
		Case 9
			y = x * 3.6 : unitText = "km/h"
		Case 10
			y = x * 3.280839895 : unitText = "ft"
		Case 11
			y = x / 3.280839895 : unitText = "m"
		Case 12
			y = x / 25.4 : unitText = "in"
		Case Else
			y = x * 25.4 : unitText = "mm"
	End Select
	lblUnitResult.Text = NumberFormat2(y, 1, 4, 4, False) & " " & unitText
End Sub


' ====================================================================
' AEROCALCULATOR-STYLE INPUT UNITS
' ====================================================================
Private Sub InitializeInputUnitMaps
	If InputUnits.IsInitialized Then
		If InputUnits.Size > 0 Then Return
	Else
		InputUnits.Initialize
	End If
	Dim lenUnit As String = "m"
	Dim areaUnit As String = "m²"
	Dim speedUnit As String = "m/s"
	Dim thrustUnit As String = "N"
	Dim tempUnit As String = "°C"
	If UnitSystem = 1 Then
		lenUnit = "ft"
		areaUnit = "ft²"
		speedUnit = "ft/s"
		thrustUnit = "lbf"
		tempUnit = "°F"
	End If
	InputUnits.Put("Radius R", lenUnit)
	InputUnits.Put("Root Chord c0", lenUnit)
	InputUnits.Put("Tip Chord c1", lenUnit)
	InputUnits.Put("Root Incidence", "deg")
	InputUnits.Put("Tip Incidence", "deg")
	InputUnits.Put("Lift Slope a0", "rad⁻¹")
	InputUnits.Put("Disk Area", areaUnit)
	InputUnits.Put("Reference Blade Area", areaUnit)
	InputUnits.Put("Active Blade Area", areaUnit)
	InputUnits.Put("Total Twist", "deg")
	InputUnits.Put("h — Altitude", lenUnit)
	InputUnits.Put("Tair — Temperature", tempUnit)
	InputUnits.Put("Horizontal Vx", speedUnit)
	InputUnits.Put("Axial Vz", speedUnit)
	InputUnits.Put("Axial Alpha", "deg")
	InputUnits.Put("RPM", "rpm")
	InputUnits.Put("Collective Δθ", "deg")
	InputUnits.Put("Target CT", "[-]")
	InputUnits.Put("Target Thrust", thrustUnit)
End Sub

Private Sub UnitKeyForField(field As String) As String
	If field = "Horizontal Flow" Then
		If HorizontalInputMode = "vx" Then Return "Horizontal Vx" Else Return "Horizontal Mu"
	End If
	If field = "Axial Flow" Then
		If AxialInputMode = "vz" Then Return "Axial Vz"
		If AxialInputMode = "alpha" Then Return "Axial Alpha"
		Return "Axial MuZ"
	End If
	Return field
End Sub

Private Sub UnitForField(field As String, fallback As String) As String
	Dim key As String = UnitKeyForField(field)
	If key = "Horizontal Mu" Or key = "Axial MuZ" Then Return "[-]"
	If InputUnits.IsInitialized Then
		If InputUnits.ContainsKey(key) Then Return "" & InputUnits.Get(key)
	End If
	Return fallback
End Sub

Private Sub UnitChoices(field As String) As List
	Dim out As List
	out.Initialize
	Dim key As String = UnitKeyForField(field)
	Select key
		Case "Radius R", "Root Chord c0", "Tip Chord c1"
			out.AddAll(Array As String("m", "ft", "in", "cm", "mm"))
		Case "h — Altitude"
			out.AddAll(Array As String("m", "ft", "km"))
		Case "Disk Area", "Reference Blade Area", "Active Blade Area"
			out.AddAll(Array As String("m²", "ft²", "in²", "cm²"))
		Case "Root Incidence", "Tip Incidence", "Total Twist", "Axial Alpha", "Collective Δθ"
			out.AddAll(Array As String("deg", "rad"))
		Case "Lift Slope a0"
			out.AddAll(Array As String("rad⁻¹", "deg⁻¹"))
		Case "Tair — Temperature"
			out.AddAll(Array As String("°C", "°F", "K"))
		Case "Horizontal Vx", "Axial Vz"
			out.AddAll(Array As String("m/s", "ft/s", "kt", "km/h"))
		Case "RPM"
			out.AddAll(Array As String("rpm", "rad/s"))
		Case "Target Thrust"
			out.AddAll(Array As String("N", "kN", "lbf"))
		Case Else
			out.Add("[-]")
	End Select
	Return out
End Sub

Private Sub CanonicalToDisplay(field As String, value As Double) As Double
	Dim key As String = UnitKeyForField(field)
	Dim u As String = UnitForField(field, "")
	Select key
		Case "Radius R", "Root Chord c0", "Tip Chord c1", "h — Altitude"
			Select u
				Case "ft": Return value * 3.280839895
				Case "in": Return value / 0.0254
				Case "cm": Return value * 100.0
				Case "mm": Return value * 1000.0
				Case "km": Return value / 1000.0
			End Select
		Case "Disk Area", "Reference Blade Area", "Active Blade Area"
			Select u
				Case "ft²": Return value * 10.763910417
				Case "in²": Return value / 0.00064516
				Case "cm²": Return value * 10000.0
			End Select
		Case "Root Incidence", "Tip Incidence", "Total Twist", "Axial Alpha", "Collective Δθ"
			If u = "rad" Then Return value * cPI / 180.0
		Case "Lift Slope a0"
			If u = "deg⁻¹" Then Return value * cPI / 180.0
		Case "Tair — Temperature"
			If u = "°F" Then Return value * 9.0 / 5.0 + 32.0
			If u = "K" Then Return value + 273.15
		Case "Horizontal Vx", "Axial Vz"
			If u = "ft/s" Then Return value * 3.280839895
			If u = "kt" Then Return value * 1.943844492
			If u = "km/h" Then Return value * 3.6
		Case "RPM"
			If u = "rad/s" Then Return value * 2.0 * cPI / 60.0
		Case "Target Thrust"
			If u = "kN" Then Return value / 1000.0
			If u = "lbf" Then Return value * 0.224808943
	End Select
	Return value
End Sub

Private Sub InputToCanonical(field As String, value As Double) As Double
	Dim key As String = UnitKeyForField(field)
	Dim u As String = UnitForField(field, "")
	Select key
		Case "Radius R", "Root Chord c0", "Tip Chord c1", "h — Altitude"
			Select u
				Case "ft": Return value / 3.280839895
				Case "in": Return value * 0.0254
				Case "cm": Return value / 100.0
				Case "mm": Return value / 1000.0
				Case "km": Return value * 1000.0
			End Select
		Case "Disk Area", "Reference Blade Area", "Active Blade Area"
			Select u
				Case "ft²": Return value / 10.763910417
				Case "in²": Return value * 0.00064516
				Case "cm²": Return value / 10000.0
			End Select
		Case "Root Incidence", "Tip Incidence", "Total Twist", "Axial Alpha", "Collective Δθ"
			If u = "rad" Then Return value * 180.0 / cPI
		Case "Lift Slope a0"
			If u = "deg⁻¹" Then Return value * 180.0 / cPI
		Case "Tair — Temperature"
			If u = "°F" Then Return (value - 32.0) * 5.0 / 9.0
			If u = "K" Then Return value - 273.15
		Case "Horizontal Vx", "Axial Vz"
			If u = "ft/s" Then Return value / 3.280839895
			If u = "kt" Then Return value / 1.943844492
			If u = "km/h" Then Return value / 3.6
		Case "RPM"
			If u = "rad/s" Then Return value * 60.0 / (2.0 * cPI)
		Case "Target Thrust"
			If u = "kN" Then Return value * 1000.0
			If u = "lbf" Then Return value / 0.224808943
	End Select
	Return value
End Sub

Private Sub FormatInputValue(field As String, canonical As Double, decimals As Int) As String
	Dim minimumDigits As Int = decimals
	If field = "Root Chord c0" Or field = "Tip Chord c1" Then minimumDigits = Min(2, decimals)
	Return NumberFormat2(CanonicalToDisplay(field, canonical), 1, decimals, minimumDigits, False)
End Sub

Sub unitRow_Click
	Dim u As Button = Sender
	Dim field As String = "" & u.Tag
	Dim options As List = UnitChoices(field)
	If options.Size <= 1 Then
		If field = "Rotor Name" Then
			ToastMessageShow("Rotor name is text. Edit the value to rename this rotor.", False)
		Else If field = "Profile Drag" Then
			ToastMessageShow("Profile drag uses Numerical Vectorial integration. Tap Drag for details.", False)
		Else If u.Text = "—" Then
			ToastMessageShow("This selection has no physical unit; tap its label or value to choose.", False)
		Else
			ToastMessageShow("This quantity has no alternate display unit.", False)
		End If
		Return
	End If
	Dim current As String = UnitForField(field, "" & u.Text)
	Dim selected As Int = 0
	For i = 0 To options.Size - 1
		If ("" & options.Get(i)) = current Then selected = i
	Next
	Dim idx As Int = InputList(options, "Unit · " & field, selected)
	If idx < 0 Then Return
	InputUnits.Put(UnitKeyForField(field), "" & options.Get(idx))
	u.Text = UnitForField(field, "" & options.Get(idx))
	If edtRadius.IsInitialized Then LoadRotorDataToFields(ActiveGeom)
	If edtAltitude.IsInitialized Then LoadConditionDataToFields
	RecalculateRotor
End Sub

Sub btnActiveRotor_Click
	Dim options As List
	options.Initialize
	For i = 0 To RotorStorage.Rotors.Size - 1
		Dim g As RotorGeometry = RotorStorage.Rotors.Get(i)
		options.Add(RotorListName(g.Name))
	Next
	options.Add("＋ NEW ROTOR")
	Dim idx As Int = InputList(options, "Active Rotor", RotorStorage.ActiveIndex)
	If idx < 0 Then Return
	If idx = RotorStorage.Rotors.Size Then
		btnNewRotor_Click
		Return
	End If
	If idx = RotorStorage.ActiveIndex Then Return
	If GeometryDirty Then
		If ResolveUnsavedGeometry("changing the active rotor") = False Then Return
	End If
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshActiveRotorBar
	RecalculateRotor
End Sub


' ====================================================================
' PAGE 0: GEOMETRY — Direct Active-Rotor Editor
' ====================================================================
Private Sub BuildPageGeom
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
	Dim topY As Int = 8dip
	Dim topH As Int = 50dip
	Dim actionsH As Int = 54dip
	
	btnActiveRotor.Initialize("btnActiveRotor")
	btnActiveRotor.Typeface = Typeface.DEFAULT_BOLD
	btnActiveRotor.TextColor = ColorAccentCyan
	btnActiveRotor.TextSize = 15 * sc
	btnActiveRotor.Gravity = Gravity.CENTER
	btnActiveRotor.SingleLine = True
	btnActiveRotor.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	
	Dim actionBar As Panel
	actionBar.Initialize("")
	actionBar.Color = ColorPnlInput5
	Dim gap As Int = 8dip
	Dim bSave As Button = CreateRowButton("SAVE", "btnGeometrySave")
	Dim bCopy As Button = CreateRowButton("COPY", "btnGeometryCopy")
	Dim bDelete As Button = CreateRowButton("DELETE", "btnGeometryDelete")
	bSave.TextColor = ColorAccentGreen
	bCopy.TextColor = ColorButText2
	bDelete.TextColor = ColorButText2
	If RotorStorage.Rotors.Size <= 1 Then
		bDelete.Enabled = False
		bDelete.TextColor = ColorButText2
	End If
	
	Dim editorTop As Int
	If ld = 1 Then
		' Landscape has little vertical room: rotor identity and actions share one 50dip band.
		Dim activeW As Int = UiContentW * 42 / 100
		Dim actionLeft As Int = UiContentLeft + activeW + 6dip
		Dim actionW As Int = UiContentW - activeW - 6dip
		pnlBack0.AddView(btnActiveRotor, UiContentLeft, topY, activeW, topH)
		pnlBack0.AddView(actionBar, actionLeft, topY, actionW, topH)
		Dim gapL As Int = 5dip
		Dim bwL As Int = (actionW - gapL * 2) / 3
		actionBar.AddView(bSave, 0, 1dip, bwL, 48dip)
		actionBar.AddView(bCopy, bwL + gapL, 1dip, bwL, 48dip)
		actionBar.AddView(bDelete, 2 * (bwL + gapL), 1dip, actionW - 2 * (bwL + gapL), 48dip)
		editorTop = topY + topH + 6dip
	Else
		pnlBack0.AddView(btnActiveRotor, UiContentLeft + 10dip, topY, UiContentW - 20dip, topH)
		pnlBack0.AddView(actionBar, UiContentLeft, topY + topH + 4dip, UiContentW, actionsH)
		Dim bw As Int = (UiContentW - gap * 4) / 3
		actionBar.AddView(bSave, gap, 3dip, bw, 48dip)
		actionBar.AddView(bCopy, gap * 2 + bw, 3dip, bw, 48dip)
		actionBar.AddView(bDelete, gap * 3 + bw * 2, 3dip, bw, 48dip)
		editorTop = topY + topH + actionsH + 8dip
	End If
	
	scvGeom.Initialize(3000dip)
	pnlBack0.AddView(scvGeom, 0, editorTop, root.Width, Max(120dip, root.Height - HeaderHeight - editorTop))
	BuildGeometryEditorContent
	LoadRotorDataToFields(ActiveGeom)
	RefreshActiveRotorBar
End Sub



Sub btnNewRotor_Click
	If GeometryDirty Then
		If ResolveUnsavedGeometry("creating a new rotor") = False Then Return
	End If
	Dim idx As Int = RotorStorage.CreateNewRotor
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshActiveRotorBar
	RecalculateRotor
End Sub


Private Sub BuildGeometryEditorContent
	Dim y As Int = 8dip
	Dim rowIndex As Int = 0
	Dim rowH As Int = 57dip
	Dim pnl As Panel
	
	y = AddGeometrySectionHeader(y, "BLADE GEOMETRY")
	Dim nameRowH As Int = 82dip
	If root.Width <= 340dip Then nameRowH = 112dip
	pnl = AddFormRowPanelSized(scvGeom, y, rowIndex, nameRowH - 1dip)
	edtRotorName = AddTextInputRow(pnl, 4dip, nameRowH - 10dip, "Rotor Name", ActiveGeom.Name, "edtGeom")
	y = y + nameRowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRadius = AddFullInputRow(pnl, 4dip, 48dip, "Radius R", "", "m", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtNBlades = AddFullInputRow(pnl, 4dip, 48dip, "Blade Count", "", "[-]", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtRootCutout = AddFullInputRow(pnl, 4dip, 48dip, "Root Cutout", "", "r/R", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtChordRoot = AddFullInputRow(pnl, 4dip, 48dip, "Root Chord c0", "", "m", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtChordTip = AddFullInputRow(pnl, 4dip, 48dip, "Tip Chord c1", "", "m", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtSigmaRef = AddFullInputRow(pnl, 4dip, 48dip, "Reference Solidity", "", "[-]", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtAspectRatio = AddFullInputRow(pnl, 4dip, 48dip, "Aspect Ratio", "", "[-]", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtThetaRoot = AddFullInputRow(pnl, 4dip, 48dip, "Root Incidence", "", "deg", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtThetaTip = AddFullInputRow(pnl, 4dip, 48dip, "Tip Incidence", "", "deg", "edtGeom"): y = y + rowH: rowIndex=rowIndex+1
	
	y = AddGeometrySectionHeader(y + 4dip, "DERIVED GEOMETRY")
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblSigmaGeomDerived = AddDerivedRow(pnl, "Geometric Solidity", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblSigmaThrustDerived = AddDerivedRow(pnl, "Thrust Solidity", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblTaperDerived = AddDerivedRow(pnl, "Taper Ratio", "[-]"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblDiskAreaDerived = AddDerivedRow(pnl, "Disk Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblRefBladeAreaDerived = AddDerivedRow(pnl, "Reference Blade Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblActiveBladeAreaDerived = AddDerivedRow(pnl, "Active Blade Area", "m²"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): lblTwistDerived = AddDerivedRow(pnl, "Total Twist", "deg"): y=y+rowH: rowIndex=rowIndex+1
	
	y = AddGeometrySectionHeader(y + 4dip, "ROTOR AERODYNAMICS")
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblAirfoil As Button = CreateRowLabel("Airfoil", "lblRowTip")
	pnl.AddView(lblAirfoil, pnl.Width*3/100, 4dip, pnl.Width*31/100, 48dip)
	btnSelectAirfoil = CreateRowButton("Airfoil", "btnSelectAirfoil")
	pnl.AddView(btnSelectAirfoil, pnl.Width*36/100, 4dip, pnl.Width*39/100, 48dip)
	Dim unitAirfoil As Button = CreateUnitButton("Airfoil", "—")
	pnl.AddView(unitAirfoil, pnl.Width*77/100, 4dip, pnl.Width*20/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtLiftSlope = AddFullInputRow(pnl, 4dip, 48dip, "Lift Slope a0", "", "rad⁻¹", "edtGeom"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtCd0 = AddFullInputRow(pnl, 4dip, 48dip, "Profile Cd0", "", "[-]", "edtGeom"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblTip As Button = CreateRowLabel("Tip Loss", "lblRowTip")
	pnl.AddView(lblTip, pnl.Width*3/100, 4dip, pnl.Width*31/100, 48dip)
	btnTipLoss = CreateRowButton("Tip Loss", "btnTipLoss")
	pnl.AddView(btnTipLoss, pnl.Width*36/100, 4dip, pnl.Width*39/100, 48dip)
	Dim unitTip As Button = CreateUnitButton("Tip Loss", "—")
	pnl.AddView(unitTip, pnl.Width*77/100, 4dip, pnl.Width*20/100, 48dip)
	y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex): edtTipLossB = AddFullInputRow(pnl, 4dip, 48dip, "Fixed Tip Factor B", "", "[-]", "edtGeom"): y=y+rowH: rowIndex=rowIndex+1
	pnl = AddFormRowPanel(scvGeom, y, rowIndex)
	Dim lblComp As Button = CreateRowLabel("Compressibility", "lblRowTip")
	pnl.AddView(lblComp, pnl.Width*3/100, 4dip, pnl.Width*31/100, 48dip)
	btnCompressibility = CreateRowButton("Compressibility", "btnCompressibility")
	pnl.AddView(btnCompressibility, pnl.Width*36/100, 4dip, pnl.Width*39/100, 48dip)
	Dim unitComp As Button = CreateUnitButton("Compressibility", "—")
	pnl.AddView(unitComp, pnl.Width*77/100, 4dip, pnl.Width*20/100, 48dip)
	y=y+rowH
	
	scvGeom.Panel.Height = y + 18dip
End Sub

Private Sub AddGeometrySectionHeader(y As Int, title As String) As Int
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title
	lbl.TextColor = ColorAccentGreen
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextSize = 14 * sc
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	scvGeom.Panel.AddView(lbl, UiContentLeft + 12dip, y, UiContentW - 24dip, 26dip)
	Return y + 28dip
End Sub

Private Sub AddFormRowPanel(scv As ScrollView, y As Int, rowIndex As Int) As Panel
	Return AddFormRowPanelSized(scv, y, rowIndex, 56dip)
End Sub

Private Sub AddFormRowPanelSized(scv As ScrollView, y As Int, rowIndex As Int, rowHeight As Int) As Panel
	Dim pnl As Panel
	pnl.Initialize("")
	If rowIndex Mod 2 = 0 Then pnl.Color = ColorPnlInput2 Else pnl.Color = ColorPnlInput1
	scv.Panel.AddView(pnl, UiContentLeft, y, UiContentW, rowHeight)
	Dim lineRow As Panel
	lineRow.Initialize("")
	lineRow.Color = ColorPnlLine3
	scv.Panel.AddView(lineRow, UiContentLeft, y + rowHeight - 1dip, UiContentW, 1dip)
	Return pnl
End Sub

Sub AddDerivedRow(pnl As Panel, title As String, unit As String) As Label
	Dim lbl As Button = CreateRowLabel(title, "lblRowTip")
	lbl.TextColor = ColorButText2
	lbl.Background = ButtonGradient(Array As Int(ColorPnlInput1, ColorPnlInput2), Array As Int(ColorPnlInput2, ColorBut1))
	pnl.AddView(lbl, pnl.Width*3/100, 4dip, pnl.Width*31/100, 48dip)
	Dim value As Label
	value.Initialize("")
	value.Text = "---"
	value.TextColor = ColorButText2
	value.Typeface = Typeface.DEFAULT_BOLD
	value.TextSize = 16 * sc
	value.Gravity = Gravity.CENTER
	value.SingleLine = True
	value.Color = Colors.Transparent
	pnl.AddView(value, pnl.Width*36/100, 4dip, pnl.Width*39/100, 48dip)
	Dim u As Button = CreateUnitButton(title, unit)
	u.TextColor = ColorButText2
	u.Background = ButtonGradient(Array As Int(ColorPnlInput1, ColorPnlInput2), Array As Int(ColorPnlInput2, ColorBut1))
	pnl.AddView(u, pnl.Width*77/100, 4dip, pnl.Width*20/100, 48dip)
	Return value
End Sub

Sub RefreshActiveRotorBar
	If btnActiveRotor.IsInitialized = False Then Return
	Dim suffix As String = ""
	If GeometryDirty Then suffix = "  ·  UNSAVED"
	btnActiveRotor.Text = "ACTIVE ROTOR  ·  " & RotorListName(ActiveGeom.Name) & suffix
	If GeometryDirty Then
		btnActiveRotor.TextColor = ColorAccentAmber
	Else
		btnActiveRotor.TextColor = ColorAccentCyan
	End If
End Sub

Sub SaveCurrentRotor
	RotorStorage.UpdateRotor(RotorStorage.ActiveIndex, ActiveGeom)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshActiveRotorBar
	RecalculateRotor
	ToastMessageShow("Rotor saved.", False)
End Sub

Private Sub ResolveUnsavedGeometry(ActionText As String) As Boolean
	If GeometryDirty = False Then Return True
	Dim answer As Int = Msgbox2("Geometry has unsaved changes." & CRLF & CRLF & _
		"Save them before " & ActionText & "?", "Unsaved Geometry", "SAVE", "Cancel", "Discard", Null)
	If answer = DialogResponse.CANCEL Then Return False
	If answer = DialogResponse.POSITIVE Then
		SaveCurrentRotor
	Else
		ActiveGeom = RotorStorage.GetActiveRotor
		GeometryDirty = False
		RecalculateRotor
	End If
	Return True
End Sub



Sub btnGeometrySave_Click
	SaveCurrentRotor
End Sub

Sub btnGeometryCopy_Click
	Dim copyGeom As RotorGeometry = zBETEngine.CloneGeometry(ActiveGeom)
	copyGeom.Name = RotorStorage.MakeCopyName(copyGeom.Name)
	Dim idx As Int = RotorStorage.AddRotor(copyGeom)
	RotorStorage.SetActiveRotor(idx)
	ActiveGeom = RotorStorage.GetActiveRotor
	GeometryDirty = False
	LoadRotorDataToFields(ActiveGeom)
	RefreshActiveRotorBar
	RecalculateRotor
	ToastMessageShow("Rotor copied: " & ActiveGeom.Name, False)
End Sub

Sub btnGeometryDelete_Click
	If RotorStorage.Rotors.Size <= 1 Then
		ToastMessageShow("At least one rotor must remain.", False)
		Return
	End If
	Dim answer As Int = Msgbox2("Delete rotor '" & ActiveGeom.Name & "'?" & CRLF & CRLF & _
		"This removes the saved geometry from the local library.", "Delete Rotor", "DELETE", "Cancel", "", Null)
	If answer <> DialogResponse.POSITIVE Then Return
	If RotorStorage.DeleteRotor(RotorStorage.ActiveIndex) Then
		ActiveGeom = RotorStorage.GetActiveRotor
		GeometryDirty = False
		LoadRotorDataToFields(ActiveGeom)
		RefreshActiveRotorBar
		RecalculateRotor
		ToastMessageShow("Rotor deleted.", False)
	End If
End Sub


